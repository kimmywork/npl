; test_core.npl — Phase 8 GAP-fix tests: cond / internal define /
; global constants / quote / new predicates / multi-expression bodies.
;
; Each case prints a marker and value; the driver (check_core.sh)
; compares combined output. Exit code encodes the last computed value.

; ---- global constants (top-level variable define) ----
(define limit 100)
(define greeting "core")
(define sym-a 'alpha)
(define lst-c '(1 2 3))

; ---- cond: ordinary clauses with body ----
(define (classify n)
  (cond ((< n 0) -1)
        ((= n 0) 0)
        (else 1)))

; ---- cond: test-only clause returns the test's value ----
(define (cond-test-only x)
  (cond ((> x 10)) (else 'small)))

; ---- internal define inside a function body ----
(define (with-inner x)
  (define doubled (* x 2))
  (define shifted (+ doubled 1))
  (+ shifted 1))

; ---- multiple expression body in lambda ----
(define (multi-body x)
  (display "side ")
  (* x x))

; ---- let with internal define semantics ----
(define (let-inner)
  (let ((a 2))
    (define b 30)
    (+ a b)))

; ---- string building via globals ----
(define (describe)
  greeting)

; ---- quote identity across shared symbol ----
(define (same-symbol? s)
  (eq? s 'alpha))

; ---- main: verify everything, print readable proof ----
(define (main)
  ; classify(-5) is -1 — compare by value, -1 literal tag matches
  (display (eq? (classify -5) -1))
  (newline)
  (display (classify 0))
  (newline)
  (display (classify 7))
  (newline)
  ; test-only cond clause returns the test value itself:
  ; (> 20 10) is a proper boolean (#t); else branch yields 'small —
  ; compare by symbol identity instead of printing.
  (display (if (eq? (cond-test-only 20) #t) 111 222))
  (newline)
  (display (if (eq? (cond-test-only 5) 'small) 333 444))
  (newline)
  ; inner defines: (7*2)+1+1 = 16
  (display (with-inner 7))
  (newline)
  ; multi-expression body prints "side " then returns 144 for x=12
  (display (multi-body 12))
  (newline)
  ; let with internal define: 32
  (display (let-inner))
  (newline)
  ; predicates on quoted structures
  (display (pair? lst-c))
  (newline)
  (display (pair? sym-a))
  (newline)
  (display (null? ()))
  (newline)
  (display (not (pair? 42)))
  (newline)
  (display (not #f))
  (newline)
  (display (not ()))
  (newline)
  ; eq? on symbols through globals and quotes
  (display (same-symbol? sym-a))
  (newline)
  (display (same-symbol? 'beta))
  (newline)
  ; quote round trips
  (display lst-c)
  (newline)
  (display 'tail-sym)
  (newline)
  (display '(nested (a b) 9))
  (newline)
  (display limit)
  (newline)
  (display sym-a)
  (newline)
  ; truthiness contract: only #f is false
  (display (if 0 'zero-true 'zero-false))
  (newline)
  (display (if () 'nil-true 'nil-false))
  (newline)
  42)
