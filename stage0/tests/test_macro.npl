; test_macro.npl — Phase 6 test: syntax-rules macros

; Define a simple macro: and
(define-syntax my-and
  (syntax-rules ()
    ((my-and a b)
     (if a b #f))))

; Define a simple macro: or
(define-syntax my-or
  (syntax-rules ()
    ((my-or a b)
     (if a #t b))))

; Define a simple macro: when
(define-syntax my-when
  (syntax-rules ()
    ((my-when test body ...)
     (if test (begin body ...) #f))))

; Test: use my-and
(define (test-and x y)
  (my-and (> x 0) (> y 0)))

; Test: use my-or
(define (test-or x y)
  (my-or (> x 0) (> y 0)))

; Main
(define (main)
  (if (test-and 5 10) 1 0))
