; gc_stress.npl — Phase 3 test: GC stress test
; Constructs many cons cells to trigger garbage collection

(define (make-list n)
  (if (<= n 0)
    ()
    (cons n (make-list (- n 1)))))

(define (list-length lst)
  (if (null? lst)
    0
    (+ 1 (list-length (cdr lst)))))

(define (main)
  (let ((lst (make-list 1000)))
    (list-length lst)))
