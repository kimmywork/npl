(import (scheme base) (scheme write) (scheme file) (npl unix) (npl process))
(define dir (make-temporary-directory))
(define f (string-append dir "/f"))
(call-with-output-file f (lambda (p) (display "0123456789" p)))
(write (guard (e (#t (list 'raised (error-object-message e))))
  (truncate-file f (+ (expt 2 61) 0))
  (list 'size (file-info:size (file-info f #t)))))
(newline)
(delete-file f) (delete-directory dir)
