(import (scheme base) (scheme write) (scheme file) (npl time) (npl unix) (npl process))
(define dir (make-temporary-directory))
(define f (string-append dir "/f"))
(call-with-output-file f (lambda (p) (display "x" p)))
(define (mtime) (time-second (file-info:mtime (file-info f #t))))
(define (try sec)
  (set-file-times f (make-time time-utc 0 100) (make-time time-utc 0 100))
  (set-file-times f (make-time time-utc 0 sec) (make-time time-utc 0 sec))
  (list sec '-> (mtime)))
(write (list (try -3) (try -2) (try -1) (try 0))) (newline)
(delete-file f) (delete-directory dir)
