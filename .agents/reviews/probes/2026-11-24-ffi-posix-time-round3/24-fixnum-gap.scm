(import (scheme base) (scheme write) (scheme file) (npl time) (npl unix) (npl process))
(define dir (make-temporary-directory))
(define f (string-append dir "/f"))
(call-with-output-file f (lambda (p) (display "x" p)))
(define (try sec)
  (guard (e (#t (list 'raised sec (error-object-message e))))
    (set-file-times f (make-time time-utc 0 sec) (make-time time-utc 0 sec))
    (list sec '-> (time-second (file-info:mtime (file-info f #t))))))
(write (try (expt 2 40))) (newline)
(write (try (expt 2 62))) (newline)
(write (try (- (expt 2 62)))) (newline)
(write (guard (e (#t (list 'raised (error-object-message e))))
  (truncate-file f (expt 2 62))
  (list 'size (file-info:size (file-info f #t)))))
(newline)
(delete-file f)
(delete-directory dir)
