; (scheme base) and (scheme char) characters and strings over ASCII
; (R7RS 6.6, 6.7); non-ASCII cases are in fixtures/unicode-strings.
(define (report name value) (write (list name value)) (newline))
(define (bytes b)
  (let loop ((i (- (bytevector-length b) 1)) (out '()))
    (if (< i 0) out (loop (- i 1) (cons (bytevector-u8-ref b i) out)))))
(define (string-results)
  (report 'ref (list (string-ref "abc" 0) (char? (string-ref "abc" 2))
                     (string-length "") (string? "x") (string? #\x)))
  (report 'char-compare (list (char=? #\a #\a #\a) (char<? #\a #\b #\c)
                              (char<? #\a #\c #\b) (char>? #\c #\b)
                              (char<=? #\a #\a #\b) (char>=? #\b #\b #\a)))
  (report 'construct (list (make-string 3 #\x) (string-length (make-string 2))
                           (string #\a #\b) (string) (list->string (list #\h #\i))
                           (string->list "abc") (string->list "abc" 1)
                           (string->list "abc" 1 2)))
  (report 'copy (list (string-copy "abc") (string-copy "abc" 1)
                      (string-copy "abc" 1 2) (string-copy "")
                      (let ((s "abc")) (eq? s (string-copy s)))
                      (substring "hello" 1 3)))
  (report 'mutate (list (let ((s (make-string 3 #\a))) (string-set! s 1 #\b) s)
                        (let ((s (make-string 3 #\a))) (string-fill! s #\z) s)
                        (let ((s (make-string 4 #\a))) (string-fill! s #\z 1 3) s)
                        (let ((s (make-string 4 #\-))) (string-copy! s 1 "ab") s)
                        (let ((s (string #\a #\b #\c #\d)))
                          (string-copy! s 1 s 0 2) s)
                        (let ((s (string-copy "abc"))) (string-set! s 0 #\x) s)))
  (report 'compare (list (string=? "a" "a" "a") (string=? "a" "b")
                         (string<? "a" "b" "c") (string<? "ab" "a")
                         (string<? "a" "ab") (string>? "b" "a")
                         (string<=? "a" "a" "b") (string>=? "b" "b" "a")))
  (report 'convert (list (string->vector "abc") (string->vector "abc" 1)
                         (vector->string #(#\a #\b)) (vector->string #(#\a #\b #\c) 1)
                         (bytes (string->utf8 "abc")) (bytes (string->utf8 "abc" 1 2))
                         (utf8->string (bytevector 104 105))
                         (utf8->string (bytevector 97 98 99) 1)
                         (string->symbol "abc") (symbol->string 'xyz)))
  (report 'map (list (string-map char-upcase "ab")
                     (string-map (lambda (a b) (if (char<? a b) a b)) "adc" "bbbb")
                     (let ((p '()))
                       (string-for-each (lambda (c) (set! p (cons c p))) "ab")
                       p)
                     (let ((p '()))
                       (string-for-each (lambda (a b) (set! p (cons (list a b) p)))
                                        "ab" "xyz")
                       p)))
  (report 'case (list (string-upcase "aBc1") (string-downcase "AbC") (string-foldcase "AbC")
                      (string-ci=? "aB" "Ab" "AB") (string-ci<? "a" "B")
                      (string-ci>? "b" "A") (string-ci<=? "a" "A")
                      (string-ci>=? "B" "a"))))
(define fixture-result (begin (string-results) 0))
