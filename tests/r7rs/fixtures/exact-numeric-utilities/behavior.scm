(define (report name value) (write (list name value)) (newline))
(define (caught thunk)
  (guard (condition (else 'caught)) (thunk) 'not-caught))
(define (utility-results)
  (report 'signs (list (abs -42) (abs -1/2) (zero? 0) (zero? 1/2)
                       (positive? 3/4) (negative? -3/4)
                       (even? 42) (odd? 41)))
  (report 'gcd-lcm (list (gcd 84 -30 18) (lcm 4 -6 10)
                          (gcd 12345678901234567890 9876543210)
                          (lcm 21 6)))
  (report 'division (list (quotient -13 5) (remainder -13 5)
                          (modulo -13 5) (quotient 13 -5)
                          (remainder 13 -5) (modulo 13 -5)))
  (report 'powers (list (expt 2 0) (expt 2 10) (expt -3 5)
                        (square 12) (expt 7/3 3) (expt 2 -1)))
  (report 'rounding (list (floor 7/3) (ceiling 7/3)
                          (truncate -7/3) (round 7/2) (round 5/2)))
  (report 'errors (list (caught (lambda () (gcd 1/2 2)))
                        (caught (lambda () (quotient 1 0)))
                        (= (expt 2 -1) 1/2))))
(define fixture-result (begin (utility-results) 0))
