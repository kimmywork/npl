; SRFI 125 (lib/npl/hashtable.sld), checked by hand against
; docs/reference/srfi-125.html: Guile 3.0 has no SRFI 125. Key order is
; unspecified, so keys are sorted before printing.
(define (sorted-keys t) (list-sort (hash-table-keys t)))
(define (insert x xs) (cond ((null? xs) (list x)) ((< x (car xs)) (cons x xs)) (else (cons (car xs) (insert x (cdr xs))))))
(define (list-sort xs) (if (null? xs) '() (insert (car xs) (list-sort (cdr xs)))))
(define t (make-hash-table equal?))
(hash-table-set! t 1 'one 2 'two)
(hash-table-set! t '(a b) 'list "str" 'string)
(write (list (hash-table-ref/default t 1 #f) (hash-table-ref t '(a b)) (hash-table-ref/default t (string #\s #\t #\r) 'none)
             (hash-table-size t) (hash-table-contains? t 3) (hash-table-ref t 9 (lambda () 'fail)) (hash-table-ref t 1 (lambda () 'fail) (lambda (v) (list v)))))
(newline)
(define q (make-hash-table eq?))
(let loop ((i 0)) (if (< i 1000) (begin (hash-table-set! q i (* i i)) (loop (+ i 1)))))
(write (hash-table-size q)) (write (hash-table-ref/default q 999 #f)) (write (hash-table-delete! q 1 2 5000)) (write (hash-table-size q))
(newline)
(let loop ((i 0)) (if (< i 1000) (begin (hash-table-delete! q i) (loop (+ i 1)))))
(write (list (hash-table-size q) (hash-table-empty? q))) (newline)
(define s (make-hash-table string=?))
(hash-table-set! s "a" 1)
(hash-table-update! s "a" (lambda (v) (+ v 10)))
(hash-table-update!/default s "b" (lambda (v) (+ v 1)) 0)
(write (list (hash-table-ref s "a") (hash-table-ref s "b") (hash-table-intern! s "c" (lambda () 'new)) (hash-table-intern! s "c" (lambda () 'newer))))
(newline)
(define ci (make-hash-table string-ci=?))
(hash-table-set! ci "Hello" 1)
(write (hash-table-ref/default ci "HELLO" #f)) (newline)
(define u (make-hash-table (lambda (a b) (= (modulo a 10) (modulo b 10))) (lambda (x) (modulo x 10))))
(hash-table-set! u 13 'x)
(write (list (hash-table-ref/default u 23 #f) (hash-table-ref/default u 24 #f))) (newline)
(define im (hash-table eqv? 1 'a 2 'b))
(write (list (hash-table-mutable? im) (hash-table-ref im 2)
  (guard (e ((error-object? e) (error-object-message e))) (hash-table-set! im 3 'c))))
(newline)
(write (sorted-keys (alist->hash-table '((3 . c) (1 . a) (3 . z)) eqv?))) (newline)
(write (hash-table-ref (alist->hash-table '((3 . c) (1 . a) (3 . z)) eqv?) 3)) (newline)
(write (hash-table-fold (lambda (k v acc) (+ k acc)) 0 (hash-table-copy im #t))) (newline)
(write (hash-table-fold (hash-table-copy im #t) (lambda (k v acc) (+ k acc)) 100)) (newline)
(define a (alist->hash-table '((1 . a) (2 . b) (3 . c)) eqv?))
(define b (alist->hash-table '((2 . x) (4 . y)) eqv?))
(write (list (list-sort (hash-table-keys (hash-table-union! (hash-table-copy a #t) b)))
             (list-sort (hash-table-keys (hash-table-intersection! (hash-table-copy a #t) b)))
             (list-sort (hash-table-keys (hash-table-difference! (hash-table-copy a #t) b)))
             (list-sort (hash-table-keys (hash-table-xor! (hash-table-copy a #t) b)))
             (hash-table-ref (hash-table-union! (hash-table-copy a #t) b) 2)))
(newline)
(write (list (hash-table=? eq? a (hash-table-copy a)) (hash-table=? eq? a b)
             (hash-table-count (lambda (k v) (odd? k)) a)
             (hash-table-find (lambda (k v) (and (= k 2) v)) a (lambda () 'no))
             (hash-table-find (lambda (k v) #f) a (lambda () 'no))))
(newline)
(define p (hash-table-copy a #t))
(hash-table-prune! (lambda (k v) (odd? k)) p)
(hash-table-map! (lambda (k v) (list k v)) p)
(write (hash-table->alist p)) (newline)
(call-with-values (lambda () (hash-table-pop! p)) (lambda (k v) (write (list k v (hash-table-size p))))) (newline)
(write (guard (e ((error-object? e) (error-object-message e))) (hash-table-pop! p))) (newline)
(write (guard (e ((error-object? e) (error-object-message e))) (hash-table-ref p 'nope))) (newline)
(write (guard (e ((error-object? e) (error-object-message e))) (make-hash-table (lambda (a b) #t)))) (newline)
(write (list (= (hash '(1 2)) (hash (list 1 2))) (= (string-hash "ab") (string-hash (string #\a #\b))) (= (string-ci-hash "AB") (string-ci-hash "ab")) (exact-integer? (hash-by-identity 'x))))
(newline)
