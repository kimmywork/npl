(write (list-sort (hash-table-map->list (lambda (k v) k) a))) (newline)
(call-with-values (lambda () (hash-table-entries a)) (lambda (ks vs) (write (length ks)) (write (length vs)))) (newline)
(write (hash-table-ref/default (hash-table-unfold (lambda (s) (> s 3)) (lambda (s) (values s (* s s))) (lambda (s) (+ s 1)) 0 eqv?) 3 #f)) (newline)
(write (list (hash-table? a) (hash-table? 'a) (hash-table-ref/default (make-hash-table) '(x) 'default-equal)))
(newline)
