(define (deep n acc) (if (= n 0) acc (deep (- n 1) (list acc))))
(define dt (make-hash-table equal?))
(hash-table-set! dt (deep 20000 'leaf) 'deep)
(write (list (hash-table-ref/default dt (deep 20000 'leaf) #f)
             (hash-table-ref/default dt (deep 19999 'leaf) #f)))
