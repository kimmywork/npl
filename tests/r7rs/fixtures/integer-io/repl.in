(import (scheme base) (scheme file) (scheme read) (scheme write))

(define (write-zeroes port count)
  (if (> count 0)
      (begin
        (write-char #\0 port)
        (write-zeroes port (- count 1)))))

(define (exercise-integer-io)
  (let ((path "/tmp/npl-r7rs-integer-io.data"))
    (call-with-output-file path
      (lambda (port)
        (write-char #\1 port)
        (write-zeroes port 40)
        (write-char #\space port)
        (write-char #\- port)
        (write-char #\1 port)
        (write-zeroes port 40)
        (write-char #\space port)
        (write-char #\- port)
        (write-zeroes port 40)
        (write-char #\space port)
        (write-char #\+ port)
        (write-char #\space port)
        (write-char #\- port)))
    (call-with-input-file path
      (lambda (port)
        (let ((positive (read port)))
          (let ((negative (read port)))
            (let ((zero (read port)))
              (write positive)
              (newline)
              (display negative)
              (newline)
              (write zero)
              (newline)
              (write (list positive negative))
              (newline)
              (write (read port))
              (newline)
              (write (read port))
              (newline)
              (write (eof-object? (read port)))
              (newline))))))
    (delete-file path)))

(exercise-integer-io)
(exit)
