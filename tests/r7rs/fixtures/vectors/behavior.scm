; (scheme base) vectors and bytevectors (R7RS 6.8, 6.9), including optional
; ranges and overlapping copies. Bytevectors are reported as byte lists:
; Guile writes #vu8(...) where R7RS writes #u8(...) (guile-extension).
(define (report name value) (write (list name value)) (newline))
(define (bytes b)
  (let loop ((i (- (bytevector-length b) 1)) (out '()))
    (if (< i 0) out (loop (- i 1) (cons (bytevector-u8-ref b i) out)))))
(define (vector-results)
  (report 'construct (list (make-vector 2 'x) (vector-length (make-vector 3))
                           (list->vector '(1 2)) (vector->list #(1 2 3))
                           (vector->list #(1 2 3) 1) (vector->list #(1 2 3) 1 2)
                           (vector->list #(1 2 3) 3)))
  (report 'copy (list (vector-copy #(1 2 3)) (vector-copy #(1 2 3) 1)
                      (vector-copy #(1 2 3) 1 2) (vector-copy #(1 2 3) 3)
                      (let ((v (vector 1 2 3))) (eq? v (vector-copy v)))))
  (report 'copy! (list (let ((v (vector 1 2 3 4 5))) (vector-copy! v 0 #(a b)) v)
                       (let ((v (vector 1 2 3 4 5))) (vector-copy! v 1 v 0 3) v)
                       (let ((v (vector 1 2 3 4 5))) (vector-copy! v 0 v 2) v)
                       (let ((v (vector 1 2 3))) (vector-copy! v 3 #()) v)))
  (report 'fill (list (let ((v (vector 1 2 3))) (vector-fill! v 'z) v)
                      (let ((v (vector 1 2 3))) (vector-fill! v 'z 1) v)
                      (let ((v (vector 1 2 3))) (vector-fill! v 'z 0 1) v)))
  (report 'append (list (vector-append) (vector-append #(1) #(2 3) #())))
  (report 'map (list (vector-map car #((1) (2))) (vector-map + #(1 2) #(10 20 30))
                     (let ((p '()))
                       (vector-for-each (lambda (x y) (set! p (cons (+ x y) p)))
                                        #(1 2) #(10 20))
                       p)))
  (report 'bytevector
          (list (bytes (make-bytevector 2 7))
                (bytevector-length (make-bytevector 3))
                (bytes (bytevector-copy #u8(1 2 3) 1))
                (bytes (bytevector-copy #u8(1 2 3) 0 2))
                (let ((b (bytevector 1 2 3 4))) (bytevector-copy! b 1 #u8(9 8))
                  (bytes b))
                (let ((b (bytevector 1 2 3 4 5))) (bytevector-copy! b 2 b 0 3)
                  (bytes b))
                (bytes (bytevector-append #u8(1) #u8(2 3) #u8()))
                (bytes (bytevector-append))
                (let ((b (bytevector 1 2))) (eq? b (bytevector-copy b))))))
(define fixture-result (begin (vector-results) 0))
