; SRFI 69 names (lib/srfi/69.sld) against Guile's (srfi srfi-69). Key
; order is unspecified, so association lists are sorted before printing.
(define (report name value) (write (list name value)) (newline))
(define (insert pair pairs)
  (cond ((null? pairs) (list pair))
        ((< (car pair) (car (car pairs))) (cons pair pairs))
        (else (cons (car pairs) (insert pair (cdr pairs))))))
(define (sort-alist pairs)
  (if (null? pairs) '() (insert (car pairs) (sort-alist (cdr pairs)))))
(define (sorted table) (sort-alist (hash-table->alist table)))

(define t (make-hash-table))
(hash-table-set! t 1 'one)
(hash-table-set! t 2 'two)
(hash-table-set! t 3 'three)
(report 'ref (list (hash-table-ref t 1) (hash-table-ref/default t 9 'none)
                   (hash-table-ref t 9 (lambda () 'thunk))))
(report 'size (hash-table-size t))
(define deleted (hash-table-delete! t 2))
(report 'delete (list (hash-table-exists? t 2) (hash-table-size t)))
(hash-table-update! t 1 (lambda (v) (list v v)))
(hash-table-update!/default t 5 (lambda (v) (+ v 1)) 10)
(report 'update (sorted t))
(report 'walk
  (let ((sum 0))
    (hash-table-walk t (lambda (k v) (set! sum (+ sum k))))
    sum))
(report 'fold (hash-table-fold t (lambda (k v acc) (+ k acc)) 0))
(define c (hash-table-copy t))
(hash-table-set! c 7 'seven)
(report 'copy (list (hash-table-size t) (hash-table-size c)))
(define m (alist->hash-table '((10 . a) (20 . b)) eqv?))
(define merged (hash-table-merge! m (alist->hash-table '((20 . x) (30 . c)) eqv?)))
(report 'merge (sorted m))
(define s (make-hash-table string=? string-hash))
(hash-table-set! s "key" 'value)
(report 'string (hash-table-ref/default s (string #\k #\e #\y) #f))
(define e (make-hash-table equal? hash))
(hash-table-set! e '(1 #(2 "three")) 'nested)
(report 'equal (hash-table-ref/default e (list 1 (vector 2 "three")) #f))
(report 'predicates (list (hash-table? t) (hash-table? '())))
(report 'equivalence ((hash-table-equivalence-function m) 2.0 2.0))
(report 'keys (length (hash-table-keys t)))
(report 'values (length (hash-table-values t)))
