; (scheme base) lists and equivalence (R7RS 6.1, 6.3, 6.4, 6.5, 6.10).
(define (report name value) (write (list name value)) (newline))
(define (list-results)
  (report 'cxr (list (caar '((1) 2)) (cadr '(1 2)) (cdar '((1 . 2)))
                     (cddr '(1 2 3))))
  (report 'predicates (list (boolean? #f) (boolean? '()) (boolean=? #t #t #t)
                            (boolean=? #t #f) (symbol=? 'a 'a 'a)
                            (symbol=? 'a 'b) (procedure? car)
                            (procedure? (lambda () 1)) (procedure? 'car)
                            (procedure? (make-parameter 1))))
  (report 'map (list (map car '((1) (2))) (map + '(1 2) '(10 20 30))
                     (map (lambda (x y z) (list x y z)) '(1 2) '(a b) '(p q))
                     (map cadr '())))
  (report 'for-each
          (let ((port (open-output-string)))
            (for-each (lambda (x) (write x port)) '(1 2 3))
            (for-each (lambda (x y) (write (+ x y) port)) '(1 2) '(10 20 30))
            (get-output-string port)))
  (report 'construct (list (make-list 3 'x) (length (make-list 2))
                           (list-copy '(1 2 3)) (list-copy '(1 2 . 3))
                           (list-copy 5)))
  (report 'access (list (list-tail '(1 2 3) 1) (list-tail '(1 2) 2)
                        (list-ref '(a b c) 2)
                        (let ((l (list 1 2 3))) (list-set! l 1 'x) l)))
  (report 'member (list (memq 'c '(a b c d)) (memq 'z '(a b)) (memv 2 '(1 2 3))
                        (member '(1) '((0) (1) (2))) (member 2.0 '(1 2 3) =)
                        (member "b" '("a" "b"))))
  (report 'assoc (list (assq 'b '((a 1) (b 2))) (assv 2 '((1 one) (2 two)))
                       (assoc '(k) '(((k) . v))) (assoc 2.0 '((1 a) (2 b)) =)
                       (assq 'z '((a 1)))))
  (report 'equal (list (equal? '(1 (2 #(3 "x"))) '(1 (2 #(3 "x"))))
                       (equal? "abc" "abc") (equal? #(1 2) #(1 3))
                       (equal? (bytevector 1 2) (bytevector 1 2))
                       (equal? 1.0 1) (equal? 'a 'a) (equal? '() '())
                       (equal? (list 1 2) (list 1 2 3)))))
(define fixture-result (begin (list-results) 0))
