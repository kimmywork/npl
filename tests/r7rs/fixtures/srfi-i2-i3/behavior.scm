; The I2/I3 libraries on both execution paths: nplc-compiled code and the
; npli evaluator. oracle=none: Guile lacks SRFI 13/130/140/41/47/158/161/195
; with these library names. Every expected value below was checked against
; the SRFI text, not copied from either NPL surface.
(define (report name value) (write (list name value)) (newline))

(report 'srfi-13 (list (string-join '("a" "b") "," 'suffix)
                       (string-pad "7" 3 #\0)
                       (string-index "abcabc" #\c 3)
                       (string-titlecase "3com makes routers.")
                       (xsubstring "abcdef" 2)))
(report 'srfi-130 (list (sc:string-cursor->index "abc" (sc:string-index "abc" #\z))
                        (sc:string-split "a,,b" ",")))
(report 'srfi-140 (list (i:istring? "lit")
                        (i:istring? (string-copy "m"))
                        (i:istring? (i:string-append (string-copy "m")))
                        (i:utf16le->string (bytevector 97 0))))
(report 'srfi-133 (list (vector-cumulate + 0 #(3 1 4))
                        (vector-index even? #(1 3 4))
                        (call-with-values (lambda () (vector-partition odd? #(1 2 3)))
                                          list)))
(report 'srfi-41 (list (stream->list 4 (stream-map * (stream-from 1) (stream-from 1)))
                       (stream-match (stream 1 2) ((a b) (+ a b)))))
(report 'srfi-158 (list (generator->list (gtake (make-iota-generator 10) 3))
                        (generator->list (gmerge < (generator 1 3) (generator 2)))
                        (generator-fold + 0 (make-coroutine-generator
                                             (lambda (yield) (yield 1) (yield 2))))))
(report 'srfi-47 (list (array-rank #2A((1 2) (3 4)))
                       (array-ref #2A((1 2) (3 4)) 1 0)
                       (array-dimensions (read (open-input-string "#3A(((1) (2)))")))
                       (array-ref (make-shared-array (make-array #(5) 2 2)
                                                     (lambda (i) (list i i)) 2)
                                  1)))
(report 'srfi-161 (let ((a (ubox 1)) (b (ubox 2)))
                    (ubox-link! a b)
                    (list (ubox=? a b) (ubox-ref a))))
(report 'srfi-195 (let ((b (box 1 2)))
                    (set-box-value! b 0 'x)
                    (list (box-arity b) (call-with-values (lambda () (unbox b)) list))))
