; Standard procedures are first-class values (R7RS 4.1.3, 6.10): they can be
; passed, returned, stored, and called with each accepted argument count.
(define (report name value) (write (list name value)) (newline))
(define (map1 f xs) (if (null? xs) '() (cons (f (car xs)) (map1 f (cdr xs)))))
(define (call0 f) (f))
(define (call1 f a) (f a))
(define (call2 f a b) (f a b))
(define (call3 f a b c) (f a b c))
(define (pick which) (if which car cdr))
(define stored (vector cons null? string-append))
(define (procedure-results)
  (report 'unary (list (map1 car '((1 2) (3 4))) (map1 cdr '((1 2) (3 4)))
                       (map1 null? '(() 1)) (map1 not '(#f 1))
                       (map1 pair? '((1) ())) (map1 symbol? '(a "a"))
                       (map1 char->integer '(#\a #\b))))
  (report 'binary (list (call2 cons 1 2) (call2 eq? 'a 'a) (call2 eqv? 2 2)
                        (call2 string=? "x" "x") (call2 vector-ref #(7 8) 1)))
  (report 'numeric (list (call0 +) (call2 + 3 4) (call3 * 2 3 4) (call1 - 5)
                         (call2 - 10 4) (call2 < 1 2) (call3 < 1 3 2)
                         (call2 = 2 2)))
  (report 'variadic (list (call0 vector) (call3 vector 1 2 3)
                          (call0 string-append)
                          (call3 string-append "a" "b" "c")
                          (call0 list) (call3 list 1 2 3)))
  (report 'returned (list ((pick #t) '(1 2)) ((pick #f) '(1 2))))
  (report 'stored (list ((vector-ref stored 0) 1 2)
                        ((vector-ref stored 1) '())
                        ((vector-ref stored 2) "p" "q")))
  (report 'output (let ((port (open-output-string)))
                    (call2 display "shown" port)
                    (call1 newline port)
                    (call2 write "quoted" port)
                    (get-output-string port))))
(define fixture-result (begin (procedure-results) 0))
