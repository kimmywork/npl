; apply (R7RS 6.10): spread the last argument (a list) after any leading
; arguments; works for primitives, procedures, rest parameters, and as a value.
(define (report name value) (write (list name value)) (newline))
(define (sum . xs) (if (null? xs) 0 (+ (car xs) (apply sum (cdr xs)))))
(define (call2 f a b) (f a b))
(define (apply-results)
  (report 'primitives (list (apply + '(1 2 3)) (apply + 1 2 '(3 4))
                            (apply cons '(1 2)) (apply vector 1 '(2 3))
                            (apply string-append '("a" "b"))
                            (apply max 3 '(9 4))))
  (report 'procedures (list (apply sum '()) (apply sum 1 '(2 3))
                            (apply (lambda (a b . c) (list a b c)) 1 '(2 3 4))
                            (apply list '())))
  (report 'nested (apply apply (list + '(1 2 3))))
  (report 'as-value (list (call2 apply + '(5 6))
                          ((lambda (a) (a list 1 '(2 3))) apply)))
  (report 'tail (let loop ((n 10000))
                  (if (= n 0) 'done (apply loop (list (- n 1)))))))
(define fixture-result (begin (apply-results) 0))
