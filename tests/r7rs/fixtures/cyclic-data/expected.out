(write-cycle "#0=(1 2 . #0#)")
(display-cycle "#0=(a b . #0#)")
(write-shared-cycle "#0=(1 2 . #0#)")
(write-no-cycle "((x) #((x) (x)) (x))")
(write-shared-sharing "(#0=(x) #(#0# #0#) #0#)")
(vector-cycle "(#0=#(1 #0#) #0#)")
(vector-shared "(#0=#(1 #0#) #0#)")
(car-cycle "#0=(1 #0# 3)")
(tail-shared ("((1 2) (2))" "((1 . #0=(2)) #0#)"))
(write-simple "((x) (x))")
(read-back (p q #t))
(equal-cycles (#t #t #f #f #t #t))
(equal-acyclic (#t #t #f))
