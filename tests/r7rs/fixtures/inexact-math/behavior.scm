(define (report name value) (write (list name value)) (newline))
(define (near-real? actual expected)
  (< (abs (- actual expected)) 0.000000001))
(define (near? actual expected)
  (and (near-real? (real-part actual) (real-part expected))
       (near-real? (imag-part actual) (imag-part expected))))
(define (expected-asin? value)
  (and (near? value (make-rectangular 1.5707963267948966 -1.3169578969248166))
       (< (imag-part value) 0)))
(define (expected-acos? value)
  (and (near? value (make-rectangular 0 1.3169578969248166))
       (> (imag-part value) 0)))
(define (caught thunk)
  (guard (condition (else 'caught)) (thunk) 'not-caught))
(define (inexact-results)
  (report 'real
    (list (near? (sin 0) 0) (near? (cos 0) 1) (near? (tan 0) 0)
          (near? (asin 0) 0) (near? (acos 1) 0) (near? (atan 0) 0)
          (near? (exp 0) 1) (near? (log 1) 0) (near? (sqrt 9) 3)
          (near? (sqrt 1/4) 1/2) (near? (sin 1/2) 0.479425538604203)))
  (report 'optional
    (list (near? (atan 1 1) 0.7853981633974483)
          (near? (atan 1 -1) 2.356194490192345)
          (near? (atan -1 -1) -2.356194490192345)
          (near? (atan -1 1) -0.7853981633974483)
          (near? (log 8 2) 3) (near? (log 1/8 2) -3)))
  (report 'complex
    (list (near? (sqrt -4) 0+2i) (near? (sqrt 3+4i) 2+1i)
          (near? (log -1) 0+3.141592653589793i)
          (near? (exp 0+3.141592653589793i) -1)
          (near? (sin 0+1i) 0+1.1752011936438014i)
          (near? (cos 0+1i) 1.5430806348152437)
          (near? (tan 0+1i) 0+0.7615941559557649i)
          (near? (sin (asin 1+1i)) 1+1i)
          (near? (cos (acos 1+1i)) 1+1i)
           (near? (tan (atan 1+1i)) 1+1i)
           (near? (log -1 -1) 1)))
  (report 'branches
    (list (expected-asin? (asin 2))
          (expected-asin? (asin 2.0))
          (expected-asin? (asin (make-rectangular 2 0)))
          (expected-acos? (acos 2))
          (expected-acos? (acos 2.0))
          (expected-acos? (acos (make-rectangular 2 0)))))
  (report 'cuts
    (list (near? (log (make-rectangular -1.0 0.0))
                 (make-rectangular 0 3.141592653589793))
          (near? (log (make-rectangular -1.0 -0.0))
                 (make-rectangular 0 -3.141592653589793))
          (near? (atan 0.0 1.0) 0)
          (near? (atan -0.0 1.0) 0)
          (near? (atan 0.0 -1.0) 3.141592653589793)
          (near? (atan -0.0 -1.0) -3.141592653589793)
          (near? (atan 0.0 0.0) 0)
          (near? (atan -0.0 0.0) 0)
          (near? (atan 0.0 -0.0) 3.141592653589793)
          (near? (atan -0.0 -0.0) -3.141592653589793)))
  (report 'classification
    (list (finite? 42) (finite? 1/3) (finite? 1+2i)
          (not (finite? +inf.0)) (not (finite? +nan.0))
          (infinite? -inf.0) (not (infinite? +nan.0)) (nan? +nan.0)
          (infinite? (make-rectangular 1 +inf.0))
          (nan? (make-rectangular +nan.0 1))
          (not (finite? (make-rectangular 1 +inf.0)))
          (not (finite? (make-rectangular 1 +nan.0)))))
  (report 'special
    (list (infinite? (exp +inf.0)) (zero? (exp -inf.0))
          (nan? (sin +inf.0)) (nan? (sqrt +nan.0))
          (near? (atan +inf.0) 1.5707963267948966)
          (near? (atan -0.0 -1.0) -3.141592653589793)))
  (report 'errors
    (list (caught (lambda () (sin "bad")))
          (caught (lambda () (sqrt #f)))
          (caught (lambda () (atan 1+1i 1)))
          (caught (lambda () (log 2 "bad")))
          (caught (lambda () (log 2 3 4)))
          (caught (lambda () (atan 1 2 3)))
          (caught (lambda () (finite? 'bad))))))
(define fixture-result (begin (inexact-results) 0))
