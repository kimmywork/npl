(define (report name value) (write (list name value)) (newline))

(define root (make-temporary-directory))
(define file (string-append root "/file.txt"))
(define link (string-append root "/link"))
(call-with-output-file file (lambda (port) (write-string "hello" port)))
(report 'regular (file-info-regular? (file-info file #t)))
(report 'size (file-info:size (file-info file #t)))
(create-symlink file link)
(report 'symlink (file-info-symlink? (file-info link #f)))
(report 'target (equal? (real-path link) (real-path file)))
(report 'missing
        (guard (condition
                ((posix-error? condition)
                 (posix-error-name condition)))
          (file-info (string-append root "/missing") #t)
          #f))
(set-environment-variable! "NPL_FIXTURE_VARIABLE" "yes")
(report 'environment (get-environment-variable "NPL_FIXTURE_VARIABLE"))
(delete-environment-variable! "NPL_FIXTURE_VARIABLE")
(report 'user (string? (user-info:name (user-info (user-uid)))))
(report 'process (> (pid) 0))
(delete-file link)
(delete-file file)
(delete-directory root)
