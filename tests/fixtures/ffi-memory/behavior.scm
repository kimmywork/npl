; Explicit foreign memory (F1): the same bodies run compiled and in npli.
(define (report name value) (write (list name value)) (newline))
(define (raises? thunk)
  (guard (condition (#t #t))
    (thunk)
    #f))

(let ((p (foreign-alloc 64)))
  (report 'size (foreign-size p))
  (report 'zero-filled
          (let loop ((index 0))
            (if (= index 64)
                #t
                (if (= (pointer-ref-u8 p index) 0)
                    (loop (+ index 1))
                    #f))))
  (pointer-set-u8! p 255)
  (pointer-set-u16! p 65535 2)
  (pointer-set-u32! p 4294967295 4)
  (pointer-set-u64! p 4000000000 8)
  (pointer-set-i8! p -128 16)
  (pointer-set-i16! p -32768 18)
  (pointer-set-i32! p -2000000000 20)
  (pointer-set-i64! p -4000000000 24)
  (pointer-set-float! p 1.5 32)
  (pointer-set-double! p 2.25 40)
  (report 'u8 (pointer-ref-u8 p))
  (report 'u16 (pointer-ref-u16 p 2))
  (report 'u32 (pointer-ref-u32 p 4))
  (report 'u64 (pointer-ref-u64 p 8))
  (report 'i8 (pointer-ref-i8 p 16))
  (report 'i16 (pointer-ref-i16 p 18))
  (report 'i32 (pointer-ref-i32 p 20))
  (report 'i64 (pointer-ref-i64 p 24))
  (report 'float (pointer-ref-float p 32))
  (report 'double (pointer-ref-double p 40))
  (let ((q (foreign-alloc 8)))
    (pointer-set-pointer! p q 48)
    (report 'pointer
            (= (pointer->integer (pointer-ref-pointer p 48))
               (pointer->integer q)))
    (foreign-free q))
  (let ((view (pointer+offset p 8)))
    (report 'view-size (foreign-size view))
    (report 'view-offset (pointer-offset view))
    (report 'view-value (pointer-ref-u64 view)))
  (report 'bounds (raises? (lambda () (pointer-ref-u64 p 60))))
  (report 'misaligned (raises? (lambda () (pointer-ref-u32 p 1))))
  (report 'free-view (raises? (lambda () (foreign-free (pointer+offset p 8)))))
  (let ((copy (foreign-copy (pointer+offset p 4) 4)))
    (report 'copy-value (pointer-ref-u32 copy))
    (report 'copy-size (foreign-size copy))
    (foreign-free copy))
  (foreign-free p))

(let ((aligned (foreign-alloc 8 64)))
  (report 'alignment (= (modulo (pointer->integer aligned) 64) 0))
  (foreign-free aligned))

(let ((array (make-c-array 4 'u16)))
  (report 'array? (c-array? array))
  (report 'array-length (c-array-length array))
  (report 'array-type (c-array-type array))
  (c-array-set! array 0 10)
  (c-array-set! array 1 20)
  (c-array-set! array 2 30)
  (c-array-set! array 3 40)
  (report 'array-ref (c-array-ref array 2))
  (report 'array-bounds (raises? (lambda () (c-array-ref array 4))))
  (report 'array-vector (c-array->vector array))
  (let ((other (vector->c-array '#(1 2 3) 'u32)))
    (report 'from-vector (c-array-ref other 1))
    (report 'from-vector-length (c-array-length other))
    (foreign-free (c-array-pointer other)))
  (foreign-free (c-array-pointer array)))

(report 'type-u8 (c-type-size 'u8))
(report 'type-u32 (c-type-size 'u32))
(report 'type-u64 (c-type-size 'u64))
(report 'type-float (c-type-size 'float))
(report 'type-double (c-type-size 'double))

(define released-normal #f)
(define released-raise #f)
(define released-escape #f)

(with-resource (p (foreign-alloc 4)
                  (lambda (pointer)
                    (set! released-normal #t)
                    (foreign-free pointer)))
  (pointer-set-u8! p 1))
(report 'release-normal released-normal)

(report 'release-raise
        (guard (condition (#t released-raise))
          (with-resource (p (foreign-alloc 4)
                            (lambda (pointer)
                              (set! released-raise #t)
                              (foreign-free pointer)))
            (error "ffi-memory raise"))))

(report 'release-escape
        (begin
          (call-with-current-continuation
            (lambda (escape)
              (with-resource (p (foreign-alloc 4)
                                (lambda (pointer)
                                  (set! released-escape #t)
                                  (foreign-free pointer)))
                (escape #t))))
          released-escape))
