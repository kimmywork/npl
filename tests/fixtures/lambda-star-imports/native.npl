(import (scheme base)
        (rename (scheme base) (car user-car) (error user-error))
        (prefix (scheme base) b:)
        (scheme write))

(write ((lambda* (x) x) 42)) (newline)
(write (let ((car (lambda (x) #f)))
         ((lambda* (x) x) 42)))
(newline)
(write (guard (condition (#t 'raised))
         (let ((error (lambda args 0)))
           ((lambda* (x) x)))))
(newline)
