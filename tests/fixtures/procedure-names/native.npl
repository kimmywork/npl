(import (scheme base) (scheme write))

(write (let ((f (lambda (x) x))) f)) (newline)
(write (letrec ((g (lambda (x) x))) g)) (newline)
(write (let () (define (h x) x) h)) (newline)
(write (let ((alias car)) alias)) (newline)
(write (let loop ((n 0)) loop)) (newline)
(write (let ((slot #f)) (set! slot (lambda (x) x)) slot)) (newline)
(write (let ((add-one (lambda (x) (+ x 1)))) add-one)) (newline)
