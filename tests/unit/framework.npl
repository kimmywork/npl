(import (scheme base) (scheme write) (npl test))

(test-begin "framework")
(test-assert #t)
(test-equal 4 (+ 2 2))
(test-error (car '()))
(test-skip 1)
(test-assert #f)
(test-expect-fail 1)
(test-assert #f)
(test-group "nested" (test-assert #t))
(test-assert (= (test-runner-pass-count) 5))
(test-assert (= (test-runner-skip-count) 1))
(test-assert (>= (test-runner-total-count) 6))
(finish-tests "framework")
