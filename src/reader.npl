; reader.npl — NPL Reader (Lexer + Parser)
;
; Reads S-expressions from a string (list of char codes)
; Returns AST nodes

; ---- Character predicates ----
(define (char-whitespace? c)
  (or (= c 32) (= c 9) (= c 10) (= c 13)))

(define (char-digit? c)
  (and (>= c 48) (<= c 57)))

(define (char-alpha? c)
  (or (and (>= c 97) (<= c 122))
      (and (>= c 65) (<= c 90))))

(define (char-alphanumeric? c)
  (or (char-alpha? c) (char-digit? c)))

(define (char-symbol? c)
  (or (char-alphanumeric? c)
      (= c 45)  ; -
      (= c 95)  ; _
      (= c 63)  ; ?
      (= c 33)  ; !
      (= c 61)  ; =
      (= c 60)  ; <
      (= c 62)  ; >
      (= c 42)  ; *
      (= c 47)  ; /
      (= c 43)  ; +
      (= c 37))) ; %

; ---- Helper functions ----
(define (rev-acc lst acc)
  (if (null? lst) acc (rev-acc (cdr lst) (cons (car lst) acc))))

(define (list-reverse lst)
  (rev-acc lst ()))

; ---- Token types ----
(define TOK_LPAREN 0)
(define TOK_RPAREN 1)
(define TOK_SYMBOL 2)
(define TOK_NUMBER 3)
(define TOK_STRING 4)
(define TOK_BOOL 5)
(define TOK_QUOTE 6)
(define TOK_DOT 7)
(define TOK_EOF 8)

; ---- Token constructor ----
(define (make-token type value line col)
  (cons type (cons value (cons line (cons col ())))))

(define (token-type t) (car t))
(define (token-value t) (car (cdr t)))
(define (token-line t) (car (cdr (cdr t))))
(define (token-col t) (car (cdr (cdr (cdr t)))))

; ---- Lexer ----
(define (lexer input)
  (cons input (cons 1 (cons 1 ()))))  ; (position line col)

(define (lexer-pos lex) (car lex))
(define (lexer-line lex) (car (cdr lex)))
(define (lexer-col lex) (car (cdr (cdr lex))))

(define (lexer-advance lex n)
  (cons (cdr (car lex))  ; rest of input
        (cons (car (cdr lex))  ; same line (simplified)
              (cons (+ (car (cdr (cdr lex))) n) ())))); col + n

(define (lexer-skip-whitespace lex)
  (if (null? (car lex))
    lex
    (if (char-whitespace? (car (car lex)))
      (lexer-skip-whitespace (cons (cdr (car lex))
                                   (cons (if (= (car (car lex)) 10)
                                           (+ (car (cdr lex)) 1)
                                           (car (cdr lex)))
                                         (cons (if (= (car (car lex)) 10)
                                                 1
                                                 (+ (car (cdr (cdr lex))) 1))
                                               ()))))
      (if (= (car (car lex)) 59)  ; semicolon = comment
        (lexer-skip-whitespace (lexer-skip-comment (cons (cdr (car lex))
                                                         (cons (car (cdr lex))
                                                               (cons (+ (car (cdr (cdr lex))) 1) ())))))
        lex))))

(define (lexer-skip-comment lex)
  (if (null? (car lex))
    lex
    (if (= (car (car lex)) 10)  ; newline
      (cons (cdr (car lex))
            (cons (+ (car (cdr lex)) 1)
                  (cons 1 ())))
      (lexer-skip-comment (cons (cdr (car lex))
                                (cons (car (cdr lex))
                                      (cons (+ (car (cdr (cdr lex))) 1) ())))))))

(define (lexer-read-symbol lex)
  (define (loop lex acc)
    (if (null? (car lex))
      (cons (list-reverse acc) lex)
      (if (char-symbol? (car (car lex)))
        (loop (cons (cdr (car lex))
                    (cons (car (cdr lex))
                          (cons (+ (car (cdr (cdr lex))) 1) ())))
              (cons (car (car lex)) acc))
        (cons (list-reverse acc) lex))))
  (loop lex ()))

(define (lexer-read-number lex)
  (define (loop lex acc)
    (if (null? (car lex))
      (cons (list-reverse acc) lex)
      (if (char-digit? (car (car lex)))
        (loop (cons (cdr (car lex))
                    (cons (car (cdr lex))
                          (cons (+ (car (cdr (cdr lex))) 1) ())))
              (cons (car (car lex)) acc))
        (cons (list-reverse acc) lex))))
  (loop lex ()))

(define (lexer-read-string lex)
  (define (loop lex acc)
    (if (null? (car lex))
      (cons (list-reverse acc) lex)  ; unterminated string
      (if (= (car (car lex)) 34)  ; closing quote
        (cons (list-reverse acc)
              (cons (cdr (car lex))
                    (cons (car (cdr lex))
                          (cons (+ (car (cdr (cdr lex))) 1) ()))))
        (loop (cons (cdr (car lex))
                    (cons (car (cdr lex))
                          (cons (+ (car (cdr (cdr lex))) 1) ())))
              (cons (car (car lex)) acc)))))
  (loop lex ()))

(define (lexer-next-token lex)
  (let ((lex (lexer-skip-whitespace lex)))
    (if (null? (car lex))
      (cons (make-token TOK_EOF () (car (cdr lex)) (car (cdr (cdr lex)))) lex)
      (let ((c (car (car lex)))
            (line (car (cdr lex)))
            (col (car (cdr (cdr lex)))))
        (cond
          ((= c 40)  ; (
           (cons (make-token TOK_LPAREN "(" line col)
                 (cons (cdr (car lex))
                       (cons line (cons (+ col 1) ())))))
          ((= c 41)  ; )
           (cons (make-token TOK_RPAREN ")" line col)
                 (cons (cdr (car lex))
                       (cons line (cons (+ col 1) ())))))
          ((= c 39)  ; '
           (cons (make-token TOK_QUOTE "'" line col)
                 (cons (cdr (car lex))
                       (cons line (cons (+ col 1) ())))))
          ((= c 34)  ; "
           (let ((result (lexer-read-string
                           (cons (cdr (car lex))
                                 (cons line (cons (+ col 1) ()))))))
             (cons (make-token TOK_STRING (car result) line col)
                   (cdr result))))
          ((char-digit? c)
           (let ((result (lexer-read-number lex)))
             (cons (make-token TOK_NUMBER (car result) line col)
                   (cdr result))))
          ((or (= c 45) (= c 43))  ; - or +
           (if (and (not (null? (cdr (car lex))))
                    (char-digit? (car (cdr (car lex)))))
             (let ((result (lexer-read-number lex)))
               (cons (make-token TOK_NUMBER (car result) line col)
                     (cdr result)))
             (let ((result (lexer-read-symbol lex)))
               (cons (make-token TOK_SYMBOL (car result) line col)
                     (cdr result)))))
          ((= c 35)  ; # (boolean)
           (if (not (null? (cdr (car lex))))
             (let ((next (car (cdr (car lex)))))
               (cons (make-token TOK_BOOL
                                 (if (= next 116) 1 0)  ; #t = 1, #f = 0
                                 line col)
                     (cons (cdr (cdr (car lex)))
                           (cons line (cons (+ col 2) ())))))
             (cons (make-token TOK_EOF () line col) lex)))
          ((char-symbol? c)
           (let ((result (lexer-read-symbol lex)))
             (cons (make-token TOK_SYMBOL (car result) line col)
                   (cdr result))))
          (else
            (cons (make-token TOK_EOF () line col) lex)))))))

; ---- Parser ----
(define (parse-expr lex)
  (let ((token-result (lexer-next-token lex)))
    (let ((tok (car token-result))
          (lex (cdr token-result)))
      (let ((type (token-type tok)))
        (cond
          ((= type TOK_NUMBER)
           (cons (cons 0 (cons (token-value tok) ())) lex))  ; (number . value)
          ((= type TOK_SYMBOL)
           (cons (cons 1 (cons (token-value tok) ())) lex))  ; (symbol . name)
          ((= type TOK_STRING)
           (cons (cons 2 (cons (token-value tok) ())) lex))  ; (string . value)
          ((= type TOK_BOOL)
           (cons (cons 3 (cons (token-value tok) ())) lex))  ; (bool . value)
          ((= type TOK_LPAREN)
           (parse-list lex))
          ((= type TOK_QUOTE)
           (let ((expr-result (parse-expr lex)))
             (cons (cons 5 (cons (car expr-result) ()))  ; (quote . expr)
                   (cdr expr-result))))
          (else
            (cons (cons 4 ()) lex)))))))  ; nil

(define (parse-list lex)
  (let ((token-result (lexer-next-token lex)))
    (let ((tok (car token-result))
          (lex (cdr token-result)))
      (if (= (token-type tok) TOK_RPAREN)
        (cons (cons 4 ()) lex)  ; nil
        (let ((expr-result (parse-expr (cons (car (cdr lex))
                                             (cons (car (cdr (cdr lex)))
                                                   (cons (car (cdr (cdr (cdr lex)))) ()))))))
          (let ((expr (car expr-result))
                (lex2 (cdr expr-result)))
            (let ((tail-result (parse-list lex2)))
              (let ((tail (car tail-result))
                    (lex3 (cdr tail-result)))
                (cons (cons expr tail) lex3)))))))))

; ---- AST node accessors ----
(define (ast-type node) (car node))
(define (ast-value node) (car (cdr node)))

; AST types:
; 0 = number
; 1 = symbol
; 2 = string
; 3 = boolean
; 4 = nil
; 5 = quote
; 6 = pair (application)

; ---- Main reader function ----
(define (read-expr input)
  (let ((lex (cons input (cons 1 (cons 1 ())))))
    (car (parse-expr lex))))

; ---- Test ----
(define (main)
  (let ((ast (read-expr "(+ 1 2)")))
    (display "Parsed: ")
    (display ast)
    (display "
")))
