(import (scheme base)
        (scheme read)
        (scheme write)
        (scheme process-context)
        (scheme internal evaluator))

(include "../compiler/tests/framework.npl")

(define environment (make-eval-environment))

(define (source-datum source)
  (read (open-input-string source)))

(define (evaluated source)
  (eval-in-environment (source-datum source) environment))

; Evaluation errors are raised error objects, as in compiled code.
(define (raises? source)
  (guard (condition ((error-object? condition) #t))
    (evaluated source)
    #f))

(define (main)
  (test-equal "literal" (lambda () (evaluated "42")) 42)
  (test-equal "arithmetic" (lambda () (evaluated "(+ 20 22)")) 42)
  (test-identity "define result unspecified"
                 (lambda ()
                   (eval-unspecified? (evaluated "(define answer 42)"))) #t)
  (test-equal "persistent definition" (lambda () (evaluated "answer")) 42)
  (test-equal "lexical closure"
              (lambda ()
                (evaluated
                  "(((lambda (x) (lambda (y) (+ x y))) 20) 22)"))
              42)
  (test-equal "recursive procedure"
              (lambda ()
                (evaluated
                  "(begin
                     (define (sum n)
                       (if (= n 0) 0 (+ n (sum (- n 1)))))
                     (sum 6))"))
              21)
  (test-equal "mutation"
              (lambda ()
                (evaluated
                  "(begin (define mutable 40)
                          (set! mutable (+ mutable 2))
                          mutable)"))
              42)
  (test-equal "multiple values"
              (lambda ()
                (evaluated
                  "(call-with-values
                     (lambda () (values 20 22))
                     (lambda (left right) (+ left right)))"))
              42)
  (test-equal "call/cc"
              (lambda ()
                (evaluated
                  "(+ 2 (call/cc (lambda (escape) (escape 40))))"))
              42)
  (test-identity "define-syntax result unspecified"
                 (lambda ()
                   (eval-unspecified?
                     (evaluated
                       "(define-syntax add-one
                          (syntax-rules ()
                            ((_ value) (+ value 1))))"))) #t)
  (test-equal "persistent syntax-rules"
              (lambda () (evaluated "(add-one 41)")) 42)
  (test-equal "hygienic introduced binding"
              (lambda ()
                (evaluated "(define temporary 100)")
                (evaluated
                  "(define-syntax with-temporary
                     (syntax-rules ()
                       ((_ value)
                        ((lambda (temporary) (+ temporary 1)) value))))")
                (evaluated
                  "(+ (with-temporary 40) (- temporary 99))"))
              42)
  (test-equal "shared derived syntax"
              (lambda () (evaluated "(and #t (or #f 42))")) 42)
  (test-identity "import result unspecified"
                 (lambda ()
                   (eval-unspecified?
                     (evaluated
                       "(import
                          (rename (only (scheme base) +) (+ plus)))"))) #t)
  (test-equal "persistent imported alias"
              (lambda () (evaluated "(plus 20 22)")) 42)
  (test-identity "recoverable unbound error"
                 (lambda () (raises? "missing")) #t)
  (test-equal "state survives error" (lambda () (evaluated "answer")) 42)
  (test-identity "recoverable arithmetic type error"
                 (lambda () (raises? "(+ #t 1)")) #t)
  (test-identity "recoverable pair type error"
                 (lambda () (raises? "(car 1)")) #t)
  (test-identity "recoverable vector bounds error"
                 (lambda () (raises? "(vector-ref #(42) 1)")) #t)
  (test-equal "state survives primitive errors"
              (lambda () (evaluated "answer")) 42)
  (test-equal "dynamic-wind normal order"
              (lambda ()
                (evaluated
                  "(begin
                     (define wind-log 0)
                     (define (wind-digit digit)
                       (set! wind-log (+ (* wind-log 10) digit)))
                     (let ((value
                             (dynamic-wind
                               (lambda () (wind-digit 1))
                               (lambda () (wind-digit 2) 42)
                               (lambda () (wind-digit 3)))))
                       (+ (* value 1000) wind-log)))"))
              42123)
  (test-equal "dynamic-wind continuation exit"
              (lambda ()
                (evaluated
                  "(begin
                     (set! wind-log 0)
                     (let ((value
                             (call/cc
                               (lambda (escape)
                                 (dynamic-wind
                                   (lambda () (wind-digit 1))
                                   (lambda () (wind-digit 2) (escape 42))
                                   (lambda () (wind-digit 3)))))))
                       (+ (* value 1000) wind-log)))"))
              42123)
  (test-equal "continuable exception"
              (lambda ()
                (evaluated
                  "(with-exception-handler
                     (lambda (object) (+ object 2))
                     (lambda () (raise-continuable 40)))"))
              42)
  (test-equal "nested handler uses previous handler"
              (lambda ()
                (evaluated
                  "(with-exception-handler
                     (lambda (object) (+ object 2))
                     (lambda ()
                       (with-exception-handler
                         (lambda (object) (raise-continuable object))
                         (lambda () (raise-continuable 40)))))"))
              42)
  (test-equal "raise exits dynamic-wind"
              (lambda ()
                (evaluated
                  "(begin
                     (set! wind-log 0)
                     (let ((value
                             (call/cc
                               (lambda (escape)
                                 (with-exception-handler
                                   (lambda (object) (escape object))
                                   (lambda ()
                                     (dynamic-wind
                                       (lambda () (wind-digit 1))
                                       (lambda () (raise 42))
                                       (lambda () (wind-digit 2)))))))))
                       (+ (* value 100) wind-log)))"))
              4212)
  (test-equal "parameter dynamic restoration"
              (lambda ()
                (evaluated
                  "(let ((parameter (make-parameter 1)))
                     (+ (parameterize ((parameter 41)) (parameter))
                        (parameter)))"))
              42)
  (test-equal "parameter converter"
              (lambda ()
                (evaluated
                  "(let ((parameter
                           (make-parameter 20
                             (lambda (value) (+ value 22)))))
                     (parameter))"))
              42)
  (test-equal "dynamic-wind continuation reentry"
              (lambda ()
                (evaluated
                  "(begin
                     (define saved-wind #f)
                     (define wind-phase 0)
                     (set! wind-log 0)
                     (let ((value
                             (dynamic-wind
                               (lambda () (wind-digit 1))
                               (lambda ()
                                 (call/cc
                                   (lambda (continuation)
                                     (set! saved-wind continuation)
                                     10)))
                               (lambda () (wind-digit 3)))))
                       (cond
                         ((= wind-phase 0)
                          (set! wind-phase 1)
                          (saved-wind 20))
                         ((= wind-phase 1)
                          (set! wind-phase 2)
                          (saved-wind 30))
                         (else (+ (* value 1000000) wind-log)))))"))
              30131313)
  (test-equal "continuation restores handler"
              (lambda ()
                (evaluated
                  "(begin
                     (define saved-handler #f)
                     (define handler-phase 0)
                     (with-exception-handler
                       (lambda (object) (+ object 2))
                       (lambda ()
                         (let ((value
                                 (call/cc
                                   (lambda (continuation)
                                     (set! saved-handler continuation)
                                     10))))
                           (if (= handler-phase 0)
                               (begin
                                 (set! handler-phase 1)
                                 (saved-handler 20))
                               (raise-continuable 40))))))"))
              42)
  (test-equal "continuation restores parameter binding"
              (lambda ()
                (evaluated
                  "(begin
                     (define saved-parameter #f)
                     (define parameter-phase 0)
                     (let ((parameter (make-parameter 0)))
                       (let ((result
                               (parameterize ((parameter 10))
                                 (let ((value
                                         (call/cc
                                           (lambda (continuation)
                                             (set! saved-parameter continuation)
                                             0))))
                                   (if (= parameter-phase 0)
                                       (begin
                                         (parameter 41)
                                         (set! parameter-phase 1)
                                         10)
                                       (+ (parameter) value))))))
                         (if (= parameter-phase 1)
                             (begin
                               (set! parameter-phase 2)
                               (saved-parameter 1))
                             result))))"))
              42)
  (test-equal "wind before sees restored handler"
              (lambda ()
                (evaluated
                  "(begin
                     (define saved-handler-wind #f)
                     (define handler-wind-phase 0)
                     (define handler-wind-log 0)
                     (let ((value
                             (with-exception-handler
                               (lambda (object)
                                 (set! handler-wind-log
                                       (+ handler-wind-log object))
                                 0)
                               (lambda ()
                                 (dynamic-wind
                                   (lambda ()
                                     (if (= handler-wind-phase 1)
                                         (raise-continuable 2)
                                         0))
                                   (lambda ()
                                     (call/cc
                                       (lambda (continuation)
                                         (set! saved-handler-wind continuation)
                                         10)))
                                   (lambda () 0))))))
                       (if (= handler-wind-phase 0)
                           (begin
                             (set! handler-wind-phase 1)
                             (saved-handler-wind 20))
                           (+ (* value 10) handler-wind-log))))"))
              202)
  (test-equal "delay memoizes once"
              (lambda ()
                (evaluated
                  "(begin
                     (define promise-count 0)
                     (let ((promise
                             (delay
                               (begin
                                 (set! promise-count (+ promise-count 1))
                                 42))))
                       (+ (force promise) (force promise))
                       promise-count))"))
              1)
  (test-equal "memoized value ignores later mutation"
              (lambda ()
                (evaluated
                  "(let ((value 20))
                     (let ((promise (delay (+ value 22))))
                       (force promise)
                       (set! value 100)
                       (force promise)))"))
              42)
  (test-identity "make-promise is idempotent"
                 (lambda ()
                   (evaluated
                     "(let ((promise (make-promise 42)))
                        (eq? promise (make-promise promise)))"))
                 #t)
  (test-identity "promise predicate"
                 (lambda ()
                   (evaluated
                     "(if (promise? (delay 42))
                          (not (promise? 42))
                          #f)"))
                 #t)
  (test-equal "forcing non-promise returns it"
              (lambda () (evaluated "(force 42)"))
              42)
  (test-equal "recursive forcing update"
              (lambda ()
                (evaluated
                  "(begin
                     (define recursive-count 0)
                     (define recursive-limit 5)
                     (define recursive-promise #f)
                     (set! recursive-promise
                       (delay
                         (begin
                           (set! recursive-count (+ recursive-count 1))
                           (if (> recursive-count recursive-limit)
                               recursive-count
                               (force recursive-promise)))))
                     (let ((first (force recursive-promise)))
                       (set! recursive-limit 10)
                       (+ (* first 6) (force recursive-promise))))"))
              42)
  (test-equal "first force parameter environment"
              (lambda ()
                (evaluated
                  "(let ((parameter (make-parameter 1)))
                     (let ((promise (delay (parameter))))
                       (parameterize ((parameter 42)) (force promise))
                       (parameterize ((parameter 10)) (force promise))))"))
              42)
  (test-equal "first force exception handler"
              (lambda ()
                (evaluated
                  "(guard (condition (else 42))
                     (force (delay (raise 1))))"))
              42)
  (test-equal "delay-force chain"
              (lambda ()
                (evaluated
                  "(letrec ((chain
                              (lambda (count)
                                (if (= count 0)
                                    (delay 42)
                                    (delay-force (chain (- count 1)))))))
                     (force (chain 1000)))"))
              42)
  (test-equal "million delay-force chain"
              (lambda ()
                (evaluated
                  "(letrec ((chain
                              (lambda (count)
                                (if (= count 0)
                                    (delay 42)
                                    (delay-force (chain (- count 1)))))))
                     (force (chain 1000000)))"))
              42)
  (finish-tests "evaluator-core"))
(main)
