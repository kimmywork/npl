; Shared compiler state, list helpers, and QBE name sanitization.

(define (cell v) (cons v ()))
(define (cell-get c) (car c))
(define (cell-set! c v) (set-car! c v))

(define FRONTEND-ERROR-HANDLER (cell ()))

(define (with-frontend-error-handler handler thunk)
  (let ((previous (cell-get FRONTEND-ERROR-HANDLER)))
    (cell-set! FRONTEND-ERROR-HANDLER handler)
    (let ((result (thunk)))
      (cell-set! FRONTEND-ERROR-HANDLER previous)
      result)))

(define (fatal msg)
  (if (null? (cell-get FRONTEND-ERROR-HANDLER))
      (begin
        (display "nplc: " (current-error-port))
        (display msg (current-error-port))
        (newline (current-error-port))
        (exit 21))
      ((cell-get FRONTEND-ERROR-HANDLER) msg)))

(define (and2 a b) (if a b #f))
(define (or2 a b) (if a #t b))

(define (rev lst) (rev-into lst ()))

(define (rev-into lst acc)
  (if (null? lst) acc (rev-into (cdr lst) (cons (car lst) acc))))

(define DATUM-SYMBOL-TAG '(_datum_symbol_tag_))

(define (pair-shape? x) (pair? x))

(define (sym-atom? x)
  (if (pair-shape? x)
      (if (number? (car x)) (= (car x) 100) #f)
      #f))

(define (str-atom? x)
  (if (pair-shape? x)
      (if (number? (car x)) (= (car x) 101) #f)
      #f))

(define DATUM-STRING-TAG '(_datum_string_tag_))
(define DATUM-CHAR-TAG '(_datum_char_tag_))
(define DATUM-VECTOR-TAG '(_datum_vector_tag_))
(define DATUM-BYTEVECTOR-TAG '(_datum_bytevector_tag_))
(define DATUM-TRUE-TAG '(_datum_true_tag_))
(define DATUM-FALSE-TAG '(_datum_false_tag_))

(define (datum-tagged? value tag)
  (if (pair-shape? value) (eq? (car value) tag) #f))

(define (datum-symbol name) (cons DATUM-SYMBOL-TAG name))
(define (datum-string text) (cons DATUM-STRING-TAG text))
(define (datum-char code) (cons DATUM-CHAR-TAG code))
(define (datum-vector items) (cons DATUM-VECTOR-TAG items))
(define (datum-bytevector items) (cons DATUM-BYTEVECTOR-TAG items))
(define (datum-true) (cons DATUM-TRUE-TAG ()))
(define (datum-false) (cons DATUM-FALSE-TAG ()))

(define (datum-symbol? value) (datum-tagged? value DATUM-SYMBOL-TAG))
(define (datum-string? value) (datum-tagged? value DATUM-STRING-TAG))
(define (datum-char? value) (datum-tagged? value DATUM-CHAR-TAG))
(define (datum-vector? value) (datum-tagged? value DATUM-VECTOR-TAG))
(define (datum-bytevector? value)
  (datum-tagged? value DATUM-BYTEVECTOR-TAG))
(define (datum-true? value) (datum-tagged? value DATUM-TRUE-TAG))
(define (datum-false? value) (datum-tagged? value DATUM-FALSE-TAG))

(define (datum-symbol-name value) (cdr value))
(define (datum-string-text value) (cdr value))
(define (datum-char-code value) (cdr value))
(define (datum-vector-items value) (cdr value))
(define (datum-bytevector-items value) (cdr value))

(define (ch-digit-q2 c) (if (< 47 c) (< c 58) #f))
(define (ch-alpha-up-e c) (if (< 64 c) (< c 91) #f))
(define (ch-alpha-low-e c) (if (< 96 c) (< c 123) #f))

; QBE-safe and injective: letters and digits are kept, every other byte
; (including _) becomes _XX in hex, so distinct names never share a symbol.
(define (sanitize s i out)
  (if (< i (string-length s))
      (let ((c (string-byte-ref s i)))
        (if (if (ch-digit-q2 c)
                #t
                (if (ch-alpha-up-e c) #t (ch-alpha-low-e c)))
            (sanitize s (+ i 1) (string-append out (int->string c)))
            (sanitize s (+ i 1) (string-append out (sanitize-escape c)))))
      out))

(define (sanitize-hex-digit d)
  (int->string (if (< d 10) (+ d 48) (+ d 87))))

; The seed dialect has no quotient: split a byte into nibbles by counting.
(define (sanitize-high-nibble c n)
  (if (< c 16) n (sanitize-high-nibble (- c 16) (+ n 1))))

(define (sanitize-escape c)
  (let ((high (sanitize-high-nibble c 0)))
    (string-append "_" (string-append (sanitize-hex-digit high)
                         (sanitize-hex-digit (- c (* high 16)))))))
