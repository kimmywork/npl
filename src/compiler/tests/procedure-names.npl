(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl format))

(include "framework.npl")

(define (top-level-procedure x) x)

(define (main)
  (test-equal "top-level procedure name"
              (lambda () (format #f "~s" top-level-procedure))
              "#<procedure top-level-procedure>")
  (test-equal "primitive procedure name"
              (lambda () (format #f "~s" car))
              "#<procedure car>")
  (test-equal "library procedure name"
              (lambda () (format #f "~s" map))
              "#<procedure scheme/base:map>")
  (test-equal "anonymous procedure"
              (lambda () (format #f "~s" (lambda (x) x)))
              "#<procedure>")
  (test-equal "parameter"
              (lambda () (format #f "~s" (make-parameter 1)))
              "#<parameter>")
  (test-equal "let-bound procedure name"
              (lambda ()
                (format #f "~s" (let ((local (lambda (x) x))) local)))
              "#<procedure local>")
  (test-equal "letrec-bound procedure name"
              (lambda ()
                (format #f "~s" (letrec ((local (lambda (x) x))) local)))
              "#<procedure local>")
  (test-equal "internal definition procedure name"
              (lambda ()
                (format #f "~s" (let () (define (inner x) x) inner)))
              "#<procedure inner>")
  (test-equal "local alias keeps its procedure name"
              (lambda () (format #f "~s" (let ((alias car)) alias)))
              "#<procedure car>")
  (test-equal "named let procedure name"
              (lambda () (format #f "~s" (let loop ((n 0)) loop)))
              "#<procedure loop>")
  (test-equal "set! procedure name"
              (lambda ()
                (format #f "~s" (let ((slot #f))
                                  (set! slot (lambda (x) x))
                                  slot)))
              "#<procedure slot>")
  (test-equal "hyphenated local procedure name"
              (lambda ()
                (format #f "~s"
                        (let ((add-one (lambda (x) (+ x 1)))) add-one)))
              "#<procedure add-one>")
  (finish-tests "procedure-names"))
(main)
