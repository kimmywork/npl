(import (scheme base)
        (scheme file)
        (scheme write)
        (scheme process-context))

(include "framework.npl")

(define (main)
  (let ((output (open-output-bytevector)))
    (test-identity "output bytevector is binary"
                   (lambda () (binary-port? output)) #t)
    (test-identity "output bytevector is not textual"
                   (lambda () (textual-port? output)) #f)
    (test-identity "output bytevector starts open"
                   (lambda () (output-port-open? output)) #t)
    (write-u8 10 output)
    (write-bytevector (bytevector 20 30 40) output 1 3)
    (let ((bytes (get-output-bytevector output)))
      (test-equal "output bytevector length"
                  (lambda () (bytevector-length bytes)) 3)
      (test-equal "output bytevector first"
                  (lambda () (bytevector-u8-ref bytes 0)) 10)
      (test-equal "output bytevector range"
                  (lambda () (bytevector-u8-ref bytes 2)) 40)
      (close-port output)
      (test-identity "closed output predicate"
                     (lambda () (output-port-open? output)) #f)
      (let ((input (open-input-bytevector bytes)))
        (test-equal "peek-u8 memory port" (lambda () (peek-u8 input)) 10)
        (test-equal "read-u8 memory port" (lambda () (read-u8 input)) 10)
        (let ((tail (read-bytevector 2 input)))
          (test-equal "bulk read length"
                      (lambda () (bytevector-length tail)) 2)
          (test-equal "bulk read data"
                      (lambda () (bytevector-u8-ref tail 1)) 40))
        (test-identity "bulk read eof"
                       (lambda () (eof-object? (read-bytevector 1 input))) #t)
        (close-port input))))
  (let ((target (bytevector 0 0 0 0))
        (input (open-input-bytevector (bytevector 5 6 7))))
    (test-equal "bulk read into count"
                (lambda () (read-bytevector! target input 1 4)) 3)
    (test-equal "bulk read into data"
                (lambda () (bytevector-u8-ref target 3)) 7))
  (let ((path "/tmp/npl-binary-io.data"))
    (let ((output (open-binary-output-file path)))
      (write-bytevector (bytevector 0 127 255) output)
      (close-port output))
    (let ((input (open-binary-input-file path)))
      (let ((bytes (read-bytevector 3 input)))
        (test-equal "binary file byte"
                    (lambda () (bytevector-u8-ref bytes 2)) 255))
      (close-port input)))
  (finish-tests "binary-io"))
