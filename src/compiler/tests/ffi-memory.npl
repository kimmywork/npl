(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl ffi))

(include "framework.npl")

(define (raises? thunk)
  (guard (condition (#t #t))
    (thunk)
    #f))

(define released-normal #f)
(define released-raise #f)
(define released-escape #f)

(define (main)
  (let ((p (foreign-alloc 64)))
    (test-equal "foreign-size" (lambda () (foreign-size p)) 64)
    (test-identity "foreign-alloc zero-fills"
                   (lambda ()
                     (let loop ((index 0))
                       (if (= index 64)
                           #t
                           (if (= (pointer-ref-u8 p index) 0)
                               (loop (+ index 1))
                               #f))))
                   #t)
    (pointer-set-u8! p 255)
    (pointer-set-u16! p 65535 2)
    (pointer-set-u32! p 4294967295 4)
    (pointer-set-u64! p 4000000000 8)
    (pointer-set-i8! p -128 16)
    (pointer-set-i16! p -32768 18)
    (pointer-set-i32! p -2000000000 20)
    (pointer-set-i64! p -4000000000 24)
    (pointer-set-float! p 1.5 32)
    (pointer-set-double! p 2.25 40)
    (test-equal "u8 round-trip" (lambda () (pointer-ref-u8 p)) 255)
    (test-equal "u16 round-trip" (lambda () (pointer-ref-u16 p 2)) 65535)
    (test-equal "u32 round-trip"
                (lambda () (pointer-ref-u32 p 4)) 4294967295)
    (test-equal "u64 round-trip"
                (lambda () (pointer-ref-u64 p 8)) 4000000000)
    (test-equal "i8 round-trip" (lambda () (pointer-ref-i8 p 16)) -128)
    (test-equal "i16 round-trip"
                (lambda () (pointer-ref-i16 p 18)) -32768)
    (test-equal "i32 round-trip"
                (lambda () (pointer-ref-i32 p 20)) -2000000000)
    (test-equal "i64 round-trip"
                (lambda () (pointer-ref-i64 p 24)) -4000000000)
    (test-equal "float round-trip"
                (lambda () (pointer-ref-float p 32)) 1.5)
    (test-equal "double round-trip"
                (lambda () (pointer-ref-double p 40)) 2.25)
    (let ((q (foreign-alloc 8)))
      (pointer-set-pointer! p q 48)
      (test-identity "pointer round-trip"
                     (lambda ()
                       (= (pointer->integer (pointer-ref-pointer p 48))
                          (pointer->integer q)))
                     #t)
      (foreign-free q))
    (let ((view (pointer+offset p 8)))
      (test-equal "view size" (lambda () (foreign-size view)) 56)
      (test-equal "view offset" (lambda () (pointer-offset view)) 8)
      (test-equal "view reads base data"
                  (lambda () (pointer-ref-u64 view)) 4000000000))
    (test-identity "out-of-bounds read raises"
                   (lambda () (raises? (lambda () (pointer-ref-u64 p 60))))
                   #t)
    (test-identity "misaligned read raises"
                   (lambda () (raises? (lambda () (pointer-ref-u32 p 1))))
                   #t)
    (pointer-set! p 'u8 1 63)
    (test-equal "generic pointer-ref"
                (lambda () (pointer-ref p 'u8 63)) 1)
    (test-identity "freeing a view raises"
                   (lambda ()
                     (raises? (lambda () (foreign-free (pointer+offset p 8)))))
                   #t)
    (let ((copy (foreign-copy (pointer+offset p 4) 4)))
      (test-equal "foreign-copy content"
                  (lambda () (pointer-ref-u32 copy)) 4294967295)
      (test-equal "foreign-copy size" (lambda () (foreign-size copy)) 4)
      (foreign-free copy))
    (foreign-free p))

  ; A freed owner and every view of it reject access, copies, and offsets.
  (let* ((p (foreign-alloc 16))
         (view (pointer+offset p 8))
         (nested (pointer+offset view 8)))
    (foreign-free p)
    (test-identity "freed owner read raises"
                   (lambda () (raises? (lambda () (pointer-ref-u8 p))))
                   #t)
    (test-identity "freed owner write raises"
                   (lambda () (raises? (lambda () (pointer-set-u8! p 1))))
                   #t)
    (test-identity "freed view read raises"
                   (lambda () (raises? (lambda () (pointer-ref-u8 view))))
                   #t)
    (test-identity "freed view write raises"
                   (lambda () (raises? (lambda () (pointer-set-u8! view 1))))
                   #t)
    (test-identity "freed view of view read raises"
                   (lambda () (raises? (lambda () (pointer-ref-u8 nested))))
                   #t)
    (test-identity "freed copy from owner raises"
                   (lambda () (raises? (lambda () (foreign-copy p 1))))
                   #t)
    (test-identity "freed copy from view raises"
                   (lambda () (raises? (lambda () (foreign-copy view 1))))
                   #t)
    (test-identity "freed offset raises"
                   (lambda () (raises? (lambda () (pointer+offset view 0))))
                   #t)
    (test-identity "freeing a freed view raises"
                   (lambda () (raises? (lambda () (foreign-free view))))
                   #t)
    (test-identity "repeated free is a no-op"
                   (lambda () (foreign-free p) #t)
                   #t))

  (let ((p (foreign-alloc 16)))
    (test-identity "zero-length view access raises"
                   (lambda ()
                     (raises? (lambda () (pointer-ref-u8 (pointer+offset p 16)))))
                   #t)
    (test-identity "offset beyond allocation raises"
                   (lambda ()
                     (raises? (lambda () (pointer+offset p 17))))
                   #t)
    (test-equal "nested view offset accumulates"
                (lambda ()
                  (pointer-offset (pointer+offset (pointer+offset p 4) 4)))
                8)
    (foreign-free p))

  (test-identity "foreign-alloc negative size raises"
                 (lambda () (raises? (lambda () (foreign-alloc -1))))
                 #t)
  (test-identity "foreign-alloc non-integer size raises"
                 (lambda () (raises? (lambda () (foreign-alloc 'x))))
                 #t)
  (test-identity "foreign-alloc non-power-of-two alignment raises"
                 (lambda () (raises? (lambda () (foreign-alloc 1 3))))
                 #t)
  (let ((p (foreign-alloc 16)))
    (test-identity "u8 write above range raises"
                   (lambda () (raises? (lambda () (pointer-set-u8! p 256))))
                   #t)
    (test-identity "u8 write negative raises"
                   (lambda () (raises? (lambda () (pointer-set-u8! p -1))))
                   #t)
    (test-identity "u64 write negative raises"
                   (lambda () (raises? (lambda () (pointer-set-u64! p -1))))
                   #t)
    (test-identity "integer write non-number raises"
                   (lambda () (raises? (lambda () (pointer-set-u8! p 'x))))
                   #t)
    (foreign-free p))

  (let ((aligned (foreign-alloc 8 64)))
    (test-equal "requested alignment"
                (lambda () (modulo (pointer->integer aligned) 64)) 0)
    (foreign-free aligned))

  (let ((empty (foreign-alloc 0)))
    (test-equal "zero-size allocation" (lambda () (foreign-size empty)) 0)
    (test-identity "zero-size access raises"
                   (lambda () (raises? (lambda () (pointer-ref-u8 empty))))
                   #t)
    (foreign-free empty))

  (let ((array (make-c-array 4 'u16)))
    (test-identity "c-array predicate" (lambda () (c-array? array)) #t)
    (test-equal "c-array length" (lambda () (c-array-length array)) 4)
    (test-identity "c-array type" (lambda () (c-array-type array)) 'u16)
    (c-array-set! array 0 10)
    (c-array-set! array 1 20)
    (c-array-set! array 2 30)
    (c-array-set! array 3 40)
    (test-equal "c-array-ref" (lambda () (c-array-ref array 2)) 30)
    (test-identity "c-array bounds"
                   (lambda () (raises? (lambda () (c-array-ref array 4))))
                   #t)
    (test-identity "c-array->vector"
                   (lambda ()
                     (equal? (c-array->vector array) '#(10 20 30 40)))
                   #t)
    (let ((view (c-array (c-array-pointer array) 4 'u16)))
      (c-array-set! view 0 99)
      (test-equal "c-array wraps an existing pointer"
                  (lambda () (c-array-ref array 0)) 99))
    (let ((other (vector->c-array '#(1 2 3) 'u32)))
      (test-equal "vector->c-array" (lambda () (c-array-ref other 1)) 2)
      (test-equal "vector->c-array length"
                  (lambda () (c-array-length other)) 3)
      (foreign-free (c-array-pointer other)))
    (foreign-free (c-array-pointer array)))

  (test-equal "c-type-size u8" (lambda () (c-type-size 'u8)) 1)
  (test-equal "c-type-size u32" (lambda () (c-type-size 'u32)) 4)
  (test-equal "c-type-size u64" (lambda () (c-type-size 'u64)) 8)
  (test-equal "c-type-size float" (lambda () (c-type-size 'float)) 4)
  (test-equal "c-type-size double" (lambda () (c-type-size 'double)) 8)

  (with-resource (p (foreign-alloc 4)
                    (lambda (pointer)
                      (set! released-normal #t)
                      (foreign-free pointer)))
    (pointer-set-u8! p 1))
  (test-identity "with-resource releases on normal return"
                 (lambda () released-normal) #t)

  (test-identity "with-resource releases on raise"
                 (lambda ()
                   (guard (condition (#t released-raise))
                     (with-resource (p (foreign-alloc 4)
                                       (lambda (pointer)
                                         (set! released-raise #t)
                                         (foreign-free pointer)))
                       (error "ffi-memory raise"))))
                 #t)

  (test-identity "with-resource releases on continuation escape"
                 (lambda ()
                   (call-with-current-continuation
                     (lambda (escape)
                       (with-resource (p (foreign-alloc 4)
                                         (lambda (pointer)
                                           (set! released-escape #t)
                                           (foreign-free pointer)))
                         (escape #t))))
                   released-escape)
                 #t)

  (finish-tests "ffi-memory"))

(main)
