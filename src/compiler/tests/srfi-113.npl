(import (scheme base)
        (scheme write)
        (scheme char)
        (scheme process-context)
        (npl comparator)
        (npl data set)
        (npl data bag)
        (prefix (srfi 113) s113:))

(include "framework.npl")

(define (test-list name thunk expected)
  (test-identity name (lambda () (equal? (thunk) expected)) #t))

(define (main)
  (define comparator (make-default-comparator))
  (define a (set comparator 1 2 3))
  (define b (set comparator 3 4))
  (define bag-a (bag comparator 1 1 2))
  (test-identity "set?" (lambda () (set? a)) #t)
  (test-equal "set-size" (lambda () (set-size a)) 3)
  (test-identity "set-contains?" (lambda () (set-contains? a 2)) #t)
  (test-equal "set-member" (lambda () (set-member a 2 #f)) 2)
  (test-equal "set-adjoin size"
              (lambda () (set-size (set-adjoin a 4)))
              4)
  (test-equal "set-union size"
              (lambda () (set-size (set-union a b)))
              4)
  (test-identity "set-union member"
                 (lambda () (set-contains? (set-union a b) 4))
                 #t)
  (test-equal "set-intersection size"
              (lambda () (set-size (set-intersection a b)))
              1)
  (test-equal "set-difference size"
              (lambda () (set-size (set-difference a b)))
              2)
  (test-identity "set=?"
                 (lambda () (set=? (set comparator 1 2) (set comparator 2 1)))
                 #t)
  (test-identity "set<?"
                 (lambda () (set<? (set comparator 1) (set comparator 1 2)))
                 #t)
  (test-equal "set-fold"
              (lambda () (set-fold + 0 a))
              6)
  (test-equal "set-count"
              (lambda () (set-count even? a))
              1)
  (test-identity "set-any?"
                 (lambda () (set-any? even? a))
                 #t)
  (test-identity "set-every?"
                 (lambda () (set-every? positive? a))
                 #t)
  (test-identity "bag?" (lambda () (bag? bag-a)) #t)
  (test-equal "bag-size" (lambda () (bag-size bag-a)) 3)
  (test-equal "bag-element-count"
              (lambda () (bag-element-count bag-a 1))
              2)
  (test-equal "bag-unique-size"
              (lambda () (bag-unique-size bag-a))
              2)
  (test-equal "bag-sum"
              (lambda ()
                (bag-element-count (bag-sum bag-a (bag comparator 1)) 1))
              3)
  (test-identity "bag->set"
                 (lambda () (set? (bag->set bag-a)))
                 #t)
  (test-identity "set comparator is unordered"
                 (lambda () (not (comparator-ordered? set-comparator)))
                 #t)
  (test-identity "set-adjoin keeps stored member"
                 (lambda ()
                   (let ((s (set (make-comparator string? string-ci=?
                                                  string-ci<? string-ci-hash)
                                 "a")))
                     (equal? (set-member (set-adjoin s "A") "a" #f) "a")))
                 #t)
  (test-equal "bag->list multiplicity"
              (lambda () (length (bag->list bag-a)))
              3)
  (test-identity "bag=? compares multiplicities"
                 (lambda ()
                   (not (bag=? (bag comparator 1 1 2)
                               (bag comparator 1 2 2))))
                 #t)
  (test-identity "bag<=? compares multiplicities"
                 (lambda ()
                   (not (bag<=? (bag comparator 1 1)
                                (bag comparator 1 2))))
                 #t)
  (test-identity "bag<? strict subbag"
                 (lambda () (bag<? (bag comparator 1 1)
                                   (bag comparator 1 1 2)))
                 #t)
  (test-identity "bag-search returns stored element"
                 (lambda ()
                   (let ((b (bag (make-comparator string? string-ci=?
                                                  string-ci<? string-ci-hash)
                                 "a" "a")))
                     (equal? (bag-search! b "A"
                                          (lambda (ignore replace delete)
                                            #f)
                                          (lambda (found replace delete)
                                            found))
                             "a")))
                 #t)
  (test-equal "bag-replace keeps count"
              (lambda ()
                (bag-element-count (bag-replace (bag comparator 1 1 1) 1) 1))
              3)
  (test-equal "set->bag"
              (lambda () (bag-size (set->bag (set comparator 1 2))))
              2)
  (test-equal "bag-sum missing element"
              (lambda ()
                (bag-element-count (bag-sum (bag comparator 1)
                                            (bag comparator 1 2))
                                   2))
              1)
  (test-identity "bag-product zero removes"
                 (lambda ()
                   (let ((b (bag-product 0 bag-a)))
                     (and (zero? (bag-size b))
                          (zero? (bag-unique-size b))
                          (not (bag-contains? b 1)))))
                 #t)
  (test-identity "bag-increment returns bag"
                 (lambda () (bag? (bag-increment! (bag comparator 1) 2 1)))
                 #t)
  (test-identity "bag-decrement returns bag"
                 (lambda () (bag? (bag-decrement! (bag comparator 1 1) 1 1)))
                 #t)
  (test-identity "bag-member stored element"
                 (lambda ()
                   (let ((b (bag (make-comparator string? string-ci=?
                                                  string-ci<? string-ci-hash)
                                 "a")))
                     (equal? (bag-member b "A" #f) "a")))
                 #t)
  (test-identity "bag-member stored false"
                 (lambda ()
                   (bag-member (bag boolean-comparator #f) #f 'missing))
                 #f)
  (test-identity "set hash tolerates unhashable element comparator"
                 (lambda ()
                   (let ((nested (set (make-comparator symbol? eq? #f #f) 'a)))
                     (exact-integer? (comparator-hash set-comparator nested))))
                 #t)
  (test-identity "set destructive and conversion surface"
                 (lambda ()
                   (let ((base (set comparator 1 2 3)))
                     (and (set=? (list->set comparator '(1 2))
                                 (set comparator 1 2))
                          (set=? (list->set! (set comparator) '(1 2))
                                 (set comparator 1 2))
                          (= 3 (length (set->list base)))
                          (set-contains? (set-adjoin! (set-copy base) 4) 4)
                          (not (set-contains? (set-delete! (set-copy base) 1) 1))
                          (= 1 (set-size (set-delete-all! (set-copy base)
                                                          '(1 2))))
                          (= 2 (set-size (set-union! (set-copy (set comparator 1))
                                                     (set comparator 2))))
                          (= 2 (set-size (set-intersection! (set-copy base)
                                                            (set comparator 2 3 4))))
                          (= 2 (set-size (set-difference! (set-copy base)
                                                          (set comparator 1))))
                          (= 2 (set-size (set-xor! (set-copy (set comparator 1 2))
                                                   (set comparator 2 3))))
                          (= 1 (set-size (set-filter! even? (set-copy base))))
                          (= 1 (set-size (set-remove! odd? (set-copy base))))
                          (eq? comparator (set-element-comparator base))
                          (not (set-empty? base))
                          (set-empty? (set comparator))
                          (set-disjoint? (set comparator 1) (set comparator 2))
                          (set<=? (set comparator 1) base)
                          (set>=? base (set comparator 1))
                          (set>? base (set comparator 1)))))
                 #t)
  (test-identity "set folds and search surface"
                 (lambda ()
                   (let ((base (set comparator 1 2 3))
                         (total 0))
                     (set-for-each (lambda (element)
                                     (set! total (+ total element)))
                                   base)
                     (and (= 6 total)
                          (= 6 (set-fold + 0 base))
                          (= 1 (set-count even? base))
                          (eqv? 2 (set-find even? base (lambda () #f)))
                          (call-with-values
                            (lambda () (set-partition even? base))
                            (lambda (yes no)
                              (and (= 1 (set-size yes)) (= 2 (set-size no)))))
                          (set=? (set-map comparator (lambda (x) (* x 2)) base)
                                 (set comparator 2 4 6))
                          (eqv? 2 (set-search! (set-copy base) 2
                                               (lambda (insert ignore) #f)
                                               (lambda (found replace delete)
                                                 found)))
                          (set-contains?
                           (set-unfold comparator (lambda (n) (> n 3))
                                      (lambda (n) n) (lambda (n) (+ n 1)) 1)
                           3))))
                 #t)
  (test-identity "bag destructive and conversion surface"
                 (lambda ()
                   (let ((base (bag comparator 1 1 2)))
                     (and (= 4 (bag-size (bag-adjoin! (bag-copy base) 3)))
                          (= 2 (bag-size (bag-delete! (bag-copy base) 1)))
                          (= 1 (bag-size (bag-delete-all! (bag-copy base)
                                                          '(1 2))))
                          (= 2 (bag-size (bag-union! (bag-copy (bag comparator 1))
                                                     (bag comparator 2))))
                          (= 2 (bag-size (bag-intersection! (bag-copy base)
                                                            (bag comparator 1 2))))
                          (= 2 (bag-size (bag-difference! (bag-copy base)
                                                          (bag comparator 1))))
                          (= 2 (bag-size (bag-xor! (bag-copy (bag comparator 1 2))
                                                   (bag comparator 2 3))))
                          (= 1 (bag-size (bag-filter! even? (bag-copy base))))
                          (= 1 (bag-size (bag-remove! odd? (bag-copy base))))
                          (= 6 (bag-size (bag-product! 2 (bag-copy base))))
                          (eq? comparator (bag-element-comparator base))
                          (not (bag-empty? base))
                          (bag-empty? (bag comparator))
                          (bag-disjoint? (bag comparator 1) (bag comparator 2))
                          (bag<=? (bag comparator 1) base)
                          (bag>=? base (bag comparator 1))
                          (bag>? base (bag comparator 1))
                          (bag=? (bag-copy base) base))))
                 #t)
  (test-identity "bag folds and conversion surface"
                 (lambda ()
                   (let ((base (bag comparator 1 1 2))
                         (total 0)
                         (unique-count 0))
                     (bag-for-each (lambda (element)
                                     (set! total (+ total element)))
                                   base)
                     (bag-for-each-unique
                      (lambda (element count)
                        (set! unique-count (+ unique-count 1)))
                      base)
                     (and (= 4 total)
                          (= 4 (bag-fold + 0 base))
                          (= 1 (bag-count even? base))
                          (eqv? 2 (bag-find even? base (lambda () #f)))
                          (= 3 (bag-element-count
                                (bag-sum! (bag-copy base) (bag comparator 1))
                                1))
                          (call-with-values
                            (lambda () (bag-partition even? base))
                            (lambda (yes no)
                              (and (= 1 (bag-size yes)) (= 2 (bag-size no)))))
                          (= 3 (bag-size
                                (bag-map comparator (lambda (x) (* x 2)) base)))
                          (= 2 (bag-unique-size
                                (bag-unfold comparator (lambda (n) (> n 2))
                                            (lambda (n) n)
                                            (lambda (n) (+ n 1)) 1)))
                          (= 2 (length (bag->alist base)))
                          (= 3 (bag-size (alist->bag comparator
                                                      '((1 . 2) (2 . 1)))))
                          (= 3 (bag-size (list->bag! (bag comparator)
                                                     '(1 1 2))))
                          (= 3 (bag-size (list->bag comparator '(1 1 2))))
                          (= 3 (bag-size (set->bag! (bag comparator)
                                                    (set comparator 1 2 3))))
                          (= 2 unique-count)
                          (= 3 (bag-fold-unique
                                (lambda (element count total)
                                  (+ total count))
                                0 base))
                          (bag? (bag-copy base))
                          (bag? (bag comparator 1 2)))))
                 #t)
  (test-identity "set non-destructive surface"
                 (lambda ()
                   (let ((base (set comparator 1 2 3)))
                     (and (not (set-contains? (set-delete base 1) 1))
                          (= 1 (set-size (set-delete-all base '(1 2))))
                          (= 1 (set-size (set-filter even? base)))
                          (call-with-values
                            (lambda () (set-partition! even? base))
                            (lambda (yes no)
                              (and (= 1 (set-size yes))
                                   (= 2 (set-size no)))))
                          (= 1 (set-size (set-remove odd? base)))
                          (set? (set-replace base 2))
                          (set? (set-replace! (set-copy base) 2))
                          (= 2 (set-size
                                (set-xor (set comparator 1 2)
                                         (set comparator 2 3)))))))
                 #t)
  (test-identity "bag non-destructive surface"
                 (lambda ()
                   (let ((base (bag comparator 1 1 2)))
                     (and (= 4 (bag-size (bag-adjoin base 3)))
                          (bag-any? even? base)
                          (bag-every? positive? base)
                          (not (comparator-ordered? bag-comparator))
                          (= 2 (bag-size (bag-delete base 1)))
                          (= 1 (bag-size (bag-delete-all base '(1 2))))
                          (= 2 (bag-size (bag-difference base
                                                        (bag comparator 1))))
                          (= 1 (bag-size (bag-filter even? base)))
                          (= 2 (bag-size (bag-intersection
                                          base (bag comparator 1 2))))
                          (call-with-values
                            (lambda () (bag-partition! even? base))
                            (lambda (yes no)
                              (and (= 1 (bag-size yes))
                                   (= 2 (bag-size no)))))
                          (= 1 (bag-size (bag-remove odd? base)))
                          (= 3 (bag-size (bag-replace! (bag-copy base) 1)))
                          (= 4 (bag-size (bag-union base
                                                    (bag comparator 3))))
                          (= 2 (bag-size
                                (bag-xor (bag comparator 1 2)
                                         (bag comparator 2 3)))))))
                 #t)
  (test-equal "srfi 113 alias"
              (lambda () (s113:set-size (s113:set comparator 1 2)))
              2)
  (finish-tests "srfi-113"))
(main)
