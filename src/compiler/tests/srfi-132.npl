(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl sort)
        (prefix (srfi 132) s132:)
        (prefix (srfi 95) s95:))

(include "framework.npl")

(define (test-list name thunk expected)
  (test-identity name (lambda () (equal? (thunk) expected)) #t))

(define (main)
  (test-list "list-sort" (lambda () (list-sort < '(3 1 2))) '(1 2 3))
  (test-list "list-stable-sort"
             (lambda () (list-stable-sort < '(3 1 2)))
             '(1 2 3))
  (test-list "list-sort!"
             (lambda ()
               (let ((items (list 3 1 2)))
                 (list-sort! < items)
                 items))
             '(1 2 3))
  (test-list "vector-sort"
             (lambda () (vector->list (vector-sort < '#(3 1 2))))
             '(1 2 3))
  (test-list "vector-sort range"
             (lambda () (vector->list (vector-sort < '#(3 1 2 0) 0 3)))
             '(1 2 3))
  (test-list "vector-sort!"
             (lambda ()
               (let ((v (vector 3 1 2)))
                 (vector-sort! < v)
                 (vector->list v)))
             '(1 2 3))
  (test-identity "list-sorted?" (lambda () (list-sorted? < '(1 2 3))) #t)
  (test-identity "vector-sorted?"
                 (lambda () (vector-sorted? < '#(1 2 3)))
                 #t)
  (test-list "list-merge"
             (lambda () (list-merge < '(1 3) '(2 4)))
             '(1 2 3 4))
  (test-list "vector-merge"
             (lambda () (vector->list (vector-merge < '#(1 3) '#(2 4))))
             '(1 2 3 4))
  (test-list "list-delete-neighbor-dups"
             (lambda () (list-delete-neighbor-dups = '(1 1 2 2 3)))
             '(1 2 3))
  (test-list "vector-delete-neighbor-dups"
             (lambda ()
               (vector->list
                (vector-delete-neighbor-dups = '#(1 1 2 2 3))))
             '(1 2 3))
  (test-equal "vector-find-median"
              (lambda () (vector-find-median < '#(3 1 2) 0))
              2)
  (test-equal "vector-select!"
              (lambda () (vector-select! < (vector 3 1 2) 1))
              2)
  (test-identity "vector-separate! partitions"
                 (lambda ()
                   (let ((v (vector 5 1 4 2 3)))
                     (vector-separate! < v 2)
                     (and (<= (vector-ref v 0) (vector-ref v 2))
                          (<= (vector-ref v 1) (vector-ref v 2)))))
                 #t)
  (test-list "srfi 95 sort list"
             (lambda () (s95:sort '(3 1 2) <))
             '(1 2 3))
  (test-list "srfi 95 sort vector"
             (lambda () (vector->list (s95:sort '#(3 1 2) <)))
             '(1 2 3))
  (test-list "srfi 95 sort with key"
             (lambda ()
               (s95:sort '(-3 1 -2) < (lambda (x) (abs x))))
             '(1 -2 -3))
  (test-list "srfi 95 sort!"
             (lambda ()
               (let ((items (list 3 1 2)))
                 (s95:sort! items <)
                 items))
             '(1 2 3))
  (test-identity "srfi 95 sorted?"
                 (lambda () (s95:sorted? '(1 2 3) <))
                 #t)
  (test-list "srfi 95 merge"
             (lambda () (s95:merge '(1 3) '(2 4) <))
             '(1 2 3 4))
  (test-list "vector-merge subranges"
             (lambda ()
               (vector->list
                (vector-merge < '#(9 1 3) '#(9 2 4) 1 3 1 3)))
             '(1 2 3 4))
  (test-identity "list-merge! reuses input pairs"
                 (lambda ()
                   (let* ((left (list 1 3))
                          (right (list 2 4))
                          (merged (list-merge! < left right)))
                     (and (eq? merged left)
                          (eq? (cdr merged) right)
                          (equal? merged '(1 2 3 4)))))
                 #t)
  (test-identity "merge! reuses input pairs"
                 (lambda ()
                   (let* ((left (list 1 3))
                          (right (list 2 4))
                          (merged (merge! left right <)))
                     (and (eq? merged left)
                          (eq? (cdr merged) right)
                          (equal? merged '(1 2 3 4)))))
                 #t)
  (test-identity "list-delete-neighbor-dups! links original pairs"
                 (lambda ()
                   (let ((items (list 1 1 2)))
                     (and (eq? (list-delete-neighbor-dups! = items) items)
                          (equal? items '(1 2)))))
                 #t)
  (test-equal "sorted? calls key once per element"
              (lambda ()
                (let ((calls 0))
                  (sorted? '(1 2 3) < (lambda (value)
                                        (set! calls (+ calls 1))
                                        value))
                  calls))
              3)
  (test-list "vector-select! returns kth smallest"
             (lambda ()
               (let ((vector (vector 9 1 8 2 7 3 6 4 5 0)))
                 (list (vector-select! < vector 0)
                       (vector-select! < vector 4)
                       (vector-select! < vector 9))))
             '(0 4 9))
  (test-list "vector-select! respects subrange"
             (lambda ()
               (let ((vector (vector 9 8 7 1 2 3 6 5 4)))
                 (list (vector-select! < vector 0 3 6)
                       (vector-select! < vector 2 3 6))))
             '(1 3))
  (test-identity "vector-select! handles duplicates"
                 (lambda ()
                   (let ((vector (vector 2 1 2 1 2)))
                     (equal? (list (vector-select! < vector 0)
                                   (vector-select! < vector 1)
                                   (vector-select! < vector 2)
                                   (vector-select! < vector 3)
                                   (vector-select! < vector 4))
                             '(1 1 2 2 2))))
                 #t)
  (test-identity "vector-separate! partitions the smallest k"
                 (lambda ()
                   (let ((vector (vector 9 1 8 2 7 3 6 4 5 0)))
                     (vector-separate! < vector 4)
                     (let ((small (list-sort < (vector->list vector 0 4)))
                           (large (list-sort < (vector->list vector 4 10))))
                       (and (equal? small '(0 1 2 3))
                            (equal? large '(4 5 6 7 8 9))))))
                 #t)
  (test-list "vector-find-median is non-destructive"
             (lambda ()
                (let ((vector (vector 5 1 4 2 3)))
                  (list (vector-find-median < vector 'none)
                        (vector->list vector))))
              '(3 (5 1 4 2 3)))
  (test-list "vector-find-median even mean"
             (lambda ()
                (vector-find-median < (vector 4 1 3 2) 'none
                                    (lambda (left right) (list left right))))
              '(2 3))
  (test-list "vector-find-median! sorts and returns median"
             (lambda ()
                (let ((vector (vector 3 1 2 4)))
                  (list (vector-find-median! < vector 'none)
                        (vector->list vector))))
              '(5/2 (1 2 3 4)))
  (test-list "stable sort variants"
             (lambda ()
               (let ((items (list 3 1 2))
                     (vector (vector 3 1 2)))
                 (list (list-stable-sort! < items)
                       (vector->list (vector-stable-sort < vector))
                       (begin (vector-stable-sort! < vector)
                              (vector->list vector)))))
             '((1 2 3) (1 2 3) (1 2 3)))
  (test-list "vector merge and neighbor mutators"
             (lambda ()
               (let ((target (vector 0 0 0 0)))
                 (vector-merge! < target '#(1 3) '#(2 4))
                 (list (vector->list target)
                       (vector-delete-neighbor-dups!
                        = (vector 1 1 2 2 3)))))
             '((1 2 3 4) 3))
  (test-equal "srfi 132 alias"
              (lambda () (s132:vector-select! < (vector 3 1 2) 1))
              2)
  (finish-tests "srfi-132"))
(main)
