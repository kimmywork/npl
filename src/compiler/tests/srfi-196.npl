(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl data range)
        (npl list)
        (prefix (srfi 196) s:))

(include "framework.npl")

(define (test-list name thunk expected)
  (test-identity name (lambda () (equal? (thunk) expected)) #t))

(define r (numeric-range 0 5))

(define (main)
  (test-identity "range predicate" (lambda () (range? r)) #t)
  (test-equal "range length" (lambda () (range-length r)) 5)
  (test-equal "range ref" (lambda () (range-ref r 3)) 3)
  (test-equal "range first/last"
              (lambda () (+ (range-first r) (range-last r)))
              4)
  (test-list "range to list" (lambda () (range->list r)) '(0 1 2 3 4))
  (test-list "range to vector"
             (lambda () (vector->list (range->vector r)))
             '(0 1 2 3 4))
  (test-identity "range equality"
                 (lambda () (range=? = r (numeric-range 0 5)))
                 #t)
  (test-list "range map" (lambda () (range->list (range-map (lambda (x) (* x x)) r)))
             '(0 1 4 9 16))
  (test-list "range reverse" (lambda () (range->list (range-reverse r)))
             '(4 3 2 1 0))
  (test-list "range take/drop"
             (lambda () (append (range->list (range-take r 2))
                                (range->list (range-drop r 2))))
             '(0 1 2 3 4))
  (test-equal "range count" (lambda () (range-count odd? r)) 2)
  (test-equal "range fold" (lambda () (range-fold + 0 r)) 10)
  (test-list "range fold-right" (lambda () (range-fold-right xcons '() r))
             '(0 1 2 3 4))
  (test-identity "range any" (lambda () (range-any odd? r)) #t)
  (test-identity "range every" (lambda () (range-every (lambda (x) (< x 5)) r)) #t)
  (test-list "range filter" (lambda () (range->list (range-filter odd? r)))
             '(1 3))
  (test-list "range remove" (lambda () (range->list (range-remove odd? r)))
             '(0 2 4))
  (test-equal "range index" (lambda () (range-index even? r)) 0)
  (test-equal "range take-while"
              (lambda () (range-length (range-take-while (lambda (x) (< x 3)) r)))
              3)
  (test-list "range append"
             (lambda () (range->list (range-append (numeric-range 0 2)
                                                   (numeric-range 5 7))))
             '(0 1 5 6))
  (test-list "vector range"
             (lambda () (range->list (vector-range #(a b c))))
             '(a b c))
  (test-list "string range"
             (lambda () (range->string (string-range "abc")))
             "abc")
  (test-list "iota range" (lambda () (range->list (iota-range 3 10 2)))
             '(10 12 14))
  (test-list "alias range" (lambda () (s:range->list (s:iota-range 2)))
             '(0 1))
  (finish-tests "srfi-196"))
(main)
