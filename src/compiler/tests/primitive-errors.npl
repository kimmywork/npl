; Primitive error objects: who, message, and irritants agree between native
; and npli (tools/check_full_compiler.sh runs both); Guile's wording differs.
(import (scheme base) (scheme write) (scheme file) (scheme read)
        (scheme process-context))

(include "framework.npl")

(define (caught thunk)
  (guard (e ((error-object? e)
             (list (error-object-message e) (error-object-irritants e))))
    (thunk)))

(define (apply-to f x) (f x))

(define (check name thunk expected)
  (test-identity name (lambda () (equal? (caught thunk) expected)) #t))

(define (main)
  (check "car" (lambda () (car 1)) '("car: expected a pair" (1)))
  (check "cdr" (lambda () (cdr '())) '("cdr: expected a pair" (())))
  (check "vector-ref range" (lambda () (vector-ref (vector 1 2) 5))
         '("vector-ref: index out of range" (5)))
  (check "vector-ref type" (lambda () (vector-ref 'v 0))
         '("vector-ref: expected a vector" (v)))
  (check "vector-set! range" (lambda () (vector-set! (make-vector 1 0) 1 2))
         '("vector-set!: index out of range" (1)))
  (check "char->integer" (lambda () (char->integer 1))
         '("char->integer: expected a character" (1)))
  (check "integer->char" (lambda () (integer->char 300))
         '("integer->char: outside supported ASCII repertoire" (300)))
  (check "string-ref" (lambda () (string-ref "ab" 9))
         '("string-ref: index out of range" (9)))
  (check "arity" (lambda () (apply-to (lambda (x y) x) 1))
         '("procedure: wrong number of arguments" (1)))
  (check "not a procedure" (lambda () (apply-to 1 2))
         '("application: not a procedure" (1)))
  (check "bytevector byte" (lambda () (bytevector 1 300))
         '("bytevector: expected a byte" (300)))
  (check "bytevector-u8-ref range" (lambda () (bytevector-u8-ref (bytevector 1) 3))
         '("bytevector-u8-ref: index out of range" (3)))
  (check "bytevector-u8-set! byte"
         (lambda () (bytevector-u8-set! (bytevector 1) 0 256))
         '("bytevector-u8-set!: expected a byte" (256)))
  (check "bytevector-length" (lambda () (bytevector-length 1))
         '("bytevector-length: expected a bytevector" (1)))
  (check "string-length" (lambda () (string-length 1))
         '("string-length: expected a string" (1)))
  (check "string-append" (lambda () (string-append "a" 1))
         '("string-append: expected a string" (1)))
  (check "substring" (lambda () (substring "abc" 2 9))
         '("substring: index out of range" ((2 9))))
  (check "make-string" (lambda () (make-string -1 #\a))
         '("make-string: expected a non-negative count" (-1)))
  (check "string-set!" (lambda () (string-set! (make-string 2 #\a) 5 #\b))
         '("string-set!: index out of range" (5)))
  (check "list->vector" (lambda () (list->vector '(1 . 2)))
         '("list->vector: expected a proper list" ((1 . 2))))
  (check "append" (lambda () (append '(1 . 2) '(3)))
         '("append: expected a proper list" ((1 . 2))))
  ; Library-level argument checks use the same error shape.
  (check "+" (lambda () (+ 1 'a)) '("+: expected a number" (a)))
  (check "/" (lambda () (/ 1 0)) '("/: division by zero" (1)))
  (check "quotient" (lambda () (quotient 7 0)) '("quotient: division by zero" (7)))
  (check "list-tail" (lambda () (list-tail '(1) 5)) '("list-tail: index out of range" (5)))
  (check "list-ref" (lambda () (list-ref '(1) 3)) '("list-ref: index out of range" (3)))
  (check "make-vector" (lambda () (make-vector 'x))
         '("make-vector: expected a non-negative exact count" (x)))
  (check "vector-copy!" (lambda () (vector-copy! (vector 1) 3 (vector 1)))
         '("vector-copy!: index out of range" (3)))
  (check "string<?" (lambda () (string<? "a" 1)) '("string<?: expected a string" (1)))
  (check "error message" (lambda () (error 'not-a-string))
         '("error: expected a string" (not-a-string)))
  ; Ports (runtime/io.c).
  (check "read-char port" (lambda () (read-char 1)) '("read-char: expected a port" (1)))
  (check "write-char char" (lambda () (write-char 1 (open-output-string)))
         '("write-char: expected a character" (1)))
  (check "open-input-string" (lambda () (open-input-string 1))
         '("open-input-string: expected a string" (1)))
  (check "display port" (lambda () (display 1 'p)) '("display: expected a port" (p)))
  (check "read syntax" (lambda () (read (open-input-string ")"))) '("unexpected )" ()))
  (test-identity "closed port"
                 (lambda ()
                   (let ((port (open-output-string)))
                     (close-port port)
                     (guard (e ((error-object? e)
                                (string=? (error-object-message e)
                                          "write-char: port is closed")))
                       (write-char #\a port))))
                 #t)
  (test-identity "delete-file is a file error"
                 (lambda ()
                   (guard (e ((file-error? e)
                              (equal? (error-object-irritants e)
                                      '("/nonexistent/npl-primitive-errors"))))
                     (delete-file "/nonexistent/npl-primitive-errors")))
                 #t)
  (finish-tests "primitive-errors"))
