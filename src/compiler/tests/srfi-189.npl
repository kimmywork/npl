(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl data maybe)
        (npl data either)
        (prefix (npl data option) option:)
        (prefix (srfi 189) s:))

(include "framework.npl")

(define (test-list name thunk expected)
  (test-identity name (lambda () (equal? (thunk) expected)) #t))

(define (main)
  (test-identity "just" (lambda () (just? (just 1))) #t)
  (test-identity "nothing" (lambda () (nothing? (nothing))) #t)
  (test-identity "maybe" (lambda () (maybe? (nothing))) #t)
  (test-equal "maybe-ref" (lambda () (maybe-ref (just 42) (lambda () 0))) 42)
  (test-equal "maybe-ref/default" (lambda () (maybe-ref/default (nothing) 42)) 42)
  (test-identity "maybe=" (lambda () (maybe= = (just 1) (just 1))) #t)
  (test-equal "maybe-join" (lambda () (maybe-ref (maybe-join (just (just 42))) (lambda () 0))) 42)
  (test-equal "maybe-bind" (lambda () (maybe-ref (maybe-bind (just 2) (lambda (x) (just (+ x 40)))) (lambda () 0))) 42)
  (test-equal "maybe-if" (lambda () (maybe-if (just 42) 42 0)) 42)
  (test-equal "two-values->maybe"
              (lambda ()
                (maybe-ref (two-values->maybe (lambda () (values 42 #t)))
                           (lambda () 0)))
              42)
  (test-list "maybe->list" (lambda () (maybe->list (just 1 2))) '(1 2))
  (test-equal "maybe->truth" (lambda () (maybe->truth (just 1))) 1)
  (test-identity "truth->maybe" (lambda () (just? (truth->maybe #t))) #t)
  (test-equal "maybe-map" (lambda () (maybe-ref/default (maybe-map (lambda (x) (+ x 1)) (just 41)) 0)) 42)
  (test-equal "maybe-fold" (lambda () (maybe-fold + 0 (just 42))) 42)
  (test-equal "maybe-unfold" (lambda () (maybe-ref (maybe-unfold (lambda (n) (= n 3)) (lambda (n) n) (lambda (n) 3) 0) (lambda () 0))) 0)
  (test-identity "maybe-and" (lambda () (just? (maybe-and (just 1) (just 2)))) #t)
  (test-identity "maybe-or" (lambda () (just? (maybe-or (nothing) (just 2)))) #t)
  (test-equal "maybe-let*" (lambda () (maybe-ref (maybe-let* (((just 40)) (x (just 2))) (+ x 40)) (lambda () 0))) 42)
  (test-equal "maybe-let*-values" (lambda () (maybe-ref (maybe-let*-values (((x y) (just 20 22))) (+ x y)) (lambda () 0))) 42)
  (test-identity "either-right" (lambda () (right? (right 1))) #t)
  (test-identity "either-left" (lambda () (left? (left 1))) #t)
  (test-equal "either-ref" (lambda () (either-ref (right 42) (lambda () 0))) 42)
  (test-identity "either=" (lambda () (either= = (right 1) (right 1))) #t)
  (test-equal "either-join" (lambda () (either-ref (either-join (right (right 42))) (lambda () 0))) 42)
  (test-equal "either-bind" (lambda () (either-ref (either-bind (right 2) (lambda (x) (right (+ x 40)))) (lambda () 0))) 42)
  (test-list "either->list Left" (lambda () (either->list (left 'failure))) '())
  (test-equal "maybe-join invalid payload"
              (lambda () (guard (e (#t 42)) (maybe-join (just 7))))
              42)
  (test-equal "either-join invalid payload"
              (lambda () (guard (e (#t 42)) (either-join (right 7))))
              42)
  (test-list "either->list" (lambda () (either->list (right 1 2))) '(1 2))
  (test-equal "either-map" (lambda () (either-ref/default (either-map (lambda (x) (+ x 1)) (right 41)) 0)) 42)
  (test-equal "either-fold" (lambda () (either-fold + 0 (right 42))) 42)
  (test-identity "either-and" (lambda () (right? (either-and (right 1) (right 2)))) #t)
  (test-identity "either-or" (lambda () (right? (either-or (left 1) (right 2)))) #t)
  (test-equal "either-let*" (lambda () (either-ref (either-let* (((right 40)) (x (right 2))) (+ x 40)) (lambda () 0))) 42)
  (test-equal "maybe->either" (lambda () (either-ref/default (maybe->either (just 42) 'missing) 0)) 42)
  (test-equal "either->maybe" (lambda () (maybe-ref (either->maybe (right 42)) (lambda () 0))) 42)
  (test-equal "option maybe-if" (lambda () (option:maybe-if (just 42) 42 0)) 42)
  (test-list "alias maybe->list" (lambda () (s:maybe->list (s:just 1 2))) '(1 2))
  (finish-tests "srfi-189"))
(main)
