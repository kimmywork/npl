#!srfi-88

(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl keyword))

(include "framework.npl")

(define* (f a #:optional (b 1) (c 2) #:key (d 3) (e 4))
  (list a b c d e))

(define* (g a (b 1) (c: c 2))
  (list a b c))

(define* (h a (key: k))
  (list a k))

(define* (h2 (key: k #f) a . r)
  (list a k r))

(define* (defaults a (b a) (key: k (* a b)))
  (list a b k))

(define* (resty a . rest)
  (list a rest))

(define* (rest-marker a #:key x #:rest rest)
  (list a x rest))

(define* (allowy a #:key x #:allow-other-keys)
  (list a x))

(define* (allow-before #:allow-other-keys #:key x)
  x)

(define* (allow-no-key a #:allow-other-keys)
  a)

(define (inner-star x)
  (define* (helper y #:optional (z 1))
    (+ y z))
  (+ (helper x) (helper x 2)))

(define (raise-default)
  (error "default evaluated"))

(define (main)
  (test-equal "guile optional defaults"
              (lambda () (equal? (f 10) '(10 1 2 3 4)))
              #t)
  (test-equal "guile optional positional"
              (lambda () (equal? (f 10 20) '(10 20 2 3 4)))
              #t)
  (test-equal "guile keyword"
              (lambda () (equal? (f 10 20 30 #:d 40) '(10 20 30 40 4)))
              #t)
  (test-equal "srfi 89 optional and named"
              (lambda () (equal? (g 10) '(10 1 2)))
              #t)
  (test-equal "srfi 89 named call"
              (lambda () (equal? (g 10 20 c: 30) '(10 20 30)))
              #t)
  (test-equal "required named"
              (lambda () (equal? (h 1 key: 2) '(1 2)))
              #t)
  (test-error "required named missing"
              (h 1))
  (test-equal "named before positional"
              (lambda () (equal? (h2 key: 2 1 3 4) '(1 2 (3 4))))
              #t)
  (test-equal "defaults see previous parameters"
              (lambda () (equal? (defaults 3 4 key: 5) '(3 4 5)))
              #t)
  (test-equal "optional default from earlier parameter"
              (lambda () (equal? (defaults 3) '(3 3 9)))
              #t)
  (test-equal "named default sees positional parameters"
              (lambda () (equal? (defaults 3 4) '(3 4 12)))
              #t)
  (test-equal "rest parameter"
              (lambda () (equal? (resty 1 2 3) '(1 (2 3))))
              #t)
  (test-equal "explicit rest marker"
              (lambda () (equal? (rest-marker 1 #:x 2 3 4)
                                 '(1 2 (3 4))))
              #t)
  (test-error "unknown keyword"
              (f 1 #:z 2))
  (test-error "duplicate keyword"
              (f 1 #:d 2 #:d 3))
  (test-equal "allow other keywords"
              (lambda () (equal? (allowy 1 #:x 2 #:z 3) '(1 2)))
              #t)
  (test-equal "allow other keywords keeps defaults"
              (lambda () (equal? (allowy 1 #:z 3) '(1 #f)))
              #t)
  (test-error "allow other keywords still rejects duplicates"
              (allowy 1 #:x 2 #:x 3))
  (test-error "allow other keywords still needs a value"
              (allowy 1 #:z))
  (test-error "allow other keywords rejects duplicate unknowns"
              (allowy 1 #:z 1 #:z 2))
  (test-equal "allow other keywords without named parameters"
              (lambda () (allow-no-key 1 #:z 2))
              1)
  (test-equal "allow-other-keys before #:key"
              (lambda () (allow-before #:x 7 #:z 8))
              7)
  (test-equal "lambda* allow other keywords"
              (lambda ()
                ((lambda* (#:key x #:allow-other-keys) x)
                 #:x 5 #:z 9))
              5)
  (test-equal "lambda* parameter named car"
              (lambda () ((lambda* (car x) (+ car x)) 1 2))
              3)
  (test-equal "lambda* parameter named vector-ref"
              (lambda () ((lambda* (vector-ref x) (+ vector-ref x)) 10 2))
              12)
  (test-equal "lambda* parameter named if"
              (lambda () ((lambda* (if x) (+ if x)) 1 2))
              3)
  (test-equal "lambda* parameter named error"
              (lambda () ((lambda* (error x) (+ error x)) 1 2))
              3)
  (test-equal "internal define* is prebound"
              (lambda () (inner-star 10))
              23)
  (test-equal "provided optional skips default"
              (lambda () ((lambda* ((x (raise-default))) x) 42))
              42)
  (test-equal "provided keyword skips default"
              (lambda ()
                ((lambda* (#:key (x (raise-default))) x) #:x 7))
              7)
  (test-equal "missing optional evaluates default once"
              (lambda ()
                (equal?
                  (let ((count 0))
                    (let ((value
                            ((lambda* ((x (begin
                                            (set! count (+ count 1))
                                            count)))
                               x))))
                      (list value count)))
                  '(1 1)))
              #t)
  (test-equal "outer car does not capture generated plumbing"
              (lambda ()
                (let ((car (lambda (x) #f)))
                  ((lambda* (x) x) 42)))
              42)
  (test-equal "outer vector-ref does not capture generated plumbing"
              (lambda ()
                (let ((vector-ref (lambda (x y) #f)))
                  ((lambda* (x) x) 42)))
              42)
  (test-equal "outer error does not capture generated plumbing"
              (lambda ()
                (let ((error (lambda args 0)))
                  ((lambda* (x) x) 42)))
              42)
  (test-equal "outer if does not capture generated plumbing"
              (lambda ()
                (let ((if (lambda args 0)))
                  ((lambda* (x) x) 42)))
              42)
  (test-equal "lambda*"
              (lambda ()
                (equal? ((lambda* (a (b 2) (c: c 3))
                           (list a b c))
                         1 c: 4)
                        '(1 2 4)))
              #t)
  (finish-tests "srfi-89"))
(main)
