(import (scheme base)
        (scheme read)
        (scheme write)
        (scheme process-context))

(include "framework.npl")

(define (read-error? text)
  (guard (condition (#t #t))
    (read (open-input-string text))
    #f))

(define (main)
  (test-assert "late lang directive"
               (read-error? "#!fold-case\n#!(lang npl)\n1"))
  (test-assert "duplicate lang directive"
               (read-error? "#!(lang npl)\n#!(lang npl)\n1"))
  (test-assert "unknown parameterized directive"
               (read-error? "#!(bogus)\n1"))
  (test-assert "directive arity"
               (read-error? "#!(fold-case extra)\n1"))
  (test-assert "missing language"
               (read-error? "#!(lang)\n1"))
  (test-assert "nested directive"
               (read-error? "#!(lang #!fold-case npl)\n1"))
  (test-assert "duplicate lang across reads"
               (let ((port (open-input-string
                             "#!(lang npl)\n1\n#!(lang npl)\n2")))
                 (read port)
                 (guard (condition (#t #t))
                   (read port)
                   #f)))
  (test-assert "fresh port starts clean"
               (let ((first (open-input-string "#!fold-case\n1"))
                     (second (open-input-string "#!(lang npl)\n2")))
                 (read first)
                 (= (read second) 2)))
  (finish-tests "reader-directive-errors"))
(main)
