(import (scheme base)
        (scheme char)
        (scheme write)
        (scheme process-context)
        (npl comparator)
        (prefix (srfi 128) s:))

(include "framework.npl")

(define-record-type tag
  (make-tag value)
  tag?
  (value tag-value))

(define (main)
  (define real (make-comparator real? = < number-hash))
  (test-identity "comparator?" (lambda () (comparator? real)) #t)
  (test-identity "ordered?" (lambda () (comparator-ordered? real)) #t)
  (test-identity "hashable?" (lambda () (comparator-hashable? real)) #t)
  (test-identity "test type" (lambda () (comparator-test-type real 1)) #t)
  (test-identity "check type failure"
                 (lambda ()
                   (guard (e (#t #t))
                     (comparator-check-type real 'x)
                     #f))
                 #t)
  (test-identity "=? " (lambda () (=? real 1 1)) #t)
  (test-identity "<? " (lambda () (<? real 1 2)) #t)
  (test-identity ">? " (lambda () (>? real 2 1)) #t)
  (test-identity "<=?" (lambda () (<=? real 2 2)) #t)
  (test-identity ">=?" (lambda () (>=? real 2 1)) #t)
  (test-identity "variadic comparisons"
                 (lambda ()
                   (and (=? real 1 1 1)
                        (<? real 1 2 3)
                        (<=? real 1 1 2)
                        (>=? real 3 2 1)))
                 #t)
  (test-identity "number hash exactness"
                 (lambda ()
                   (= (comparator-hash real 1)
                      (comparator-hash real 1.0)))
                 #t)
  (test-identity "single-argument hash function"
                 (lambda ()
                   (= 7 (comparator-hash
                         (make-comparator integer? = < (lambda (value) 7))
                         3)))
                 #t)
  (test-identity "number-hash infinity"
                 (lambda () (exact-integer? (number-hash +inf.0)))
                 #t)
  (test-equal "comparator-max"
              (lambda () (comparator-max real 1 3 2))
              3)
  (test-equal "comparator-min"
              (lambda () (comparator-min real 1 3 2))
              1)
  (test-equal "comparator-max-in-list"
              (lambda () (comparator-max-in-list real '(1 5 2)))
              5)
  (test-identity "comparator-if<=>"
                 (lambda ()
                   (comparator-if<=> real 1 2 'less 'equal 'greater))
                 'less)
  (test-identity "comparator-if<=> default comparator"
                 (lambda () (comparator-if<=> 1 2 'less 'equal 'greater))
                 'less)
  (test-identity "default comparator ordering"
                 (lambda () (<? (make-default-comparator) 1 2))
                 #t)
  (test-identity "default comparator number equality"
                 (lambda () (=? (make-default-comparator) 1 1.0))
                 #t)
  (test-identity "list comparator"
                 (lambda ()
                   (=? list-comparator '(1 2) '(1 2)))
                 #t)
  (test-identity "list comparator ordering"
                 (lambda () (<? list-comparator '(1 2) '(1 3)))
                 #t)
  (test-identity "vector comparator"
                 (lambda ()
                   (=? vector-comparator '#(1 2) '#(1 2)))
                 #t)
  (test-identity "vector comparator ordering"
                 (lambda () (<? vector-comparator '#(1) '#(1 2)))
                 #t)
  (test-identity "pair comparator ordering"
                 (lambda ()
                   (<? (make-pair-comparator real real) '(1 . 2) '(1 . 3)))
                 #t)
  (test-identity "pair comparator type test"
                 (lambda ()
                   (not (comparator-test-type
                         (make-pair-comparator real real) '(1 . x))))
                 #t)
  (test-identity "string comparator"
                 (lambda () (=? string-comparator "ab" "ab"))
                 #t)
  (test-identity "default comparator"
                 (lambda () (=? default-comparator '(1 2) '(1 2)))
                 #t)
  (test-identity "registered default comparator"
                 (lambda ()
                   (comparator-register-default!
                    (make-comparator
                     tag?
                     (lambda (left right)
                       (= (tag-value left) (tag-value right)))
                     (lambda (left right)
                       (< (tag-value left) (tag-value right)))
                     (lambda (value) 5)))
                   (and (=? default-comparator (make-tag 1) (make-tag 1))
                        (<? default-comparator (make-tag 1) (make-tag 2))))
                 #t)
  (test-identity "srfi 128 alias"
                 (lambda () (s:comparator? s:default-comparator))
                 #t)
  (finish-tests "srfi-128"))
(main)
