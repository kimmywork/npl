#!colon-keyword

(import (scheme base)
        (scheme read)
        (scheme write)
        (scheme process-context)
        (npl format)
        (npl keyword))

(include "framework.npl")

(define (keyword-roundtrip name)
  (let ((port (open-output-string)))
    (write (string->keyword name) port)
    (keyword->string
      (read (open-input-string (get-output-string port))))))

(define (main)
  (test-identity "keyword predicate" (lambda () (keyword? 'foo:)) #t)
  (test-identity "keyword is not a symbol" (lambda () (symbol? 'foo:)) #f)
  (test-identity "hash syntax is the same keyword"
                 (lambda () (eq? #:foo 'foo:)) #t)
  (test-identity "barred spelling is a symbol"
                 (lambda () (symbol? '|foo:|)) #t)
  (test-identity "barred spelling is not a keyword"
                 (lambda () (keyword? '|foo:|)) #f)
  (test-equal "keyword->string" (lambda () (keyword->string 'foo:)) "foo")
  (test-equal "string->keyword writes keyword syntax"
              (lambda () (format #f "~s" (string->keyword "bar")))
              "#:bar")
  (test-equal "write keyword" (lambda () (format #f "~s" #:baz)) "#:baz")
  (test-assert "colon-keyword directive in a port"
               (keyword?
                 (read (open-input-string "#!colon-keyword foo:"))))
  (test-assert "srfi-88 alias in a port"
               (keyword?
                 (read (open-input-string "#!srfi-88 foo:"))))
  (test-assert "removed no-srfi-88 directive is rejected"
               (guard (condition (#t #t))
                 (read (open-input-string "#!no-srfi-88 1"))
                 #f))
  (test-equal "keyword roundtrip spaces"
              (lambda ()
                (keyword-roundtrip "a b"))
              "a b")
  (test-equal "keyword roundtrip empty"
              (lambda () (keyword-roundtrip ""))
              "")
  (test-equal "keyword roundtrip delimiters and escapes"
              (lambda () (keyword-roundtrip "a|b\\c(d)"))
              "a|b\\c(d)")
  (test-assert "fold-case folds keyword names"
               (let ((port (open-input-string
                             "#!fold-case #!colon-keyword\nFoo:")))
                 (string=? (keyword->string (read port)) "foo")))
  (test-equal "barred keyword literal"
              (lambda () (keyword->string #:|a b|))
              "a b")
  (test-equal "empty barred keyword literal"
              (lambda () (keyword->string #:||))
              "")
  (finish-tests "srfi-88"))
(main)
