;; Cases for the direct-call report (frontend/direct-calls.npl, design-calls
;; addendum C2a). expected.txt lists the verdict for each top-level function.
(import (scheme base) (scheme write))
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(define (tak x y z) (if (not (< y x)) z (tak (tak (- x 1) y z) (tak (- y 1) z x) (tak (- z 1) x y))))
(define (len xs) (if (null? xs) 0 (+ 1 (len (cdr xs)))))
(define (ev? n) (if (= n 0) #t (od? (- n 1))))
(define (od? n) (if (= n 0) #f (ev? (- n 1))))
(define (twice n) (+ (fib n) (fib n)))
(define (uses-callcc x) (call-with-current-continuation (lambda (k) (k x))))
(define (calls-closure f x) (f x))
(define (makes-closure x) (lambda () x))
(define (uses-apply xs) (apply + xs))
(define (uses-error x) (if (< x 0) (error "negative" x) x))
(define (uses-wind) (dynamic-wind (lambda () 0) (lambda () 1) (lambda () 2)))
(define p (make-parameter 1))
(define (uses-parameterize) (parameterize ((p 2)) (p)))
(define (calls-map xs) (map car xs))
(define (calls-unsafe x) (uses-error x))
(define (variadic . xs) xs)
(define (named-loop n) (let loop ((i 0) (acc 0)) (if (= i n) acc (loop (+ i 1) (+ acc i)))))
(define (vec-sum v)
  (let loop ((i 0) (acc 0))
    (if (= i (vector-length v)) acc (loop (+ i 1) (+ acc (vector-ref v i))))))
(define (with-set n) (let ((x 0)) (set! x (+ x n)) x))
(write (list (fib 10) (tak 6 4 2) (len '(1 2)) (ev? 4) (twice 3) (named-loop 3) (vec-sum (vector 1 2)) (with-set 4))) (newline)
