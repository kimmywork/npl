(import (scheme base) (scheme write) (npl ffi))

(define-c-struct timespec
  "struct timespec"
  (tv_sec long)
  (tv_nsec long))

(define-c-struct passwd
  "struct passwd"
  (pw_name pointer))

; A typedef name, not a "struct tag": the layout probe supplies the header,
; while the generated stub must need no complete declaration.
(define-c-struct div-result
  "ldiv_t"
  (quot long)
  (rem long))

(define-c-function time-now "npl_time_now_ts" (int struct:timespec) -> int)
(define-c-function timespec-size "npl_time_timespec_size" () -> long)
(define-c-function ldiv-quot "npl_ldiv_quot" (struct:div-result) -> long)

(define-record-type ordinary (make-ordinary a b) ordinary?
  (a ordinary-a)
  (b ordinary-b))

(define (raises? thunk)
  (guard (condition (#t #t))
    (thunk)
    #f))

(define (main)
  (let ((value (make-c-struct timespec)))
    (let ((status (time-now 0 value)))
      (write (list status
                   (> (c-struct-ref value 'tv_sec) 0)
                   (>= (c-struct-ref value 'tv_nsec) 0)
                   (< (c-struct-ref value 'tv_nsec) 1000000000)
                   (= (c-struct-size value) (timespec-size))))
      (newline))
    (let ((wrong (make-c-struct passwd)))
      (write (list (raises? (lambda () (time-now 0 wrong)))
                   (raises? (lambda () (time-now 0 (make-ordinary 1 2))))
                   (raises? (lambda () (time-now 0 (vector 1 2))))))
      (newline)
      (free-c-struct wrong))
    (free-c-struct value)
    (write (list 'freed (raises? (lambda () (time-now 0 value)))))
    (newline))
  (let ((div (make-c-struct div-result)))
    (c-struct-set! div 'quot 7)
    (c-struct-set! div 'rem 2)
    (write (list 'typedef (ldiv-quot div)))
    (newline)
    (free-c-struct div)))

(main)
