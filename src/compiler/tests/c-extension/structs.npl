(import (scheme base) (scheme write) (npl ffi))

(define-c-struct timespec
  "struct timespec"
  (tv_sec long)
  (tv_nsec long))

(define-c-struct passwd
  "struct passwd"
  (pw_name pointer))

(define-c-function time-now "npl_time_now_ts" (int struct:timespec) -> int)
(define-c-function timespec-size "npl_time_timespec_size" () -> long)

(define-record-type ordinary (make-ordinary a b) ordinary?
  (a ordinary-a)
  (b ordinary-b))

(define (raises? thunk)
  (guard (condition (#t #t))
    (thunk)
    #f))

(define (main)
  (let ((value (make-c-struct timespec)))
    (let ((status (time-now 0 value)))
      (write (list status
                   (> (c-struct-ref value 'tv_sec) 0)
                   (>= (c-struct-ref value 'tv_nsec) 0)
                   (< (c-struct-ref value 'tv_nsec) 1000000000)
                   (= (c-struct-size value) (timespec-size))))
      (newline))
    (let ((wrong (make-c-struct passwd)))
      (write (list (raises? (lambda () (time-now 0 wrong)))
                   (raises? (lambda () (time-now 0 (make-ordinary 1 2))))
                   (raises? (lambda () (time-now 0 (vector 1 2))))))
      (newline)
      (free-c-struct wrong))))

(main)
