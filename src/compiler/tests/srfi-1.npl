(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl list)
        (prefix (srfi 1) s:))

(include "framework.npl")

(define (test-list name thunk expected)
  (test-identity name (lambda () (equal? (thunk) expected)) #t))

(define (main)
  (test-list "constructors" (lambda () (cons* 1 2 '(3))) '(1 2 3))
  (test-list "iota" (lambda () (iota 4 10 2)) '(10 12 14 16))
  (test-list "list-tabulate"
             (lambda () (list-tabulate 4 (lambda (i) (* i i))))
             '(0 1 4 9))
  (test-identity "proper-list?" (lambda () (proper-list? '(1 2 3))) #t)
  (test-identity "dotted-list?" (lambda () (dotted-list? '(1 2 . 3))) #t)
  (test-identity "circular-list?"
                 (lambda () (circular-list? (circular-list 1 2)))
                 #t)
  (test-identity "list=" (lambda () (list= = '(1 2 3) '(1 2 3))) #t)
  (test-list "take/drop" (lambda () (take '(1 2 3 4) 2)) '(1 2))
  (test-list "drop" (lambda () (drop '(1 2 3 4) 2)) '(3 4))
  (test-list "take-right" (lambda () (take-right '(1 2 3 4) 2)) '(3 4))
  (test-list "drop-right" (lambda () (drop-right '(1 2 3 4) 2)) '(1 2))
  (test-list "split-at"
             (lambda () (call-with-values (lambda () (split-at '(1 2 3 4) 2))
                                          list))
             '((1 2) (3 4)))
  (test-equal "first..tenth" (lambda () (fifth '(1 2 3 4 5 6))) 5)
  (test-list "zip" (lambda () (zip '(1 2) '(a b))) '((1 a) (2 b)))
  (test-list "unzip2"
             (lambda () (call-with-values (lambda () (unzip2 '((1 a) (2 b))))
                                          list))
             '((1 2) (a b)))
  (test-equal "count" (lambda () (count odd? '(1 2 3 4 5))) 3)
  (test-equal "fold" (lambda () (fold + 0 '(1 2 3 4))) 10)
  (test-list "fold-right" (lambda () (fold-right cons '() '(1 2 3))) '(1 2 3))
  (test-list "unfold" (lambda () (unfold (lambda (n) (= n 4))
                                          (lambda (n) (* n n))
                                          (lambda (n) (+ n 1))
                                          0))
               '(0 1 4 9))
  (test-list "filter" (lambda () (filter odd? '(1 2 3 4 5))) '(1 3 5))
  (test-list "remove" (lambda () (remove odd? '(1 2 3 4 5))) '(2 4))
  (test-equal "find" (lambda () (find even? '(1 2 3 4))) 2)
  (test-list "find-tail" (lambda () (find-tail even? '(1 2 3 4))) '(2 3 4))
  (test-identity "any" (lambda () (any odd? '(2 4 5))) #t)
  (test-identity "every" (lambda () (every odd? '(1 3 5))) #t)
  (test-equal "list-index" (lambda () (list-index even? '(1 3 4 6))) 2)
  (test-list "delete" (lambda () (delete 3 '(1 2 3 2 1))) '(1 2 2 1))
  (test-list "delete-duplicates"
             (lambda () (delete-duplicates '(1 2 1 3 2 4)))
             '(1 2 3 4))
  (test-list "alist-delete"
             (lambda () (alist-delete 'a '((a . 1) (b . 2) (a . 3)) eq?))
             '((b . 2)))
  (test-identity "lset-union"
                 (lambda () (lset= = (lset-union = '(1 2) '(2 3) '(4))
                                      '(1 2 3 4)))
                 #t)
  (test-identity "lset<="
                 (lambda () (lset<= = '(1 2) '(1 2 3)))
                 #t)
  (test-equal "npl library feature"
              (lambda () (cond-expand ((library (npl list)) 42) (else 0)))
              42)
  (test-equal "srfi alias feature"
              (lambda () (cond-expand ((library (srfi 1)) 42) (else 0)))
              42)
  (test-list "alias take" (lambda () (s:take '(1 2 3) 1)) '(1))
  (test-list "alias filter" (lambda () (s:filter odd? '(1 2 3))) '(1 3))
  (finish-tests "srfi-1"))
(main)
