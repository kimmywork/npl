(define-library (libraries inline)
  (export inline-value)
  (import (scheme base))
  (begin
    (define inline-value 6)))

; Library body: top-level begin splices, a macro defined later is visible to
; an earlier macro, and names a macro defines can be exported.
(define-library (libraries generated)
  (export generated-value generated-getter spliced-value)
  (import (scheme base))
  (begin
    (define-syntax define-with-getter
      (syntax-rules ()
        ((_ name getter value)
         (begin (define name (scale value)) (define (getter) name)))))
    (define-syntax scale
      (syntax-rules () ((_ value) (* value 2))))
    (define-with-getter generated-value generated-getter 21)
    (begin (define spliced-value 7))))

(import (only (libraries core) base-value add)
        (except (libraries extra) omitted)
        (prefix (libraries core) core-)
        (rename (libraries core) (old-name renamed-old))
        (libraries syntax)
        (libraries included)
        (libraries inline)
        (libraries generated)
        (scheme base)
        (scheme write)
        (scheme process-context)
        (prefix (only (scheme base) + car) base-)
        (rename (only (scheme base) when) (when standard-when)))

(include "framework.npl")

(define (main)
  (test-equal "only and library procedure"
              (lambda () (add base-value 22))
              42)
  (test-equal "except retains selected value"
              (lambda () (if (number? kept) kept 0))
              42)
  (test-equal "prefix import"
              (lambda () (+ core-base-value core-hidden))
              30)
  (test-equal "rename import"
              (lambda () renamed-old)
              12)
  (test-equal "syntax export keeps definition site"
              (lambda () (increment 2))
              42)
  (test-equal "include"
              (lambda () included-value)
              20)
  (test-equal "include-ci"
              (lambda () case-folded-value)
              20)
  (test-equal "include-library-declarations cond-expand"
              (lambda () declaration-value)
              2)
  (test-equal "inline library"
              (lambda () inline-value)
              6)
  (test-equal "macro-defined export"
              (lambda () (+ generated-value (generated-getter)))
              84)
  (test-equal "spliced begin export"
              (lambda () spliced-value)
              7)
  (test-equal "library cache initializes once"
              (lambda () (+ base-value core-base-value))
              40)
  (test-equal "standard base procedure source"
              (lambda () (base-+ (base-car '(40 2)) 2))
              42)
  (test-equal "standard base syntax source"
              (lambda ()
                (let ((value 0))
                  (standard-when #t (set! value 42))
                  value))
              42)
  (test-equal "standard library feature"
              (lambda ()
                (cond-expand
                  ((library (scheme write)) 42)
                  (else 0)))
              42)
  (test-equal "unknown standard library feature"
              (lambda ()
                (cond-expand
                  ((library (scheme nonexistent)) 0)
                  (else 42)))
              42)
  (test-equal "installed npl library feature"
              (lambda ()
                (cond-expand
                  ((library (npl hashtable)) 42)
                  (else 0)))
              42)
  (test-equal "installed srfi alias feature"
              (lambda ()
                (cond-expand
                  ((library (srfi 125)) 42)
                  (else 0)))
              42)
  (test-equal "user library feature"
              (lambda ()
                (cond-expand
                  ((library (libraries conditional-only)) 42)
                  (else 0)))
              42)
  (test-identity "portable feature identifiers"
                 (lambda ()
                   (if (if (memq 'full-unicode (features)) #t #f)
                       (if (memq 'ratios (features)) #t #f)
                       #f))
                 #t)
  (test-equal "cond-expand feature identifier"
              (lambda ()
                (cond-expand
                  (full-unicode 42)
                  (else 0)))
              42)
  (finish-tests "libraries"))
(main)
