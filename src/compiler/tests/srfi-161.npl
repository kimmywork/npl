(import (scheme base)
        (scheme write)
        (scheme process-context)
        (npl data unifiable-box)
        (prefix (srfi 161) s161:))

(include "framework.npl")

(define (main)
  (define a (ubox 1))
  (define b (ubox 2))
  (define c (ubox 10))
  (test-identity "ubox?" (lambda () (ubox? a)) #t)
  (test-identity "ubox? rejects values" (lambda () (ubox? 42)) #f)
  (test-equal "ubox-ref" (lambda () (ubox-ref a)) 1)
  (test-identity "fresh boxes differ" (lambda () (ubox=? a b)) #f)
  (ubox-link! a b)
  (test-identity "link unifies" (lambda () (ubox=? a b)) #t)
  (test-equal "link keeps right value" (lambda () (ubox-ref a)) 2)
  (ubox-set! a 7)
  (test-equal "set! updates the class" (lambda () (ubox-ref b)) 7)
  (ubox-unify! + a c)
  (test-identity "unify unifies" (lambda () (ubox=? a c)) #t)
  (test-equal "unify combines values" (lambda () (ubox-ref c)) 17)
  (test-identity "srfi 161 alias"
                 (lambda () (s161:ubox=? (s161:ubox 1) (s161:ubox 2)))
                 #f)
  (finish-tests "srfi-161"))
(main)
