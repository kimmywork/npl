(include "framework.npl")

(define saved-parameter-continuation #f)
(define parameter-phase 0)
(define parameter-log 0)

(define (log-parameter digit value)
  (set! parameter-log (+ (* parameter-log 10) digit))
  value)

(define (parameter-continuation-reentry parameter)
  (set! parameter-phase 0)
  (let ((result
          (parameterize ((parameter 10))
            (let ((value
                    (call/cc
                      (lambda (continuation)
                        (set! saved-parameter-continuation continuation)
                        0))))
              (if (= parameter-phase 0)
                  (begin
                    (parameter 41)
                    (set! parameter-phase 1)
                    10)
                  (+ (parameter) value))))))
    (if (= parameter-phase 1)
        (begin
          (set! parameter-phase 2)
          (saved-parameter-continuation 1))
        result)))

(define (main)
  (test-equal "default value"
              (lambda ()
                (let ((parameter (make-parameter 42)))
                  (parameter)))
              42)
  (test-equal "default assignment"
              (lambda ()
                (let ((parameter (make-parameter 0)))
                  (parameter 42)
                  (parameter)))
              42)
  (test-equal "initial converter"
              (lambda ()
                (let ((parameter
                        (make-parameter 20 (lambda (value) (+ value 22)))))
                  (parameter)))
              42)
  (test-equal "assignment converter"
              (lambda ()
                (let ((parameter
                        (make-parameter 0 (lambda (value) (+ value 1)))))
                  (parameter 41)
                  (parameter)))
              42)
  (test-equal "dynamic restoration"
              (lambda ()
                (let ((parameter (make-parameter 1)))
                  (+ (parameterize ((parameter 41)) (parameter))
                     (parameter))))
              42)
  (test-equal "nested parameterization"
              (lambda ()
                (let ((parameter (make-parameter 0)))
                  (+ (parameterize ((parameter 20))
                       (+ (parameter)
                          (parameterize ((parameter 2)) (parameter))))
                     (parameter))))
              22)
  (test-equal "all bindings evaluated before conversion"
              (lambda ()
                (set! parameter-log 0)
                (let ((left
                        (make-parameter 0
                          (lambda (value) (log-parameter 5 value))))
                      (right
                        (make-parameter 0
                          (lambda (value) (log-parameter 6 value)))))
                  (set! parameter-log 0)
                  (parameterize
                    (((log-parameter 1 left) (log-parameter 2 20))
                     ((log-parameter 3 right) (log-parameter 4 22)))
                    (+ (left) (right)))
                  parameter-log))
              132456)
  (test-equal "continuation restores mutated binding"
              (lambda ()
                (parameter-continuation-reentry (make-parameter 0)))
              42)
  (test-equal "body multiple values"
              (lambda ()
                (let ((parameter (make-parameter 42)))
                  (call-with-values
                    (lambda ()
                      (parameterize ((parameter 1))
                        (values 20 22)))
                    (lambda (left right) (+ left right)))))
              42)
  (test-equal "empty parameterization"
              (lambda () (parameterize () 42))
              42)
  (finish-tests "parameters"))
(main)
