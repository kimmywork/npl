; Datum parsing, quotation, labels, and quasiquote normalization.

(define DATUM-LABELS (cell ()))
(define ACTIVE-DATUM-LABELS (cell ()))

;; Token kind 18 is a #; datum comment: the datum after it is skipped
;; wherever a token is examined (R7RS 2.2).
(define (peek-kind cur)
  (skip-datum-comments! cur)
  (car (car (car cur))))
(define (peek-payload cur) (cdr (car (car cur))))
(define (advance! cur) (set-car! cur (cdr (car cur))))

(define (skip-datum-comments! cur)
  (if (= (car (car (car cur))) 18)
      (begin
        (advance! cur)
        (let ((saved-labels (cell-get ACTIVE-DATUM-LABELS)))
          (parse-quote-datum cur)
          (cell-set! ACTIVE-DATUM-LABELS saved-labels))
        (skip-datum-comments! cur))))

(define (close-kind open)
  (if (= open 21) 22 2))

(define (expect-rparen cur what open)
  (if (= (peek-kind cur) (close-kind open))
      (advance! cur)
      (fatal (string-append "expected "
                            (if (= open 21) "]" ")")
                            " after " what))))

(define QUASIQUOTE-LEVEL (cell 0))
(define UNRESOLVED-DATUM (cons 110 ()))

(define (parse-raw-expr cur)
  (let ((kind (peek-kind cur)))
    (if (if (= kind 11) #t (= kind 12))
        (fatal "unquote outside quasiquote"))
    (parse-quote-datum cur)))

(define (parse-expr cur) (parse-raw-expr cur))

(define (active-datum-label? labels label)
  (if (null? labels)
      #f
      (if (= (car labels) label)
          #t
          (active-datum-label? (cdr labels) label))))

(define (datum-label-entry entries label)
  (if (null? entries)
      ()
      (if (= (car (car entries)) label)
          (car entries)
          (datum-label-entry (cdr entries) label))))

(define (datum-label-ref label)
  (if (if (> (cell-get QUASIQUOTE-LEVEL) 0)
          (active-datum-label? (cell-get ACTIVE-DATUM-LABELS) label)
          #f)
      (fatal "circular datum label in quasiquote"))
  (let ((entry (datum-label-entry (cell-get DATUM-LABELS) label)))
    (if (null? entry) (fatal "undefined datum label"))
    (if (eq? (cdr entry) UNRESOLVED-DATUM)
        (fatal "datum label cannot directly reference itself"))
    (cdr entry)))

(define (new-datum-placeholder kind)
  (case kind
    ((1 21) (cons 0 ()))
    ((14) (datum-vector ()))
    ((15) (datum-bytevector ()))
    (else UNRESOLVED-DATUM)))

(define (fill-datum-placeholder placeholder datum)
  (if (eq? placeholder UNRESOLVED-DATUM)
      datum
      (begin
        (set-car! placeholder (car datum))
        (set-cdr! placeholder (cdr datum))
        placeholder)))

(define (parse-datum-label cur label)
  (if (not (null? (datum-label-entry (cell-get DATUM-LABELS) label)))
      (fatal "duplicate datum label"))
  (advance! cur)
  (let ((placeholder (new-datum-placeholder (peek-kind cur))))
    (let ((entry (cons label placeholder)))
      (cell-set! DATUM-LABELS (cons entry (cell-get DATUM-LABELS)))
      (cell-set! ACTIVE-DATUM-LABELS
                 (cons label (cell-get ACTIVE-DATUM-LABELS)))
      (let ((datum (parse-quote-datum cur)))
        (cell-set! ACTIVE-DATUM-LABELS
                   (cdr (cell-get ACTIVE-DATUM-LABELS)))
        (let ((value (fill-datum-placeholder placeholder datum)))
          (set-cdr! entry value)
          value)))))

(define ARRAY-MAX-RANK 32)

(define (array-list-length items n)
  (if (null? items) n (array-list-length (cdr items) (+ n 1))))

(define (array-list-proper? items)
  (let loop ((slow items) (fast items))
    (cond ((null? fast) #t)
          ((not (pair? fast)) #f)
          ((null? (cdr fast)) #t)
          ((not (pair? (cdr fast))) #f)
          (else
           (let ((slow-next (cdr slow))
                 (fast-next (cdr (cdr fast))))
             (if (eq? slow-next fast-next)
                 #f
                 (loop slow-next fast-next)))))))

(define (array-tagged-datum? value)
  (if (not (pair? value))
      #f
      (let ((head (car value)))
        (if (eq? head DATUM-SYMBOL-TAG)
            #t
            (if (eq? head DATUM-KEYWORD-TAG)
                #t
                    (if (eq? head DATUM-STRING-TAG)
                        #t
                        (if (eq? head DATUM-CHAR-TAG)
                            #t
                            (if (eq? head DATUM-VECTOR-TAG)
                                #t
                                (if (eq? head DATUM-BYTEVECTOR-TAG)
                                    #t
                                    (if (eq? head DATUM-TRUE-TAG)
                                        #t
                                        (eq? head DATUM-FALSE-TAG)))))))))))

(define (array-zero-shape rank)
  (if (= rank 0) () (cons 0 (array-zero-shape (- rank 1)))))

(define (array-flat rank items flat)
  (if (not (array-list-proper? items))
      (fatal "array literal row is not a proper list")
      (if (= rank 1)
          (cons (cons (array-list-length items 0) ())
                (rev-into items flat))
          (let loop ((rows items) (shape #f) (count 0) (flat flat))
            (if (null? rows)
                (cons (cons count
                            (if shape shape
                                (array-zero-shape (- rank 1))))
                      flat)
                (let ((row (car rows)))
                  (if (not (if (pair? row) #t (null? row)))
                      (fatal "array literal row is not a list"))
                  (if (array-tagged-datum? row)
                      (fatal "array literal row is not a list"))
                  (let* ((sub (array-flat (- rank 1) row flat))
                         (sub-shape (car sub))
                         (sub-flat (cdr sub)))
                  (if (if shape
                          (not (number-list=? shape sub-shape))
                          #f)
                      (fatal "array literal rows differ in shape"))
                    (loop (cdr rows)
                          (if shape shape sub-shape)
                          (+ count 1)
                          sub-flat))))))))

(define (array-datum rank items)
  (if (< rank 1)
      (fatal "array literal rank must be at least 1")
      (if (> rank ARRAY-MAX-RANK)
          (fatal "array literal rank is too large")
          (let* ((data (array-flat rank items ()))
                 (shape (car data))
                 (flat (rev (cdr data))))
            (if (= rank 1)
                (datum-vector flat)
                (datum-vector
                 (cons (datum-symbol "npl-array-literal-5f8d")
                       (cons (datum-vector shape)
                             (cons (datum-vector flat) ())))))))))

(define (curly-length items n)
  (if (null? items) n (curly-length (cdr items) (+ n 1))))

(define (curly-equal? left right)
  (cond
    ((if (number? left) (number? right) #f) (= left right))
    ((if (datum-symbol? left) (datum-symbol? right) #f)
     (string=? (datum-symbol-name left) (datum-symbol-name right)))
    ((if (datum-keyword? left) (datum-keyword? right) #f)
     (string=? (datum-keyword-name left) (datum-keyword-name right)))
    ((if (datum-string? left) (datum-string? right) #f)
     (string=? (datum-string-text left) (datum-string-text right)))
    ((if (datum-char? left) (datum-char? right) #f)
     (= (datum-char-code left) (datum-char-code right)))
    ((if (datum-true? left) (datum-true? right) #f) #t)
    ((if (datum-false? left) (datum-false? right) #f) #t)
    ((if (pair? left) (pair? right) #f)
     (if (curly-equal? (car left) (car right))
         (curly-equal? (cdr left) (cdr right))
         #f))
    ((if (datum-vector? left) (datum-vector? right) #f)
     (curly-equal? (datum-vector-items left) (datum-vector-items right)))
    (else #f)))

(define (curly-operands items out)
  (if (null? items)
      (rev out)
      (let ((rest (cdr items)))
        (if (null? rest)
            (rev (cons (car items) out))
            (curly-operands (cdr rest) (cons (car items) out))))))

(define (curly-map items)
  (let ((count (curly-length items 0)))
    (cond
      ((= count 0) ())
      ((= count 1) (car items))
      ((= count 2) (cons (car items) (cons (car (cdr items)) ())))
      ((= 0 (npl_number_remainder count 2))
       (cons (datum-symbol "$nfx$") items))
      (else
       (let ((operator (car (cdr items)))
             (rest (cdr (cdr items))))
         (let loop ((rest rest))
           (if (null? rest)
               (cons operator (curly-operands items ()))
               (let ((next (cdr rest)))
                 (if (null? next)
                     (cons operator (curly-operands items ()))
                     (if (curly-equal? operator (car next))
                         (loop (cdr next))
                         (cons (datum-symbol "$nfx$") items)))))))))))

(define (curly-items cur acc)
  (if (= (peek-kind cur) 25)
      (begin (advance! cur) (rev acc))
      (if (= (peek-kind cur) 7)
          (fatal "unexpected end of input in curly-infix list")
          (curly-items cur (cons (parse-quote-datum cur) acc)))))

(define (parse-curly-datum cur)
  (advance! cur)
  (curly-map (curly-items cur ())))

(define (parse-quote-datum cur)
  (let ((k (peek-kind cur)))
    (case k
      ((5) (let ((v (peek-payload cur))) (advance! cur) v))
      ((7) (fatal "unexpected end of input"))
      ((2) (fatal "unexpected )"))
      ((22) (fatal "unexpected ]"))
      ((4 19) (let ((nm (peek-payload cur)))
                (advance! cur)
                (datum-symbol nm)))
      ((23) (let ((nm (peek-payload cur)))
              (advance! cur)
              (datum-keyword nm)))
      ((6) (let ((tx (peek-payload cur)))
             (advance! cur)
             (datum-string tx)))
      ((8) (begin (advance! cur) (datum-true)))
      ((9) (begin (advance! cur) (datum-false)))
      ((3) (parse-datum-abbreviation cur "quote"))
      ((10) (parse-quasiquote-abbreviation cur))
      ((11) (parse-datum-abbreviation cur "unquote"))
      ((12) (parse-datum-abbreviation cur "unquote-splicing"))
      ((13) (let ((code (peek-payload cur)))
              (advance! cur)
              (datum-char code)))
      ((14) (begin (advance! cur) (datum-vector (datum-items cur 1))))
      ((15) (begin (advance! cur) (datum-bytevector (datum-items cur 1))))
      ((20) (let ((rank (peek-payload cur)))
              (advance! cur)
              (if (= (peek-kind cur) 1)
                  (begin
                    (advance! cur)
                    (array-datum rank (datum-items cur 1)))
                  (fatal "array literal requires (...)"))))
      ((16) (parse-datum-label cur (peek-payload cur)))
      ((17) (let ((label (peek-payload cur)))
              (advance! cur)
              (datum-label-ref label)))
      ((1) (begin (advance! cur) (datum-items cur 1)))
      ((21) (begin (advance! cur) (datum-items cur 21)))
      ((24) (parse-curly-datum cur))
      ((25) (fatal "unexpected }"))
      (else (fatal "bad quoted datum")))))

(define (parse-quasiquote-abbreviation cur)
  (cell-set! QUASIQUOTE-LEVEL (+ 1 (cell-get QUASIQUOTE-LEVEL)))
  (let ((value (parse-datum-abbreviation cur "quasiquote")))
    (cell-set! QUASIQUOTE-LEVEL (- (cell-get QUASIQUOTE-LEVEL) 1))
    value))

(define (parse-datum-abbreviation cur name)
  (advance! cur)
  (cons (datum-symbol name)
        (cons (parse-quote-datum cur) ())))

(define (dot-token? cur)
  (if (= (peek-kind cur) 4)
      (string=? (peek-payload cur) ".")
      #f))

(define (datum-items cur open)
  (if (= (peek-kind cur) (close-kind open))
      (begin (advance! cur) ())
      (if (dot-token? cur)
          (begin
            (advance! cur)
            (let ((tail (parse-quote-datum cur)))
              (expect-rparen cur "dotted datum" open)
              tail))
          (cons (parse-quote-datum cur) (datum-items cur open)))))
