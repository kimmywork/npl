; Datum parsing, quotation, labels, and quasiquote normalization.

(define DATUM-LABELS (cell ()))
(define ACTIVE-DATUM-LABELS (cell ()))

;; Token kind 18 is a #; datum comment: the datum after it is skipped
;; wherever a token is examined (R7RS 2.2).
(define (peek-kind cur)
  (skip-datum-comments! cur)
  (car (car (car cur))))
(define (peek-payload cur) (cdr (car (car cur))))
(define (advance! cur) (set-car! cur (cdr (car cur))))

(define (skip-datum-comments! cur)
  (if (= (car (car (car cur))) 18)
      (begin
        (advance! cur)
        (let ((saved-labels (cell-get ACTIVE-DATUM-LABELS)))
          (parse-quote-datum cur)
          (cell-set! ACTIVE-DATUM-LABELS saved-labels))
        (skip-datum-comments! cur))))

(define (expect-rparen cur what)
  (if (= (peek-kind cur) 2) (advance! cur) (fatal (string-append "expected ) after " what))))

(define QUASIQUOTE-LEVEL (cell 0))
(define UNRESOLVED-DATUM (cons 110 ()))

(define (parse-raw-expr cur)
  (let ((kind (peek-kind cur)))
    (if (if (= kind 11) #t (= kind 12))
        (fatal "unquote outside quasiquote"))
    (parse-quote-datum cur)))

(define (parse-expr cur) (parse-raw-expr cur))

(define (active-datum-label? labels label)
  (if (null? labels)
      #f
      (if (= (car labels) label)
          #t
          (active-datum-label? (cdr labels) label))))

(define (datum-label-entry entries label)
  (if (null? entries)
      ()
      (if (= (car (car entries)) label)
          (car entries)
          (datum-label-entry (cdr entries) label))))

(define (datum-label-ref label)
  (if (if (> (cell-get QUASIQUOTE-LEVEL) 0)
          (active-datum-label? (cell-get ACTIVE-DATUM-LABELS) label)
          #f)
      (fatal "circular datum label in quasiquote"))
  (let ((entry (datum-label-entry (cell-get DATUM-LABELS) label)))
    (if (null? entry) (fatal "undefined datum label"))
    (if (eq? (cdr entry) UNRESOLVED-DATUM)
        (fatal "datum label cannot directly reference itself"))
    (cdr entry)))

(define (new-datum-placeholder kind)
  (case kind
    ((1) (cons 0 ()))
    ((14) (datum-vector ()))
    ((15) (datum-bytevector ()))
    (else UNRESOLVED-DATUM)))

(define (fill-datum-placeholder placeholder datum)
  (if (eq? placeholder UNRESOLVED-DATUM)
      datum
      (begin
        (set-car! placeholder (car datum))
        (set-cdr! placeholder (cdr datum))
        placeholder)))

(define (parse-datum-label cur label)
  (if (not (null? (datum-label-entry (cell-get DATUM-LABELS) label)))
      (fatal "duplicate datum label"))
  (advance! cur)
  (let ((placeholder (new-datum-placeholder (peek-kind cur))))
    (let ((entry (cons label placeholder)))
      (cell-set! DATUM-LABELS (cons entry (cell-get DATUM-LABELS)))
      (cell-set! ACTIVE-DATUM-LABELS
                 (cons label (cell-get ACTIVE-DATUM-LABELS)))
      (let ((datum (parse-quote-datum cur)))
        (cell-set! ACTIVE-DATUM-LABELS
                   (cdr (cell-get ACTIVE-DATUM-LABELS)))
        (let ((value (fill-datum-placeholder placeholder datum)))
          (set-cdr! entry value)
          value)))))

(define (array-list-length items n)
  (if (null? items) n (array-list-length (cdr items) (+ n 1))))

(define (array-shape-equal left right)
  (cond ((null? left) (null? right))
        ((null? right) #f)
        ((= (car left) (car right))
         (array-shape-equal (cdr left) (cdr right)))
        (else #f)))

(define (array-zero-shape rank)
  (if (= rank 0) () (cons 0 (array-zero-shape (- rank 1)))))

(define (array-append left right)
  (if (null? left) right (cons (car left) (array-append (cdr left) right))))

(define (array-flat rank items)
  (if (= rank 1)
      (cons (cons (array-list-length items 0) ()) items)
      (let loop ((rows items) (shape #f) (flat ()) (count 0))
        (if (null? rows)
            (cons (cons count
                        (if shape shape (array-zero-shape (- rank 1))))
                  flat)
            (let ((row (car rows)))
              (if (not (if (pair? row) #t (null? row)))
                  (fatal "array literal row is not a list"))
              (let* ((sub (array-flat (- rank 1) row))
                     (sub-shape (car sub))
                     (sub-flat (cdr sub)))
                (if (if shape (not (array-shape-equal shape sub-shape)) #f)
                    (fatal "array literal rows differ in shape"))
                (loop (cdr rows)
                      (if shape shape sub-shape)
                      (array-append flat sub-flat)
                      (+ count 1))))))))

; #nA(...) reads as the vector [npl-array-tag shape flat-data]. Keeping the
; shape explicit lets ordinary vectors stay rank-1 arrays whose elements may
; themselves be vectors, and preserves zero-length dimensions.
(define (array-datum rank items)
  (if (< rank 1)
      (fatal "array literal rank must be at least 1")
      (let* ((data (array-flat rank items))
             (shape (car data))
             (flat (cdr data)))
        (datum-vector
         (cons (datum-symbol "npl-array-tag")
               (cons (datum-vector shape)
                     (cons (datum-vector flat) ())))))))

(define (parse-quote-datum cur)
  (let ((k (peek-kind cur)))
    (case k
      ((5) (let ((v (peek-payload cur))) (advance! cur) v))
      ((7) (fatal "unexpected end of input"))
      ((2) (fatal "unexpected )"))
      ((4 19) (let ((nm (peek-payload cur)))
                (advance! cur)
                (datum-symbol nm)))
      ((6) (let ((tx (peek-payload cur)))
             (advance! cur)
             (datum-string tx)))
      ((8) (begin (advance! cur) (datum-true)))
      ((9) (begin (advance! cur) (datum-false)))
      ((3) (parse-datum-abbreviation cur "quote"))
      ((10) (parse-quasiquote-abbreviation cur))
      ((11) (parse-datum-abbreviation cur "unquote"))
      ((12) (parse-datum-abbreviation cur "unquote-splicing"))
      ((13) (let ((code (peek-payload cur)))
              (advance! cur)
              (datum-char code)))
      ((14) (begin (advance! cur) (datum-vector (datum-items cur))))
      ((15) (begin (advance! cur) (datum-bytevector (datum-items cur))))
      ((20) (let ((rank (peek-payload cur)))
              (advance! cur)
              (if (= (peek-kind cur) 1)
                  (begin
                    (advance! cur)
                    (array-datum rank (datum-items cur)))
                  (fatal "array literal requires (...)"))))
      ((16) (parse-datum-label cur (peek-payload cur)))
      ((17) (let ((label (peek-payload cur)))
              (advance! cur)
              (datum-label-ref label)))
      ((1) (begin (advance! cur) (datum-items cur)))
      (else (fatal "bad quoted datum")))))

(define (parse-quasiquote-abbreviation cur)
  (cell-set! QUASIQUOTE-LEVEL (+ 1 (cell-get QUASIQUOTE-LEVEL)))
  (let ((value (parse-datum-abbreviation cur "quasiquote")))
    (cell-set! QUASIQUOTE-LEVEL (- (cell-get QUASIQUOTE-LEVEL) 1))
    value))

(define (parse-datum-abbreviation cur name)
  (advance! cur)
  (cons (datum-symbol name)
        (cons (parse-quote-datum cur) ())))

(define (dot-token? cur)
  (if (= (peek-kind cur) 4)
      (string=? (peek-payload cur) ".")
      #f))

(define (datum-items cur)
  (if (= (peek-kind cur) 2)
      (begin (advance! cur) ())
      (if (dot-token? cur)
          (begin
            (advance! cur)
            (let ((tail (parse-quote-datum cur)))
              (expect-rparen cur "dotted datum")
              tail))
          (cons (parse-quote-datum cur) (datum-items cur)))))
