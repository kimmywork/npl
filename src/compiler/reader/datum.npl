; Datum parsing, quotation, labels, and quasiquote normalization.

(define (peek-kind cur) (car (car (car cur))))
(define (peek-payload cur) (cdr (car (car cur))))
(define (advance! cur) (set-car! cur (cdr (car cur))))

(define (expect-rparen cur what)
  (if (= (peek-kind cur) 2) (advance! cur) (fatal (string-append "expected ) after " what))))

(define (parse-expr cur)
  (let ((k (peek-kind cur)))
    (case k
      ((5) (let ((v (peek-payload cur))) (advance! cur) v))
      ((7) (fatal "unexpected end of input"))
      ((2) (fatal "unexpected )"))
      ((8) (begin (advance! cur) (cons 108 ())))
      ((9) (begin (advance! cur) (cons 109 ())))
      ((10) (begin (advance! cur) (parse-quasiquote cur)))
      ((11 12) (fatal "unquote outside quasiquote"))
      ((13) (let ((code (peek-payload cur)))
              (advance! cur)
              (cons 102 code)))
      ((14) (begin (advance! cur)
                   (cons 103 (cons (datum-items cur) ()))))
      ((15) (begin (advance! cur)
                   (cons 104 (cons (datum-items cur) ()))))
      ((4) (let ((nm (peek-payload cur)))
             (advance! cur)
             (cons 100 nm)))
      ((6) (let ((tx (peek-payload cur)))
             (advance! cur)
             (cons 101 tx)))
      ((3) (begin (advance! cur)
                  (cons 204 (cons (parse-quote-datum cur) ()))))
      (else (parse-list-form cur)))))

(define DATUM-LABELS (cell ()))
(define ACTIVE-DATUM-LABELS (cell ()))
(define QUASIQUOTE-LEVEL (cell 0))
(define UNRESOLVED-DATUM (cons 110 ()))

(define (active-datum-label? labels label)
  (if (null? labels)
      #f
      (if (= (car labels) label)
          #t
          (active-datum-label? (cdr labels) label))))

(define (datum-label-entry entries label)
  (if (null? entries)
      ()
      (if (= (car (car entries)) label)
          (car entries)
          (datum-label-entry (cdr entries) label))))

(define (datum-label-ref label)
  (if (if (> (cell-get QUASIQUOTE-LEVEL) 0)
          (active-datum-label? (cell-get ACTIVE-DATUM-LABELS) label)
          #f)
      (fatal "circular datum label in quasiquote"))
  (let ((entry (datum-label-entry (cell-get DATUM-LABELS) label)))
    (if (null? entry) (fatal "undefined datum label"))
    (if (eq? (cdr entry) UNRESOLVED-DATUM)
        (fatal "datum label cannot directly reference itself"))
    (cdr entry)))

(define (new-datum-placeholder kind)
  (case kind
    ((1) (cons 0 ()))
    ((14) (cons 103 (cons () ())))
    ((15) (cons 104 (cons () ())))
    (else UNRESOLVED-DATUM)))

(define (fill-datum-placeholder placeholder datum)
  (if (eq? placeholder UNRESOLVED-DATUM)
      datum
      (begin
        (set-car! placeholder (car datum))
        (set-cdr! placeholder (cdr datum))
        placeholder)))

(define (parse-datum-label cur label)
  (if (not (null? (datum-label-entry (cell-get DATUM-LABELS) label)))
      (fatal "duplicate datum label"))
  (advance! cur)
  (let ((placeholder (new-datum-placeholder (peek-kind cur))))
    (let ((entry (cons label placeholder)))
      (cell-set! DATUM-LABELS (cons entry (cell-get DATUM-LABELS)))
      (cell-set! ACTIVE-DATUM-LABELS
                 (cons label (cell-get ACTIVE-DATUM-LABELS)))
      (let ((datum (parse-quote-datum cur)))
        (cell-set! ACTIVE-DATUM-LABELS
                   (cdr (cell-get ACTIVE-DATUM-LABELS)))
        (let ((value (fill-datum-placeholder placeholder datum)))
          (set-cdr! entry value)
          value)))))

(define (parse-quote-datum cur)
  (let ((k (peek-kind cur)))
    (case k
      ((5) (let ((v (peek-payload cur))) (advance! cur) v))
      ((4) (let ((nm (peek-payload cur)))
             (advance! cur)
             (cons 100 nm)))
      ((6) (let ((tx (peek-payload cur)))
             (advance! cur)
             (cons 101 tx)))
      ((8) (begin (advance! cur) (cons 106 ())))
      ((9) (begin (advance! cur) (cons 107 ())))
      ((3) (parse-datum-abbreviation cur "quote"))
      ((10) (parse-datum-abbreviation cur "quasiquote"))
      ((11) (parse-datum-abbreviation cur "unquote"))
      ((12) (parse-datum-abbreviation cur "unquote-splicing"))
      ((13) (let ((code (peek-payload cur)))
              (advance! cur)
              (cons 102 code)))
      ((14) (begin (advance! cur)
                   (cons 103 (cons (datum-items cur) ()))))
      ((15) (begin (advance! cur)
                   (cons 104 (cons (datum-items cur) ()))))
      ((16) (parse-datum-label cur (peek-payload cur)))
      ((17) (let ((label (peek-payload cur)))
              (advance! cur)
              (datum-label-ref label)))
      ((1) (begin (advance! cur) (datum-items cur)))
      (else (fatal "bad quoted datum")))))

(define (parse-datum-abbreviation cur name)
  (advance! cur)
  (cons (cons 100 name)
        (cons (parse-quote-datum cur) ())))

(define (dot-token? cur)
  (if (= (peek-kind cur) 4)
      (string=? (peek-payload cur) ".")
      #f))

(define (datum-items cur)
  (if (= (peek-kind cur) 2)
      (begin (advance! cur) ())
      (if (dot-token? cur)
          (begin
            (advance! cur)
            (let ((tail (parse-quote-datum cur)))
              (expect-rparen cur "dotted datum")
              tail))
          (cons (parse-quote-datum cur) (datum-items cur)))))

(define (call-node name args)
  (cons (cons 100 name) args))

(define (quote-node datum)
  (cons 204 (cons datum ())))

(define (splice-node? value)
  (if (pair-shape? value)
      (if (number? (car value)) (= (car value) 105) #f)
      #f))

(define (qq-keyword name content)
  (call-node "cons"
    (cons (quote-node (cons 100 name))
      (cons (call-node "cons"
              (cons content (cons (quote-node ()) ())))
            ()))))

(define (qq-special-list cur depth name)
  (let ((content
          (cond
            ((string=? name "quasiquote")
             (qq-keyword name (parse-quasiquote-depth cur (+ depth 1))))
            ((string=? name "unquote")
             (if (= depth 1)
                 (parse-expr cur)
                 (qq-keyword name (parse-quasiquote-depth cur (- depth 1)))))
            (else
             (if (= depth 1)
                 (cons 105 (cons (parse-expr cur) ()))
                 (qq-keyword name (parse-quasiquote-depth cur (- depth 1))))))))
    (expect-rparen cur name)
    content))

(define (qq-head-name cur)
  (if (= (peek-kind cur) 4)
      (let ((name (peek-payload cur)))
        (if (or2 (string=? name "quasiquote")
                 (or2 (string=? name "unquote")
                      (string=? name "unquote-splicing")))
            name
            ""))
      ""))

(define (parse-quasiquote-list cur depth)
  (advance! cur)
  (let ((special (qq-head-name cur)))
    (if (> (string-length special) 0)
        (begin
          (advance! cur)
          (qq-special-list cur depth special))
        (quasiquote-items cur depth))))

(define (parse-quasiquote cur)
  (cell-set! QUASIQUOTE-LEVEL (+ 1 (cell-get QUASIQUOTE-LEVEL)))
  (let ((value (parse-quasiquote-depth cur 1)))
    (cell-set! QUASIQUOTE-LEVEL (- (cell-get QUASIQUOTE-LEVEL) 1))
    value))

(define (parse-quasiquote-depth cur depth)
  (let ((kind (peek-kind cur)))
    (case kind
      ((10)
       (begin
         (advance! cur)
         (qq-keyword "quasiquote"
                     (parse-quasiquote-depth cur (+ depth 1)))))
      ((11)
       (begin
         (advance! cur)
         (if (= depth 1)
             (parse-expr cur)
             (qq-keyword "unquote"
                         (parse-quasiquote-depth cur (- depth 1))))))
      ((12)
       (begin
         (advance! cur)
         (if (= depth 1)
             (cons 105 (cons (parse-expr cur) ()))
             (qq-keyword "unquote-splicing"
                         (parse-quasiquote-depth cur (- depth 1))))))
      ((1) (parse-quasiquote-list cur depth))
      ((14)
       (begin
         (advance! cur)
         (call-node "list->vector"
                    (cons (quasiquote-items cur depth) ()))))
      (else (quote-node (parse-quote-datum cur))))))

(define (quasiquote-items cur depth)
  (if (= (peek-kind cur) 2)
      (begin (advance! cur) (quote-node ()))
      (if (dot-token? cur)
          (begin
            (advance! cur)
            (let ((tail (parse-quasiquote-depth cur depth)))
              (if (splice-node? tail)
                  (fatal "unquote-splicing in dotted tail"))
              (expect-rparen cur "dotted quasiquote")
              tail))
          (let ((item (parse-quasiquote-depth cur depth)))
            (let ((rest (quasiquote-items cur depth)))
              (if (splice-node? item)
                  (call-node "append" (cons (car (cdr item)) (cons rest ())))
                  (call-node "cons" (cons item (cons rest ())))))))))
