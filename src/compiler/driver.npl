; Unified nplc command line: options, tool and library resolution, and the
; ssa -> asm -> obj/exe stage pipeline. SSA emission itself is program.npl.
;
; SSA to standard output is emitted in-process (this is the relay path). Any
; file-producing build re-runs this executable with --emit=ssa redirected into
; a temporary file, so a failing compilation (which exits) cannot leave the
; driver's temporary directory or a partial output behind.

(define DRIVER-USAGE
"usage: nplc [options] <source.npl>

Output kinds (default exe):
  --emit=ssa        QBE SSA (standard output unless -o is given)
  --emit=asm, -S    assembly
  --emit=obj, -c    object file
  --emit=exe        executable
  --emit-qbe        same as --emit=ssa
  --emit=c-stubs    C stubs for define-c-function (standard output unless -o)
  --emit=c-structs  define-c-struct layout cache (standard output unless -o)
  --emit=staticlib, --emit=dylib are reserved and not yet supported

Options:
  -o PATH           output path (default: derived from the source name)
  --keep-temps      keep intermediate files and report their directory
  --stdlib-root DIR standard library root   (env NPL_STDLIB_ROOT)
  --qbe PATH        QBE executable          (env NPL_QBE)
  --cc PATH         C compiler and linker   (env NPL_CC, then CC)
  --runtime PATH    runtime archive         (env NPL_RUNTIME)
                    npl.h for C stubs: env NPL_INCLUDE, else the layout
  -l NAME, -lNAME   link library NAME into the executable
  -L DIR, -LDIR     search DIR for -l libraries
  --native=MODE     native packages: static (default) or shared
                    (env NPL_NATIVE_LINK)
  -h, --help        show this help
  --version         show the NPL release version
")

; Configuration slots.
(define DRIVER-KIND 0)
(define DRIVER-OUTPUT 1)
(define DRIVER-SOURCE 2)
(define DRIVER-STDLIB 3)
(define DRIVER-QBE 4)
(define DRIVER-CC 5)
(define DRIVER-RUNTIME 6)
(define DRIVER-KEEP 7)
; Linker arguments (-lNAME, -LDIR), most recent first.
(define DRIVER-LINK 8)
; Internal (--c-stubs-file PATH): the SSA child run also writes the
; define-c-function stubs there, so a build expands the program once.
(define DRIVER-STUBS 9)
(define DRIVER-NATIVE 10)
; Internal (--native-packages-file PATH): the SSA child run records the
; native-package declarations of the expanded program.
(define DRIVER-PACKAGES 11)

; DRIVER-NATIVE is #f until --native is seen or the environment supplies the
; mode; a literal default would hide NPL_NATIVE_LINK.
(define (driver-config)
  (vector "exe" #f #f #f #f #f #f #f () #f #f #f))
(define (driver-get config slot) (vector-ref config slot))
(define (driver-set! config slot value) (vector-set! config slot value))

(define (driver-message text)
  (display "nplc: " (current-error-port))
  (display text (current-error-port))
  (newline (current-error-port)))

(define (driver-error text)
  (driver-message text)
  (exit 2))

(define (driver-prefix? prefix text)
  (if (< (string-length text) (string-length prefix))
      #f
      (string=? prefix (substring text 0 (string-length prefix)))))

(define DRIVER-KINDS '("exe" "obj" "asm" "ssa" "c-stubs" "c-structs"))
(define DRIVER-RESERVED-KINDS '("staticlib" "dylib"))

; Single predicate tests: control conversion copies an if's continuation
; into both branches, so compound tests and non-tail ifs would duplicate
; the rest of each procedure (frontend/c-primitives.npl).
(define (driver-listed? text items)
  (cond
    ((null? items) #f)
    ((string=? text (car items)) #t)
    (else (driver-listed? text (cdr items)))))

(define (driver-set-kind! config kind)
  (cond
    ((driver-listed? kind DRIVER-KINDS)
     (driver-set! config DRIVER-KIND kind))
    ((driver-listed? kind DRIVER-RESERVED-KINDS)
     (driver-error
       (string-append "--emit=" kind
                      " is not yet supported (see docs/toolchain.md)")))
    (else (driver-error (string-append "unknown output kind: " kind)))))

(define (driver-check-native-mode mode)
  (if (if (string=? mode "static") #t (string=? mode "shared"))
      mode
      (driver-error (string-append "unknown native link mode: " mode))))

(define (driver-set-native-mode! config mode)
  (driver-set! config DRIVER-NATIVE (driver-check-native-mode mode)))

(define (driver-native-mode config)
  (let ((explicit (driver-get config DRIVER-NATIVE)))
    (if explicit
        explicit
        (let ((environment (get-environment-variable "NPL_NATIVE_LINK")))
          (if (if environment (> (string-length environment) 0) #f)
              (driver-check-native-mode environment)
              "static")))))

(define (driver-value option rest)
  (if (null? rest)
      (driver-error (string-append option " needs a value"))
      (car rest)))

; -l and -L take their value attached (-lm) or as the next argument (-l m).
(define (driver-link-option? argument)
  (if (driver-prefix? "-l" argument) #t (driver-prefix? "-L" argument)))

(define (driver-add-link! config argument rest)
  (let ((attached (> (string-length argument) 2)))
    (driver-set! config DRIVER-LINK
      (cons (if attached argument
                (string-append argument (driver-value argument rest)))
            (driver-get config DRIVER-LINK)))
    (if attached rest (cdr rest))))

(define (driver-parse! config arguments)
  (if (null? arguments)
      config
      (let ((argument (car arguments))
            (rest (cdr arguments)))
        (cond
          ((string=? argument "--version")
           (display "nplc ")
           (display NPL-VERSION)
           (newline)
           (exit 0))
          ((if (string=? argument "-h") #t (string=? argument "--help"))
           (display DRIVER-USAGE)
           (exit 0))
          ((string=? argument "--emit-qbe")
           (driver-set-kind! config "ssa")
           (driver-parse! config rest))
          ((string=? argument "-S")
           (driver-set-kind! config "asm")
           (driver-parse! config rest))
          ((string=? argument "-c")
           (driver-set-kind! config "obj")
           (driver-parse! config rest))
          ((driver-prefix? "--emit=" argument)
           (driver-set-kind! config
             (substring argument 7 (string-length argument)))
           (driver-parse! config rest))
          ((string=? argument "--keep-temps")
           (driver-set! config DRIVER-KEEP #t)
           (driver-parse! config rest))
          ((string=? argument "-o")
           (driver-set! config DRIVER-OUTPUT (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((string=? argument "--stdlib-root")
           (driver-set! config DRIVER-STDLIB (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((string=? argument "--qbe")
           (driver-set! config DRIVER-QBE (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((string=? argument "--cc")
           (driver-set! config DRIVER-CC (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((string=? argument "--runtime")
           (driver-set! config DRIVER-RUNTIME (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((string=? argument "--c-stubs-file")
           (driver-set! config DRIVER-STUBS (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((string=? argument "--native-packages-file")
           (driver-set! config DRIVER-PACKAGES (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((driver-prefix? "--native=" argument)
           (driver-set-native-mode! config
             (substring argument 9 (string-length argument)))
           (driver-parse! config rest))
          ((string=? argument "--native")
           (driver-set-native-mode! config (driver-value argument rest))
           (driver-parse! config (cdr rest)))
          ((driver-link-option? argument)
           (driver-parse! config (driver-add-link! config argument rest)))
          ((if (driver-prefix? "-" argument)
               (> (string-length argument) 1) #f)
           (driver-error (string-append "unknown option " argument)))
          ((driver-get config DRIVER-SOURCE)
           (driver-error "multiple source files are not supported"))
          (else
           (driver-set! config DRIVER-SOURCE argument)
           (driver-parse! config rest))))))

; ---------------- tool and library resolution ----------------

(define (driver-environment name)
  (let ((value (get-environment-variable name)))
    (if (if value (> (string-length value) 0) #f) value #f)))

; Installation layout relative to <prefix>/bin/nplc; #f when unknown.
(define (driver-layout relative)
  (let ((self (executable-path)))
    (if self
        (let ((candidate (string-append (path-dir self) "../" relative)))
          (if (file-exists? candidate) candidate #f))
        #f)))

; Explicit option, then environment, then the installation layout.
(define (driver-resolve config slot variable relative)
  (let ((explicit (driver-get config slot)))
    (if explicit
        explicit
        (let ((environment (driver-environment variable)))
          (if environment
              environment
              (if relative (driver-layout relative) #f))))))

(define (driver-stdlib config)
  (let ((root (driver-resolve config DRIVER-STDLIB
                              "NPL_STDLIB_ROOT" "share/npl/lib")))
    (if root root "lib/")))

(define (driver-qbe config)
  (let ((qbe (driver-resolve config DRIVER-QBE "NPL_QBE" "libexec/npl/qbe")))
    (if qbe qbe "qbe")))

(define (driver-cc config)
  (let ((cc (driver-resolve config DRIVER-CC "NPL_CC" #f)))
    (if cc cc (let ((fallback (driver-environment "CC")))
                (if fallback fallback "cc")))))

; Directory of npl.h for compiling define-c-function stubs: NPL_INCLUDE,
; then the install layout (the build tree mirrors it).
(define (driver-include config)
  (let ((environment (driver-environment "NPL_INCLUDE")))
    (if environment
        environment
        (let ((layout (driver-layout "include/npl/npl.h")))
          (if layout
              (path-dir layout)
              (driver-error
                "npl.h not found; set NPL_INCLUDE to its directory"))))))

(define (driver-runtime config)
  (let ((runtime (driver-resolve config DRIVER-RUNTIME "NPL_RUNTIME"
                                 "lib/npl/libnpl_runtime.a")))
    (if runtime
        runtime
        (driver-error
          "runtime archive not found; use --runtime or NPL_RUNTIME"))))

; ---------------- output naming ----------------

(define (driver-base-name path)
  (let ((directory (path-dir path)))
    (substring path (string-length directory) (string-length path))))

(define (driver-stem path)
  (let ((name (driver-base-name path)))
    (let loop ((index (- (string-length name) 1)))
      (cond
        ((< index 1) name)
        ((= (string-byte-ref name index) 46) (substring name 0 index))
        (else (loop (- index 1)))))))

(define (driver-output config)
  (let ((explicit (driver-get config DRIVER-OUTPUT))
        (kind (driver-get config DRIVER-KIND))
        (stem (driver-stem (driver-get config DRIVER-SOURCE))))
    (cond
      (explicit explicit)
      ((string=? kind "asm") (string-append stem ".s"))
      ((string=? kind "obj") (string-append stem ".o"))
      (else stem))))

; ---------------- stage pipeline ----------------

(define (driver-delete-if-present path)
  (if (file-exists? path) (delete-file path) #f))

(define (driver-stage-failure stage status)
  (driver-message
    (string-append stage " failed (status " (number->string status) ")"))
  status)

(define (driver-self)
  (let ((self (executable-path)))
    (if self self (driver-error "cannot locate the nplc executable"))))

; Compiler diagnostics go to standard error; standard output is reserved for
; SSA. A failed child therefore needs no output relay, and a large partial
; SSA file can never bury the diagnostic.
(define (driver-emit-ssa config ssa stubs packages)
  (let ((status
          (run-process
            (cons (driver-self)
              (cons "--emit=ssa"
                (cons "--stdlib-root"
                  (cons (driver-stdlib config)
                    (cons "--native"
                      (cons (driver-native-mode config)
                        (cons "--c-stubs-file"
                          (cons stubs
                            (cons "--native-packages-file"
                              (cons packages
                                (cons (driver-get config DRIVER-SOURCE)
                                      ())))))))))))
            ssa)))
    (if (= status 0)
        0
        (driver-stage-failure "compile" status))))

(define (driver-compile-stubs config stubs object)
  (let ((status
          (run-process
            (cons (driver-cc config)
              (cons "-std=c99"
                (cons (string-append "-I" (driver-include config))
                  (cons "-c" (cons "-o" (cons object (cons stubs ())))))))
            #f)))
    (if (= status 0) 0 (driver-stage-failure "cc (c stubs)" status))))

; The stub object to link, () when the program declares no C functions
; (the SSA run wrote no stub file), or a failure status.
(define (driver-stub-objects config directory)
  (let ((stubs (string-append directory "/stubs.c"))
        (object (string-append directory "/stubs.o")))
    (if (file-exists? stubs)
        (let ((compiled (driver-compile-stubs config stubs object)))
          (if (= compiled 0) (cons object ()) compiled))
        ())))

(define (driver-assemble config ssa assembly)
  (let ((status
          (run-process
            (cons (driver-qbe config)
              (cons "-o" (cons assembly (cons ssa ()))))
            #f)))
    (if (= status 0) 0 (driver-stage-failure "qbe" status))))

(define (driver-object config assembly object)
  (let ((status
          (run-process
            (cons (driver-cc config)
              (cons "-c" (cons "-o" (cons object (cons assembly ())))))
            #f)))
    (if (= status 0) 0 (driver-stage-failure "cc" status))))

; Native packages are described by native.meta beside the runtime archive.
; nplc links only the packages the expanded program declared, in the artifact
; form selected by --native=static|shared.  core.meta is the fallback index
; for older installs and for the static core package names.
(define (driver-native-directory config)
  (let* ((runtime (driver-runtime config))
         (beside (string-append (path-dir runtime) "native"))
         (layout (string-append (path-dir runtime) "../lib/npl/native")))
    (if (if (file-exists? (string-append beside "/native.meta"))
            #t
            (file-exists? (string-append beside "/core.meta")))
        beside
        (if (if (file-exists? (string-append layout "/native.meta"))
                #t
                (file-exists? (string-append layout "/core.meta")))
            layout
            #f))))

(define (driver-runtime-shared config)
  (let ((explicit (driver-environment "NPL_RUNTIME_SHARED")))
    (if explicit explicit
        (let ((directory (path-dir (driver-runtime config))))
          (if (file-exists? (string-append directory "libnpl_runtime.dylib"))
              (string-append directory "libnpl_runtime.dylib")
              (if (file-exists? (string-append directory "libnpl_runtime.so"))
                  (string-append directory "libnpl_runtime.so")
                  (driver-error
                    "shared runtime not found; build npl_runtime_shared")))))))

(define (driver-native-meta-forms path)
  (let ((forms (parse-source-file path)))
    (if (null? forms)
        ()
        (let ((form (car forms)))
          (if (raw-form? form "native-packages")
              (cdr form)
              forms)))))

(define (driver-native-entries directory)
  (let ((path (string-append directory "/native.meta")))
    (if (file-exists? path)
        (let loop ((forms (driver-native-meta-forms path)) (entries ()))
          (if (null? forms)
              (rev entries)
              (let ((form (car forms)))
                (if (raw-form? form "native-package")
                    (let ((parts (cdr form)))
                      (if (not (= (raw-list-count parts 0) 5))
                          (driver-error "malformed native.meta entry"))
                      (let ((name (datum-string-text (car parts)))
                            (tier (car (cdr parts)))
                            (archive (datum-string-text (car (cdr (cdr parts)))))
                            (shared (datum-string-text
                                      (car (cdr (cdr (cdr parts))))))
                            (system (driver-native-system-list
                                      (car (cdr (cdr (cdr (cdr parts))))))))
                        (loop (cdr forms)
                              (cons (cons name
                                          (cons tier
                                                (cons archive
                                                      (cons shared
                                                            (cons system ())))))
                                    entries))))
                    (loop (cdr forms) entries)))))
        (let loop ((forms (parse-source-file
                            (string-append directory "/core.meta")))
                   (entries ()))
          (if (null? forms)
              (rev entries)
              (let ((form (car forms)))
                (if (raw-form? form "core-native")
                    (let ((name (datum-string-text (car (cdr form)))))
                      (loop (cdr forms)
                            (cons (cons name
                                        (cons 'core
                                              (cons (string-append "lib" name ".a")
                                                    (cons #f (cons () ())))))
                                  entries)))
                    (loop (cdr forms) entries))))))))

(define (driver-native-system-list values)
  (if (null? values)
      ()
      (if (not (datum-string? (car values)))
          (driver-error "native.meta system library must be a string")
          (cons (datum-string-text (car values))
                (driver-native-system-list (cdr values))))))

(define (driver-native-system-flags names)
  (if (null? names)
      ()
      (cons (string-append "-l" (car names))
            (driver-native-system-flags (cdr names)))))

(define (driver-native-system-args entry)
  (if entry
      (if (pair? (car (cdr (cdr (cdr (cdr entry))))))
          (driver-native-system-flags
            (car (cdr (cdr (cdr (cdr entry))))))
          ())
      ()))

(define (driver-native-entry name entries)
  (if (null? entries)
      #f
      (if (string=? name (car (car entries)))
          (car entries)
          (driver-native-entry name (cdr entries)))))

(define (driver-split-colon text)
  (let loop ((start 0) (index 0) (parts ()))
    (cond
      ((= index (string-length text))
       (rev (cons (substring text start index) parts)))
      ((= (string-byte-ref text index) 58)
       (loop (+ index 1) (+ index 1)
             (cons (substring text start index) parts)))
      (else (loop start (+ index 1) parts)))))

(define (driver-native-search-directories config)
  (let ((configured (get-environment-variable "NPL_NATIVE_PATH"))
        (primary (driver-native-directory config)))
    (append
      (if primary (cons primary ()) ())
      (if configured
          (let loop ((parts (driver-split-colon configured)) (out ()))
            (if (null? parts)
                (rev out)
                (loop (cdr parts)
                      (if (> (string-length (car parts)) 0)
                          (cons (car parts) out)
                          out))))
          ()))))

(define (driver-file-in-directories directories name)
  (if (null? directories)
      #f
      (let ((path (string-append (car directories) "/" name)))
        (if (file-exists? path)
            path
            (driver-file-in-directories (cdr directories) name)))))

(define (driver-native-static-name entry name)
  (if entry
      (car (cdr (cdr entry)))
      (string-append "lib" name ".a")))

(define (driver-native-shared-name entry name)
  (if entry
      (let ((shared (car (cdr (cdr (cdr entry))))))
        (if shared shared (string-append "lib" name ".dylib")))
      (string-append "lib" name ".dylib")))

(define (driver-native-static-file config entry name)
  (let ((file (driver-native-static-name entry name)))
    (let ((path (driver-file-in-directories
                  (driver-native-search-directories config) file)))
      (if path path
          (driver-error
            (string-append "native package " name
                           " has no static archive (" file ")"))))))

(define (driver-native-shared-file config entry name)
  (let ((directories (driver-native-search-directories config)))
    (let ((file (driver-native-shared-name entry name)))
      (let ((path (driver-file-in-directories directories file)))
        (if path path
            (if (string=? file (string-append "lib" name ".dylib"))
                (let ((fallback (driver-file-in-directories
                                  directories (string-append "lib" name ".so"))))
                  (if fallback fallback
                      (driver-error
                        (string-append "native package " name
                                       " has no shared object"))))
                (driver-error
                  (string-append "native package " name
                                 " has no shared object (" file ")"))))))))

(define (driver-native-package-names directory)
  (let ((path (string-append directory "/native-packages.meta")))
    (if (not (file-exists? path))
        ()
        (let loop ((forms (parse-source-file path)) (names ()))
          (if (null? forms)
              (rev names)
              (let ((form (car forms)))
                (if (raw-form? form "native-package")
                    (loop (cdr forms)
                          (cons (datum-string-text (car (cdr form))) names))
                    (loop (cdr forms) names))))))))

(define (driver-native-static-args config directory names entries)
  (if (null? names)
      ()
      (let ((entry (driver-native-entry (car names) entries)))
        (append
          (cons (driver-native-static-file config entry (car names))
                (driver-native-system-args entry))
          (driver-native-static-args config directory (cdr names) entries)))))

(define (driver-native-shared-args config names entries)
  (if (null? names)
      ()
      (let ((entry (driver-native-entry (car names) entries)))
        (append
          (cons (driver-native-shared-file config entry (car names))
                (driver-native-system-args entry))
          (driver-native-shared-args config (cdr names) entries)))))

(define (driver-native-rpath-args config)
  (let ((runtime (driver-runtime-shared config))
        (native (driver-native-directory config)))
    (let ((absolute
            (append
              (cons (path-dir runtime) ())
              (if native (cons native ()) ()))))
      (if (npl_platform_feature "darwin")
          (append
            (cons "-Wl,-rpath,@loader_path/../lib/npl"
              (cons "-Wl,-rpath,@loader_path/../lib/npl/native" ()))
            (let loop ((rest absolute) (out ()))
              (if (null? rest)
                  (rev out)
                  (loop (cdr rest)
                        (cons (string-append "-Wl,-rpath,"
                                             (car rest))
                              out)))))
          (append
            (cons "-Wl,-rpath,$ORIGIN/../lib/npl"
              (cons "-Wl,-rpath,$ORIGIN/../lib/npl/native" ()))
            (let loop ((rest absolute) (out ()))
              (if (null? rest)
                  (rev out)
                  (loop (cdr rest)
                        (cons (string-append "-Wl,-rpath,"
                                             (car rest))
                              out)))))))))

(define (driver-native-link-args config directory)
  (let ((mode (driver-native-mode config)))
    (let ((native (driver-native-directory config)))
      (let ((names (driver-native-package-names directory))
            (entries (if native (driver-native-entries native) ())))
        (if (string=? mode "shared")
            (append
              (driver-native-shared-args config names entries)
              (cons (driver-runtime-shared config)
                    (driver-native-rpath-args config)))
            (driver-native-static-args config directory names entries))))))

; User libraries precede the native packages and the runtime: native and
; shared objects may call into the runtime.  Static mode links the runtime
; archive; shared mode links the shared runtime plus package shared objects.
(define (driver-link-objects config directory assembly stubs executable)
  (let ((runtime (if (string=? (driver-native-mode config) "static")
                     (cons (driver-runtime config) ())
                     ()))
        ;; Native programs that evaluate libraries with define-c-primitive
        ;; need the runtime symbols in the executable's dynamic symbol table
        ;; on ELF; npli already links -rdynamic for the same reason.
        (extra (if (npl_platform_feature "darwin")
                   ()
                   (cons "-ldl" (cons "-rdynamic" ())))))
    (let ((status
            (run-process
              (cons (driver-cc config)
                (cons "-o" (cons executable
                  (cons assembly
                    (append stubs
                      (append
                        (rev-into (driver-get config DRIVER-LINK) ())
                        (append
                          (driver-native-link-args config directory)
                          (append runtime
                                  (append extra (cons "-lm" ()))))))))))
              #f)))
      (if (= status 0) 0 (driver-stage-failure "link" status)))))

(define (driver-link config directory assembly executable)
  (let ((stubs (driver-stub-objects config directory)))
    (if (number? stubs)
        stubs
        (driver-link-objects config directory assembly stubs executable))))

(define (driver-final-stage config directory kind assembly output)
  (cond
    ((string=? kind "obj") (driver-object config assembly output))
    ((string=? kind "exe") (driver-link config directory assembly output))
    (else 0)))

(define (driver-pipeline config directory output)
  (let ((kind (driver-get config DRIVER-KIND)))
    (let ((ssa (if (string=? kind "ssa")
                   output
                   (string-append directory "/source.ssa")))
          (assembly (if (string=? kind "asm")
                        output
                        (string-append directory "/source.s"))))
      (let ((emitted (driver-emit-ssa config ssa
                                      (string-append directory "/stubs.c")
                                      (string-append directory
                                                     "/native-packages.meta"))))
        (if (if (= emitted 0) (string=? kind "ssa") #t)
            emitted
            (let ((assembled (driver-assemble config ssa assembly)))
              (if (if (= assembled 0) (string=? kind "asm") #t)
                  assembled
                  (driver-final-stage config directory kind assembly
                                      output))))))))

(define (driver-cleanup config directory)
  (if (driver-get config DRIVER-KEEP)
      (driver-message (string-append "kept temporaries in " directory))
      (begin
        (driver-delete-if-present (string-append directory "/source.ssa"))
        (driver-delete-if-present (string-append directory "/source.s"))
        (driver-delete-if-present (string-append directory "/stubs.c"))
        (driver-delete-if-present (string-append directory "/stubs.o"))
        (driver-delete-if-present
          (string-append directory "/native-packages.meta"))
        (delete-directory directory))))

(define (driver-build config)
  (let ((output (driver-output config))
        (directory (make-temporary-directory)))
    (let ((status (driver-pipeline config directory output)))
      (driver-cleanup config directory)
      (if (not (= status 0)) (driver-delete-if-present output))
      status)))

; Expansion runs before the output is opened, so a compile error leaves no
; partial file.
(define (driver-c-stubs config)
  (library-set-standard-root! (driver-stdlib config))
  (native-package-set-link-mode! (driver-native-mode config))
  (expand-for-c-stubs (driver-get config DRIVER-SOURCE))
  (if (driver-get config DRIVER-OUTPUT)
      (let ((port (open-output-file (driver-get config DRIVER-OUTPUT))))
        (write-c-stubs port)
        (close-port port))
      (write-c-stubs (current-output-port)))
  0)

; Build and package cache: expand the program and its libraries, which probes
; every define-c-struct, then write the layouts for later imports to read.
(define (driver-c-structs config)
  (library-set-standard-root! (driver-stdlib config))
  (native-package-set-link-mode! (driver-native-mode config))
  (expand-for-c-stubs (driver-get config DRIVER-SOURCE))
  (if (driver-get config DRIVER-OUTPUT)
      (let ((port (open-output-file (driver-get config DRIVER-OUTPUT))))
        (write-c-struct-layouts port)
        (close-port port))
      (write-c-struct-layouts (current-output-port)))
  0)

(define (driver-ssa-to-stdout? config)
  (if (string=? (driver-get config DRIVER-KIND) "ssa")
      (not (driver-get config DRIVER-OUTPUT))
      #f))

; The SSA child run of a build also writes the stubs (--c-stubs-file).
(define (driver-write-requested-stubs config)
  (if (driver-get config DRIVER-STUBS)
      (begin (write-c-stubs-file (driver-get config DRIVER-STUBS)) 0)
      0))

(define (driver-write-native-packages path)
  (let ((port (open-output-file path)))
    (let loop ((names (rev (cell-get NATIVE-PACKAGES))))
      (if (pair? names)
          (begin
            (display "(native-package \"" port)
            (display (car names) port)
            (display "\")\n" port)
            (loop (cdr names)))))
    (close-port port)))

(define (driver-write-requested-native-packages config)
  (if (driver-get config DRIVER-PACKAGES)
      (begin
        (driver-write-native-packages (driver-get config DRIVER-PACKAGES))
        0)
      0))

(define (driver-emit-ssa-in-process config)
  (library-set-standard-root! (driver-stdlib config))
  (native-package-set-link-mode! (driver-native-mode config))
  (emit-program (driver-get config DRIVER-SOURCE))
  (driver-write-requested-stubs config)
  (driver-write-requested-native-packages config))

(define (driver-run config)
  (cond
    ((not (driver-get config DRIVER-SOURCE))
     (display DRIVER-USAGE (current-error-port))
     2)
    ((string=? (driver-get config DRIVER-KIND) "c-stubs")
     (driver-c-stubs config))
    ((string=? (driver-get config DRIVER-KIND) "c-structs")
     (driver-c-structs config))
    ((driver-ssa-to-stdout? config) (driver-emit-ssa-in-process config))
    (else (driver-build config))))

(exit (driver-run (driver-parse! (driver-config) (program-arguments))))
