; Pattern and template validation for syntax-rules.

(define (syntax-atom-equal? left right)
  (cond
    ((if (number? left) (number? right) #f) (= left right))
    ((if (datum-symbol? left) (datum-symbol? right) #f)
     (string=? (datum-symbol-name left) (datum-symbol-name right)))
    ((if (datum-keyword? left) (datum-keyword? right) #f)
     (string=? (datum-keyword-name left) (datum-keyword-name right)))
    ((if (datum-string? left) (datum-string? right) #f)
     (string=? (datum-string-text left) (datum-string-text right)))
    ((if (datum-char? left) (datum-char? right) #f)
     (= (datum-char-code left) (datum-char-code right)))
    ((if (datum-true? left) (datum-true? right) #f) #t)
    ((if (datum-false? left) (datum-false? right) #f) #t)
    (else #f)))

(define (syntax-equal? left right)
  (cond
    ((if (null? left) (null? right) #f) #t)
    ((syntax-atom-equal? left right) #t)
    ((if (datum-vector? left) (datum-vector? right) #f)
     (syntax-equal? (datum-vector-items left) (datum-vector-items right)))
    ((if (datum-bytevector? left) (datum-bytevector? right) #f)
     (syntax-equal? (datum-bytevector-items left)
                    (datum-bytevector-items right)))
    ((if (pair? left) (pair? right) #f)
     (if (syntax-equal? (car left) (car right))
         (syntax-equal? (cdr left) (cdr right))
         #f))
    (else #f)))

; A pattern identifier is a literal when it is the same identifier as one in
; the literal list: same name and same syntax mark (bound-identifier=?).
; An identifier a macro inserted into a pattern is a different identifier
; from a user-written literal of the same name (R7RS 4.3.2; chibi
; r7rs-tests "bound-identifier=?").
(define (literal-identifier? identifier literals)
  (if (null? literals)
      #f
      (if (if (string=? (datum-symbol-name identifier)
                        (datum-symbol-name (car literals)))
              (= (identifier-mark identifier) (identifier-mark (car literals)))
              #f)
          #t
          (literal-identifier? identifier (cdr literals)))))

(define (active-ellipsis? identifier ellipsis literals)
  (if (not (datum-symbol? identifier))
      #f
      (if (literal-identifier? identifier literals)
          #f
          (string=? (datum-symbol-name identifier) ellipsis))))

(define (literal-identifier-match? pattern input definition-env use-env)
  (if (not (datum-symbol? input))
      #f
      (if (not (string=? (datum-symbol-name pattern)
                         (datum-symbol-name input)))
          #f
          (string=?
            (literal-binding-key
              pattern (lookup-value-binding pattern definition-env))
            (literal-binding-key
              input (lookup-value-binding input use-env))))))

; Both unbound, or the same binding. A primitive is one binding however it
; is reached: free in a program without imports or an npli session, bound
; to its own name by (npl internal primitive), or, for = and the other numeric
; operators, exported by (scheme base) as the validating procedure that
; stands for it (numeric-aliases.npl), as in match's (= f p).
(define (literal-binding-key identifier binding)
  (if (= (string-length binding) 0)
      (if (primitive-row (datum-symbol-name identifier))
          (datum-symbol-name identifier)
          "")
      (let ((primitive (numeric-alias-primitive-name binding)))
        (if (> (string-length primitive) 0) primitive binding))))

;; Pattern variables are identifiers: a template symbol refers to a pattern
;; variable only if it has the same name and syntax mark, so an identifier
;; one macro inserts into another macro's rules does not capture the user's
;; identifier of the same name (bound-identifier=?, R7RS 4.3.2).
(define (pattern-key identifier)
  (let ((mark (identifier-mark identifier)))
    (if (= mark 0)
        (datum-symbol-name identifier)
        (string-append (datum-symbol-name identifier)
          (string-append (int->string 1) (number->string mark))))))

(define (validate-pattern pattern literals ellipsis depth variables)
  (cond
    ((datum-symbol? pattern)
     (let ((name (datum-symbol-name pattern)))
       (if (if (string=? name "_")
               #t
               (literal-identifier? pattern literals))
           variables
           (if (active-ellipsis? pattern ellipsis literals)
               (fatal "misplaced ellipsis in pattern")
               (if (not (null? (string-assoc
                                 (pattern-key pattern) variables)))
                   (fatal "duplicate pattern variable")
                   (cons (cons (pattern-key pattern) depth) variables))))))
    ((datum-keyword? pattern) variables)
    ((datum-vector? pattern)
     (validate-pattern-list (datum-vector-items pattern)
                            literals ellipsis depth variables))
    ((datum-string? pattern) variables)
    ((datum-char? pattern) variables)
    ((datum-bytevector? pattern) variables)
    ((datum-true? pattern) variables)
    ((datum-false? pattern) variables)
    ((pair? pattern)
     (validate-pattern-list pattern literals ellipsis depth variables))
    (else variables)))

(define (count-active-ellipsis patterns ellipsis literals count)
  (if (null? patterns)
      count
      (if (syntax-atomic? patterns)
          count
          (if (pair? patterns)
              (count-active-ellipsis
                (cdr patterns) ellipsis literals
                (if (active-ellipsis? (car patterns) ellipsis literals)
                    (+ count 1)
                    count))
              count))))

(define (validate-pattern-list patterns literals ellipsis depth variables)
  (if (> (count-active-ellipsis patterns ellipsis literals 0) 1)
      (fatal "misplaced ellipsis in pattern"))
  (if (null? patterns)
      variables
      (if (syntax-atomic? patterns)
          (validate-pattern patterns literals ellipsis depth variables)
          (if (pair? patterns)
              (if (if (pair? (cdr patterns))
                      (active-ellipsis? (car (cdr patterns))
                                        ellipsis literals)
                      #f)
                  (let ((after-repeat
                          (validate-pattern (car patterns) literals ellipsis
                                            (+ depth 1) variables)))
                    (validate-pattern-list (cdr (cdr patterns))
                                           literals ellipsis depth after-repeat))
                  (let ((after-head
                          (validate-pattern (car patterns) literals ellipsis
                                            depth variables)))
                    (validate-pattern-list (cdr patterns) literals ellipsis
                                           depth after-head)))
              (validate-pattern patterns literals ellipsis depth variables)))))

(define (validate-rule rule literals ellipsis)
  (if (not (= (raw-list-count rule 0) 2))
      (fatal "syntax rule must contain a pattern and template"))
  (let ((pattern (car rule)))
    (if (not (pair? pattern)) (fatal "syntax rule pattern must be a list"))
    (if (not (datum-symbol? (car pattern)))
        (fatal "syntax rule pattern must start with an identifier"))
    (let ((variables
            (validate-pattern-list (cdr pattern)
                                   literals ellipsis 0 ())))
      (cell-set! TEMPLATE-BUDGET 2000)
      (validate-template (car (cdr rule)) variables ellipsis literals 0)
      (cons pattern
        (cons (car (cdr rule))
          (cons variables ()))))))

(define (escaped-template-tail? template ellipsis literals)
  (if (syntax-atomic? template)
      #f
  (if (not (pair? template))
      #f
      (if (not (active-ellipsis? (car template) ellipsis literals))
          #f
          (if (not (pair? (cdr template)))
              #f
              (null? (cdr (cdr template))))))))

(define (template-driver? template variables ellipsis literals depth)
  (cond
    ((datum-symbol? template)
     (let ((descriptor
             (string-assoc (pattern-key template) variables)))
       (if (null? descriptor) #f (> (cdr descriptor) depth))))
    ((datum-vector? template)
     (template-list-driver? (datum-vector-items template)
                            variables ellipsis literals depth))
    ((pair? template)
     (if (escaped-template-tail? template ellipsis literals)
         (template-driver? (car (cdr template)) variables ellipsis literals
                           depth)
         (if (template-driver? (car template) variables ellipsis literals depth)
             #t
             (template-driver? (cdr template) variables ellipsis literals
                               depth))))
    (else #f)))

(define (template-list-driver? templates variables ellipsis literals depth)
  (if (null? templates)
      #f
      (if (syntax-atomic? templates)
          (template-driver? templates variables ellipsis literals depth)
          (if (pair? templates)
              (if (template-driver? (car templates) variables ellipsis literals
                                    depth)
                  #t
                  (template-list-driver? (cdr templates) variables ellipsis
                                         literals depth))
              (template-driver? templates variables ellipsis literals depth)))))

(define TEMPLATE-BUDGET (cell 0))

(define (validate-template template variables ellipsis literals depth)
  (if (<= (cell-get TEMPLATE-BUDGET) 0)
      #t
      (begin
        (cell-set! TEMPLATE-BUDGET (- (cell-get TEMPLATE-BUDGET) 1))
  (cond
    ((datum-symbol? template)
     (let ((descriptor
             (string-assoc (pattern-key template) variables)))
       (if (null? descriptor)
           #t
           (if (> (cdr descriptor) depth)
               (fatal "pattern variable used at wrong ellipsis depth")
               #t))))
    ((datum-keyword? template) #t)
    ((datum-vector? template)
     (validate-template-list (datum-vector-items template)
                             variables ellipsis literals depth))
    ((pair? template)
     (validate-template-list template variables ellipsis literals depth))
    (else #t)))))

(define (ellipsis-count-from templates ellipsis literals count)
  (if (pair? templates)
      (if (active-ellipsis? (car templates) ellipsis literals)
          (ellipsis-count-from (cdr templates) ellipsis literals (+ count 1))
          count)
      count))

(define (drop-forms forms count)
  (if (= count 0)
      forms
      (drop-forms (cdr forms) (- count 1))))

(define (validate-template-list templates variables ellipsis literals depth)
  (if (escaped-template-tail? templates ellipsis literals)
      (validate-template (car (cdr templates)) variables ellipsis literals
                         depth)
  (if (null? templates)
      #t
      (if (syntax-atomic? templates)
          (validate-template templates variables ellipsis literals depth)
          (if (pair? templates)
              (if (if (pair? (cdr templates))
                      (active-ellipsis? (car (cdr templates))
                                        ellipsis literals)
                      #f)
                  (let ((levels
                          (ellipsis-count-from (cdr templates)
                                               ellipsis literals 0)))
                    (validate-template (car templates) variables ellipsis
                                       literals (+ depth levels))
                    (validate-template-list
                      (drop-forms (cdr templates) levels)
                      variables ellipsis literals depth))
                  (begin
                    (validate-template (car templates) variables ellipsis
                                       literals depth)
                    (validate-template-list (cdr templates)
                                            variables ellipsis literals depth)))
              (validate-template templates variables ellipsis literals depth))))))

(define (validate-rules rules literals ellipsis)
  (if (null? rules)
      ()
      (if (pair? rules)
          (cons (validate-rule (car rules) literals ellipsis)
                (validate-rules (cdr rules) literals ellipsis))
          (fatal "syntax-rules rules must be a proper list"))))

(define (name-in-literal-tail? name literals)
  (if (null? literals)
      #f
      (if (not (datum-symbol? (car literals)))
          #f
          (if (string=? name (datum-symbol-name (car literals)))
              #t
              (name-in-literal-tail? name (cdr literals))))))

(define (validate-literals literals)
  (if (null? literals)
      literals
      (if (pair? literals)
          (if (datum-symbol? (car literals))
              (begin
                (if (name-in-literal-tail?
                      (datum-symbol-name (car literals)) (cdr literals))
                    (fatal "duplicate syntax literal"))
                (validate-literals (cdr literals))
                literals)
              (fatal "syntax literal must be an identifier"))
          (fatal "syntax literal list must be proper"))))

