; Lower expanded raw syntax into the compact core AST.

(define (raw-name value)
  (if (datum-symbol? value)
      (datum-symbol-name value)
      (fatal "expected identifier")))

(define (raw-name? value name)
  (if (datum-symbol? value)
      (string=? (datum-symbol-name value) name)
      #f))

(define (raw-form? value name)
  (if (pair-shape? value)
      (raw-name? (car value) name)
      #f))

(define (raw-list-count values count)
  (if (null? values)
      count
      (if (pair-shape? values)
          (raw-list-count (cdr values) (+ count 1))
          (fatal "expected proper list"))))

(define (require-raw-arity form count name)
  (if (not (= (raw-list-count (cdr form) 0) count))
      (fatal (string-append "malformed " name))))

(define (core-symbol value)
  (cons 100 (raw-name value)))

(define (core-true) (cons 108 ()))
(define (core-false) (cons 109 ()))
; The unspecified value (runtime IMM_UNSPECIFIED): one-armed if and set!.
(define (core-unspecified) (cons 110 ()))

(define (lower-program forms)
  (if (null? forms)
      ()
      (cons (lower-expr (car forms))
            (lower-program (cdr forms)))))

(define (lower-expressions values)
  (if (null? values)
      ()
      (if (pair-shape? values)
          (cons (lower-expr (car values))
                (lower-expressions (cdr values)))
          (fatal "expression list must be proper"))))

(define (lower-expr value)
  (cond
    ((number? value) value)
    ((null? value) ())
    ((datum-symbol? value) (core-symbol value))
    ((datum-string? value) (cons 101 (datum-string-text value)))
    ((datum-char? value) (cons 102 (datum-char-code value)))
    ((datum-vector? value)
     (cons 103 (cons (datum-vector-items value) ())))
    ((datum-bytevector? value)
     (cons 104 (cons (datum-bytevector-items value) ())))
    ((datum-true? value) (core-true))
    ((datum-false? value) (core-false))
    ((pair-shape? value) (lower-form value))
    (else (fatal "bad raw expression"))))

(define (lower-form form)
  (if (datum-symbol? (car form))
      (let ((name (datum-symbol-name (car form))))
        (cond
          ((string=? name "quote") (lower-quote form))
          ((string=? name "quasiquote") (lower-quasiquote-form form))
          ((string=? name "unquote") (fatal "unquote outside quasiquote"))
          ((string=? name "unquote-splicing")
           (fatal "unquote outside quasiquote"))
          ((string=? name "define") (lower-define form))
          ((string=? name "lambda") (lower-lambda form))
          ((string=? name "if") (lower-if form))
          ((string=? name "begin")
           (cons 216 (lower-expressions (cdr form))))
          ((string=? name "let") (lower-binding-form form 214))
          ((string=? name "let*") (lower-binding-form form 220))
          ((string=? name "letrec") (lower-binding-form form 221))
          ((string=? name "letrec*") (lower-binding-form form 222))
          ((string=? name "set!") (lower-set form))
          (else (lower-application form))))
      (lower-application form)))

(define (lower-application form)
  (lower-expressions form))

(define (lower-quote form)
  (require-raw-arity form 1 "quote")
  (cons 204 (cons (car (cdr form)) ())))

(define (raw-single-argument form name)
  (require-raw-arity form 1 name)
  (car (cdr form)))

(define (call-node name args)
  (cons (cons 100 name) args))

(define (quote-node datum)
  (cons 204 (cons datum ())))

(define (splice-node? value)
  (if (pair-shape? value)
      (if (number? (car value)) (= (car value) 105) #f)
      #f))

(define (qq-keyword name content)
  (call-node "cons"
    (cons (quote-node (datum-symbol name))
      (cons (call-node "cons"
              (cons content (cons (quote-node ()) ())))
            ()))))

(define (lower-quasiquote-form form)
  (lower-quasiquote (raw-single-argument form "quasiquote") 1))

(define (lower-quasiquote value depth)
  (cond
    ((raw-form? value "quasiquote")
     (qq-keyword "quasiquote"
       (lower-quasiquote
         (raw-single-argument value "quasiquote") (+ depth 1))))
    ((raw-form? value "unquote")
     (let ((content (raw-single-argument value "unquote")))
       (if (= depth 1)
           (lower-expr content)
           (qq-keyword "unquote"
             (lower-quasiquote content (- depth 1))))))
    ((raw-form? value "unquote-splicing")
     (let ((content (raw-single-argument value "unquote-splicing")))
       (if (= depth 1)
           (cons 105 (cons (lower-expr content) ()))
           (qq-keyword "unquote-splicing"
             (lower-quasiquote content (- depth 1))))))
    ((datum-vector? value)
     (call-node "list->vector"
       (cons (lower-quasiquote-list (datum-vector-items value) depth) ())))
    ((datum-symbol? value) (quote-node value))
    ((datum-string? value) (quote-node value))
    ((datum-char? value) (quote-node value))
    ((datum-bytevector? value) (quote-node value))
    ((datum-true? value) (quote-node value))
    ((datum-false? value) (quote-node value))
    ((pair-shape? value) (lower-quasiquote-list value depth))
    (else (quote-node value))))

(define (lower-quasiquote-list values depth)
  (if (null? values)
      (quote-node ())
      (if (pair-shape? values)
          (let ((item (lower-quasiquote (car values) depth)))
            (let ((rest (lower-quasiquote-list (cdr values) depth)))
              (if (splice-node? item)
                  (call-node "append"
                    (cons (car (cdr item)) (cons rest ())))
                  (call-node "cons" (cons item (cons rest ()))))))
          (let ((tail (lower-quasiquote values depth)))
            (if (splice-node? tail)
                (fatal "unquote-splicing in dotted tail")
                tail)))))

(define (lower-define form)
  (if (null? (cdr form)) (fatal "define needs a target"))
  (let ((target (car (cdr form))))
    (let ((rest (cdr (cdr form))))
      (if (datum-symbol? target)
          (begin
            (if (not (= (raw-list-count rest 0) 1))
                (fatal "define variable needs one value"))
            (cons 200
              (cons (core-symbol target)
                    (cons (lower-expr (car rest)) ()))))
          (if (pair-shape? target)
              (begin
                (if (not (datum-symbol? (car target)))
                    (fatal "bad define name"))
                (if (null? rest) (fatal "define function needs a body"))
                (cons 211
                  (cons (cons (core-symbol (car target))
                              (lower-parameters (cdr target)))
                        (cons (lower-expressions rest) ()))))
              (fatal "bad define target"))))))

(define (lower-parameters params)
  (if (null? params)
      ()
      (if (datum-symbol? params)
          (core-symbol params)
          (if (pair-shape? params)
              (if (datum-symbol? (car params))
                  (cons (core-symbol (car params))
                        (lower-parameters (cdr params)))
                  (fatal "bad parameter name"))
              (fatal "malformed parameter list")))))

(define (lower-lambda form)
  (if (null? (cdr form)) (fatal "lambda needs parameters"))
  (let ((params (car (cdr form))))
    (let ((body (cdr (cdr form))))
      (if (null? body) (fatal "lambda needs a body"))
      (cons 212
        (cons (lower-parameters params)
              (cons (lower-expressions body) ()))))))

(define (lower-if form)
  (let ((count (raw-list-count (cdr form) 0)))
    (if (if (= count 2) #f (not (= count 3)))
        (fatal "malformed if"))
    (let ((test (lower-expr (car (cdr form)))))
      (let ((consequent (lower-expr (car (cdr (cdr form))))))
        (let ((alternate
                (if (= count 3)
                    (lower-expr (car (cdr (cdr (cdr form)))))
                    (core-unspecified))))
          (cons 213
            (cons test (cons consequent (cons alternate ())))))))))

(define (lower-set form)
  (require-raw-arity form 2 "set!")
  (let ((name (car (cdr form))))
    (if (not (datum-symbol? name)) (fatal "set! needs a variable"))
    (cons 217
      (cons (core-symbol name)
            (cons (lower-expr (car (cdr (cdr form)))) ())))))

(define (core-single-let binding body)
  (cons 214
    (cons (cons binding ())
          (cons (cons body ()) ()))))

(define (core-expand-letstar bindings body)
  (if (null? bindings)
      (cons 214 (cons () (cons body ())))
      (core-single-let
        (car bindings)
        (core-expand-letstar (cdr bindings) body))))

(define (core-internal-definition? expression)
  (if (pair-shape? expression)
      (if (number? (car expression))
          (if (= (car expression) 200) #t (= (car expression) 211))
          #f)
      #f))

(define (core-internal-binding expression)
  (if (= (car expression) 200)
      (cons (car (cdr expression))
            (car (cdr (cdr expression))))
      (cons (car (car (cdr expression)))
            (cons 212
              (cons (cdr (car (cdr expression)))
                    (cons (car (cdr (cdr expression))) ()))))))

(define (core-leading-bindings body)
  (if (if (null? body)
          #f
          (core-internal-definition? (car body)))
      (cons (core-internal-binding (car body))
            (core-leading-bindings (cdr body)))
      ()))

(define (core-after-definitions body)
  (if (if (null? body)
          #f
          (core-internal-definition? (car body)))
      (core-after-definitions (cdr body))
      body))

; Both execution paths use the same internal-definition scope and ordering.
(define (core-body-expression body)
  (let ((bindings (core-leading-bindings body)))
    (if (null? bindings)
        (cons 216 body)
        (cons 222
          (cons bindings
                (cons (core-after-definitions body) ()))))))

(define (lower-binding-form form tag)
  (if (null? (cdr form)) (fatal "binding form needs bindings"))
  (let ((bindings (car (cdr form))))
    (let ((body (cdr (cdr form))))
      (if (null? body) (fatal "binding form needs a body"))
      (cons tag
        (cons (lower-bindings bindings)
              (cons (lower-expressions body) ()))))))

(define (checked-raw-binding binding)
  (if (not (pair-shape? binding)) (fatal "malformed binding"))
  (if (not (= (raw-list-count binding 0) 2)) (fatal "malformed binding"))
  (if (not (datum-symbol? (car binding)))
      (fatal "binding name must be an identifier"))
  binding)

(define (checked-raw-bindings bindings)
  (if (not (null? bindings))
      (begin
        (if (not (pair-shape? bindings))
            (fatal "bindings must be a proper list"))
        (checked-raw-binding (car bindings))
        (checked-raw-bindings (cdr bindings))))
  bindings)

(define (lower-bindings bindings)
  (if (null? bindings)
      ()
      (if (not (pair-shape? bindings))
          (fatal "bindings must be a proper list")
          (let ((binding (checked-raw-binding (car bindings))))
            (cons
              (cons (core-symbol (car binding))
                    (lower-expr (car (cdr binding))))
              (lower-bindings (cdr bindings)))))))
