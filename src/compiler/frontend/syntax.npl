; syntax-rules matcher and hygienic template transcription.

(define SYNTAX-MARKS (cell ()))
(define SYNTAX-NEXT-MARK (cell 0))
; Definition-site bindings for spliced macro output (transcription.npl).
(define TRANSCRIPTION-ALIASES (cell ()))
(define MATCH-FAIL '(_syntax_match_fail_))
(define CURRENT-PATTERN-VARIABLES (cell ()))
(define NO-REPEAT-COUNT 1000000000)
(define CURRENT-REPEAT-DRIVER-DEPTH (cell 1000000000))
(define UNINITIALIZED-SYNTAX '(_uninitialized_syntax_))

(define (syntax-atomic? value)
  (if (datum-symbol? value)
      #t
      (if (datum-string? value)
          #t
          (if (datum-char? value)
              #t
              (if (datum-vector? value)
                  #t
                  (if (datum-bytevector? value)
                      #t
                      (if (datum-true? value)
                          #t
                          (datum-false? value))))))))

(define (identifier-mark identifier)
  (identifier-mark-in identifier (cell-get SYNTAX-MARKS)))

(define (identifier-mark-in identifier entries)
  (if (null? entries)
      0
      (if (eq? identifier (car (car entries)))
          (cdr (car entries))
          (identifier-mark-in identifier (cdr entries)))))

(define (set-identifier-mark! identifier mark)
  (cell-set! SYNTAX-MARKS
    (cons (cons identifier mark) (cell-get SYNTAX-MARKS))))

(define (fresh-syntax-mark)
  (cell-set! SYNTAX-NEXT-MARK (+ 1 (cell-get SYNTAX-NEXT-MARK)))
  (cell-get SYNTAX-NEXT-MARK))

(define (lookup-value-binding identifier environment)
  (let ((name (datum-symbol-name identifier))
        (mark (identifier-mark identifier)))
    (let ((binding (lookup-value-binding-key name mark environment)))
      (if (> (string-length binding) 0)
          binding
          (lookup-value-binding-key
            name mark (cell-get TRANSCRIPTION-ALIASES))))))

; Compute the lookup key once, not once per environment entry.
(define (lookup-value-binding-key name mark environment)
  (if (null? environment)
      ""
      (let ((entry (car environment)))
        (if (if (string=? name (car entry))
                (= mark (car (cdr entry)))
                #f)
            (car (cdr (cdr entry)))
            (lookup-value-binding-key name mark (cdr environment))))))

(define (add-value-binding identifier emitted environment)
  (cons (cons (datum-symbol-name identifier)
              (cons (identifier-mark identifier) (cons emitted ())))
        environment))

(define (lookup-macro-binding identifier environment)
  (if (null? environment)
      ()
      (let ((entry (car environment)))
        (if (if (string=? (datum-symbol-name identifier) (car entry))
                (= (identifier-mark identifier) (car (cdr entry)))
                #f)
            (cell-get (car (cdr (cdr entry))))
            (lookup-macro-binding identifier (cdr environment))))))

(define (lookup-macro-cell identifier environment)
  (if (null? environment)
      ()
      (let ((entry (car environment)))
        (if (if (string=? (datum-symbol-name identifier) (car entry))
                (= (identifier-mark identifier) (car (cdr entry)))
                #f)
            (macro-entry-cell entry)
            (lookup-macro-cell identifier (cdr environment))))))

(define (add-macro-cell-binding identifier transformer-cell environment)
  (cons (cons (datum-symbol-name identifier)
              (cons (identifier-mark identifier)
                    (cons transformer-cell ())))
        environment))

(define (add-macro-binding identifier transformer environment)
  (add-macro-cell-binding identifier (cell transformer) environment))

(define (macro-entry-cell entry) (car (cdr (cdr entry))))

(define (syntax-atom-equal? left right)
  (cond
    ((if (number? left) (number? right) #f) (= left right))
    ((if (datum-symbol? left) (datum-symbol? right) #f)
     (string=? (datum-symbol-name left) (datum-symbol-name right)))
    ((if (datum-string? left) (datum-string? right) #f)
     (string=? (datum-string-text left) (datum-string-text right)))
    ((if (datum-char? left) (datum-char? right) #f)
     (= (datum-char-code left) (datum-char-code right)))
    ((if (datum-true? left) (datum-true? right) #f) #t)
    ((if (datum-false? left) (datum-false? right) #f) #t)
    (else #f)))

(define (syntax-equal? left right)
  (cond
    ((if (null? left) (null? right) #f) #t)
    ((syntax-atom-equal? left right) #t)
    ((if (datum-vector? left) (datum-vector? right) #f)
     (syntax-equal? (datum-vector-items left) (datum-vector-items right)))
    ((if (datum-bytevector? left) (datum-bytevector? right) #f)
     (syntax-equal? (datum-bytevector-items left)
                    (datum-bytevector-items right)))
    ((if (pair? left) (pair? right) #f)
     (if (syntax-equal? (car left) (car right))
         (syntax-equal? (cdr left) (cdr right))
         #f))
    (else #f)))

(define (literal-identifier? identifier literals)
  (if (null? literals)
      #f
      (if (string=? (datum-symbol-name identifier)
                    (datum-symbol-name (car literals)))
          #t
          (literal-identifier? identifier (cdr literals)))))

(define (active-ellipsis? identifier ellipsis literals)
  (if (not (datum-symbol? identifier))
      #f
      (if (literal-identifier? identifier literals)
          #f
          (string=? (datum-symbol-name identifier) ellipsis))))

(define (literal-identifier-match? pattern input definition-env use-env)
  (if (not (datum-symbol? input))
      #f
      (if (not (string=? (datum-symbol-name pattern)
                         (datum-symbol-name input)))
          #f
          (let ((definition-binding
                  (lookup-value-binding pattern definition-env)))
            (let ((use-binding (lookup-value-binding input use-env)))
              (if (= (string-length definition-binding) 0)
                  (= (string-length use-binding) 0)
                  (if (= (string-length use-binding) 0)
                      #f
                      (string=? definition-binding use-binding))))))))

; variable descriptor = (name . repetition-depth)
(define (variable-descriptor name variables)
  (if (null? variables)
      ()
      (if (string=? name (car (car variables)))
          (car variables)
          (variable-descriptor name (cdr variables)))))

(define (validate-pattern pattern literals ellipsis depth variables)
  (cond
    ((datum-symbol? pattern)
     (let ((name (datum-symbol-name pattern)))
       (if (if (string=? name "_")
               #t
               (literal-identifier? pattern literals))
           variables
           (if (active-ellipsis? pattern ellipsis literals)
               (fatal "misplaced ellipsis in pattern")
               (if (not (null? (variable-descriptor name variables)))
                   (fatal "duplicate pattern variable")
                   (cons (cons name depth) variables))))))
    ((datum-vector? pattern)
     (validate-pattern-list (datum-vector-items pattern)
                            literals ellipsis depth variables))
    ((datum-string? pattern) variables)
    ((datum-char? pattern) variables)
    ((datum-bytevector? pattern) variables)
    ((datum-true? pattern) variables)
    ((datum-false? pattern) variables)
    ((pair? pattern)
     (validate-pattern-list pattern literals ellipsis depth variables))
    (else variables)))

(define (validate-pattern-list patterns literals ellipsis depth variables)
  (if (null? patterns)
      variables
      (if (syntax-atomic? patterns)
          (validate-pattern patterns literals ellipsis depth variables)
          (if (pair? patterns)
              (if (if (pair? (cdr patterns))
                      (active-ellipsis? (car (cdr patterns))
                                        ellipsis literals)
                      #f)
                  (let ((after-repeat
                          (validate-pattern (car patterns) literals ellipsis
                                            (+ depth 1) variables)))
                    (validate-pattern-list (cdr (cdr patterns))
                                           literals ellipsis depth after-repeat))
                  (let ((after-head
                          (validate-pattern (car patterns) literals ellipsis
                                            depth variables)))
                    (validate-pattern-list (cdr patterns) literals ellipsis
                                           depth after-head)))
              (validate-pattern patterns literals ellipsis depth variables)))))

(define (validate-rule rule literals ellipsis)
  (if (not (= (raw-list-count rule 0) 2))
      (fatal "syntax rule must contain a pattern and template"))
  (let ((pattern (car rule)))
    (if (not (pair? pattern)) (fatal "syntax rule pattern must be a list"))
    (if (not (datum-symbol? (car pattern)))
        (fatal "syntax rule pattern must start with an identifier"))
    (let ((variables
            (validate-pattern-list (cdr pattern)
                                   literals ellipsis 0 ())))
      (cons pattern
        (cons (car (cdr rule))
          (cons variables ()))))))

(define (validate-rules rules literals ellipsis)
  (if (null? rules)
      ()
      (if (pair? rules)
          (cons (validate-rule (car rules) literals ellipsis)
                (validate-rules (cdr rules) literals ellipsis))
          (fatal "syntax-rules rules must be a proper list"))))

(define (name-in-literal-tail? name literals)
  (if (null? literals)
      #f
      (if (not (datum-symbol? (car literals)))
          #f
          (if (string=? name (datum-symbol-name (car literals)))
              #t
              (name-in-literal-tail? name (cdr literals))))))

(define (validate-literals literals)
  (if (null? literals)
      literals
      (if (pair? literals)
          (if (datum-symbol? (car literals))
              (begin
                (if (name-in-literal-tail?
                      (datum-symbol-name (car literals)) (cdr literals))
                    (fatal "duplicate syntax literal"))
                (validate-literals (cdr literals))
                literals)
              (fatal "syntax literal must be an identifier"))
          (fatal "syntax literal list must be proper"))))

; transformer = (ellipsis literals annotated-rules definition-value-env
;                definition-macro-env)
(define (parse-syntax-rules specification definition-env definition-macro-env)
  (if (not (raw-form? specification "syntax-rules"))
      (fatal "transformer must be syntax-rules"))
  (let ((parts (cdr specification)))
    (if (null? parts) (fatal "syntax-rules needs literals and rules"))
    (let ((ellipsis
            (if (datum-symbol? (car parts))
                (datum-symbol-name (car parts))
                "...")))
      (let ((after-ellipsis
              (if (datum-symbol? (car parts)) (cdr parts) parts)))
        (if (null? after-ellipsis)
            (fatal "syntax-rules needs literals and rules"))
        (let ((literals (car after-ellipsis)))
          (let ((rules (cdr after-ellipsis)))
            (validate-literals literals)
            (if (null? rules) (fatal "syntax-rules needs a rule"))
            (let ((annotated-rules
                    (validate-rules rules literals ellipsis)))
              (cons ellipsis
                (cons literals
                  (cons annotated-rules
                    (cons definition-env
                      (cons definition-macro-env ()))))))))))))

(define (transformer-ellipsis transformer) (car transformer))
(define (transformer-literals transformer) (car (cdr transformer)))
(define (transformer-rules transformer) (car (cdr (cdr transformer))))
(define (transformer-definition-env transformer)
  (car (cdr (cdr (cdr transformer)))))
(define (transformer-definition-macro-env transformer)
  (car (cdr (cdr (cdr (cdr transformer))))))

; capture = (name path value)
(define (add-capture name path value captures)
  (cons (cons name (cons path (cons value ()))) captures))

(define (capture-name capture) (car capture))
(define (capture-path capture) (car (cdr capture)))
(define (capture-value capture) (car (cdr (cdr capture))))

(define (path-equal? left right)
  (if (null? left)
      (null? right)
      (if (null? right)
          #f
          (if (= (car left) (car right))
              (path-equal? (cdr left) (cdr right))
              #f))))

(define (path-prefix? prefix path)
  (if (null? prefix)
      #t
      (if (null? path)
          #f
          (if (= (car prefix) (car path))
              (path-prefix? (cdr prefix) (cdr path))
              #f))))

(define (path-drop-prefix prefix path)
  (if (null? prefix)
      path
      (path-drop-prefix (cdr prefix) (cdr path))))

(define (path-append-index path index)
  (if (null? path)
      (cons index ())
      (cons (car path) (path-append-index (cdr path) index))))

(define (path-length path)
  (if (null? path) 0 (+ 1 (path-length (cdr path)))))

(define (capture-exact name path captures)
  (if (null? captures)
      ()
      (let ((capture (car captures)))
        (if (if (string=? name (capture-name capture))
                (path-equal? path (capture-path capture))
                #f)
            capture
            (capture-exact name path (cdr captures))))))

(define (capture-next-count name path captures count)
  (if (null? captures)
      count
      (let ((capture (car captures)))
        (if (if (string=? name (capture-name capture))
                (path-prefix? path (capture-path capture))
                #f)
            (let ((rest (path-drop-prefix path (capture-path capture))))
              (if (null? rest)
                  (capture-next-count name path (cdr captures) count)
                  (let ((next (+ (car rest) 1)))
                    (capture-next-count name path (cdr captures)
                      (if (> next count) next count)))))
            (capture-next-count name path (cdr captures) count)))))

(define (match-pattern pattern input transformer use-env captures path)
  (let ((literals (transformer-literals transformer)))
    (let ((ellipsis (transformer-ellipsis transformer)))
      (cond
        ((datum-symbol? pattern)
         (let ((name (datum-symbol-name pattern)))
           (cond
             ((string=? name "_") captures)
             ((active-ellipsis? pattern ellipsis literals)
              (fatal "misplaced ellipsis in pattern"))
             ((literal-identifier? pattern literals)
              (if (literal-identifier-match?
                    pattern input
                    (transformer-definition-env transformer) use-env)
                  captures
                  MATCH-FAIL))
             (else (add-capture name path input captures)))))
        ((datum-vector? pattern)
         (if (datum-vector? input)
             (match-pattern-list (datum-vector-items pattern)
                                 (datum-vector-items input)
                                 transformer use-env captures path)
             MATCH-FAIL))
        ((datum-bytevector? pattern)
         (if (syntax-equal? pattern input) captures MATCH-FAIL))
        ((datum-string? pattern)
         (if (syntax-equal? pattern input) captures MATCH-FAIL))
        ((datum-char? pattern)
         (if (syntax-equal? pattern input) captures MATCH-FAIL))
        ((datum-true? pattern)
         (if (datum-true? input) captures MATCH-FAIL))
        ((datum-false? pattern)
         (if (datum-false? input) captures MATCH-FAIL))
        ((pair? pattern)
         (if (pair? input)
             (match-pattern-list pattern input transformer use-env
                                 captures path)
             MATCH-FAIL))
        (else (if (syntax-equal? pattern input) captures MATCH-FAIL))))))

(define (match-pattern-list patterns input transformer use-env captures path)
  (if (null? patterns)
      (if (null? input) captures MATCH-FAIL)
      (if (syntax-atomic? patterns)
          (match-pattern patterns input transformer use-env captures path)
          (if (pair? patterns)
              (if (if (pair? (cdr patterns))
                      (active-ellipsis?
                        (car (cdr patterns))
                        (transformer-ellipsis transformer)
                        (transformer-literals transformer))
                      #f)
                  (match-repeated-pattern
                    (car patterns) (cdr (cdr patterns)) input
                    transformer use-env captures path 0)
                  (if (not (pair? input))
                      MATCH-FAIL
                      (let ((head-captures
                              (match-pattern (car patterns) (car input)
                                transformer use-env captures path)))
                        (if (eq? head-captures MATCH-FAIL)
                            MATCH-FAIL
                            (match-pattern-list
                              (cdr patterns) (cdr input)
                              transformer use-env head-captures path)))))
              (match-pattern patterns input transformer use-env captures path)))))

(define (match-repeated-pattern repeated suffix input transformer use-env
                                captures path index)
  (let ((consume-result
          (if (if (pair? input) (not (syntax-atomic? input)) #f)
              (let ((next-captures
                      (match-pattern repeated (car input)
                        transformer use-env captures
                        (path-append-index path index))))
                (if (eq? next-captures MATCH-FAIL)
                    MATCH-FAIL
                    (match-repeated-pattern
                      repeated suffix (cdr input)
                      transformer use-env next-captures path (+ index 1))))
              MATCH-FAIL)))
    (if (eq? consume-result MATCH-FAIL)
        (match-pattern-list suffix input transformer use-env captures path)
        consume-result)))

(define (merge-repeat-count current candidate)
  (if (= candidate NO-REPEAT-COUNT)
      current
      (if (= current NO-REPEAT-COUNT)
          candidate
          (if (= current candidate)
              current
              (fatal "inconsistent ellipsis repetition lengths")))))

(define (template-repeat-count template transformer captures path)
  (let ((driver-depth
          (template-repeat-driver-depth
            template transformer (path-length path) NO-REPEAT-COUNT)))
    (cell-set! CURRENT-REPEAT-DRIVER-DEPTH driver-depth)
    (template-repeat-count-in template transformer captures
                              path NO-REPEAT-COUNT)))

(define (template-repeat-driver-depth template transformer path-depth current)
  (cond
    ((datum-symbol? template)
     (let ((descriptor
             (variable-descriptor
               (datum-symbol-name template)
               (cell-get CURRENT-PATTERN-VARIABLES))))
       (if (null? descriptor)
           current
           (if (> (cdr descriptor) path-depth)
               (if (< (cdr descriptor) current)
                   (cdr descriptor)
                   current)
               current))))
    ((datum-vector? template)
     (template-repeat-driver-depth
       (datum-vector-items template) transformer path-depth current))
    ((datum-string? template) current)
    ((datum-char? template) current)
    ((datum-bytevector? template) current)
    ((datum-true? template) current)
    ((datum-false? template) current)
    ((pair? template)
     (if (escaped-ellipsis-template? template transformer)
         current
         (template-repeat-driver-depth
           (cdr template) transformer path-depth
           (template-repeat-driver-depth
             (car template) transformer path-depth current))))
    (else current)))

(define (template-repeat-count-in template transformer captures path current)
  (cond
    ((datum-symbol? template)
     (let ((descriptor
             (variable-descriptor
               (datum-symbol-name template)
               (cell-get CURRENT-PATTERN-VARIABLES))))
       (if (null? descriptor)
           current
           (if (= (cdr descriptor)
                  (cell-get CURRENT-REPEAT-DRIVER-DEPTH))
               (merge-repeat-count
                 current
                 (capture-next-count (car descriptor) path captures 0))
               current))))
    ((datum-vector? template)
     (template-repeat-count-in (datum-vector-items template)
                               transformer captures path current))
    ((datum-string? template) current)
    ((datum-char? template) current)
    ((datum-bytevector? template) current)
    ((datum-true? template) current)
    ((datum-false? template) current)
    ((pair? template)
     (if (escaped-ellipsis-template? template transformer)
         current
         (let ((after-head
                 (template-repeat-count-in
                   (car template) transformer captures path current)))
           (template-repeat-count-in
             (cdr template) transformer captures path after-head))))
    (else current)))

(define (escaped-ellipsis-template? template transformer)
  (if (not (pair? template))
      #f
      (if (not (active-ellipsis?
                 (car template)
                 (transformer-ellipsis transformer)
                 (transformer-literals transformer)))
          #f
          (if (not (pair? (cdr template)))
              #f
              (null? (cdr (cdr template)))))))

(define (clone-template template transformer captures mark path enabled)
  (cond
    ((datum-symbol? template)
     (let ((descriptor
             (variable-descriptor
               (datum-symbol-name template)
               (cell-get CURRENT-PATTERN-VARIABLES))))
       (if (null? descriptor)
           (begin
             (if (if enabled
                     (active-ellipsis?
                       template
                       (transformer-ellipsis transformer)
                       (transformer-literals transformer))
                     #f)
                 (fatal "misplaced ellipsis in template"))
             (let ((copy (datum-symbol (datum-symbol-name template))))
               (set-identifier-mark! copy mark)
               copy))
           (if (not (= (cdr descriptor) (path-length path)))
               (fatal "pattern variable used at wrong ellipsis depth")
               (let ((capture
                       (capture-exact (car descriptor) path captures)))
                 (if (null? capture)
                     (fatal "missing pattern capture")
                     (capture-value capture)))))))
    ((datum-vector? template)
     (datum-vector
       (clone-template-list (datum-vector-items template)
                            transformer captures mark path enabled)))
    ((datum-bytevector? template) template)
    ((datum-string? template) template)
    ((datum-char? template) template)
    ((datum-true? template) template)
    ((datum-false? template) template)
    ((pair? template)
     (if (if enabled (escaped-ellipsis-template? template transformer) #f)
         (clone-template (car (cdr template)) transformer captures
                         mark path #f)
         (clone-template-list template transformer captures
                              mark path enabled)))
    (else template)))

(define (clone-repeated-template template count index transformer captures
                                 mark path enabled)
  (if (= index count)
      ()
      (cons
        (clone-template template transformer captures mark
                        (path-append-index path index) enabled)
        (clone-repeated-template template count (+ index 1)
                                 transformer captures mark path enabled))))

(define (clone-template-list templates transformer captures mark path enabled)
  (if (null? templates)
      ()
      (if (syntax-atomic? templates)
          (clone-template templates transformer captures mark path enabled)
          (if (pair? templates)
              (if (if enabled
                      (if (pair? (cdr templates))
                          (active-ellipsis?
                            (car (cdr templates))
                            (transformer-ellipsis transformer)
                            (transformer-literals transformer))
                          #f)
                      #f)
                  (let ((count
                          (template-repeat-count (car templates)
                                                 transformer captures path)))
                    (if (= count NO-REPEAT-COUNT)
                        (fatal "ellipsis template has no repeated pattern variable"))
                    (append-forms
                      (clone-repeated-template
                        (car templates) count 0 transformer captures
                        mark path enabled)
                      (clone-template-list
                        (cdr (cdr templates)) transformer captures
                        mark path enabled)))
                  (cons
                    (clone-template (car templates) transformer captures
                                    mark path enabled)
                    (clone-template-list (cdr templates) transformer captures
                                         mark path enabled)))
              (clone-template templates transformer captures mark path enabled)))))

(define (transcribe-rules rules use transformer use-env)
  (if (null? rules)
      (fatal (string-append "macro use does not match any syntax rule: "
                            (datum-symbol-name (car use))))
      (let ((rule (car rules)))
        (let ((pattern (car rule)))
          (cell-set! CURRENT-PATTERN-VARIABLES
                     (car (cdr (cdr rule))))
          (let ((captures
                  (match-pattern-list (cdr pattern) (cdr use)
                    transformer use-env () ())))
            (if (eq? captures MATCH-FAIL)
                (transcribe-rules (cdr rules) use transformer use-env)
                (let ((mark (fresh-syntax-mark)))
                  (cons
                    (clone-template (car (cdr rule)) transformer captures
                                    mark () #t)
                    mark))))))))

(define (transcribe-macro transformer use use-env)
  (transcribe-rules (transformer-rules transformer)
                    use transformer use-env))
