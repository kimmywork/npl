; Hygienic expansion and lexical alpha-renaming before core lowering.

(define EXPAND-NEXT-VALUE (cell 0))
(define EXPAND-REQUIRE-BOUND (cell 0))

(define (fresh-value-name identifier)
  (cell-set! EXPAND-NEXT-VALUE (+ 1 (cell-get EXPAND-NEXT-VALUE)))
  (string-append "_npl_h_"
    (string-append (number->string (cell-get EXPAND-NEXT-VALUE))
      (string-append "_" (sanitize (datum-symbol-name identifier) 0 "")))))

(define (direct-defined-identifier form)
  (if (raw-form? form "define")
      (if (null? (cdr form))
          ()
          (let ((target (car (cdr form))))
            (if (datum-symbol? target)
                target
                (if (pair? target)
                    (if (datum-symbol? (car target)) (car target) ())
                    ()))))
      ()))

(define (direct-defined-identifiers form)
  (let ((single (direct-defined-identifier form)))
    (if (null? single)
        (if (raw-form? form "define-values")
            (begin
              (require-raw-arity form 2 "define-values")
              (car (cdr form)))
            ())
        (cons single ()))))

(define (predeclare-global-identifiers identifiers environment)
  (if (null? identifiers)
      environment
      (if (not (pair? identifiers))
          (fatal "definition names must be a proper list")
          (let ((identifier (car identifiers)))
            (if (not (datum-symbol? identifier))
                (fatal "definition name must be an identifier"))
            (predeclare-global-identifiers
              (cdr identifiers)
              (add-value-binding identifier
                                 (datum-symbol-name identifier)
                                 environment))))))

(define (predeclare-globals forms environment)
  (if (null? forms)
      environment
      (predeclare-globals
        (cdr forms)
        (predeclare-global-identifiers
          (direct-defined-identifiers (car forms)) environment))))

(define (expand-program forms)
  (cell-set! EXPAND-REQUIRE-BOUND 0)
  (cell-set! SYNTAX-MARKS ())
  (cell-set! SYNTAX-NEXT-MARK 0)
  (cell-set! EXPAND-NEXT-VALUE 0)
  (let ((environment (predeclare-globals forms ())))
    (let ((core-result
            (expand-top-sequence
              (parse-source-text DERIVED-SYNTAX-SOURCE)
              environment () ())))
      (if (not (null? (car core-result)))
          (fatal "derived syntax source emitted runtime forms"))
      (car (expand-top-sequence
             forms environment (cdr core-result) ())))))

; result = (expanded-forms . final-macro-environment)
(define (expand-top-sequence forms value-env macro-env acc)
  (if (null? forms)
      (cons (rev acc) macro-env)
      (let ((form (car forms)))
        (if (raw-form? form "define-syntax")
            (begin
              (require-raw-arity form 2 "define-syntax")
              (let ((keyword (car (cdr form))))
                (if (not (datum-symbol? keyword))
                    (fatal "define-syntax needs an identifier"))
                (let ((transformer-cell (cell UNINITIALIZED-SYNTAX)))
                  (let ((definition-macros
                          (add-macro-cell-binding
                            keyword transformer-cell macro-env)))
                    (cell-set! transformer-cell
                      (parse-syntax-rules
                        (car (cdr (cdr form)))
                        value-env definition-macros))
                    (expand-top-sequence
                      (cdr forms) value-env definition-macros acc)))))
            (let ((expanded
                    (expand-expression form value-env macro-env)))
              (if (raw-form? expanded "define-syntax")
                  (expand-top-sequence
                    (cons expanded (cdr forms)) value-env macro-env acc)
                  (if (raw-form? expanded "begin")
                      (expand-top-sequence
                        (append-forms (cdr expanded) (cdr forms))
                        value-env macro-env acc)
                      (expand-top-sequence
                        (cdr forms) value-env macro-env
                        (cons expanded acc)))))))))

(define (resolve-identifier identifier environment)
  (let ((binding (lookup-value-binding identifier environment)))
    (if (= (string-length binding) 0)
        (if (= (cell-get EXPAND-REQUIRE-BOUND) 2)
            (fatal
              (string-append
                "unbound identifier: " (datum-symbol-name identifier)))
            identifier)
        (datum-symbol binding))))

(define (head-value-bound? identifier environment)
  (> (string-length (lookup-value-binding identifier environment)) 0))

(define (expand-expression expression value-env macro-env)
  (cond
    ((datum-symbol? expression)
     (resolve-identifier expression value-env))
    ((datum-string? expression) expression)
    ((datum-char? expression) expression)
    ((datum-bytevector? expression) expression)
    ((datum-true? expression) expression)
    ((datum-false? expression) expression)
    ((datum-vector? expression)
     (datum-vector
       (expand-expression-list (datum-vector-items expression)
                               value-env macro-env)))
    ((pair? expression)
     (expand-pair-expression expression value-env macro-env))
    (else expression)))

(define (alias-value-environment definition-env mark use-env)
  (if (null? definition-env)
      use-env
      (let ((entry (car definition-env)))
        (alias-value-environment
          (cdr definition-env) mark
          (cons (cons (car entry)
                      (cons mark (cons (car (cdr (cdr entry))) ())))
                use-env)))))

(define (alias-macro-environment definition-env mark use-env)
  (if (null? definition-env)
      use-env
      (let ((entry (car definition-env)))
        (alias-macro-environment
          (cdr definition-env) mark
          (cons (cons (car entry)
                      (cons mark (cons (macro-entry-cell entry) ())))
                use-env)))))

(define (definition-form? form)
  (if (raw-form? form "define")
      #t
      (raw-form? form "define-syntax")))

(define (definition-begin? form)
  (if (not (raw-form? form "begin"))
      #f
      (begin-contains-definition? (cdr form))))

(define (begin-contains-definition? forms)
  (if (null? forms)
      #f
      (if (definition-form? (car forms))
          #t
          (if (definition-begin? (car forms))
              #t
              (begin-contains-definition? (cdr forms))))))

(define (expand-transcription transformer transcription value-env macro-env)
  (let ((output (car transcription)))
    (let ((mark (cdr transcription)))
      (if (if (raw-form? output "define-syntax")
              #t
              (definition-begin? output))
          output
          (expand-expression
            output
            (alias-value-environment
              (transformer-definition-env transformer) mark value-env)
            (alias-macro-environment
              (transformer-definition-macro-env transformer) mark macro-env))))))

(define (case-datum-seen? datum seen)
  (if (null? seen)
      #f
      (if (syntax-equal? datum (car seen))
          #t
          (case-datum-seen? datum (cdr seen)))))

(define (validate-case-datums datums seen)
  (if (null? datums)
      seen
      (if (not (pair? datums))
          (fatal "case datum list must be proper")
          (let ((datum (car datums)))
            (if (case-datum-seen? datum seen)
                (fatal "duplicate case datum"))
            (validate-case-datums (cdr datums) (cons datum seen))))))

(define (validate-case-clauses clauses seen)
  (if (null? clauses)
      seen
      (if (not (pair? clauses))
          (fatal "case clauses must be proper")
          (let ((clause (car clauses)))
            (if (not (pair? clause))
                (fatal "malformed case clause"))
            (let ((head (car clause)))
              (if (if (datum-symbol? head)
                      (string=? (datum-symbol-name head) "else")
                      #f)
                  (validate-case-clauses (cdr clauses) seen)
                  (validate-case-clauses
                    (cdr clauses)
                    (validate-case-datums head seen))))))))

(define (internal-case-use? expression)
  (if (null? (cdr expression))
      #f
      (let ((head (car expression)))
        (let ((argument (car (cdr expression))))
          (if (datum-symbol? argument)
              (if (string=? (datum-symbol-name argument) "_case")
                  (= (identifier-mark argument) (identifier-mark head))
                  #f)
              #f)))))

(define (validate-case-use expression)
  (if (not (internal-case-use? expression))
      (if (not (null? (cdr expression)))
          (validate-case-clauses (cdr (cdr expression)) ()))))

(define (expand-pair-expression expression value-env macro-env)
  (let ((head (car expression)))
    (if (datum-symbol? head)
        (let ((transformer
                (if (head-value-bound? head value-env)
                    ()
                    (lookup-macro-binding head macro-env))))
          (if (not (null? transformer))
              (begin
                (if (if (string=? (datum-symbol-name head) "case")
                        (not (internal-case-use? expression))
                        #f)
                    (validate-case-use expression))
                (if (eq? transformer UNINITIALIZED-SYNTAX)
                    (fatal "syntax keyword used before its definition")
                    (expand-transcription
                      transformer
                      (transcribe-macro transformer expression value-env)
                      value-env macro-env)))
              (if (head-value-bound? head value-env)
                  (expand-application expression value-env macro-env)
                  (expand-keyword-or-application
                    expression (datum-symbol-name head)
                    value-env macro-env))))
        (expand-application expression value-env macro-env))))

(define (expand-keyword-or-application form name value-env macro-env)
  (cond
    ((string=? name "quote") form)
    ((string=? name "quasiquote")
     (expand-quasiquote-form form value-env macro-env))
    ((string=? name "lambda") (expand-lambda form value-env macro-env))
    ((string=? name "define") (expand-define form value-env macro-env))
    ((string=? name "if") (expand-if form value-env macro-env))
    ((string=? name "begin")
     (cons (car form)
           (expand-expression-list (cdr form) value-env macro-env)))
    ((string=? name "let")
     (expand-binding-form form 1 value-env macro-env))
    ((string=? name "let*")
     (expand-binding-form form 2 value-env macro-env))
    ((string=? name "letrec")
     (expand-binding-form form 3 value-env macro-env))
    ((string=? name "letrec*")
     (expand-binding-form form 4 value-env macro-env))
    ((string=? name "let-syntax")
     (expand-local-syntax form #f value-env macro-env))
    ((string=? name "letrec-syntax")
     (expand-local-syntax form #t value-env macro-env))
    ((string=? name "let-values")
     (expand-let-values form value-env macro-env))
    ((string=? name "define-values")
     (expand-define-values form value-env macro-env))
    ((string=? name "cond-expand")
     (expand-expression
       (library-expand-cond-expression form) value-env macro-env))
    ((string=? name "set!") (expand-set form value-env macro-env))
    ((string=? name "syntax-error") (expand-syntax-error form))
    ((string=? name "define-syntax")
     (fatal "define-syntax is not valid in expression position"))
    ((string=? name "syntax-rules")
     (fatal "syntax-rules is not valid in expression position"))
    (else
     (if (> (cell-get EXPAND-REQUIRE-BOUND) 0)
         (fatal (string-append "unbound identifier: " name))
         (expand-application form value-env macro-env)))))

(define (expand-expression-list expressions value-env macro-env)
  (if (null? expressions)
      ()
      (if (pair? expressions)
          (cons (expand-expression (car expressions) value-env macro-env)
                (expand-expression-list (cdr expressions)
                                        value-env macro-env))
          (begin
            (display "nplc1: improper expression tail: ")
            (display expressions)
            (newline)
            (fatal "expression list must be proper")))))

(define (expand-application form value-env macro-env)
  (expand-expression-list form value-env macro-env))

(define (bind-identifiers identifiers environment)
  (if (null? identifiers)
      (cons () environment)
      (if (not (pair? identifiers))
          (fatal "identifier list must be proper")
          (let ((identifier (car identifiers)))
            (if (not (datum-symbol? identifier))
                (fatal "binding name must be an identifier"))
            (let ((emitted (fresh-value-name identifier)))
              (let ((rest
                      (bind-identifiers
                        (cdr identifiers)
                        (add-value-binding identifier emitted environment))))
                (cons (cons (datum-symbol emitted) (car rest))
                      (cdr rest))))))))

(define (prepend-identifiers-reversed identifiers acc)
  (if (null? identifiers)
      acc
      (if (not (pair? identifiers))
          (fatal "definition names must be a proper list")
          (prepend-identifiers-reversed
            (cdr identifiers) (cons (car identifiers) acc)))))

(define (bind-formals formals environment)
  (if (null? formals)
      (cons () environment)
      (if (datum-symbol? formals)
          (let ((emitted (fresh-value-name formals)))
            (cons (datum-symbol emitted)
                  (add-value-binding formals emitted environment)))
          (if (not (pair? formals))
              (fatal "malformed procedure formals")
              (let ((identifier (car formals)))
                (if (not (datum-symbol? identifier))
                    (fatal "formal name must be an identifier"))
                (let ((emitted (fresh-value-name identifier)))
                  (let ((rest
                          (bind-formals
                            (cdr formals)
                            (add-value-binding
                              identifier emitted environment))))
                    (cons (cons (datum-symbol emitted) (car rest))
                          (cdr rest)))))))))

(define (body-defined-identifiers body acc)
  (if (null? body)
      (rev acc)
      (let ((form (car body)))
        (if (raw-form? form "define-syntax")
            (body-defined-identifiers (cdr body) acc)
            (let ((identifiers (direct-defined-identifiers form)))
              (if (null? identifiers)
                  (rev acc)
                  (body-defined-identifiers
                    (cdr body)
                    (prepend-identifiers-reversed identifiers acc))))))))

(define (bind-body-definitions body environment)
  (bind-identifiers (body-defined-identifiers body ()) environment))

(define (syntax-definition-keyword form)
  (if (raw-form? form "define-syntax")
      (begin
        (require-raw-arity form 2 "define-syntax")
        (let ((keyword (car (cdr form))))
          (if (datum-symbol? keyword)
              keyword
              (fatal "define-syntax needs an identifier"))))
      ()))

(define (identifier-name-seen? identifier identifiers)
  (if (null? identifiers)
      #f
      (if (string=? (datum-symbol-name identifier)
                    (datum-symbol-name (car identifiers)))
          #t
          (identifier-name-seen? identifier (cdr identifiers)))))

(define (prebind-body-syntax body macro-env seen)
  (if (null? body)
      macro-env
      (let ((form (car body)))
        (if (raw-form? form "define-syntax")
            (let ((keyword (syntax-definition-keyword form)))
              (if (identifier-name-seen? keyword seen)
                  (fatal "duplicate internal syntax keyword"))
              (prebind-body-syntax
                (cdr body)
                (add-macro-binding keyword UNINITIALIZED-SYNTAX macro-env)
                (cons keyword seen)))
            (if (if (raw-form? form "define")
                    #t
                    (raw-form? form "define-values"))
                (prebind-body-syntax (cdr body) macro-env seen)
                macro-env)))))

(define (expand-body-sequence body value-env macro-env)
  (if (null? body)
      ()
      (let ((form (car body)))
        (if (raw-form? form "define-syntax")
            (let ((keyword (syntax-definition-keyword form)))
              (let ((binding-cell (lookup-macro-cell keyword macro-env)))
                (if (null? binding-cell)
                    (let ((transformer
                            (parse-syntax-rules
                              (car (cdr (cdr form)))
                              value-env macro-env)))
                      (expand-body-sequence
                        (cdr body) value-env
                        (add-macro-binding keyword transformer macro-env)))
                    (begin
                      (cell-set! binding-cell
                        (parse-syntax-rules
                          (car (cdr (cdr form))) value-env macro-env))
                      (expand-body-sequence
                        (cdr body) value-env macro-env)))))
            (if (raw-form? form "define")
                (cons (expand-expression form value-env macro-env)
                      (expand-body-sequence
                        (cdr body) value-env macro-env))
                (let ((expanded
                        (expand-expression form value-env macro-env)))
                  (if (definition-begin? expanded)
                      (let ((spliced
                              (append-forms (cdr expanded) (cdr body))))
                        (let ((spliced-macros
                                (prebind-body-syntax
                                  spliced macro-env ())))
                          (expand-body-sequence
                            spliced value-env spliced-macros)))
                      (if (raw-form? expanded "define")
                          (cons expanded
                                (expand-body-sequence
                                  (cdr body) value-env macro-env))
                          (cons expanded
                                (expand-expression-list
                                  (cdr body) value-env macro-env))))))))))

(define (expand-body body value-env macro-env)
  (let ((bound (bind-body-definitions body value-env)))
    (let ((body-macros (prebind-body-syntax body macro-env ())))
      (expand-body-sequence body (cdr bound) body-macros))))

(define (expand-lambda form value-env macro-env)
  (if (null? (cdr form)) (fatal "lambda needs parameters"))
  (let ((bound (bind-formals (car (cdr form)) value-env)))
    (cons (car form)
      (cons (car bound)
        (expand-body (cdr (cdr form)) (cdr bound) macro-env)))))

(define (defined-target-identifier target)
  (if (datum-symbol? target)
      target
      (if (pair? target)
          (if (datum-symbol? (car target)) (car target) ())
          ())))

(define (rename-defined-target target environment)
  (if (datum-symbol? target)
      (resolve-identifier target environment)
      (if (pair? target)
          (cons (resolve-identifier (car target) environment)
                (cdr target))
          target)))

(define (expand-define form value-env macro-env)
  (if (null? (cdr form)) (fatal "define needs a target"))
  (let ((target (car (cdr form))))
    (let ((rest (cdr (cdr form))))
      (if (datum-symbol? target)
          (cons (car form)
            (cons (resolve-identifier target value-env)
                  (expand-expression-list rest value-env macro-env)))
          (if (pair? target)
              (let ((bound (bind-formals (cdr target) value-env)))
                (cons (car form)
                  (cons
                    (cons (resolve-identifier (car target) value-env)
                          (car bound))
                    (expand-body rest (cdr bound) macro-env))))
              (fatal "bad define target"))))))

(define (expand-if form value-env macro-env)
  (cons (car form)
        (expand-expression-list (cdr form) value-env macro-env)))

(define (expand-set form value-env macro-env)
  (require-raw-arity form 2 "set!")
  (let ((identifier (car (cdr form))))
    (if (not (datum-symbol? identifier))
        (fatal "set! needs an identifier"))
    (cons (car form)
      (cons (resolve-identifier identifier value-env)
        (cons (expand-expression (car (cdr (cdr form)))
                                 value-env macro-env)
              ())))))

(define (binding-identifiers bindings)
  (if (null? bindings)
      ()
      (if (not (pair? bindings))
          (fatal "bindings must be a proper list")
          (let ((binding (car bindings)))
            (if (if (not (pair? binding))
                    #t
                    (not (datum-symbol? (car binding))))
                (fatal "malformed binding"))
            (cons (car binding)
                  (binding-identifiers (cdr bindings)))))))

(define (expand-bound-bindings bindings names init-env body-env macro-env)
  (if (null? bindings)
      ()
      (let ((binding (car bindings)))
        (cons
          (cons (car names)
            (cons (expand-expression (car (cdr binding))
                                     init-env macro-env)
                  ()))
          (expand-bound-bindings (cdr bindings) (cdr names)
                                 init-env body-env macro-env)))))

(define (expand-let-star-bindings bindings environment macro-env)
  (if (null? bindings)
      (cons () environment)
      (let ((binding (car bindings)))
        (if (if (not (pair? binding))
                #t
                (not (datum-symbol? (car binding))))
            (fatal "malformed binding"))
        (let ((identifier (car binding)))
          (let ((emitted (fresh-value-name identifier)))
            (let ((expanded-init
                    (expand-expression (car (cdr binding))
                                       environment macro-env)))
              (let ((next-env
                      (add-value-binding identifier emitted environment)))
                (let ((rest
                        (expand-let-star-bindings
                          (cdr bindings) next-env macro-env)))
                  (cons
                    (cons
                      (cons (datum-symbol emitted)
                            (cons expanded-init ()))
                      (car rest))
                    (cdr rest))))))))))

; kind: 1 let, 2 let*, 3 letrec, 4 letrec*
(define (expand-binding-form form kind value-env macro-env)
  (if (null? (cdr form)) (fatal "binding form needs bindings"))
  (if (if (= kind 1) (datum-symbol? (car (cdr form))) #f)
      (expand-named-let form value-env macro-env)
      (expand-ordinary-binding-form form kind value-env macro-env)))

; R7RS 4.2.4: (let name ((var init) ...) body ...) is
; ((letrec ((name (lambda (var ...) body ...))) name) init ...).
; The result is already expanded; the inits see the outer environment only.
(define (expand-named-let form value-env macro-env)
  (let ((name (car (cdr form))))
    (if (null? (cdr (cdr form))) (fatal "named let needs bindings"))
    (let ((bindings (checked-raw-bindings (car (cdr (cdr form))))))
      (let ((body (cdr (cdr (cdr form)))))
        (if (null? body) (fatal "binding form needs a body"))
        (let ((bound (bind-identifiers (cons name ()) value-env)))
          (let ((emitted (car (car bound))))
            (let ((procedure
                    (expand-lambda
                      (cons (datum-symbol "lambda")
                            (cons (binding-identifiers bindings) body))
                      (cdr bound) macro-env)))
              (cons
                (cons (datum-symbol "letrec")
                  (cons (cons (cons emitted (cons procedure ())) ())
                        (cons emitted ())))
                (expand-expression-list
                  (named-let-inits bindings) value-env macro-env)))))))))

(define (named-let-inits bindings)
  (if (null? bindings)
      ()
      (cons (car (cdr (car bindings)))
            (named-let-inits (cdr bindings)))))

(define (expand-ordinary-binding-form form kind value-env macro-env)
  (let ((bindings (checked-raw-bindings (car (cdr form)))))
    (let ((body (cdr (cdr form))))
      (if (= kind 2)
          (let ((expanded
                  (expand-let-star-bindings bindings value-env macro-env)))
            (cons (car form)
              (cons (car expanded)
                    (expand-body body (cdr expanded) macro-env))))
          (let ((bound
                  (bind-identifiers
                    (binding-identifiers bindings) value-env)))
            (let ((body-env (cdr bound)))
              (let ((init-env (if (= kind 1) value-env body-env)))
                (cons (car form)
                  (cons
                    (expand-bound-bindings bindings (car bound)
                                            init-env body-env macro-env)
                    (expand-body body body-env macro-env))))))))))

(define (values-producer-records bindings value-env macro-env)
  (if (null? bindings)
      ()
      (if (not (pair? bindings))
          (fatal "let-values bindings must be a proper list")
          (let ((binding (car bindings)))
            (if (not (pair? binding))
                (fatal "malformed let-values binding"))
            (if (not (= (raw-list-count binding 0) 2))
                (fatal "malformed let-values binding"))
            (let ((identifiers (car binding)))
              (bind-identifiers identifiers value-env)
              (let ((producer
                      (datum-symbol
                        (fresh-value-name
                          (datum-symbol "values_producer")))))
                (cons
                  (cons producer
                    (cons identifiers
                      (cons
                        (expand-expression
                          (car (cdr binding)) value-env macro-env)
                        ())))
                  (values-producer-records
                    (cdr bindings) value-env macro-env))))))))

(define (values-producer-bindings records)
  (if (null? records)
      ()
      (let ((record (car records)))
        (cons
          (cons (car record)
            (cons
              (cons (datum-symbol "lambda")
                    (cons () (cons (car (cdr (cdr record))) ())))
              ()))
          (values-producer-bindings (cdr records))))))

(define (values-consumer-chain records body value-env macro-env)
  (if (null? records)
      (expanded-body-expression
        (expand-body body value-env macro-env))
      (let ((record (car records)))
        (let ((bound
                (bind-identifiers (car (cdr record)) value-env)))
          (cons (datum-symbol "call-with-values")
            (cons (car record)
              (cons
                (cons (datum-symbol "lambda")
                  (cons (car bound)
                    (cons
                      (values-consumer-chain
                        (cdr records) body (cdr bound) macro-env)
                      ())))
                ())))))))

(define (expand-let-values form value-env macro-env)
  (if (null? (cdr form)) (fatal "let-values needs bindings"))
  (let ((body (cdr (cdr form))))
    (if (null? body) (fatal "let-values needs a body"))
    (let ((records
            (values-producer-records
              (car (cdr form)) value-env macro-env)))
      (if (null? records)
          (expanded-body-expression
            (expand-body body value-env macro-env))
          (cons (datum-symbol "let")
            (cons (values-producer-bindings records)
              (cons
                (values-consumer-chain
                  records body value-env macro-env)
                ())))))))

(define (values-pack-expression identifiers)
  (if (null? identifiers)
      (cons (datum-symbol "quote") (cons () ()))
      (cons (datum-symbol "cons")
        (cons (car identifiers)
          (cons (values-pack-expression (cdr identifiers)) ())))))

(define (define-values-forms identifiers rest)
  (if (null? identifiers)
      ()
      (cons
        (cons (datum-symbol "define")
          (cons (car identifiers)
            (cons
              (cons (datum-symbol "car") (cons rest ()))
              ())))
        (define-values-forms
          (cdr identifiers)
          (cons (datum-symbol "cdr") (cons rest ()))))))

(define (expand-define-values form value-env macro-env)
  (require-raw-arity form 2 "define-values")
  (let ((identifiers (car (cdr form))))
    (let ((bound (bind-identifiers identifiers value-env)))
      (let ((packed
              (datum-symbol
                (fresh-value-name (datum-symbol "values_packed")))))
        (let ((initializer
                (expand-expression
                  (car (cdr (cdr form))) value-env macro-env)))
          (let ((producer
                  (cons (datum-symbol "lambda")
                    (cons () (cons initializer ())))))
            (let ((consumer
                    (cons (datum-symbol "lambda")
                      (cons (car bound)
                        (cons
                          (values-pack-expression (car bound))
                          ())))))
              (cons (datum-symbol "begin")
                (cons
                  (cons (datum-symbol "define")
                    (cons packed
                      (cons
                        (cons (datum-symbol "call-with-values")
                          (cons producer (cons consumer ())))
                        ())))
                  (define-values-forms identifiers packed))))))))))

(define (local-syntax-binding-keyword binding)
  (if (not (pair? binding)) (fatal "malformed syntax binding"))
  (if (not (= (raw-list-count binding 0) 2))
      (fatal "malformed syntax binding"))
  (let ((keyword (car binding)))
    (if (datum-symbol? keyword)
        keyword
        (fatal "syntax binding needs an identifier"))))

(define (prebind-local-syntax bindings macro-env seen)
  (if (null? bindings)
      macro-env
      (if (not (pair? bindings))
          (fatal "syntax bindings must be a proper list")
          (let ((keyword
                  (local-syntax-binding-keyword (car bindings))))
            (if (identifier-name-seen? keyword seen)
                (fatal "duplicate local syntax keyword"))
            (prebind-local-syntax
              (cdr bindings)
              (add-macro-binding keyword UNINITIALIZED-SYNTAX macro-env)
              (cons keyword seen))))))

(define (fill-local-syntax bindings value-env definition-macro-env body-macro-env)
  (if (null? bindings)
      body-macro-env
      (let ((binding (car bindings)))
        (let ((keyword (local-syntax-binding-keyword binding)))
          (let ((transformer
                  (parse-syntax-rules
                    (car (cdr binding)) value-env definition-macro-env)))
            (let ((binding-cell
                    (lookup-macro-cell keyword body-macro-env)))
              (if (null? binding-cell)
                  (fatal "local syntax binding is missing"))
              (cell-set! binding-cell transformer)
              (fill-local-syntax (cdr bindings) value-env
                                 definition-macro-env body-macro-env)))))))

(define (expand-let-syntax-nonrecursive bindings value-env macro-env acc seen)
  (if (null? bindings)
      acc
      (if (not (pair? bindings))
          (fatal "syntax bindings must be a proper list")
          (let ((binding (car bindings)))
            (let ((keyword (local-syntax-binding-keyword binding)))
              (if (identifier-name-seen? keyword seen)
                  (fatal "duplicate local syntax keyword"))
              (let ((transformer
                      (parse-syntax-rules
                        (car (cdr binding)) value-env macro-env)))
                (expand-let-syntax-nonrecursive
                  (cdr bindings) value-env macro-env
                  (add-macro-binding keyword transformer acc)
                  (cons keyword seen))))))))

(define (expanded-body-expression body)
  (if (null? body)
      (fatal "syntax binding form needs a body")
      (if (null? (cdr body))
          (car body)
          (cons (datum-symbol "begin") body))))

(define (expand-local-syntax form recursive value-env macro-env)
  (if (null? (cdr form)) (fatal "syntax binding form needs bindings"))
  (let ((bindings (car (cdr form))))
    (let ((body (cdr (cdr form))))
      (if recursive
          (let ((body-macros
                  (prebind-local-syntax bindings macro-env ())))
            (fill-local-syntax bindings value-env body-macros body-macros)
            (expanded-body-expression
              (expand-body body value-env body-macros)))
          (let ((body-macros
                  (expand-let-syntax-nonrecursive
                    bindings value-env macro-env macro-env ())))
            (expanded-body-expression
              (expand-body body value-env body-macros)))))))

(define (expand-quasiquote-form form value-env macro-env)
  (require-raw-arity form 1 "quasiquote")
  (cons (car form)
    (cons (expand-quasiquote (car (cdr form)) 1 value-env macro-env) ())))

(define (expand-quasiquote value depth value-env macro-env)
  (cond
    ((raw-form? value "quasiquote")
     (cons (car value)
       (cons (expand-quasiquote (raw-single-argument value "quasiquote")
                                (+ depth 1) value-env macro-env)
             ())))
    ((raw-form? value "unquote")
     (cons (car value)
       (cons
         (if (= depth 1)
             (expand-expression (raw-single-argument value "unquote")
                                value-env macro-env)
             (expand-quasiquote (raw-single-argument value "unquote")
                                (- depth 1) value-env macro-env))
         ())))
    ((raw-form? value "unquote-splicing")
     (cons (car value)
       (cons
         (if (= depth 1)
             (expand-expression
               (raw-single-argument value "unquote-splicing")
               value-env macro-env)
             (expand-quasiquote
               (raw-single-argument value "unquote-splicing")
               (- depth 1) value-env macro-env))
         ())))
    ((datum-vector? value)
     (datum-vector
       (expand-quasiquote-list (datum-vector-items value) depth
                               value-env macro-env)))
    ((datum-symbol? value) value)
    ((datum-string? value) value)
    ((datum-char? value) value)
    ((datum-bytevector? value) value)
    ((datum-true? value) value)
    ((datum-false? value) value)
    ((pair? value)
     (expand-quasiquote-list value depth value-env macro-env))
    (else value)))

(define (expand-quasiquote-list values depth value-env macro-env)
  (if (null? values)
      ()
      (if (pair? values)
          (cons (expand-quasiquote (car values) depth value-env macro-env)
                (expand-quasiquote-list (cdr values) depth
                                        value-env macro-env))
          (expand-quasiquote values depth value-env macro-env))))

(define (expand-syntax-error form)
  (if (null? (cdr form))
      (fatal "syntax-error needs a message"))
  (let ((message (car (cdr form))))
    (if (datum-string? message)
        (fatal (datum-string-text message))
        (fatal "syntax-error message must be a string"))))
