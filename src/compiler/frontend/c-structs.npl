; (define-c-struct name "c_type" (field c-type) ...)
;
; The layout is normally read from c-struct-layouts.meta, generated at build
; time by `nplc --emit=c-structs` (or installed with a native package), so
; importing a core library never runs a C compiler.  A type missing from the
; cache falls back to compiling and running a tiny C program with
; sizeof/offsetof.  The resulting descriptor is emitted as a quoted value, so
; make-c-struct/c-struct-ref need no generated C stubs.  Only pointer-to-
; struct values cross the FFI boundary; by-value structs stay out of scope.
;
; The declaration is a top-level core form like define-c-function.  The C
; compiler is NPL_CC, else CC, else "cc".  The result is cached per c_type.

(define C-STRUCTS (cell ()))
(define C-STRUCT-LAYOUTS (cell ()))
; Layouts generated by the build or installed with a package, loaded once.
(define C-STRUCT-CACHE (cell #f))

(define (c-struct-declaration? form value-env macro-env)
  (if (raw-form? form "define-c-struct")
      (head-is-core? form "define-c-struct" value-env macro-env)
      #f))

(define (c-struct-c-identifier-char? code)
  (if (if (> 64 code) (< code 91) #f) #t
      (if (if (> 96 code) (< code 123) #f) #t
          (if (if (> 47 code) (< code 58) #f) #t
              (= code 95)))))

; string-ref returns a tagged character; char->integer returns a tagged
; code, so divide by four before comparing with ASCII constants.
(define (c-struct-byte-at text index)
  (npl_number_quotient (char->integer (string-ref text index)) 4))

(define (c-struct-c-identifier? text start index)
  (if (= index (string-length text))
      #t
      (if (c-struct-c-identifier-char? (c-struct-byte-at text index))
          (c-struct-c-identifier? text start (+ index 1))
          #f)))

(define (c-struct-check-field-name name)
  (if (if (> (string-length name) 0)
          (c-struct-c-identifier? name 0 0)
          #f)
      #t
      (fatal (string-append "define-c-struct: bad field name: " name))))

; C type text is a typedef or "struct tag": letters, digits, '_' and spaces.
(define (c-struct-c-type-char? code)
  (if (if (> 64 code) (< code 91) #f) #t
      (if (if (> 96 code) (< code 123) #f) #t
          (if (if (> 47 code) (< code 58) #f) #t
              (if (= code 95) #t (= code 32))))))

(define (c-struct-c-type? text index)
  (if (= index (string-length text))
      (> (string-length text) 0)
      (if (c-struct-c-type-char? (c-struct-byte-at text index))
          (c-struct-c-type? text (+ index 1))
          #f)))

(define (c-struct-type-code type)
  (let ((name (datum-symbol-name type)))
    (cond
      ((string=? name "u8") 0)
      ((string=? name "u16") 1)
      ((string=? name "u32") 2)
      ((string=? name "u64") 3)
      ((string=? name "i8") 4)
      ((string=? name "i16") 5)
      ((string=? name "i32") 6)
      ((string=? name "i64") 7)
      ((string=? name "float") 8)
      ((string=? name "double") 9)
      ((string=? name "pointer") 10)
      ((string=? name "int") 6)
      ((string=? name "long") 7)
      ((string=? name "int64") 7)
      ((string=? name "size_t") 3)
      ((string=? name "bool") 11)
      (else (fatal (string-append
                     "define-c-struct: unknown field type: " name))))))

(define (c-struct-fields fields)
  (if (null? fields)
      ()
      (let ((field (car fields)))
        (if (not (pair? field))
            (fatal "define-c-struct field must be (name c-type)"))
        (if (not (= (raw-list-count field 0) 2))
            (fatal "define-c-struct field must be (name c-type)"))
        (let ((name (car field))
              (type (car (cdr field))))
          (if (not (datum-symbol? name))
              (fatal "define-c-struct field name must be an identifier"))
          (if (not (datum-symbol? type))
              (fatal "define-c-struct field type must be an identifier"))
          (c-struct-check-field-name (datum-symbol-name name))
          (cons (cons (datum-symbol-name name) (c-struct-type-code type))
                (c-struct-fields (cdr fields)))))))

(define (c-struct-probe-source c-type fields)
  (let ((header
          (string-append
            "#define _GNU_SOURCE\n#define _DARWIN_C_SOURCE\n"
            "#include <stddef.h>\n#include <stdio.h>\n#include <stdint.h>\n"
            "#include <time.h>\n#include <sys/stat.h>\n#include <stdlib.h>\n"
            "#ifndef _WIN32\n"
            "#include <sys/time.h>\n#include <dirent.h>\n"
            "#include <pwd.h>\n#include <grp.h>\n"
            "#include <sys/utsname.h>\n#include <sys/resource.h>\n"
            "#include <sys/uio.h>\n#include <sys/select.h>\n"
            "#endif\n"
            "int main(void) {\n  printf(\"((size . %zu)\", sizeof("
            c-type "));\n")))
    (let loop ((items fields) (text header))
      (if (null? items)
          (string-append text "  printf(\")\\n\");\n  return 0;\n}\n")
          (let ((name (car (car items))))
            (loop (cdr items)
              (string-append text
                "  printf(\" (" name " . %zu)\", offsetof(" c-type ", "
                name "));\n")))))))

(define (c-struct-cc)
  (let ((configured (get-environment-variable "NPL_CC")))
    (if configured configured
        (let ((cc (get-environment-variable "CC")))
          (if cc cc
              (if (npl_platform_feature "windows") "clang" "cc"))))))

(define (c-struct-parse-layout text)
  (let ((forms (parse-source-text text)))
    (if (null? forms)
        (fatal "define-c-struct: empty layout probe output")
        (car forms))))

(define (c-struct-probe c-type fields)
  (let* ((directory (make-temporary-directory))
         (windows? (npl_platform_feature "windows"))
         (source (string-append directory "/layout.c"))
         (binary (string-append directory (if windows? "/layout.exe" "/layout")))
         (output (string-append directory "/layout.out")))
    (let ((port (open-output-file source)))
      (display (c-struct-probe-source c-type fields) port)
      (close-port port))
    (let ((cc (c-struct-cc)))
      (let ((status
              (run-process
                (cons cc
                  (cons "-std=c99"
                    (cons "-o" (cons binary (cons source ())))))
                (if windows? "NUL" "/dev/null"))))
        (if (not (= status 0))
            (fatal (string-append
                     "define-c-struct: C probe compilation failed for "
                     c-type)))))
    (let ((status (run-process (cons binary ()) output)))
      (if (not (= status 0))
          (fatal (string-append
                   "define-c-struct: C probe failed for " c-type))))
    (let ((text (read-file output)))
      (delete-file source)
      (delete-file binary)
      (delete-file output)
      (delete-directory directory)
      (c-struct-parse-layout text))))

; NPL_C_STRUCT_LAYOUTS is a search path: colon-separated explicit files
; first, then the build/install cache beside the native packages.  A package
; that ships its own cache therefore still sees the core layouts.
(define (c-struct-explicit-cache-paths text start index paths)
  (let ((sep (if (npl_platform_feature "windows") 59 58)))
    (if (= index (string-length text))
        (rev (if (= start index) paths
                 (cons (substring text start index) paths)))
        (if (= (string-byte-ref text index) sep)
            (c-struct-explicit-cache-paths
              text (+ index 1) (+ index 1)
              (if (= start index) paths
                  (cons (substring text start index) paths)))
            (c-struct-explicit-cache-paths text start (+ index 1) paths)))))

(define (c-struct-default-cache-paths)
  (let ((stdlib (string-append (cell-get LIBRARY-STANDARD-ROOT)
                               "npl/native/c-struct-layouts.meta"))
        (self (executable-path)))
    (if self
        (cons (string-append (path-dir self)
                             "../lib/npl/native/c-struct-layouts.meta")
              (cons stdlib ()))
        (cons stdlib ()))))

(define (c-struct-cache-candidates)
  (let ((explicit (get-environment-variable "NPL_C_STRUCT_LAYOUTS")))
    (if (if explicit (> (string-length explicit) 0) #f)
        (append (c-struct-explicit-cache-paths explicit 0 0 ())
                (c-struct-default-cache-paths))
        (c-struct-default-cache-paths))))

(define (c-struct-cache-entries form entries)
  (if (null? form)
      (rev entries)
      (let ((entry (car form)))
        (if (not (pair? entry))
            (fatal "c-struct layout cache entry must be a list")
            (if (not (datum-string? (car entry)))
                (fatal "c-struct layout cache type must be a string")
                (c-struct-cache-entries (cdr form) (cons entry entries)))))))

(define (c-struct-cache-read path)
  (let ((forms (parse-source-file path)))
    (if (null? forms)
        (fatal (string-append "empty c-struct layout cache: " path))
        (let ((form (car forms)))
          (if (raw-form? form "c-struct-layouts")
              (c-struct-cache-entries (cdr form) ())
              (fatal (string-append "bad c-struct layout cache: " path)))))))

(define (c-struct-read-caches paths layouts)
  (if (null? paths)
      layouts
      (c-struct-read-caches
        (cdr paths)
        (if (file-exists? (car paths))
            (append layouts (c-struct-cache-read (car paths)))
            layouts))))

(define (c-struct-disk-layouts)
  (if (cell-get C-STRUCT-CACHE)
      (cell-get C-STRUCT-CACHE)
      (let ((layouts (c-struct-read-caches (c-struct-cache-candidates) ())))
        (cell-set! C-STRUCT-CACHE layouts)
        layouts)))

(define (c-struct-disk-entry c-type entries)
  (if (null? entries)
      ()
      (if (string=? c-type (datum-string-text (car (car entries))))
          (car entries)
          (c-struct-disk-entry c-type (cdr entries)))))

(define (c-struct-layout-complete? fields layout)
  (if (null? fields)
      #t
      (if (null? (c-struct-layout-entry (datum-symbol (car (car fields)))
                                        layout))
          #f
          (c-struct-layout-complete? (cdr fields) layout))))

(define (c-struct-cache-layout c-type fields)
  (let ((entry (c-struct-disk-entry c-type (c-struct-disk-layouts))))
    (if (null? entry)
        ()
        (let ((layout (cdr entry)))
          (if (if (null? (c-struct-layout-entry (datum-symbol "size") layout))
                  #f
                  (c-struct-layout-complete? fields layout))
              layout
              ())))))

; Keep earlier offsets while adding the fields a new declaration needs, so
; one type can be described by several declarations in one compilation.
(define (c-struct-layout-merge old new)
  (if (null? old)
      new
      (if (null? (c-struct-layout-entry (car (car old)) new))
          (cons (car old) (c-struct-layout-merge (cdr old) new))
          (c-struct-layout-merge (cdr old) new))))

(define (c-struct-cache-store c-type layout)
  (cell-set! C-STRUCT-LAYOUTS
             (cons (cons c-type layout) (cell-get C-STRUCT-LAYOUTS)))
  layout)

; The in-process cache is keyed by C type, so a layout that lacks a field a
; later declaration needs is not a hit: consult the disk cache, then probe,
; and merge instead of replacing (R20).
(define (c-struct-layout c-type fields)
  (let ((cached (string-assoc c-type (cell-get C-STRUCT-LAYOUTS))))
    (if (if (pair? cached)
            (c-struct-layout-complete? fields (cdr cached))
            #f)
        (cdr cached)
        (let ((disk (c-struct-cache-layout c-type fields)))
          (if (pair? disk)
              (c-struct-cache-store c-type
                (if (pair? cached)
                    (c-struct-layout-merge (cdr cached) disk)
                    disk))
              (c-struct-cache-store c-type
                (if (pair? cached)
                    (c-struct-layout-merge
                      (cdr cached) (c-struct-probe c-type fields))
                    (c-struct-probe c-type fields))))))))

; nplc --emit=c-structs writes this file for the build and for packages.
(define (c-struct-layout-text layout)
  (if (null? layout)
      ""
      (let ((entry (car layout)))
        (string-append " (" (datum-symbol-name (car entry)) " . "
                       (number->string (cdr entry)) ")"
                       (c-struct-layout-text (cdr layout))))))

(define (c-struct-cache-line entry)
  (string-append "  (\"" (car entry) "\""
                 (c-struct-layout-text (cdr entry)) ")\n"))

(define (write-c-struct-layouts port)
  (display "(c-struct-layouts\n" port)
  (let loop ((entries (rev (cell-get C-STRUCT-LAYOUTS))))
    (if (pair? entries)
        (begin
          (display (c-struct-cache-line (car entries)) port)
          (loop (cdr entries)))))
  (display ")\n" port))

(define (c-struct-layout-entry key entries)
  (if (null? entries)
      ()
      (if (string=? (datum-symbol-name key)
                    (datum-symbol-name (car (car entries))))
          (car entries)
          (c-struct-layout-entry key (cdr entries)))))

(define (c-struct-layout-number key layout)
  (let ((entry (c-struct-layout-entry key layout)))
    (if (null? entry)
        (fatal (string-append "define-c-struct: missing layout for "
                              (datum-symbol-name key)))
        (cdr entry))))

(define (c-struct-field-entries fields layout entries)
  (if (null? fields)
      (rev entries)
      (let* ((field (car fields))
             (name (car field))
             (code (cdr field))
             (offset (c-struct-layout-number (datum-symbol name) layout)))
        (c-struct-field-entries
          (cdr fields) layout
          (cons (cons (datum-symbol name)
                  (cons offset (cons code ())))
                entries)))))

(define (c-struct-descriptor-datum c-type fields layout)
  (cons (datum-symbol "quote")
    (cons
      (cons (cons (datum-symbol "c-type") (datum-string c-type))
        (cons
          (cons (datum-symbol "size")
                (c-struct-layout-number (datum-symbol "size") layout))
          (cons
            (cons (datum-symbol "fields")
                  (c-struct-field-entries fields layout ()))
            ())))
      ())))

(define (c-struct-register name c-type fields)
  (cell-set! C-STRUCTS
             (cons (cons (datum-symbol-name name)
                     (cons c-type (cons fields ())))
                   (cell-get C-STRUCTS))))

(define (c-struct-definition form)
  (if (not (>= (raw-list-count (cdr form) 0) 3))
      (fatal "malformed define-c-struct"))
  (let ((name (car (cdr form)))
        (type-value (car (cdr (cdr form))))
        (field-forms (cdr (cdr (cdr form)))))
    (if (not (datum-symbol? name))
        (fatal "define-c-struct needs an identifier"))
    (if (not (datum-string? type-value))
        (fatal "define-c-struct needs a C type string"))
    (let ((c-type (datum-string-text type-value)))
      (if (not (c-struct-c-type? c-type 0))
          (fatal (string-append "define-c-struct: bad C type: " c-type)))
      (let* ((fields (c-struct-fields field-forms))
             (layout (c-struct-layout c-type fields)))
        (c-struct-register name c-type fields)
        (cons (datum-symbol "define")
          (cons name
            (cons (c-struct-descriptor-datum c-type fields layout) ())))))))

(define (c-struct-type-name type)
  (let ((name (datum-symbol-name type)))
    (if (>= (string-length name) 7)
        (if (string=? (substring name 0 7) "struct:")
            (substring name 7 (string-length name))
            #f)
        #f)))

(define (c-struct-type-canonical type)
  (let ((name (c-struct-type-name type)))
    (if (not name)
        (fatal "not a struct type")
        (if (null? (string-assoc name (cell-get C-STRUCTS)))
            (fatal (string-append
                     "define-c-function: unknown struct type: " name))
            (string-append "struct:" name)))))

(define (c-struct-c-type-for type)
  (let ((name (c-struct-type-name type)))
    (if (not name)
        (fatal "not a struct type")
        (let ((entry (string-assoc name (cell-get C-STRUCTS))))
          (if (null? entry)
              (fatal (string-append
                       "define-c-function: unknown struct type: " name))
              (car (cdr entry)))))))

(define (c-struct-type-string? type)
  (if (>= (string-length type) 7)
      (string=? (substring type 0 7) "struct:")
      #f))
