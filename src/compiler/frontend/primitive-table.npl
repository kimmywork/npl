; Primitive registry: one declaration per runtime primitive, shared by the
; compiler backend, the (npl primitive) library, and the evaluator frontend.
;
; Declaration: (name kind required optional [c-symbol]), kind a symbol:
;   kind fixed     call the C symbol with exactly `required` operands
;        in-port   0..1 operands; missing input port is current-input-port
;        out-port  required..required+1; missing port is current-output-port
;        count     variadic: symbol(argc, argv)
;        special   emitted by emit-special-primitive (inline or bespoke)
; `optional` is -1 for unbounded (count kind) and 1 for port kinds.
; The C symbol follows from the name (primitive-c-name) unless given; ""
; means the primitive has no C entry (inline only).
;
; Control conversion treats every registered name as synchronous
; (control-primitive-name?), so a new intrinsic is added here only.

(define PRIMITIVE-DECLARATIONS
  '(
    ; numbers
    ("+" special 0 -1 "") ("-" special 1 -1 "")
    ("*" special 0 -1 "")
    ("<" special 2 -1 "") (">" special 2 -1 "")
    ("=" special 2 -1 "") ("<=" special 2 -1 "")
    (">=" special 2 -1 "")
    ("number?" fixed 1 0)
    ("number->string" fixed 1 0)
    ("npl_tagged_num_to_string" fixed 1 0)
    ("npl_inexact_p" fixed 1 0)
    ("npl_inexact_bits" fixed 1 0)
    ("npl_inexact_op" fixed 2 0)
    ("npl_inexact_binary" fixed 3 0)
    ("npl_finite_p" fixed 1 0)
    ("npl_nan_p" fixed 1 0)
    ("npl_infinite_p" fixed 1 0)
    ("npl_exact_to_inexact" fixed 1 0)
    ("npl_inexact_to_exact" fixed 1 0)
    ("npl_number_div" fixed 2 0)
    ("npl_integer_p" fixed 1 0)
    ("npl_rational_numerator" fixed 1 0)
    ("npl_rational_denominator" fixed 1 0)
    ("npl_number_from_string" fixed 1 0)
    ("npl_number_from_string_radix" fixed 2 0)
    ("npl_number_to_string_radix" fixed 2 0)
    ("npl_complex_make" fixed 2 0)
    ("npl_complex_p" fixed 1 0)
    ("npl_complex_real" fixed 1 0)
    ("npl_complex_imag" fixed 1 0)
    ("npl_number_zero_p" fixed 1 0)
    ("npl_number_gcd" fixed 2 0)
    ("npl_number_quotient" fixed 2 0)
    ("npl_number_remainder" fixed 2 0)
    ; pairs, equivalence, booleans
    ; car, cdr, and the vector accessors are inline (backend/inline.npl);
    ; their C functions raise the errors.
    ("cons" fixed 2 0) ("car" special 1 0 "npl_car")
    ("cdr" special 1 0 "npl_cdr")
    ("set-car!" special 2 0)
    ("set-cdr!" special 2 0)
    ("null?" special 1 0 "") ("pair?" special 1 0 "")
    ("not" special 1 0 "") ("eq?" special 2 0 "")
    ("eqv?" fixed 2 0 "npl_eqv")
    ("procedure?" fixed 1 0)
    ("append" fixed 2 0)
    ; strings, symbols, chars
    ("string?" fixed 1 0)
    ("string-length" special 1 0 "")
    ("string-ref" fixed 2 0 "npl_string_char_ref")
    ; byte at an index as a fixnum: compiler/lexer internals, not R7RS
    ("string-byte-ref" fixed 2 0 "npl_string_ref")
    ("npl_make_string" fixed 2 0)
    ("string-set!" fixed 3 0)
    ("npl_string_fill" fixed 4 0 "npl_string_fill_range")
    ("substring" fixed 3 0)
    ("string-append" count 0 -1 "npl_string_append_n")
    ("string=?" special 2 0 "")
    ("int->string" fixed 1 0 "npl_int_to_string_char")
    ("symbol?" fixed 1 0 "npl_symbol_predicate")
    ("symbol->string" fixed 1 0)
    ("string->symbol" fixed 1 0)
    ("char?" fixed 1 0)
    ("char->integer" fixed 1 0)
    ("integer->char" fixed 1 0)
    ("npl_lex_class_w" fixed 2 0)
    ("npl_lex_scan_sym_end" fixed 2 0)
    ("npl_lex_number" fixed 3 0)
    ; vectors, bytevectors
    ("vector" count 0 -1 "npl_make_vector")
    ; records: define-record-type (frontend/derived.npl) is built on these;
    ; the predicate and the field access are inline (backend/inline.npl)
    ("npl_make_record" count 1 -1)
    ("npl_record_p" special 2 0 "npl_record_p")
    ("npl_record_ref" special 3 0 "npl_record_ref")
    ("npl_record_set" special 4 0 "npl_record_set")
    ("npl_record_type" fixed 2 0)
    ("npl_record_instance_type" fixed 1 0)
    ("npl_record_length" fixed 1 0)
    ("npl_record_update" count 3 -1)
    ; SRFI 125 hash tables (runtime/hashtable.c); (srfi 125) builds the
    ; standard interface on these
    ("npl_make_hash_table" fixed 4 0)
    ("npl_hash_table_p" fixed 1 0)
    ("npl_hash_table_ref" fixed 3 0)
    ("npl_hash_table_set" fixed 3 0)
    ("npl_hash_table_delete" fixed 2 0)
    ("npl_hash_table_contains_p" fixed 2 0)
    ("npl_hash_table_size" fixed 1 0)
    ("npl_hash_table_keys" fixed 1 0)
    ("npl_hash_table_values" fixed 1 0)
    ("npl_hash_table_items" fixed 1 0)
    ("npl_hash_table_clear" fixed 1 0)
    ("npl_hash_table_copy" fixed 2 0)
    ("npl_hash_table_pop" fixed 1 0)
    ("npl_hash_table_info" fixed 2 0)
    ("npl_hash_value" fixed 2 0)
    ("npl_same_procedure_p" fixed 2 0)
    ("list->vector" fixed 1 0)
    ("vector?" fixed 1 0)
    ("vector-length" special 1 0 "npl_vector_length")
    ("vector-ref" special 2 0 "npl_vector_ref")
    ("vector-set!" special 3 0 "npl_vector_set")
    ("bytevector" count 0 -1 "npl_make_bytevector")
    ("bytevector?" fixed 1 0)
    ("bytevector-length" fixed 1 0)
    ("bytevector-u8-ref" fixed 2 0 "npl_bytevector_ref")
    ("bytevector-u8-set!" fixed 3 0 "npl_bytevector_set")
    ; output
    ("display" out-port 1 1 "npl_display_port")
    ("write" out-port 1 1 "npl_write_port")
    ("write-shared" out-port 1 1 "npl_write_shared_port")
    ("write-simple" out-port 1 1 "npl_write_simple_port")
    ("newline" out-port 0 1 "npl_newline_port")
    ("flush-output-port" out-port 0 1)
    ("write-char" out-port 1 1)
    ("write-u8" out-port 1 1 "npl_write_byte")
    ("write-bytevector" special 1 3)
    ; input
    ("read-char" in-port 0 1)
    ("peek-char" in-port 0 1)
    ("read-u8" in-port 0 1 "npl_read_byte")
    ("peek-u8" in-port 0 1 "npl_peek_byte")
    ("read-result" in-port 0 1)
    ("read" in-port 0 1 "npl_read_datum")
    ("read-bytevector" special 1 1)
    ("read-bytevector!" special 1 3 "npl_read_bytevector_into")
    ("read-file" fixed 1 0)
    ; ports
    ("current-input-port" fixed 0 0)
    ("current-output-port" fixed 0 0)
    ("current-error-port" fixed 0 0)
    ("npl_port_parameter" fixed 1 0)
    ("npl_port_ready_p" fixed 1 0)
    ("npl_byte_ready_p" fixed 1 0)
    ("npl_string_to_utf8" fixed 3 0)
    ("npl_utf8_to_string" fixed 3 0)
    ("npl_char_property" fixed 2 0)
    ("npl_char_digit_value" fixed 1 0)
    ("npl_char_case" fixed 2 0)
    ("npl_char_full_case" fixed 2 0)
    ("npl_string_full_case" fixed 2 0)
    ; (scheme time)
    ("npl_jiffies_per_second" fixed 0 0)
    ("npl_current_jiffy" fixed 0 0)
    ("npl_current_second" fixed 0 0)
    ("open-input-file" fixed 1 0)
    ("npl_try_open_file" fixed 2 0)
    ("open-output-file" fixed 1 0)
    ("open-binary-input-file" fixed 1 0)
    ("open-binary-output-file" fixed 1 0)
    ("open-input-bytevector" fixed 1 0)
    ("open-output-bytevector" fixed 0 0)
    ("get-output-bytevector" fixed 1 0)
    ("open-input-string" fixed 1 0)
    ("open-output-string" fixed 0 0)
    ("get-output-string" fixed 1 0)
    ("close-input-port" fixed 1 0)
    ("close-output-port" fixed 1 0)
    ("close-port" fixed 1 0)
    ("eof-object" fixed 0 0)
    ("eof-object?" fixed 1 0)
    ("port?" fixed 1 0)
    ("input-port?" fixed 1 0)
    ("output-port?" fixed 1 0)
    ("input-port-open?" fixed 1 0)
    ("output-port-open?" fixed 1 0)
    ("textual-port?" fixed 1 0)
    ("binary-port?" fixed 1 0)
    ; process and files
    ("exit" special 0 1 "")
    ("program-arguments" fixed 0 0)
    ("command-line" fixed 0 0)
    ("set-command-line!" fixed 1 0)
    ("get-environment-variable" fixed 1 0)
    ("get-environment-variables" fixed 0 0)
    ("run-process" fixed 2 0 "npl_process_run")
    ("file-exists?" fixed 1 0 "npl_file_exists")
    ("delete-file" fixed 1 0)
    ("make-temporary-directory" fixed 0 0)
    ("delete-directory" fixed 1 0)
    ("executable-path" fixed 0 0)
    ; foreign calls (runtime/ffi.c): table rows, so evaluated declarations
    ; of them need no symbol lookup
    ("npl_ffi_load_library" fixed 1 0)
    ("npl_ffi_procedure" fixed 2 0)
    ; C pointers (runtime/ffi.c), exported by (npl ffi)
    ("pointer?" fixed 1 0)
    ("pointer-null?" fixed 1 0)
    ("null-pointer" fixed 0 0)
    ("pointer->integer" fixed 1 0)
    ; control mechanisms used by control conversion and (scheme base)
    ("npl_expect_one" fixed 1 0)
    ("npl_make_values" count 0 -1)
    ("npl_list_to_values" fixed 1 0)
    ("npl_current_wind" fixed 0 0)
    ("npl_wind_push" fixed 2 0)
    ("npl_wind_pop" fixed 1 0)
    ("npl_wind_exit_step" fixed 0 0)
    ("npl_current_handler" fixed 0 0)
    ("npl_handler_push" fixed 1 0)
    ("npl_handler_pop" fixed 1 0)
    ; raise in a direct entry (direct-calls.npl, runtime/error.c)
    ("npl_raise_direct" fixed 1 0)
    ; evaluator constants (lib/npl/evaluator-compile.scm, runtime/value.c)
    ("npl_freeze_literal" fixed 1 0)
    ("npl_make_parameter" fixed 2 0)
    ("npl_parameter_converter" fixed 1 0)
    ("npl_parameters_enter" fixed 3 0)
    ("npl_parameters_leave" fixed 1 0)
    ("npl_promise_op" count 0 -1)
    ; apply is a tail-call form in head position (control conversion); this
    ; row gives it a value form (primitive-values.npl)
    ("apply" special 2 -1 "npl_apply_tail")))


; The C symbol for a primitive name: a name starting with npl_ is used as
; is; otherwise npl_ followed by the name with -> as _to_, a final ? as _p,
; ! dropped, and - as _ (char->integer -> npl_char_to_integer).
(define (primitive-c-name name)
  (if (primitive-c-prefixed? name)
      name
      (string-append "npl_" (primitive-c-chars name 0 ""))))

(define (primitive-c-prefixed? name)
  (if (< (string-length name) 4)
      #f
      (string=? (substring name 0 4) "npl_")))

(define (primitive-c-chars name index out)
  (if (= index (string-length name))
      out
      (let ((c (string-byte-ref name index)))
        (cond
          ((if (= c 45)
               (if (< (+ index 1) (string-length name))
                   (= (string-byte-ref name (+ index 1)) 62)
                   #f)
               #f)
           (primitive-c-chars name (+ index 2) (string-append out "_to_")))
          ((= c 45) (primitive-c-chars name (+ index 1) (string-append out "_")))
          ((= c 33) (primitive-c-chars name (+ index 1) out))
          ((if (= c 63) (= (+ index 1) (string-length name)) #f)
           (string-append out "_p"))
          (else
           (primitive-c-chars name (+ index 1)
                              (string-append out (int->string c))))))))

; Row: (name kind c-symbol required optional), built once from the
; declarations.
(define (primitive-declaration-row declaration)
  (let ((name (car declaration))
        (rest (cdr declaration)))
    (let ((kind (car rest))
          (required (car (cdr rest)))
          (optional (car (cdr (cdr rest))))
          (explicit (cdr (cdr (cdr rest)))))
      (cons name
        (cons kind
          (cons (if (null? explicit) (primitive-c-name name) (car explicit))
            (cons required (cons optional ()))))))))

(define (primitive-declaration-rows declarations)
  (if (null? declarations)
      ()
      (cons (primitive-declaration-row (car declarations))
            (primitive-declaration-rows (cdr declarations)))))

(define PRIMITIVE-TABLE (primitive-declaration-rows PRIMITIVE-DECLARATIONS))

(define (primitive-row-name row) (car row))
(define (primitive-row-kind row) (symbol->string (car (cdr row))))
(define (primitive-row-symbol row) (car (cdr (cdr row))))
(define (primitive-row-required row) (car (cdr (cdr (cdr row)))))
(define (primitive-row-optional row) (car (cdr (cdr (cdr (cdr row))))))

(define (primitive-row-in name rows)
  (if (null? rows)
      #f
      (if (string=? name (primitive-row-name (car rows)))
          (car rows)
          (primitive-row-in name (cdr rows)))))

;; Rows this compilation declared with define-c-primitive, %c-call, or
;; %c-procedure (c-primitives.npl); same layout plus argument and result types.
(define DECLARED-PRIMITIVE-ROWS (cell ()))

; A declared row whose result type is values: its C function may return
; several values (npl_make_values). Table rows return one value.
(define (primitive-row-multiple-values? row)
  (let ((types (cdr (cdr (cdr (cdr (cdr row)))))))
    (if (null? types)
        #f
        (string=? (car (cdr types)) "values"))))

(define (primitive-row name)
  (let ((row (primitive-row-in name PRIMITIVE-TABLE)))
    (if row row (primitive-row-in name (cell-get DECLARED-PRIMITIVE-ROWS)))))
