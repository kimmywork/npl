; Parsed by the full compiler at expansion startup. Keeping these definitions
; as source text lets the permanent previous-generation compiler build this
; implementation without having to understand active macro definitions.

(define DERIVED-SYNTAX-SOURCE
"(define-syntax and
  (syntax-rules ()
    ((and) #t)
    ((and test) test)
    ((and test first ...) (if test (and first ...) #f))))

(define-syntax or
  (syntax-rules ()
    ((or) #f)
    ((or test) test)
    ((or test first ...)
     (let ((value test))
       (if value value (or first ...))))))

(define-syntax when
  (syntax-rules ()
    ((when test result ...)
     (if test (begin result ...)))))

(define-syntax unless
  (syntax-rules ()
    ((unless test result ...)
     (if (not test) (begin result ...)))))

(define-syntax cond
  (syntax-rules (else =>)
    ((cond (else result1 result2 ...))
     (begin result1 result2 ...))
    ((cond (else result1 result2 ...) clause1 clause2 ...)
     (syntax-error \"cond else clause must be last\"))
    ((cond (test => result))
     (let ((value test))
       (if value (result value))))
    ((cond (test => result) clause1 clause2 ...)
     (let ((value test))
       (if value
           (result value)
           (cond clause1 clause2 ...))))
    ((cond (test)) test)
    ((cond (test) clause1 clause2 ...)
     (let ((value test))
       (if value value (cond clause1 clause2 ...))))
    ((cond (test result1 result2 ...))
     (if test (begin result1 result2 ...)))
    ((cond (test result1 result2 ...) clause1 clause2 ...)
     (if test
         (begin result1 result2 ...)
         (cond clause1 clause2 ...)))))

(define-syntax case
  (syntax-rules (else => _case)
    ((case _case key)
     (if #f #f))
    ((case _case key (else => result))
     (result key))
    ((case _case key (else result1 result2 ...))
     (begin result1 result2 ...))
    ((case _case key (() result1 result2 ...) clause ...)
     (case _case key clause ...))
    ((case _case key (() => result) clause ...)
     (case _case key clause ...))
    ((case _case key ((atom atoms ...) => result) clause ...)
     (if (eqv? key (quote atom))
         (result key)
         (case _case key ((atoms ...) => result) clause ...)))
    ((case _case key ((atom atoms ...) result1 result2 ...) clause ...)
     (if (eqv? key (quote atom))
         (begin result1 result2 ...)
         (case _case key ((atoms ...) result1 result2 ...) clause ...)))
    ((case _case key clause ...)
     (syntax-error \"malformed case clauses\"))
    ((case key clause ...)
     (let ((value key)) (case _case value clause ...)))))

(define-syntax do
  (syntax-rules (_step)
    ((do ((var init step ...) ...)
         (test result ...)
         command ...)
     (letrec ((loop
                (lambda (var ...)
                  (if test
                      (begin (if #f #f) result ...)
                      (begin
                        command ...
                        (loop (do _step var step ...) ...))))))
       (loop init ...)))
    ((do _step value) value)
    ((do _step value step) step)))

(define-syntax let*-values
  (syntax-rules ()
    ((let*-values () body ...)
     (let () body ...))
    ((let*-values (((var ...) init) binding ...) body ...)
     (call-with-values
       (lambda () init)
       (lambda (var ...)
         (let*-values (binding ...) body ...))))))

(define-syntax guard
  (syntax-rules (=> else)
    ((guard (condition clause ... (else result1 result2 ...)) body ...)
     (call/cc
       (lambda (return)
         (with-exception-handler
           (lambda (condition)
             (return
               (cond clause ... (#t result1 result2 ...))))
           (lambda () body ...)))))
    ((guard (condition clause ...) body ...)
     (call/cc
       (lambda (return)
         (with-exception-handler
           (lambda (condition)
             (return
               (cond clause ... (#t (raise condition)))))
           (lambda () body ...)))))))

(define-syntax make-parameter
  (syntax-rules ()
    ((make-parameter value)
     (npl_make_parameter (quote ()) value))
    ((make-parameter value converter)
     (let ((saved-value value) (saved-converter converter))
       (call-with-values
         (lambda () (saved-converter saved-value))
         (lambda (converted)
           (npl_make_parameter saved-converter converted)))))))

(define-syntax parameterize
  (syntax-rules ()
    ((parameterize bindings)
     (syntax-error \"parameterize needs a body\"))
    ((parameterize () body ...)
     (begin body ...))
    ((parameterize ((parameter value) ...) body ...)
     (let ((parameters (vector parameter ...))
           (new-values (vector value ...))
           (converted-values (vector (if #t #f parameter) ...))
           (frames (vector (if #t #f parameter) ...)))
       (letrec
         ((convert
            (lambda (index)
              (if (= index (vector-length parameters))
                  (dynamic-wind
                    (lambda ()
                      (npl_parameters_enter
                        parameters converted-values frames))
                    (lambda () body ...)
                    (lambda () (npl_parameters_leave frames)))
                  (let ((converter
                          (npl_parameter_converter
                            (vector-ref parameters index))))
                    (call-with-values
                      (lambda ()
                        (if converter
                            (converter (vector-ref new-values index))
                            (vector-ref new-values index)))
                      (lambda (converted)
                        (vector-set! converted-values index converted)
                        (convert (+ index 1)))))))))
         (convert 0))))))
")
