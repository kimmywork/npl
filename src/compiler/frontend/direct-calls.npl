; Direct calls (docs/design-calls.md, addendum C2): which top-level functions
; get a direct entry that returns its value, and the frontend side of using
; it. The analysis runs on the lowered core forms, before control
; conversion; with NPL_DIRECT_REPORT set it also writes one line per
; top-level function to the error port.
;
; A function is direct-safe when its body uses only literals, variables,
; if, let forms, begin, set!, lambda creation, single-value primitives,
; public numeric aliases, raise with one operand (C2c), and calls to
; direct-safe functions with an arity they accept, and it is in no cycle of
; tail calls with another function; a self tail call is a jump unless a
; parameter is assigned or the function is variadic. The set is the
; greatest fixed point.

; Entry: #(name arity reason calls tails mark assigned rest). arity: the
; number of fixed parameters; rest: a rest parameter follows them. reason
; #f: direct-safe so far, otherwise why not. calls and tails: callee entries
; of non-tail and tail calls. mark: last tail-cycle search stamp. assigned:
; a parameter is a set! target, so a self tail call is no jump.
(define (direct-entry name arity rest)
  (vector name arity #f () () 0 #f rest))
(define (direct-name entry) (vector-ref entry 0))
(define (direct-arity entry) (vector-ref entry 1))
(define (direct-reason entry) (vector-ref entry 2))
(define (direct-calls entry) (vector-ref entry 3))
(define (direct-tails entry) (vector-ref entry 4))
(define (direct-mark entry) (vector-ref entry 5))
(define (direct-assigned? entry) (vector-ref entry 6))
(define (direct-rest? entry) (vector-ref entry 7))
(define (direct-safe? entry) (not (direct-reason entry)))

(define (direct-unsafe! entry reason)
  (if (direct-reason entry) 0 (vector-set! entry 2 reason)))

; (name . entry) for every top-level function of the program, in source
; order.
(define DIRECT-FUNCTIONS (cell ()))
(define DIRECT-STAMP (cell 0))
; The same pairs in DIRECT-BUCKET-COUNT buckets (direct-find); #f before
; the analysis has run, so no call is direct.
(define DIRECT-TABLE (cell #f))
(define DIRECT-BUCKET-COUNT 509)

(define (direct-lookup name entries)
  (if (null? entries)
      #f
      (if (string=? name (car (car entries)))
          (cdr (car entries))
          (direct-lookup name (cdr entries)))))

; Length and three bytes: one remainder per lookup. control-simple? asks
; for every application head.
(define (direct-hash name)
  (let ((length (string-length name)))
    (if (= length 0)
        0
        (npl_number_remainder
          (+ (* length 7)
             (+ (string-byte-ref name 0)
                (+ (* 3 (string-byte-ref name (- length 1)))
                   (string-byte-ref name (quotient-by-two length)))))
          DIRECT-BUCKET-COUNT))))

(define (quotient-by-two n) (npl_number_quotient n 2))

(define (direct-empty-buckets count acc)
  (if (= count 0) acc (direct-empty-buckets (- count 1) (cons () acc))))

(define (direct-fill-table! table entries)
  (if (null? entries)
      table
      (let ((index (direct-hash (car (car entries)))))
        (vector-set! table index (cons (car entries) (vector-ref table index)))
        (direct-fill-table! table (cdr entries)))))

(define (direct-find name)
  (let ((table (cell-get DIRECT-TABLE)))
    (if table (direct-lookup name (vector-ref table (direct-hash name))) #f)))

(define (direct-length xs count)
  (if (pair-shape? xs) (direct-length (cdr xs) (+ count 1)) count))

(define (direct-prefix? prefix text)
  (if (< (string-length text) (string-length prefix))
      #f
      (string=? prefix (substring text 0 (string-length prefix)))))

(define (direct-tag-in? tag tags)
  (if (null? tags)
      #f
      (if (= tag (car tags)) #t (direct-tag-in? tag (cdr tags)))))

; ---------------- entries ----------------

(define (direct-form-entry form)
  (let ((name (control-function-name form))
        (params (cdr (car (cdr form)))))
    (cons name
          (direct-entry name
            (direct-length (control-fixed-formals params) 0)
            (not (control-proper-formals? params))))))

(define (direct-function-entries forms)
  (if (null? forms)
      ()
      (if (control-function-form? (car forms))
          (cons (direct-form-entry (car forms))
                (direct-function-entries (cdr forms)))
          (direct-function-entries (cdr forms)))))

; ---------------- body walk ----------------

(define (direct-walk-functions forms)
  (if (null? forms)
      0
      (begin
        (if (control-function-form? (car forms))
            (direct-walk-function (car forms))
            0)
        (direct-walk-functions (cdr forms)))))

(define (direct-params-assigned? params names)
  (if (pair-shape? params)
      (if (assigned-name? (cdr (car params)) names)
          #t
          (direct-params-assigned? (cdr params) names))
      #f))

(define (direct-walk-function form)
  (let ((entry (direct-find (control-function-name form))))
    (vector-set! entry 6
      (direct-params-assigned?
        (control-fixed-formals (cdr (car (cdr form))))
        (collect-assigned form ())))
    (direct-walk (core-body-expression (car (cdr (cdr form)))) #t entry)))

(define (direct-walk expression tail entry)
  (if (pair-shape? expression)
      (if (number? (car expression))
          (direct-walk-form (car expression) expression tail entry)
          (direct-walk-application expression tail entry))
      0))

(define (direct-walk-each expressions tail entry)
  (if (pair-shape? expressions)
      (begin
        (direct-walk (car expressions) tail entry)
        (direct-walk-each (cdr expressions) tail entry))
      0))

; Literals, variable references, and lambda creation (its body runs in its
; own function).
(define DIRECT-LEAF-TAGS '(100 101 102 103 104 108 109 110 204 212))
(define DIRECT-BINDING-TAGS '(214 220 221 222))

(define (direct-walk-form tag expression tail entry)
  (cond
    ((direct-tag-in? tag DIRECT-LEAF-TAGS) 0)
    ((= tag 213) (direct-walk-if expression tail entry))
    ((= tag 216) (direct-walk-sequence (cdr expression) tail entry))
    ((= tag 217) (direct-walk (car (cdr (cdr expression))) #f entry))
    ((direct-tag-in? tag DIRECT-BINDING-TAGS)
     (direct-walk-binding expression tail entry))
    (else (direct-unsafe! entry "form"))))

(define (direct-walk-if expression tail entry)
  (direct-walk (car (cdr expression)) #f entry)
  (direct-walk-each (cdr (cdr expression)) tail entry))

(define (direct-walk-sequence expressions tail entry)
  (if (null? expressions)
      0
      (if (null? (cdr expressions))
          (direct-walk (car expressions) tail entry)
          (begin
            (direct-walk (car expressions) #f entry)
            (direct-walk-sequence (cdr expressions) tail entry)))))

; (tag ((name . init) ...) body): inits in value position, body in place.
(define (direct-walk-binding expression tail entry)
  (direct-walk-inits (car (cdr expression)) entry)
  (direct-walk (core-body-expression (car (cdr (cdr expression)))) tail entry))

(define (direct-walk-inits bindings entry)
  (if (pair-shape? bindings)
      (begin
        (if (pair-shape? (car bindings))
            (direct-walk (cdr (car bindings)) #f entry)
            0)
        (direct-walk-inits (cdr bindings) entry))
      0))

(define (direct-walk-application expression tail entry)
  (direct-walk-each (cdr expression) #f entry)
  (direct-walk-head (car expression) (direct-length (cdr expression) 0)
                    tail entry))

; A named let expands to ((letrec ((name lambda)) name) init ...): its loop
; is a local procedure, reported separately because C2b could treat it as
; part of the function (O2b loop) rather than as an unknown call.
(define (direct-named-let-head? head)
  (if (pair-shape? head)
      (if (number? (car head)) (= (car head) 221) #f)
      #f))

(define (direct-walk-head head argc tail entry)
  (cond
    ((sym-atom? head) (direct-classify-call (cdr head) argc tail entry))
    ((direct-named-let-head? head) (direct-unsafe! entry "named-let"))
    (else (direct-unsafe! entry "computed-call"))))

; Control-transfer operators and apply take continuations. A primitive runs
; no NPL code; one with a values result sends it to a continuation. A
; lexical binding (renamed _npl_h_ by expansion) or a global variable holds
; an unknown procedure.
(define (direct-classify-call name argc tail entry)
  (cond
    ((if (string=? name "raise") (= argc 1) #f) 0)
    ((control-transfer-name? name) (direct-unsafe! entry "control"))
    ((string=? name "apply") (direct-unsafe! entry "control"))
    ((primitive-row name) (direct-primitive-call (primitive-row name) entry))
    ((> (string-length (numeric-alias-primitive-name name)) 0) 0)
    (else
     (direct-function-call name (direct-find name) argc tail entry))))

(define (direct-primitive-call row entry)
  (if (control-single-value-row? row)
      0
      (direct-unsafe! entry "values-primitive")))

(define (direct-function-call name callee argc tail entry)
  (if callee
      (direct-record-call callee argc tail entry)
      (direct-unsafe! entry
        (if (direct-prefix? "_npl_h_" name) "local-call" "global-call"))))

; A self tail call of a variadic function or one with an assigned parameter
; is no jump (backend program.npl self-loop-eligible?), so it would grow the
; C stack.
(define (direct-record-call callee argc tail entry)
  (cond
    ((not (direct-accepts? callee argc)) (direct-unsafe! entry "arity"))
    ((if tail
         (if (eq? callee entry)
             (if (direct-assigned? entry) #t (direct-rest? entry))
             #f)
         #f)
     (direct-unsafe! entry "tail-cycle"))
    (tail (vector-set! entry 4 (cons callee (direct-tails entry))))
    (else (vector-set! entry 3 (cons callee (direct-calls entry))))))

; ---------------- fixed point ----------------

(define (direct-first-unsafe callees)
  (if (null? callees)
      #f
      (if (direct-safe? (car callees))
          (direct-first-unsafe (cdr callees))
          (car callees))))

(define (direct-unsafe-callee entry)
  (let ((callee (direct-first-unsafe (direct-calls entry))))
    (if callee callee (direct-first-unsafe (direct-tails entry)))))

(define (direct-callee-reason callee)
  (if (direct-prefix? "_npl_lib_" (direct-name callee))
      "library-call"
      "calls-unsafe"))

(define (direct-prune-with entry callee changed)
  (if callee
      (begin (vector-set! entry 2 (direct-callee-reason callee)) #t)
      changed))

(define (direct-prune-entry entry changed)
  (if (direct-safe? entry)
      (direct-prune-with entry (direct-unsafe-callee entry) changed)
      changed))

(define (direct-prune-pass entries changed)
  (if (null? entries)
      changed
      (direct-prune-pass (cdr entries)
                         (direct-prune-entry (cdr (car entries)) changed))))

(define (direct-prune entries)
  (if (direct-prune-pass entries #f) (direct-prune entries) 0))

; A direct tail call to another function is a C call followed by ret, so a
; cycle of tail calls through another function would grow the C stack
; without bound. A self tail call is a jump (backend/tail.npl).
(define (direct-reach-one? target node stamp)
  (cond
    ((eq? node target) #t)
    ((not (direct-safe? node)) #f)
    ((= (direct-mark node) stamp) #f)
    (else
     (begin
       (vector-set! node 5 stamp)
       (direct-reach-any? target (direct-tails node) stamp)))))

(define (direct-reach-any? target callees stamp)
  (if (null? callees)
      #f
      (if (direct-reach-one? target (car callees) stamp)
          #t
          (direct-reach-any? target (cdr callees) stamp))))

; The target's own tail calls, except self calls, lead back to it.
(define (direct-reaches-others? target callees stamp)
  (if (null? callees)
      #f
      (if (eq? (car callees) target)
          (direct-reaches-others? target (cdr callees) stamp)
          (if (direct-reach-one? target (car callees) stamp)
              #t
              (direct-reaches-others? target (cdr callees) stamp)))))

(define (direct-next-stamp)
  (cell-set! DIRECT-STAMP (+ 1 (cell-get DIRECT-STAMP)))
  (cell-get DIRECT-STAMP))

(define (direct-cycle-entry entry changed)
  (if (direct-safe? entry)
      (if (direct-reaches-others? entry (direct-tails entry)
                                  (direct-next-stamp))
          (begin (vector-set! entry 2 "tail-cycle") #t)
          changed)
      changed))

(define (direct-cycle-pass entries changed)
  (if (null? entries)
      changed
      (direct-cycle-pass (cdr entries)
                         (direct-cycle-entry (cdr (car entries)) changed))))

(define (direct-settle entries)
  (direct-prune entries)
  (if (direct-cycle-pass entries #f) (direct-settle entries) 0))

; ---------------- report ----------------

(define (direct-count-safe entries count)
  (if (null? entries)
      count
      (direct-count-safe (cdr entries)
        (if (direct-safe? (cdr (car entries))) (+ count 1) count))))

(define (direct-report-entry entry port)
  (display "direct-calls: " port)
  (display (if (direct-safe? entry) "safe" (direct-reason entry)) port)
  (display " " port)
  (display (direct-name entry) port)
  (newline port))

(define (direct-report-entries entries port)
  (if (null? entries)
      0
      (begin
        (direct-report-entry (cdr (car entries)) port)
        (direct-report-entries (cdr entries) port))))

(define (direct-report entries port)
  (direct-report-entries entries port)
  (display "direct-calls: total " port)
  (display (direct-length entries 0) port)
  (display " safe " port)
  (display (direct-count-safe entries 0) port)
  (newline port))

; Analyze a program's lowered forms; emit-program runs it before control
; conversion.
(define (direct-calls-analyze! forms)
  (cell-set! DIRECT-FUNCTIONS (direct-function-entries forms))
  (cell-set! DIRECT-TABLE
    (direct-fill-table!
      (list->vector (direct-empty-buckets DIRECT-BUCKET-COUNT ()))
      (cell-get DIRECT-FUNCTIONS)))
  (direct-walk-functions forms)
  (direct-settle (cell-get DIRECT-FUNCTIONS))
  (if (get-environment-variable "NPL_DIRECT_REPORT")
      (direct-report (cell-get DIRECT-FUNCTIONS) (current-error-port))
      0))

; ---------------- using direct entries ----------------

(define (direct-accepts? entry argc)
  (if (direct-rest? entry)
      (>= argc (direct-arity entry))
      (= argc (direct-arity entry))))

; The entry of a direct-safe name that a call with argc operands may use
; directly, or #f.
(define (direct-entry-for name argc)
  (let ((entry (direct-find name)))
    (if (if entry (direct-safe? entry) #f)
        (if (direct-accepts? entry argc) entry #f)
        #f)))

; Whether a call of name with argc operands is a direct call. A public
; numeric alias keeps its inline fast path; its slow path may still call
; the direct entry (backend/numeric.npl emit-value-call).
(define (direct-target name argc)
  (if (direct-entry-for name argc)
      (= (string-length (numeric-alias-primitive-name name)) 0)
      #f))

; For a direct call of name with argc operands: how many operands go to the
; rest list, or #f when the entry has no rest parameter.
(define (direct-rest-count name argc)
  (let ((entry (direct-find name)))
    (if (direct-rest? entry) (- argc (direct-arity entry)) #f)))

(define (direct-safe-name? name)
  (let ((entry (direct-find name)))
    (if entry (direct-safe? entry) #f)))

; Control conversion treats a call to a direct entry as it treats a
; primitive (control-simple?, control-cps-application), except while it
; converts the CPS entry of a direct-safe function: that entry is the
; stack-limit fallback, so it must stay entirely in CPS.
(define CONTROL-DIRECT-CALLS (cell #t))

; A call that runs to completion and returns one value: a single-value
; primitive or a direct call (control.npl control-simple?).
(define (control-synchronous-call? expression)
  (if (control-single-value-primitive-head? (car expression))
      #t
      (control-direct-call? expression)))

; control-cps-application sends the value of these to its continuation.
(define (control-primitive-or-direct? application)
  (if (control-primitive-head? (car application))
      #t
      (control-direct-call? application)))

(define (control-direct-call? expression)
  (if (cell-get CONTROL-DIRECT-CALLS)
      (if (sym-atom? (car expression))
          (if (direct-target (cdr (car expression))
                             (direct-length (cdr expression) 0))
              #t
              #f)
          #f)
      #f))

; The direct entry's body: the lowered body with every lambda converted to
; CPS (it is a closure called through the trampoline); every other form
; stays in direct style for the backend (program.npl emit-direct-function).
(define (control-direct-expression expression)
  (cond
    ((not (pair-shape? expression)) expression)
    ((control-raise-name? (car expression) "raise")
     (cons (control-symbol "npl_raise_direct")
           (control-direct-list (cdr expression))))
    ((not (number? (car expression))) (control-direct-list expression))
    ((= (car expression) 100) (control-transform-symbol expression))
    ((= (car expression) 212) (control-transform-lambda expression))
    ((direct-tag-in? (car expression) '(213 216))
     (cons (car expression) (control-direct-list (cdr expression))))
    ((= (car expression) 217)
     (cons 217
       (cons (car (cdr expression))
         (cons (control-direct-expression (car (cdr (cdr expression)))) ()))))
    ((direct-tag-in? (car expression) DIRECT-BINDING-TAGS)
     (control-direct-binding-form expression))
    (else expression)))

(define (control-direct-list expressions)
  (if (pair-shape? expressions)
      (cons (control-direct-expression (car expressions))
            (control-direct-list (cdr expressions)))
      expressions))

(define (control-direct-body body)
  (cons (control-direct-expression (core-body-expression body)) ()))

(define (control-direct-bindings bindings)
  (if (pair-shape? bindings)
      (cons (cons (car (car bindings))
                  (control-direct-expression (cdr (car bindings))))
            (control-direct-bindings (cdr bindings)))
      bindings))

(define (control-direct-binding-form expression)
  (cons (car expression)
    (cons (control-direct-bindings (car (cdr expression)))
      (cons (control-direct-body (car (cdr (cdr expression)))) ()))))

; ---------------- direct lambdas (design-calls C3) ----------------

; A lambda with fixed parameters whose body is direct-safe under the rules
; for functions, after the top-level verdicts are settled. A call through
; a parameter or captured variable is a local call, so named-let loops are
; never direct.
(define (direct-lambda? expression)
  (let ((params (car (cdr expression))))
    (if (control-proper-formals? params)
        (let ((entry (direct-entry "" (direct-length params 0) #f)))
          (direct-walk (core-body-expression (car (cdr (cdr expression))))
                       #t entry)
          (if (direct-safe? entry) (not (direct-unsafe-callee entry)) #f))
        #f)))

; (219 cps-lambda params direct-body): the CPS lambda, the source
; parameters, and the body for the direct entry (backend program.npl
; emit-direct-lambda).
(define (control-direct-lambda cps expression)
  (cons 219
    (cons cps
      (cons (car (cdr expression))
        (cons (control-direct-body (car (cdr (cdr expression)))) ())))))

; A CPS call (head argument ... continuation) whose head is a variable (not
; a top-level function, so it holds a closure value; the backend evaluates
; it on both paths) and whose continuation is a literal
; one-parameter lambda with a small body: the backend calls the closure's
; direct entry when it has one and runs the body inline (tail.npl
; emit-closure-call-site). The body is emitted twice (inline and as the
; slow path's continuation); the size bound counts nested sites and
; lambdas in it, so the duplication stays small. Nested sites are the
; common case in npli, whose syntax nodes call child nodes.
(define CONTROL-INLINE-BODY-LIMIT 120)

(define (control-closure-call-site? head continuation)
  (if (if (sym-atom? head) (direct-find (cdr head)) #t)
      #f
      (if (control-inline-continuation? continuation)
          (control-inline-body?
            (car (cdr (cdr continuation))) CONTROL-INLINE-BODY-LIMIT)
          #f)))

; Remaining budget after x, negative when x is too large.
(define (control-inline-size x budget)
  (cond
    ((< budget 0) budget)
    ((not (pair-shape? x)) budget)
    (else (control-inline-size (cdr x)
            (control-inline-size (car x) (- budget 1))))))

(define (control-inline-body? body limit)
  (>= (control-inline-size body limit) 0))

; (218 signature body): the direct entry of a direct-safe function, with
; the signature of its definition (no continuation parameter). Variadic
; formals become (230 fixed rest), as control conversion writes them.
(define (control-direct-function form)
  (let ((signature (car (cdr form))))
    (cons 218
      (cons (cons (car signature) (control-direct-formals (cdr signature)))
        (cons (control-direct-body (car (cdr (cdr form)))) ())))))

(define (control-direct-formals formals)
  (if (control-proper-formals? formals)
      formals
      (cons 230
        (cons (control-fixed-formals formals)
          (cons (control-rest-formal formals) ())))))

; The converted definitions of a top-level function (control-program.npl):
; its CPS entry and, when it is direct-safe, its direct entry. The CPS entry
; of a direct-safe function is the stack-limit fallback of the direct one
; (backend/program.npl emit-direct-function), so it is converted without
; direct calls: the fallback must not re-enter the C stack.
(define (control-function-definitions form)
  (let ((name (control-function-name form)))
    (if (direct-safe-name? name)
        (control-direct-definitions form name)
        (cons (control-transform-function form name ()) ()))))

(define (control-direct-definitions form name)
  (cell-set! CONTROL-DIRECT-CALLS #f)
  (let ((cps (control-transform-function form name ())))
    (cell-set! CONTROL-DIRECT-CALLS #t)
    (cons cps (cons (control-direct-function form) ()))))
