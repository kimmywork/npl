; The (npl primitive) library: runtime primitive value names and core
; derived-syntax keywords, with their bindings for import resolution.

(define LIBRARY-PRIMITIVE-MACROS (cell ()))

(define PRIMITIVE-VALUE-SOURCE
"(+ - * < <= = > >= append bytevector bytevector-length
bytevector-u8-ref bytevector-u8-set! bytevector? binary-port? car cdr
char->integer char? close-input-port close-output-port close-port cons
current-error-port current-input-port current-output-port delete-directory
delete-file dynamic-wind executable-path exit
eof-object eof-object? eq? eqv? flush-output-port get-environment-variable
get-environment-variables get-output-bytevector
get-output-string
input-port-open? input-port? int->string integer->char list->vector
npl_make_record npl_record_p npl_record_ref npl_record_set npl_try_open_file
npl_port_parameter
make-temporary-directory
newline not null?
number->string number? npl_lex_class_w npl_lex_number npl_lex_scan_sym_end
npl_number_div npl_integer_p npl_rational_numerator npl_rational_denominator
npl_number_from_string npl_number_from_string_radix
npl_number_to_string_radix npl_complex_make npl_complex_p
npl_complex_real npl_complex_imag npl_number_zero_p
npl_number_gcd npl_number_quotient npl_number_remainder string?
npl_inexact_p npl_inexact_bits npl_inexact_op npl_inexact_binary npl_finite_p npl_nan_p npl_infinite_p
npl_exact_to_inexact npl_inexact_to_exact
npl_make_parameter npl_parameter_converter npl_list_to_values
npl_parameters_enter npl_parameters_leave npl_promise_op program-arguments
command-line set-command-line!
run-process
open-binary-input-file open-binary-output-file
open-input-bytevector open-input-file open-input-string
open-output-bytevector open-output-file open-output-string file-exists?
output-port-open? output-port? pair? peek-char peek-u8 port? raise
raise-continuable read read-file read-result read-bytevector read-bytevector!
read-char
read-u8
set-car! set-cdr! string-append string-length string-ref string-byte-ref
npl_make_string string-set! npl_string_fill string=? symbol?
substring procedure?
symbol->string string->symbol textual-port? values vector vector-length vector-ref vector-set!
vector? call-with-current-continuation call/cc call-with-values apply
display with-exception-handler write write-bytevector write-char write-shared
write-simple write-u8)" )

(define PRIMITIVE-MACRO-SOURCE
"(and or when unless cond case do let*-values guard make-parameter
parameterize make-promise promise? force delay delay-force)" )

(define (library-primitive-names source)
  (car (parse-source-text source)))

(define (library-primitive-value-bindings identifiers)
  (if (null? identifiers)
      ()
      (let ((name (datum-symbol-name (car identifiers))))
        (cons (library-binding name 1 name)
              (library-primitive-value-bindings (cdr identifiers))))))

(define (library-primitive-value-environment identifiers environment)
  (if (null? identifiers)
      environment
      (let ((identifier (car identifiers)))
        (library-primitive-value-environment
          (cdr identifiers)
          (add-value-binding identifier
            (datum-symbol-name identifier) environment)))))

(define (library-primitive-macro-bindings identifiers)
  (if (null? identifiers)
      ()
      (let ((identifier (car identifiers)))
        (let ((macro
                (lookup-macro-cell
                  identifier (cell-get LIBRARY-PRIMITIVE-MACROS))))
          (if (null? macro)
              (fatal "missing primitive syntax binding"))
          (cons
            (library-binding (datum-symbol-name identifier) 2 macro)
            (library-primitive-macro-bindings (cdr identifiers)))))))

(define (library-primitive-bindings)
  (append-forms
    (library-primitive-value-bindings
      (library-primitive-names PRIMITIVE-VALUE-SOURCE))
    (library-primitive-macro-bindings
      (library-primitive-names PRIMITIVE-MACRO-SOURCE))))

(define (library-primitive-name? name)
  (string=? (library-name-key name) "npl/primitive"))
