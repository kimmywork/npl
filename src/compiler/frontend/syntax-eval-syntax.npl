; ---------------- quasiquote ----------------

(define (syntax-eval-quasiquote template env depth)
  (cond
    ((raw-form? template "unquote")
     (if (= depth 1)
         (syntax-eval (car (cdr template)) env)
         (cons (datum-symbol "unquote")
               (cons (syntax-eval-quasiquote
                       (car (cdr template)) env (- depth 1)) ()))))
    ((raw-form? template "unquote-splicing")
     (cons (datum-symbol "unquote-splicing")
           (cons (syntax-eval-quasiquote
                   (car (cdr template)) env (- depth 1)) ())))
    ((raw-form? template "quasiquote")
     (cons (datum-symbol "quasiquote")
           (cons (syntax-eval-quasiquote
                   (car (cdr template)) env (+ depth 1)) ())))
    ((pair? template)
     (syntax-eval-quasiquote-list template env depth))
    (else template)))

(define (syntax-eval-quasiquote-list templates env depth)
  (if (null? templates)
      ()
      (if (syntax-atomic? templates)
          (syntax-eval-quasiquote templates env depth)
          (let ((head (car templates)))
            (if (if (raw-form? head "unquote-splicing") (= depth 1) #f)
                (syntax-append
                  (syntax-eval (car (cdr head)) env)
                  (syntax-eval-quasiquote-list (cdr templates) env depth))
                (cons (syntax-eval-quasiquote head env depth)
                      (syntax-eval-quasiquote-list
                        (cdr templates) env depth)))))))

; ---------------- syntax-case environments ----------------

(define (syntax-materialize-range key depth path index count captures)
  (if (= index count)
      ()
      (cons
        (syntax-materialize-capture key depth (path-append-index path index)
                                    captures)
        (syntax-materialize-range key depth path (+ index 1) count captures))))

(define (syntax-materialize-capture key depth path captures)
  (if (= depth 0)
      (let ((capture (capture-exact key path captures)))
        (if (null? capture)
            (fatal (string-append "missing pattern variable: " key))
            (capture-value capture)))
      (let ((count (capture-next-count key path captures 0)))
        (syntax-materialize-range key (- depth 1) path 0 count captures))))

(define (syntax-bind-pattern-values variables captures env)
  (if (null? variables)
      env
      (syntax-bind-pattern-values
        (cdr variables) captures
        (syntax-env-bind env (car (car variables))
          (syntax-materialize-capture
            (car (car variables)) (cdr (car variables)) () captures)))))

(define (syntax-context-extend outer transformer captures variables)
  (if (null? outer)
      (cons transformer (cons captures (cons variables ())))
      (cons transformer
            (cons (syntax-append captures (car (cdr outer)))
                  (cons (syntax-append variables (car (cdr (cdr outer))))
                        ())))))

(define (syntax-eval-current-transformer)
  (let ((context (cell-get SYNTAX-EVAL-CONTEXT)))
    (if (null? context)
        (make-syntax-transformer "..." () ()
          (cell-get SYNTAX-EVAL-DEFINITION-ENV)
          (cell-get SYNTAX-EVAL-DEFINITION-MACRO-ENV))
        (car context))))

(define (syntax-eval-syntax form env)
  (let ((context (cell-get SYNTAX-EVAL-CONTEXT)))
    (if (null? context)
        (fatal "syntax used outside a syntax-case clause")
        (let ((transformer (car context))
              (captures (car (cdr context)))
              (variables (car (cdr (cdr context)))))
          (cell-set! CURRENT-PATTERN-VARIABLES variables)
          (clone-template (car (cdr form)) transformer captures
                          (cell-get SYNTAX-EVAL-MARK) () #t)))))

(define (syntax-eval-quasisyntax form env)
  (let ((context (cell-get SYNTAX-EVAL-CONTEXT)))
    (if (null? context)
        (fatal "quasisyntax used outside a syntax-case clause")
        (let ((transformer (car context))
              (captures (car (cdr context)))
              (variables (car (cdr (cdr context)))))
          (cell-set! CURRENT-PATTERN-VARIABLES variables)
          (syntax-quasisyntax-walk (car (cdr form)) env 1 transformer captures
                                   (cell-get SYNTAX-EVAL-MARK))))))

(define (syntax-quasisyntax-walk template env depth transformer captures mark)
  (cond
    ((raw-form? template "unsyntax")
     (if (= depth 1)
         (syntax-eval (car (cdr template)) env)
         (cons (datum-symbol "unsyntax")
               (cons (syntax-quasisyntax-walk
                       (car (cdr template)) env (- depth 1)
                       transformer captures mark) ()))))
    ((raw-form? template "quasisyntax")
     (cons (datum-symbol "quasisyntax")
           (cons (syntax-quasisyntax-walk
                   (car (cdr template)) env (+ depth 1)
                   transformer captures mark) ())))
    ((datum-symbol? template)
     (clone-template template transformer captures mark () #t))
    ((datum-vector? template)
     (datum-vector
       (syntax-quasisyntax-walk
         (datum-vector-items template) env depth transformer captures mark)))
    ((syntax-atomic? template) template)
    ((pair? template)
     (syntax-quasisyntax-list template env depth transformer captures mark))
    (else template)))

(define (syntax-quasisyntax-list templates env depth transformer captures mark)
  (if (null? templates)
      ()
      (if (syntax-atomic? templates)
          (syntax-quasisyntax-walk templates env depth transformer captures mark)
          (let ((head (car templates)))
            (if (if (raw-form? head "unsyntax-splicing") (= depth 1) #f)
                (syntax-append
                  (syntax-eval (car (cdr head)) env)
                  (syntax-quasisyntax-list (cdr templates) env depth
                                           transformer captures mark))
                (if (if (pair? (cdr templates))
                        (active-ellipsis?
                          (car (cdr templates))
                          (transformer-ellipsis transformer)
                          (transformer-literals transformer))
                        #f)
                    (let ((levels
                            (ellipsis-count-from
                              (cdr templates)
                              (transformer-ellipsis transformer)
                              (transformer-literals transformer) 0)))
                      (syntax-append
                        (clone-repeated-template-levels
                          head levels transformer captures mark () #t)
                        (syntax-quasisyntax-list
                          (drop-forms (cdr templates) levels) env depth
                          transformer captures mark)))
                    (cons (syntax-quasisyntax-walk
                            head env depth transformer captures mark)
                          (syntax-quasisyntax-list
                            (cdr templates) env depth transformer captures
                            mark))))))))

(define (syntax-eval-match-pattern pattern literals ellipsis)
  (if (datum-symbol? pattern)
      (validate-pattern pattern literals ellipsis 0 ())
      (if (pair? pattern)
          (validate-pattern-list (cdr pattern) literals ellipsis 0 ())
          (fatal "malformed syntax-case pattern"))))

; A clause is (pattern body ...) or (pattern fender body).  A fender that
; evaluates false falls through to the next clause with the same subject
; (Guile/R6RS syntax-case accepts the three-element form).
(define (syntax-eval-syntax-clause-parts clause)
  (let ((rest (cdr clause)))
    (if (null? rest)
        (fatal "syntax-case clause needs a body"))
    (if (null? (cdr rest))
        (cons #f rest)
        (cons (car rest) (cdr rest)))))

(define (syntax-eval-syntax-clauses clauses subject transformer env outer)
  (if (null? clauses)
      (fatal "syntax-case: no matching clause")
      (let ((clause (car clauses)))
        (if (not (pair? clause))
            (fatal "malformed syntax-case clause"))
        (let ((pattern (car clause)))
          (let ((parts (syntax-eval-syntax-clause-parts clause)))
            (let ((fender (car parts))
                  (body (cdr parts)))
              (let ((variables
                      (syntax-eval-match-pattern
                        pattern (transformer-literals transformer)
                        (transformer-ellipsis transformer))))
                (let ((captures
                        (if (datum-symbol? pattern)
                            (match-pattern pattern subject transformer
                                           (cell-get SYNTAX-EVAL-USE-ENV) () ())
                            (if (pair? subject)
                                (match-pattern-list
                                  (cdr pattern) (cdr subject) transformer
                                  (cell-get SYNTAX-EVAL-USE-ENV) () ())
                                MATCH-FAIL))))
                  (if (eq? captures MATCH-FAIL)
                      (syntax-eval-syntax-clauses
                        (cdr clauses) subject transformer env outer)
                      (let ((clause-env
                              (syntax-bind-pattern-values
                                variables captures (syntax-env-push env))))
                        (let ((context
                                (syntax-context-extend
                                  outer transformer captures variables)))
                          (cell-set! SYNTAX-EVAL-CONTEXT context)
                          (let ((passed
                                  (if fender
                                      (syntax-eval fender clause-env)
                                      (syntax-eval-true))))
                            (if (syntax-eval-false? passed)
                                (begin
                                  (cell-set! SYNTAX-EVAL-CONTEXT outer)
                                  (syntax-eval-syntax-clauses
                                    (cdr clauses) subject transformer env
                                    outer))
                                (let ((result
                                        (syntax-eval-body
                                          body clause-env context)))
                                  (cell-set! SYNTAX-EVAL-CONTEXT outer)
                                  result))))))))))))))

(define (syntax-eval-syntax-case form env)
  (let ((subject (syntax-eval (car (cdr form)) env)))
    (let ((literals (car (cdr (cdr form))))
          (clauses (cdr (cdr (cdr form)))))
      (validate-literals literals)
      (let ((transformer
              (make-syntax-transformer "..." literals ()
                (cell-get SYNTAX-EVAL-DEFINITION-ENV)
                (cell-get SYNTAX-EVAL-DEFINITION-MACRO-ENV))))
        (syntax-eval-syntax-clauses
          clauses subject transformer env (cell-get SYNTAX-EVAL-CONTEXT))))))

(define (syntax-eval-with-bindings bindings env captures variables)
  (if (null? bindings)
      (cons captures variables)
      (let ((binding (car bindings)))
        (if (not (pair? binding))
            (fatal "malformed with-syntax binding"))
        (let ((pattern (car binding))
              (value (syntax-eval (car (cdr binding)) env)))
          (let ((transformer (syntax-eval-current-transformer)))
            (let ((new-variables
                    (validate-pattern
                      pattern (transformer-literals transformer)
                      (transformer-ellipsis transformer) 0 ())))
              (let ((new-captures
                      (match-pattern pattern value transformer
                                     (cell-get SYNTAX-EVAL-USE-ENV) () ())))
                (if (eq? new-captures MATCH-FAIL)
                    (fatal "with-syntax pattern did not match")
                    (syntax-eval-with-bindings
                      (cdr bindings) env
                      (syntax-append new-captures captures)
                      (syntax-append new-variables variables))))))))))

(define (syntax-eval-with-syntax form env)
  (let ((bindings (car (cdr form)))
        (body (cdr (cdr form))))
    (let ((collected (syntax-eval-with-bindings bindings env () ())))
      (let ((captures (car collected))
            (variables (cdr collected)))
        (let ((body-env
                (syntax-bind-pattern-values
                  variables captures (syntax-env-push env))))
          (let ((outer (cell-get SYNTAX-EVAL-CONTEXT)))
            (let ((context
                    (syntax-context-extend
                      outer (syntax-eval-current-transformer)
                      captures variables)))
              (cell-set! SYNTAX-EVAL-CONTEXT context)
              (let ((result (syntax-eval-body body body-env context)))
                (cell-set! SYNTAX-EVAL-CONTEXT outer)
                result))))))))

; ---------------- entry points ----------------

(define (syntax-eval-phase-definitions forms)
  (if (null? (cell-get PHASE-VALUE-ENV))
      (cell-set! PHASE-VALUE-ENV (cons () ()))
      ())
  (let ((env (cell-get PHASE-VALUE-ENV)))
    (syntax-eval-predeclare forms env)
    (syntax-eval-body-loop forms env ())))

(define (syntax-eval-for-syntax forms)
  (let ((env
          (if (null? (cell-get PHASE-VALUE-ENV))
              (begin
                (cell-set! PHASE-VALUE-ENV (cons () ()))
                (cell-get PHASE-VALUE-ENV))
              (cell-get PHASE-VALUE-ENV))))
    (syntax-eval-body forms env ())))

(define (eval-procedural-transformer transformer use value-env)
  (let ((previous-definition (cell-get SYNTAX-EVAL-DEFINITION-ENV))
        (previous-macro (cell-get SYNTAX-EVAL-DEFINITION-MACRO-ENV))
        (previous-use (cell-get SYNTAX-EVAL-USE-ENV))
        (previous-mark (cell-get SYNTAX-EVAL-MARK))
        (previous-context (cell-get SYNTAX-EVAL-CONTEXT)))
    (cell-set! SYNTAX-EVAL-DEFINITION-ENV
               (procedural-transformer-definition-env transformer))
    (cell-set! SYNTAX-EVAL-DEFINITION-MACRO-ENV
               (procedural-transformer-definition-macro-env transformer))
    (cell-set! SYNTAX-EVAL-USE-ENV value-env)
    (cell-set! SYNTAX-EVAL-MARK (fresh-syntax-mark))
    (cell-set! SYNTAX-EVAL-CONTEXT ())
    (let ((procedure
            (syntax-eval (procedural-transformer-specification transformer)
                         (syntax-env-push ()))))
      (let ((result (syntax-eval-call procedure (cons use ()))))
        (let ((mark (cell-get SYNTAX-EVAL-MARK)))
          (cell-set! SYNTAX-EVAL-DEFINITION-ENV previous-definition)
          (cell-set! SYNTAX-EVAL-DEFINITION-MACRO-ENV previous-macro)
          (cell-set! SYNTAX-EVAL-USE-ENV previous-use)
          (cell-set! SYNTAX-EVAL-MARK previous-mark)
          (cell-set! SYNTAX-EVAL-CONTEXT previous-context)
          (cons result mark))))))

; ---------------- compile-time macros inside transformer bodies ----------------

; Local let-syntax bindings shadow phase-1 and definition-site macros.
(define (syntax-eval-macro-binding identifier)
  (let ((name (datum-symbol-name identifier)))
    (let ((local (string-assoc
                   name (cell-get SYNTAX-EVAL-LOCAL-MACROS))))
      (if (not (null? local))
          (cdr local)
          (let ((phase (string-assoc
                         name (cell-get PHASE-MACRO-ENV))))
            (if (not (null? phase))
                (cdr phase)
                (let ((global
                        (lookup-macro-binding
                          identifier
                          (cell-get SYNTAX-EVAL-DEFINITION-MACRO-ENV))))
                  (if (null? global)
                      ()
                      (if (eq? global UNINITIALIZED-SYNTAX)
                          ()
                          (if (core-syntax-value? global) () global))))))))))

(define (syntax-eval-expand-macro transformer expression env)
  (if (procedural-transformer? transformer)
      (let ((transcription
              (eval-procedural-transformer
                transformer expression (cell-get SYNTAX-EVAL-USE-ENV))))
        (syntax-eval (car transcription) env))
      (let ((transcription
              (transcribe-macro
                transformer expression (cell-get SYNTAX-EVAL-USE-ENV))))
        (let ((output (car transcription))
              (outer (cell-get SYNTAX-EVAL-CONTEXT))
              (captures (cell-get CURRENT-TRANSCRIPTION-CAPTURES))
              (variables (cell-get CURRENT-TRANSCRIPTION-VARIABLES)))
          (cell-set! SYNTAX-EVAL-CONTEXT
                     (syntax-context-extend
                       outer transformer captures variables))
          (let ((result (syntax-eval output env)))
            (cell-set! SYNTAX-EVAL-CONTEXT outer)
            result)))))

(define (syntax-eval-define-syntax form env)
  (if (not (pair? (cdr form)))
      (fatal "malformed transformer define-syntax"))
  (let ((name (car (cdr form))))
    (if (not (datum-symbol? name))
        (fatal "transformer define-syntax needs an identifier"))
    (let ((transformer
            (parse-syntax-rules
              (car (cdr (cdr form)))
              (cell-get SYNTAX-EVAL-DEFINITION-ENV)
              (cell-get SYNTAX-EVAL-DEFINITION-MACRO-ENV))))
      (cell-set! PHASE-MACRO-ENV
                 (cons (cons (datum-symbol-name name) transformer)
                       (cell-get PHASE-MACRO-ENV)))
      SYNTAX-EVAL-UNSPECIFIED)))

(define (syntax-eval-local-macro-specs bindings)
  (if (null? bindings)
      ()
      (let ((binding (car bindings)))
        (if (not (pair? binding))
            (fatal "malformed transformer let-syntax binding"))
        (cons
          (cons (datum-symbol-name (car binding))
                (parse-syntax-rules
                  (car (cdr binding))
                  (cell-get SYNTAX-EVAL-DEFINITION-ENV)
                  (cell-get SYNTAX-EVAL-DEFINITION-MACRO-ENV)))
          (syntax-eval-local-macro-specs (cdr bindings))))))

(define (syntax-eval-local-macro-placeholders bindings)
  (if (null? bindings)
      ()
      (cons (cons (datum-symbol-name (car (car bindings)))
                  UNINITIALIZED-SYNTAX)
            (syntax-eval-local-macro-placeholders (cdr bindings)))))

(define (syntax-eval-let-syntax form env recursive)
  (let ((bindings (car (cdr form)))
        (body (cdr (cdr form))))
    (let ((saved (cell-get SYNTAX-EVAL-LOCAL-MACROS)))
      (if recursive
          (cell-set! SYNTAX-EVAL-LOCAL-MACROS
                     (syntax-append
                       (syntax-eval-local-macro-placeholders bindings)
                       saved))
          ())
      (let ((parsed (syntax-eval-local-macro-specs bindings)))
        (cell-set! SYNTAX-EVAL-LOCAL-MACROS
                   (syntax-append parsed saved))
        (let ((result
                (syntax-eval-body body env (cell-get SYNTAX-EVAL-CONTEXT))))
          (cell-set! SYNTAX-EVAL-LOCAL-MACROS saved)
          result)))))
