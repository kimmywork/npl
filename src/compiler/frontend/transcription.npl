; Macro transcription hygiene (see expand-transcription in expand.npl):
; definition-producing output spliced unexpanded into a body or top level,
; and the alias environments used to expand expression output.

(define (begin-defined-identifiers form acc)
  (cond
    ((raw-form? form "begin")
     (begin-defined-list (cdr form) acc))
    ((raw-form? form "define")
     (let ((single (direct-defined-identifier form)))
       (if (null? single) acc (cons single acc))))
    ((raw-form? form "define-values")
     (append-forms (define-values-proper-formals (car (cdr form))) acc))
    ((raw-form? form "define-syntax")
     (if (datum-symbol? (car (cdr form))) (cons (car (cdr form)) acc) acc))
    (else acc)))

;; Like begin-defined-list, but only names defined as values (define,
;; define-values): syntax keywords must not be predeclared as variables.
(define (begin-defined-value-list forms acc)
  (if (pair? forms)
      (begin-defined-value-list
        (cdr forms)
        (let ((form (car forms)))
          (cond
            ((raw-form? form "begin") (begin-defined-value-list (cdr form) acc))
            ((raw-form? form "define-syntax") acc)
            (else (begin-defined-identifiers form acc)))))
      acc))

(define (begin-defined-list forms acc)
  (if (pair? forms)
      (begin-defined-list (cdr forms) (begin-defined-identifiers (car forms) acc))
      acc))

(define (identifier-member? identifier identifiers)
  (if (null? identifiers)
      #f
      (if (eq? identifier (car identifiers))
          #t
          (identifier-member? identifier (cdr identifiers)))))

; Free marked identifiers are kept as identifiers but re-marked with a
; fresh mark whose only binding is the definition-site one, recorded in
; TRANSCRIPTION-ALIASES (syntax.npl); value lookup consults it last.
; Quoted data stays unchanged.

; Keywords get the same treatment through TRANSCRIPTION-MACRO-ALIASES.
(define (resolve-marked-free form mark definition-env definition-macros
                             defined)
  (cond
    ((datum-symbol? form)
     (if (if (= (identifier-mark form) mark)
             (not (identifier-member? form defined))
             #f)
         (let ((name (datum-symbol-name form)))
           (let ((binding (lookup-value-binding-key name 0 definition-env))
                 (keyword (lookup-macro-cell-key name 0 definition-macros)))
             (cond
               ((> (string-length binding) 0)
                (transcription-alias form TRANSCRIPTION-ALIASES binding))
               ((not (null? keyword))
                (transcription-alias form TRANSCRIPTION-MACRO-ALIASES keyword))
               (else form))))
         form))
    ((pair? form)
     (if (if (datum-symbol? (car form))
             (string=? (datum-symbol-name (car form)) "quote")
             #f)
         form
         (cons (resolve-marked-free (car form) mark definition-env
                                    definition-macros defined)
               (resolve-marked-free (cdr form) mark definition-env
                                    definition-macros defined))))
    (else form)))

(define (transcription-alias form table meaning)
  (let ((alias (datum-symbol (datum-symbol-name form)))
        (alias-mark (fresh-syntax-mark)))
    (set-identifier-mark! alias alias-mark)
    (cell-set! table
      (cons (cons (datum-symbol-name form) (cons alias-mark (cons meaning ())))
            (cell-get table)))
    alias))

; Expression output: the definition environment is visible under the
; transcription mark, layered over the use environment.
(define (alias-value-environment definition-env mark use-env)
  (if (null? definition-env)
      use-env
      (let ((entry (car definition-env)))
        (alias-value-environment
          (cdr definition-env) mark
          (cons (cons (car entry)
                      (cons mark (cons (car (cdr (cdr entry))) ())))
                use-env)))))

(define (alias-macro-environment definition-env mark use-env)
  (if (null? definition-env)
      use-env
      (let ((entry (car definition-env)))
        (alias-macro-environment
          (cdr definition-env) mark
          (cons (cons (car entry)
                      (cons mark (cons (macro-entry-cell entry) ())))
                use-env)))))
