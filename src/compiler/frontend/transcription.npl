; Hygiene for definition-producing macro output that is spliced unexpanded
; into a body or top level (see expand-transcription in expand.npl).

(define (begin-defined-identifiers form acc)
  (cond
    ((raw-form? form "begin")
     (begin-defined-list (cdr form) acc))
    ((raw-form? form "define")
     (let ((single (direct-defined-identifier form)))
       (if (null? single) acc (cons single acc))))
    ((raw-form? form "define-values")
     (append-forms (car (cdr form)) acc))
    ((raw-form? form "define-syntax")
     (if (datum-symbol? (car (cdr form))) (cons (car (cdr form)) acc) acc))
    (else acc)))

(define (begin-defined-list forms acc)
  (if (pair? forms)
      (begin-defined-list (cdr forms) (begin-defined-identifiers (car forms) acc))
      acc))

(define (identifier-member? identifier identifiers)
  (if (null? identifiers)
      #f
      (if (eq? identifier (car identifiers))
          #t
          (identifier-member? identifier (cdr identifiers)))))

; Free marked identifiers are kept as identifiers but re-marked with a
; fresh mark whose only binding is the definition-site one, recorded in
; TRANSCRIPTION-ALIASES (syntax.npl); value lookup consults it last.
; Quoted data stays unchanged.

(define (resolve-marked-free form mark definition-env defined)
  (cond
    ((datum-symbol? form)
     (if (if (= (identifier-mark form) mark)
             (not (identifier-member? form defined))
             #f)
         (let ((binding (lookup-value-binding-key
                          (datum-symbol-name form) 0 definition-env)))
           (if (> (string-length binding) 0)
               (let ((alias (datum-symbol (datum-symbol-name form)))
                     (alias-mark (fresh-syntax-mark)))
                 (set-identifier-mark! alias alias-mark)
                 (cell-set! TRANSCRIPTION-ALIASES
                   (cons (cons (datum-symbol-name form)
                               (cons alias-mark (cons binding ())))
                         (cell-get TRANSCRIPTION-ALIASES)))
                 alias)
               form))
         form))
    ((pair? form)
     (if (if (datum-symbol? (car form))
             (string=? (datum-symbol-name (car form)) "quote")
             #f)
         form
         (cons (resolve-marked-free (car form) mark definition-env defined)
               (resolve-marked-free (cdr form) mark definition-env defined))))
    (else form)))
