; Expression, primitive call, and application emission.

(define (count-up xs n)
  (if (null? xs) n (count-up (cdr xs) (+ n 1))))

(define (eval-args-fixed args env need acc)
  (if (= need 0)
      (rev acc)
      (if (null? args)
          (fatal "missing argument")
          (let ((v (emit-expr (car args) env)))
            (eval-args-fixed (cdr args) env (- need 1) (cons v acc))))))

(define (check-arity args lo hi)
  (let ((n (count-up args 0)))
    (if (< n lo) (fatal "too few arguments")
        (if (> n hi) (fatal2n "too many arguments" hi) n))))

(define (fatal2n msg n)
  (begin (display "nplc1: ") (display msg)
         (display " expected=") (display n)
         (newline) (exit 21)))

(define (checked-call fn n args env)
  (check-arity args n n)
  (let ((ops (eval-args-fixed args env n ())))
    (call-with-ops fn ops)))

(define (zero-named fn args)
  (check-arity args 0 0)
  (let ((r (new-tmp)))
    (func-line (string-append r " =l call $" fn "()"))
    r))

(define (current-port-op fn)
  (let ((port (new-tmp)))
    (func-line (string-append port " =l call $" fn "()"))
    port))

(define (optional-input-call fn args env)
  (let ((count (check-arity args 0 1)))
    (if (= count 0)
        (call-with-ops fn
          (cons (current-port-op "npl_current_input_port") ()))
        (checked-call fn 1 args env))))

(define (optional-output-call fn required args env)
  (let ((count (check-arity args required (+ required 1))))
    (let ((ops (eval-args-fixed args env count ())))
      (if (= count required)
          (call-with-ops fn
            (append-list ops
              (cons (current-port-op "npl_current_output_port") ())))
          (call-with-ops fn ops)))))

(define (not-builtin args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =l ceql " v ", 10"))
      (bool-from-raw raw))))

(define (eq-builtin args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =l ceql " (car ops) ", "
                                (car (cdr ops))))
      (bool-from-raw raw))))

(define (null-question args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =w ceql " v ", 2"))
      (bool-from-raw raw))))

(define (pair-question args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((low (new-tmp)))
      (func-line (string-append low " =w and " v ", 3"))
      (let ((isp (new-tmp)))
        (func-line (string-append isp " =w ceqw " low ", 1"))
        (let ((lt (new-label)))
          (let ((lf (new-label)))
            (let ((ld (new-label)))
              (let ((raw (new-tmp)))
                (func-line (string-append "jnz " isp ", " lt ", " lf))
                (func-line lt)
                (let ((addr (new-tmp)))
                  (func-line (string-append addr " =l add " v ", -1"))
                  (let ((hdr (new-tmp)))
                    (func-line (string-append hdr " =l loadsw " addr))
                    (func-line (string-append raw " =w ceqw " hdr ", 0"))
                    (func-line (string-append "jmp " ld))
                    (func-line lf)
                    (func-line (string-append raw " =l copy 0"))
                    (func-line ld)
                    (bool-from-raw raw)))))))))))

(define (progn-exit args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (func-line (string-append "call $npl_exit(l " v ")"))
    "2"))

(define (two-to-nil qfn args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (func-line (string-append "call $" qfn "(l " (car ops)
                             ", l " (car (cdr ops)) ")"))
    "2"))

(define (len-as-fixnum args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =l call $npl_string_length(l " v ")"))
      (let ((r (new-tmp)))
        (func-line (string-append r " =l shl " raw ", 2"))
        r))))

(define (streq-builtin args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =w call $npl_string_equal(l "
                                (car ops) ", l " (car (cdr ops)) ")"))
      (bool-from-raw raw))))

(define (unknown-call nm)
  (begin (display "nplc1: unknown builtin or unbound: ")
         (display nm) (newline) (exit 31)))

(define (make-cell-op value)
  (let ((cell-op (new-tmp)))
    (func-line (string-append cell-op " =l call $npl_cons(l " value ", l 2)"))
    cell-op))

(define (read-cell-op cell-op)
  (let ((value (new-tmp)))
    (func-line (string-append value " =l call $npl_car(l " cell-op ")"))
    value))

(define (write-cell-op cell-op value)
  (func-line (string-append "call $npl_set_car(l " cell-op ", l " value ")")))

(define (symbol-value nm env)
  (let ((local (env-read env nm)))
    (if (> (string-length local) 0)
        local
        (let ((glob (lookup-glob nm)))
          (if (> (string-length glob) 0)
              (let ((r (new-tmp)))
                (func-line (string-append r " =l loadl " glob))
                r)
              (if (> (string-length (lookup-func nm)) 0)
                  (function-closure nm)
                  (if (primitive-row nm)
                      (primitive-closure nm)
                      (fatal (string-append "unbound symbol " nm)))))))))

(define (tagged-form e env)
  ; an APPLICATION's head is itself a pair (the callee expression);
  ; tagged forms carry a numeric tag in the car.
  (if (pair-shape? (car e))
      (emit-application e env)
      (tagged-dispatch e env)))

(define (tagged-dispatch e env)
  (case (car e)
    ((108) (let ((r (new-tmp)))
             (func-line (string-append r " =l copy 6"))
             r))
    ((109) (let ((r (new-tmp)))
             (func-line (string-append r " =l copy 10"))
             r))
    ((100) (symbol-value (cdr e) env))
    ((101) (fresh-string-op (cdr e)))
    ((102 103 104) (walk-boxed e))
    ((204) (walk-datum (car (cdr e))))
    ((212) (emit-lambda e env))
    ((213) (emit-if e env))
    ((214) (emit-let e env))
    ((216) (emit-body (cdr e) env))
    ((217) (emit-set e env))
    ((220) (emit-letstar e env))
    ((221) (emit-letrec e env #f))
    ((222) (emit-letrec e env #t))
    ((215) (emit-application e env))
    (else (fatal "unknown AST form"))))

(define (emit-application e env)
  (let ((head (car e)))
    (if (sym-atom? head)
        (let ((local (env-read env (cdr head))))
          (if (> (string-length local) 0)
              (emit-closure-call local (cdr e) env)
              (if (> (string-length (lookup-glob (cdr head))) 0)
                  (emit-closure-call (symbol-value (cdr head) env)
                                     (cdr e) env)
                  (route-call (cdr head) (cdr e) env))))
        (emit-closure-call (emit-expr head env) (cdr e) env))))

(define (store-argv ops base index)
  (if (null? ops)
      0
      (if (= index 0)
          (begin
            (func-line (string-append "storel " (car ops) ", " base))
            (store-argv (cdr ops) base (+ index 1)))
          (let ((slot (new-tmp)))
            (func-line (string-append slot " =l add " base ", "
                                      (number->string (* index 8))))
            (func-line (string-append "storel " (car ops) ", " slot))
            (store-argv (cdr ops) base (+ index 1))))))

(define (argv-op ops)
  (if (null? ops)
      "0"
      (let ((base (new-tmp)))
        (func-line (string-append base " =l alloc8 "
                                  (number->string (* (count-up ops 0) 8))))
        (store-argv ops base 0)
        base)))

(define (emit-closure-call closure args env)
  (let ((count (count-up args 0)))
    (let ((ops (eval-args-fixed args env count ())))
      (let ((argv (argv-op ops)))
        (let ((result (new-tmp)))
          (func-line
            (string-append result " =l call $npl_apply(l " closure
                           ", l " (number->string count) ", l " argv ")"))
          result)))))

(define (function-closure nm)
  (let ((result (new-tmp)))
    (func-line
      (string-append result " =l call $npl_make_closure(l $"
                     (lookup-func nm) ", l 2, l "
                     (number->string (lookup-func-arity nm)) ")"))
    result))

(define (emit-expr e env)
  (if (number? e)
      (let ((r (new-tmp)))
        (func-line (string-append r " =l copy "
                            (integer-literal-op e #f)))
        r)
      (if (null? e)
          "2"
          (if (pair-shape? e)
              (tagged-form e env)
              (fatal "bad expression")))))

; build a call argument list of ANY length by folding the operand list
(define (args-join ops)
  ; returns "l a, l b, ..." — requires >=1 op
  (if (null? (cdr ops))
      (string-append "l " (car ops))
      (string-append "l " (car ops) ", " (args-join (cdr ops)))))

(define (call-with-ops fn ops)
  (let ((r (new-tmp))
        (n (length-xs ops)))
    (if (= n 0)
        (func-line (string-append r " =l call $" fn "()"))
        (func-line (string-append r " =l call $" fn "("
                                  (args-join ops) ")")))
    r))

(define (length-xs xs)
  (if (null? xs) 0 (+ 1 (length-xs (cdr xs)))))

(define (bool-from-raw raw)
  (let ((wide (new-tmp)))
    (func-line (string-append wide " =l extsw " raw))
    (let ((sh (new-tmp)))
      (func-line (string-append sh " =l shl " wide ", 2"))
      (let ((base (new-tmp)))
        (func-line (string-append base " =l copy 10"))
        (let ((rr (new-tmp)))
          (func-line (string-append rr " =l sub " base ", " sh))
          rr)))))

(define (emit-compare opn args env)
  (let ((count (count-up args 0)))
    (check-arity args 2 count)
    ; Evaluate every operand once before testing any adjacent pair.
    (emit-compare-chain opn (eval-args-fixed args env count ()))))

(define (emit-compare-chain opn ops)
  (let ((first (emit-compare-pair opn (car ops) (car (cdr ops)))))
    (if (null? (cdr (cdr ops)))
        first
        (let ((rest (emit-compare-chain opn (cdr ops))))
          ; Tagged booleans are 6 and 10: OR is false if either is false.
          (let ((combined (new-tmp)))
            (func-line (string-append combined " =l or " first ", " rest))
            (let ((raw (new-tmp)))
              (func-line (string-append raw " =w ceql " combined ", 6"))
              (bool-from-raw raw)))))))

(define (emit-compare-pair opn va vb)
  (let ((order (new-tmp)))
    (func-line (string-append order " =w call $npl_number_compare(l "
                             va ", l " vb ")"))
    (let ((raw (new-tmp)))
      (func-line
        (string-append raw " =w "
          (cond ((string=? opn "<") "csltw")
                ((string=? opn ">") "csgtw")
                ((string=? opn "=") "ceqw")
                ((string=? opn "<=") "cslew")
                (else "csgew"))
          " " order ", 0"))
      (bool-from-raw raw))))

(define (is-cmp? nm)
  (cond ((string=? nm "<") #t)
        ((string=? nm ">") #t)
        ((string=? nm "=") #t)
        ((string=? nm "<=") #t)
        ((string=? nm ">=") #t)
        (else #f)))

(define (collection-call-ops constructor ops)
  (let ((count (count-up ops 0)))
    (let ((argv (argv-op ops)))
      (let ((result (new-tmp)))
        (func-line
          (string-append result " =l call $" constructor "(l "
                         (number->string count) ", l " argv ")"))
        result))))

(define (bytevector-end-op bytevector)
  (call-with-ops "npl_bytevector_length" (cons bytevector ())))

(define (read-bytevector-call args env)
  (let ((count (check-arity args 1 2)))
    (let ((ops (eval-args-fixed args env count ())))
      (if (= count 1)
          (collection-call-ops "npl_read_bytevector"
            (append-list ops
              (cons (current-port-op "npl_current_input_port") ())))
          (collection-call-ops "npl_read_bytevector" ops)))))

(define (bytevector-range-call fn port-fn args env)
  (let ((count (check-arity args 1 4)))
    (let ((ops (eval-args-fixed args env count ())))
      (let ((bytevector (car ops)))
        (cond
          ((= count 1)
           (collection-call-ops fn
             (cons bytevector
               (cons (current-port-op port-fn)
                 (cons "0" (cons (bytevector-end-op bytevector) ()))))))
          ((= count 2)
           (collection-call-ops fn
             (append-list ops
               (cons "0" (cons (bytevector-end-op bytevector) ())))))
          ((= count 3)
           (collection-call-ops fn
             (append-list ops
               (cons (bytevector-end-op bytevector) ()))))
          (else (collection-call-ops fn ops)))))))

(define (collection-call constructor args env)
  (let ((count (count-up args 0)))
    (let ((ops (eval-args-fixed args env count ())))
      (let ((argv (argv-op ops)))
        (let ((result (new-tmp)))
          (func-line
            (string-append result " =l call $" constructor "(l "
                           (number->string count) ", l " argv ")"))
          result)))))

;; A registered intrinsic is emitted from its PRIMITIVE-TABLE row; any other
;; name is a top-level user function.
(define (route-call nm args env)
  (let ((row (primitive-row nm)))
    (cond
      ((not row)
       (if (> (string-length (lookup-func nm)) 0)
           (if (> (string-length (numeric-alias-primitive-name nm)) 0)
               (emit-numeric-alias-call nm args env)
               (user-call nm args env))
           (unknown-call nm)))
      ((string=? (primitive-row-kind row) "fixed")
       (checked-call (primitive-row-symbol row)
                     (primitive-row-required row) args env))
      ((string=? (primitive-row-kind row) "out-port")
       (optional-output-call (primitive-row-symbol row)
                             (primitive-row-required row) args env))
      ((string=? (primitive-row-kind row) "in-port")
       (optional-input-call (primitive-row-symbol row) args env))
      ((string=? (primitive-row-kind row) "count")
       (collection-call (primitive-row-symbol row) args env))
      (else (emit-special-primitive nm row args env)))))

(define (emit-special-primitive nm row args env)
  (cond
    ((is-cmp? nm) (emit-compare nm args env))
    ((string=? nm "+") (emit-integer-arithmetic nm args env))
    ((string=? nm "-") (emit-integer-arithmetic nm args env))
    ((string=? nm "*") (emit-integer-arithmetic nm args env))
    ((string=? nm "null?") (null-question args env))
    ((string=? nm "pair?") (pair-question args env))
    ((string=? nm "not") (not-builtin args env))
    ((string=? nm "eq?") (eq-builtin args env))
    ((string=? nm "exit") (progn-exit args env))
    ((string=? nm "set-car!") (two-to-nil (primitive-row-symbol row) args env))
    ((string=? nm "set-cdr!") (two-to-nil (primitive-row-symbol row) args env))
    ((string=? nm "string-length") (len-as-fixnum args env))
    ((string=? nm "string=?") (streq-builtin args env))
    ((string=? nm "apply")
     (fatal "apply outside tail position after control conversion"))
    ((string=? nm "read-bytevector") (read-bytevector-call args env))
    ((string=? nm "read-bytevector!")
     (bytevector-range-call (primitive-row-symbol row)
                            "npl_current_input_port" args env))
    ((string=? nm "write-bytevector")
     (bytevector-range-call (primitive-row-symbol row)
                            "npl_current_output_port" args env))
    (else (fatal (string-append "unhandled special primitive " nm)))))

(define (registered-arity-accepts? arity count)
  (if (< arity 0)
      (>= count (- (- 0 arity) 1))
      (= count arity)))

(define (user-call nm args env)
  (let ((argn (count-up args 0)))
    (if (not (registered-arity-accepts?
               (lookup-func-arity nm) argn))
        (fatal "function arity mismatch"))
    (let ((ops (eval-args-fixed args env argn ())))
      (let ((argv (argv-op ops)))
        (let ((result (new-tmp)))
          (func-line
            (string-append result " =l call $npl_trampoline(l $"
                           (lookup-func nm) ", l 2, l "
                           (number->string argn) ", l " argv ")"))
          result)))))
