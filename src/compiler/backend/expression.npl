; Expression, primitive call, and application emission.

(define (count-up xs n)
  (if (null? xs) n (count-up (cdr xs) (+ n 1))))

(define (eval-args-fixed args env need acc)
  (if (= need 0)
      (rev acc)
      (if (null? args)
          (fatal "missing argument")
          (let ((v (emit-expr (car args) env)))
            (eval-args-fixed (cdr args) env (- need 1) (cons v acc))))))

(define (check-arity args lo hi)
  (let ((n (count-up args 0)))
    (if (< n lo) (fatal "too few arguments")
        (if (> n hi) (fatal2n "too many arguments" hi) n))))

(define (fatal2n msg n)
  (begin (display "nplc1: ") (display msg)
         (display " expected=") (display n)
         (newline) (exit 21)))

; R7RS variadic string-append: fold left-to-right via npl_string_append
(define (variadic-append args env)
  (app-fold (eval-args-fixed args env (count-up args 0) ())))

(define (app-fold ops)
  (if (null? ops)
      (fatal "append-empty")
      (if (null? (cdr ops))
          (car ops)
          (let ((r (new-tmp)))
            (func-line (string-append r " =l call $npl_string_append(l "
                                      (car ops) ", l "
                                      (car (cdr ops)) ")"))
            (app-fold (cons r (cdr (cdr ops))))))))

(define (checked-call fn n args env)
  (check-arity args n n)
  (let ((ops (eval-args-fixed args env n ())))
    (call-with-ops fn ops)))

(define (zero-named fn args)
  (check-arity args 0 0)
  (let ((r (new-tmp)))
    (func-line (string-append r " =l call $" fn "()"))
    r))

(define (current-port-op fn)
  (let ((port (new-tmp)))
    (func-line (string-append port " =l call $" fn "()"))
    port))

(define (optional-input-call fn args env)
  (let ((count (check-arity args 0 1)))
    (if (= count 0)
        (call-with-ops fn
          (cons (current-port-op "npl_current_input_port") ()))
        (checked-call fn 1 args env))))

(define (optional-output-call fn required args env)
  (let ((count (check-arity args required (+ required 1))))
    (let ((ops (eval-args-fixed args env count ())))
      (if (= count required)
          (call-with-ops fn
            (append-list ops
              (cons (current-port-op "npl_current_output_port") ())))
          (call-with-ops fn ops)))))

(define (not-builtin args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =l ceql " v ", 10"))
      (bool-from-raw raw))))

(define (eq-builtin args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =l ceql " (car ops) ", "
                                (car (cdr ops))))
      (bool-from-raw raw))))

(define (null-question args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =w ceql " v ", 2"))
      (bool-from-raw raw))))

(define (pair-question args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((low (new-tmp)))
      (func-line (string-append low " =w and " v ", 3"))
      (let ((isp (new-tmp)))
        (func-line (string-append isp " =w ceqw " low ", 1"))
        (let ((lt (new-label)))
          (let ((lf (new-label)))
            (let ((ld (new-label)))
              (let ((raw (new-tmp)))
                (func-line (string-append "jnz " isp ", " lt ", " lf))
                (func-line lt)
                (let ((addr (new-tmp)))
                  (func-line (string-append addr " =l add " v ", -4"))
                  (let ((hdr (new-tmp)))
                    (func-line (string-append hdr " =l loadsw " addr))
                    (func-line (string-append raw " =w ceqw " hdr ", 0"))
                    (func-line (string-append "jmp " ld))
                    (func-line lf)
                    (func-line (string-append raw " =l copy 0"))
                    (func-line ld)
                    (bool-from-raw raw)))))))))))

(define (progn-exit args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (func-line (string-append "call $npl_exit(l " v ")"))
    "2"))

(define (two-to-nil qfn args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (func-line (string-append "call $" qfn "(l " (car ops)
                             ", l " (car (cdr ops)) ")"))
    "2"))

(define (len-as-fixnum args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =l call $npl_string_length(l " v ")"))
      (let ((r (new-tmp)))
        (func-line (string-append r " =l shl " raw ", 2"))
        r))))

(define (streq-builtin args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =w call $npl_string_equal(l "
                                (car ops) ", l " (car (cdr ops)) ")"))
      (bool-from-raw raw))))

(define (mul-builtin args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (let ((ua (new-tmp)))
      (func-line (string-append ua " =l sar " (car ops) ", 2"))
      (let ((ub (new-tmp)))
        (func-line (string-append ub " =l sar " (car (cdr ops)) ", 2"))
        (let ((m (new-tmp)))
          (func-line (string-append m " =l mul " ua ", " ub))
          (let ((r (new-tmp)))
            (func-line (string-append r " =l shl " m ", 2"))
            r))))))

(define (binary-tagged qop args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (let ((r (new-tmp)))
      (func-line (string-append r " =l " qop " " (car ops)
                               ", " (car (cdr ops))))
      r)))

(define (unknown-call nm)
  (begin (display "nplc1: unknown builtin or unbound: ")
         (display nm) (newline) (exit 31)))

(define (make-cell-op value)
  (let ((cell-op (new-tmp)))
    (func-line (string-append cell-op " =l call $npl_cons(l " value ", l 2)"))
    cell-op))

(define (read-cell-op cell-op)
  (let ((value (new-tmp)))
    (func-line (string-append value " =l call $npl_car(l " cell-op ")"))
    value))

(define (write-cell-op cell-op value)
  (func-line (string-append "call $npl_set_car(l " cell-op ", l " value ")")))

(define (symbol-value nm env)
  (let ((local (env-lookup env nm)))
    (if (> (string-length local) 0)
        (read-cell-op local)
        (let ((glob (lookup-glob nm)))
          (if (> (string-length glob) 0)
              (let ((r (new-tmp)))
                (func-line (string-append r " =l loadl " glob))
                r)
              (if (> (string-length (lookup-func nm)) 0)
                  (function-closure nm)
                  (fatal (string-append "unbound symbol " nm))))))))

(define (tagged-form e env)
  ; an APPLICATION's head is itself a pair (the callee expression);
  ; tagged forms carry a numeric tag in the car.
  (if (pair-shape? (car e))
      (emit-application e env)
      (tagged-dispatch e env)))

(define (tagged-dispatch e env)
  (case (car e)
    ((108) (let ((r (new-tmp)))
             (func-line (string-append r " =l copy 6"))
             r))
    ((109) (let ((r (new-tmp)))
             (func-line (string-append r " =l copy 10"))
             r))
    ((100) (symbol-value (cdr e) env))
    ((101) (fresh-string-op (cdr e)))
    ((102 103 104) (walk-boxed e))
    ((204) (walk-datum (car (cdr e))))
    ((212) (emit-lambda e env))
    ((213) (emit-if e env))
    ((214) (emit-let e env))
    ((216) (emit-body (cdr e) env))
    ((217) (emit-set e env))
    ((220) (emit-letstar e env))
    ((221) (emit-letrec e env #f))
    ((222) (emit-letrec e env #t))
    ((215) (emit-application e env))
    (else (fatal "unknown AST form"))))

(define (emit-application e env)
  (let ((head (car e)))
    (if (sym-atom? head)
        (let ((local (env-lookup env (cdr head))))
          (if (> (string-length local) 0)
              (emit-closure-call (read-cell-op local) (cdr e) env)
              (if (> (string-length (lookup-glob (cdr head))) 0)
                  (emit-closure-call (symbol-value (cdr head) env)
                                     (cdr e) env)
                  (route-call (cdr head) (cdr e) env))))
        (emit-closure-call (emit-expr head env) (cdr e) env))))

(define (store-argv ops base index)
  (if (null? ops)
      0
      (if (= index 0)
          (begin
            (func-line (string-append "storel " (car ops) ", " base))
            (store-argv (cdr ops) base (+ index 1)))
          (let ((slot (new-tmp)))
            (func-line (string-append slot " =l add " base ", "
                                      (number->string (* index 8))))
            (func-line (string-append "storel " (car ops) ", " slot))
            (store-argv (cdr ops) base (+ index 1))))))

(define (argv-op ops)
  (if (null? ops)
      "0"
      (let ((base (new-tmp)))
        (func-line (string-append base " =l alloc8 "
                                  (number->string (* (count-up ops 0) 8))))
        (store-argv ops base 0)
        base)))

(define (emit-closure-call closure args env)
  (let ((count (count-up args 0)))
    (let ((ops (eval-args-fixed args env count ())))
      (let ((argv (argv-op ops)))
        (let ((result (new-tmp)))
          (func-line
            (string-append result " =l call $npl_apply(l " closure
                           ", l " (number->string count) ", l " argv ")"))
          result)))))

(define (function-closure nm)
  (let ((result (new-tmp)))
    (func-line
      (string-append result " =l call $npl_make_closure(l $"
                     (lookup-func nm) ", l 2, l "
                     (number->string (lookup-func-arity nm)) ")"))
    result))

(define (emit-expr e env)
  (if (number? e)
      (let ((r (new-tmp)))
        (func-line (string-append r " =l copy "
                            (npl_tagged_num_to_string e)))
        r)
      (if (null? e)
          "2"
          (if (pair-shape? e)
              (tagged-form e env)
              (fatal "bad expression")))))

; build a call argument list of ANY length by folding the operand list
(define (args-join ops)
  ; returns "l a, l b, ..." — requires >=1 op
  (if (null? (cdr ops))
      (string-append "l " (car ops))
      (string-append "l " (car ops) ", " (args-join (cdr ops)))))

(define (call-with-ops fn ops)
  (let ((r (new-tmp))
        (n (length-xs ops)))
    (if (= n 0)
        (func-line (string-append r " =l call $" fn "()"))
        (func-line (string-append r " =l call $" fn "("
                                  (args-join ops) ")")))
    r))

(define (length-xs xs)
  (if (null? xs) 0 (+ 1 (length-xs (cdr xs)))))

(define (bool-from-raw raw)
  (let ((wide (new-tmp)))
    (func-line (string-append wide " =l extsw " raw))
    (let ((sh (new-tmp)))
      (func-line (string-append sh " =l shl " wide ", 2"))
      (let ((base (new-tmp)))
        (func-line (string-append base " =l copy 10"))
        (let ((rr (new-tmp)))
          (func-line (string-append rr " =l sub " base ", " sh))
          rr)))))

(define (emit-compare opn args env)
  (check-arity args 2 2)
  (let ((va (emit-expr (car args) env)))
    (let ((vb (emit-expr (car (cdr args)) env)))
    (let ((ua (new-tmp)))
      (func-line (string-append ua " =l sar " va ", 2"))
      (let ((ub (new-tmp)))
        (func-line (string-append ub " =l sar " vb ", 2"))
        (let ((raw (new-tmp)))
          (func-line
            (string-append raw " =w "
              (cond ((string=? opn "<") "csltw")
                    ((string=? opn ">") "csgtw")
                    ((string=? opn "=") "ceqw")
                    ((string=? opn "<=") "cslew")
                    (else "csgew"))
              " " ua ", " ub))
          (bool-from-raw raw)))))))

(define (is-cmp? nm)
  (cond ((string=? nm "<") #t)
        ((string=? nm ">") #t)
        ((string=? nm "=") #t)
        ((string=? nm "<=") #t)
        ((string=? nm ">=") #t)
        (else #f)))

(define (cmp-or-arith nm args env)
  (cond ((is-cmp? nm) (emit-compare nm args env))
        ((string=? nm "+") (binary-tagged "add" args env))
        ((string=? nm "-") (binary-tagged "sub" args env))
        ((string=? nm "*") (mul-builtin args env))
        ((> (string-length (lookup-func nm)) 0) (user-call nm args env))
        (else (unknown-call nm))))

(define (number-question args env)
  (check-arity args 1 1)
  (let ((v (emit-expr (car args) env)))
    (let ((low (new-tmp)))
      (func-line (string-append low " =w and " v ", 3"))
      (let ((raw (new-tmp)))
        (func-line (string-append raw " =w ceqw " low ", 0"))
        (bool-from-raw raw)))))

; some C predicates return a raw int in a word register; those MUST be
; converted to proper booleans (#f=10/#t=6) before any `if` sees them.
(define (word-pred qfn args env)
  (check-arity args (count-up args 0) (count-up args 0))
  (let ((ops (eval-args-fixed args env (count-up args 0) ())))
    (let ((raw (new-tmp)))
      (func-line (string-append raw " =w call $" qfn "(l "
                                (car ops)
                                (arg-tail-rest (cdr ops))
                                ")"))
      (bool-from-raw raw))))

(define (arg-tail-rest rest)
  (if (null? rest)
      ""
      (string-append ", l " (car rest)
                     (arg-tail-rest (cdr rest)))))


(define (two-named-w qfn args env)
  (check-arity args 2 2)
  (let ((ops (eval-args-fixed args env 2 ())))
    (let ((r (new-tmp)))
      (func-line (string-append r " =l call $" qfn
                                "(l " (car ops)
                                ", l " (car (cdr ops)) ")"))
      r)))

(define (three-named-w qfn args env)
  (check-arity args 3 3)
  (let ((ops (eval-args-fixed args env 3 ())))
    (let ((r (new-tmp)))
      (func-line (string-append r " =l call $" qfn
                                "(l " (car ops)
                                ", l " (car (cdr ops))
                                ", l " (car (cdr (cdr ops))) ")"))
      r)))

(define (collection-call-ops constructor ops)
  (let ((count (count-up ops 0)))
    (let ((argv (argv-op ops)))
      (let ((result (new-tmp)))
        (func-line
          (string-append result " =l call $" constructor "(l "
                         (number->string count) ", l " argv ")"))
        result))))

(define (bytevector-end-op bytevector)
  (call-with-ops "npl_bytevector_length" (cons bytevector ())))

(define (read-bytevector-call args env)
  (let ((count (check-arity args 1 2)))
    (let ((ops (eval-args-fixed args env count ())))
      (if (= count 1)
          (collection-call-ops "npl_read_bytevector"
            (append-list ops
              (cons (current-port-op "npl_current_input_port") ())))
          (collection-call-ops "npl_read_bytevector" ops)))))

(define (bytevector-range-call fn port-fn args env)
  (let ((count (check-arity args 1 4)))
    (let ((ops (eval-args-fixed args env count ())))
      (let ((bytevector (car ops)))
        (cond
          ((= count 1)
           (collection-call-ops fn
             (cons bytevector
               (cons (current-port-op port-fn)
                 (cons "0" (cons (bytevector-end-op bytevector) ()))))))
          ((= count 2)
           (collection-call-ops fn
             (append-list ops
               (cons "0" (cons (bytevector-end-op bytevector) ())))))
          ((= count 3)
           (collection-call-ops fn
             (append-list ops
               (cons (bytevector-end-op bytevector) ()))))
          (else (collection-call-ops fn ops)))))))

(define (collection-call constructor args env)
  (let ((count (count-up args 0)))
    (let ((ops (eval-args-fixed args env count ())))
      (let ((argv (argv-op ops)))
        (let ((result (new-tmp)))
          (func-line
            (string-append result " =l call $" constructor "(l "
                           (number->string count) ", l " argv ")"))
          result)))))

(define (route-call nm args env)
  (cond
    ((string=? nm "string-ref") (checked-call "npl_string_ref" 2 args env))
    ((string=? nm "substring") (three-named-w "npl_substring" args env))
    ((string=? nm "int->string")
     (checked-call "npl_int_to_string_char" 1 args env))
    ((string=? nm "npl_tagged_num_to_string")
     (checked-call "npl_tagged_num_to_string" 1 args env))
    ((string=? nm "npl_lex_class_w")
     (checked-call "npl_lex_class_w" 2 args env))
    ((string=? nm "npl_lex_scan_sym_end")
     (checked-call "npl_lex_scan_sym_end" 2 args env))
    ((string=? nm "npl_lex_number")
     (checked-call "npl_lex_number" 3 args env))
    ((string=? nm "number?") (number-question args env))
    ((string=? nm "cons") (checked-call "npl_cons" 2 args env))
    ((string=? nm "car") (checked-call "npl_car" 1 args env))
    ((string=? nm "cdr") (checked-call "npl_cdr" 1 args env))
    ((string=? nm "display")
     (optional-output-call "npl_display_port" 1 args env))
    ((string=? nm "write")
     (optional-output-call "npl_write_port" 1 args env))
    ((string=? nm "write-shared")
     (optional-output-call "npl_write_port" 1 args env))
    ((string=? nm "write-simple")
     (optional-output-call "npl_write_port" 1 args env))
    ((string=? nm "newline")
     (optional-output-call "npl_newline_port" 0 args env))
    ((string=? nm "null?") (null-question args env))
    ((string=? nm "pair?") (pair-question args env))
    ((string=? nm "not") (not-builtin args env))
    ((string=? nm "eq?") (eq-builtin args env))
    ((string=? nm "eqv?") (eq-builtin args env))
    ((string=? nm "exit") (progn-exit args env))
    ((string=? nm "program-arguments")
     (zero-named "npl_program_arguments" args))
    ((string=? nm "get-environment-variable")
     (checked-call "npl_get_environment_variable" 1 args env))
    ((string=? nm "get-environment-variables")
     (zero-named "npl_get_environment_variables" args))
    ((string=? nm "set-car!") (two-to-nil "npl_set_car" args env))
    ((string=? nm "set-cdr!") (two-to-nil "npl_set_cdr" args env))
    ((string=? nm "string-append") (variadic-append args env))
    ((string=? nm "number->string")
     (checked-call "npl_number_to_string" 1 args env))
    ((string=? nm "symbol->string")
     (checked-call "npl_symbol_to_string" 1 args env))
    ((string=? nm "string-length") (len-as-fixnum args env))
    ((string=? nm "string=?") (streq-builtin args env))
    ((string=? nm "read-file") (checked-call "npl_read_file" 1 args env))
    ((string=? nm "run-process")
     (checked-call "npl_process_run" 2 args env))
    ((string=? nm "current-input-port")
     (zero-named "npl_current_input_port" args))
    ((string=? nm "current-output-port")
     (zero-named "npl_current_output_port" args))
    ((string=? nm "current-error-port")
     (zero-named "npl_current_error_port" args))
    ((string=? nm "open-input-file")
     (checked-call "npl_open_input_file" 1 args env))
    ((string=? nm "open-output-file")
     (checked-call "npl_open_output_file" 1 args env))
    ((string=? nm "file-exists?")
     (checked-call "npl_file_exists" 1 args env))
    ((string=? nm "delete-file")
     (checked-call "npl_delete_file" 1 args env))
    ((string=? nm "make-temporary-directory")
     (zero-named "npl_make_temporary_directory" args))
    ((string=? nm "delete-directory")
     (checked-call "npl_delete_directory" 1 args env))
    ((string=? nm "open-binary-input-file")
     (checked-call "npl_open_binary_input_file" 1 args env))
    ((string=? nm "open-binary-output-file")
     (checked-call "npl_open_binary_output_file" 1 args env))
    ((string=? nm "open-input-bytevector")
     (checked-call "npl_open_input_bytevector" 1 args env))
    ((string=? nm "open-output-bytevector")
     (zero-named "npl_open_output_bytevector" args))
    ((string=? nm "get-output-bytevector")
     (checked-call "npl_get_output_bytevector" 1 args env))
    ((string=? nm "open-input-string")
     (checked-call "npl_open_input_string" 1 args env))
    ((string=? nm "open-output-string")
     (zero-named "npl_open_output_string" args))
    ((string=? nm "get-output-string")
     (checked-call "npl_get_output_string" 1 args env))
    ((string=? nm "close-input-port")
     (checked-call "npl_close_input_port" 1 args env))
    ((string=? nm "close-output-port")
     (checked-call "npl_close_output_port" 1 args env))
    ((string=? nm "close-port")
     (checked-call "npl_close_port" 1 args env))
    ((string=? nm "flush-output-port")
     (optional-output-call "npl_flush_output_port" 0 args env))
    ((string=? nm "read-char")
     (optional-input-call "npl_read_char" args env))
    ((string=? nm "peek-char")
     (optional-input-call "npl_peek_char" args env))
    ((string=? nm "write-char")
     (optional-output-call "npl_write_char" 1 args env))
    ((string=? nm "read-u8")
     (optional-input-call "npl_read_byte" args env))
    ((string=? nm "peek-u8")
     (optional-input-call "npl_peek_byte" args env))
    ((string=? nm "write-u8")
     (optional-output-call "npl_write_byte" 1 args env))
    ((string=? nm "read-bytevector")
     (read-bytevector-call args env))
    ((string=? nm "read-bytevector!")
     (bytevector-range-call "npl_read_bytevector_into"
                            "npl_current_input_port" args env))
    ((string=? nm "write-bytevector")
     (bytevector-range-call "npl_write_bytevector"
                            "npl_current_output_port" args env))
    ((string=? nm "read")
     (optional-input-call "npl_read_datum" args env))
    ((string=? nm "eof-object")
     (zero-named "npl_eof_object" args))
    ((string=? nm "eof-object?")
     (checked-call "npl_eof_object_p" 1 args env))
    ((string=? nm "port?")
     (checked-call "npl_port_p" 1 args env))
    ((string=? nm "input-port?")
     (checked-call "npl_input_port_p" 1 args env))
    ((string=? nm "output-port?")
     (checked-call "npl_output_port_p" 1 args env))
    ((string=? nm "input-port-open?")
     (checked-call "npl_input_port_open_p" 1 args env))
    ((string=? nm "output-port-open?")
     (checked-call "npl_output_port_open_p" 1 args env))
    ((string=? nm "textual-port?")
     (checked-call "npl_textual_port_p" 1 args env))
    ((string=? nm "binary-port?")
     (checked-call "npl_binary_port_p" 1 args env))
    ((string=? nm "append") (checked-call "npl_append" 2 args env))
    ((string=? nm "vector") (collection-call "npl_make_vector" args env))
    ((string=? nm "list->vector")
     (checked-call "npl_list_to_vector" 1 args env))
    ((string=? nm "vector?") (checked-call "npl_vector_p" 1 args env))
    ((string=? nm "vector-length")
     (checked-call "npl_vector_length" 1 args env))
    ((string=? nm "vector-ref") (checked-call "npl_vector_ref" 2 args env))
    ((string=? nm "vector-set!")
     (checked-call "npl_vector_set" 3 args env))
    ((string=? nm "bytevector")
     (collection-call "npl_make_bytevector" args env))
    ((string=? nm "bytevector?")
     (checked-call "npl_bytevector_p" 1 args env))
    ((string=? nm "bytevector-length")
     (checked-call "npl_bytevector_length" 1 args env))
    ((string=? nm "bytevector-u8-ref")
     (checked-call "npl_bytevector_ref" 2 args env))
    ((string=? nm "bytevector-u8-set!")
     (checked-call "npl_bytevector_set" 3 args env))
    ((string=? nm "char?") (checked-call "npl_char_p" 1 args env))
    ((string=? nm "char->integer")
     (checked-call "npl_char_to_integer" 1 args env))
    ((string=? nm "integer->char")
     (checked-call "npl_integer_to_char" 1 args env))
    ((string=? nm "npl_expect_one")
     (checked-call "npl_expect_one" 1 args env))
    ((string=? nm "npl_make_values")
     (collection-call "npl_make_values" args env))
    ((string=? nm "npl_list_to_values")
     (checked-call "npl_list_to_values" 1 args env))
    ((string=? nm "npl_current_wind")
     (zero-named "npl_current_wind" args))
    ((string=? nm "npl_wind_push")
     (checked-call "npl_wind_push" 2 args env))
    ((string=? nm "npl_wind_pop")
     (checked-call "npl_wind_pop" 1 args env))
    ((string=? nm "npl_current_handler")
     (zero-named "npl_current_handler" args))
    ((string=? nm "npl_handler_push")
     (checked-call "npl_handler_push" 1 args env))
    ((string=? nm "npl_handler_pop")
     (checked-call "npl_handler_pop" 1 args env))
    ((string=? nm "npl_make_parameter")
     (two-named-w "npl_make_parameter" args env))
    ((string=? nm "npl_parameter_converter")
     (checked-call "npl_parameter_converter" 1 args env))
    ((string=? nm "npl_parameters_enter")
     (three-named-w "npl_parameters_enter" args env))
    ((string=? nm "npl_parameters_leave")
     (checked-call "npl_parameters_leave" 1 args env))
    ((string=? nm "npl_promise_op")
     (collection-call "npl_promise_op" args env))
    (else (cmp-or-arith nm args env))))

(define (registered-arity-accepts? arity count)
  (if (< arity 0)
      (>= count (- (- 0 arity) 1))
      (= count arity)))

(define (user-call nm args env)
  (let ((argn (count-up args 0)))
    (if (not (registered-arity-accepts?
               (lookup-func-arity nm) argn))
        (fatal "function arity mismatch"))
    (let ((ops (eval-args-fixed args env argn ())))
      (let ((argv (argv-op ops)))
        (let ((result (new-tmp)))
          (func-line
            (string-append result " =l call $npl_trampoline(l $"
                           (lookup-func nm) ", l 2, l "
                           (number->string argn) ", l " argv ")"))
          result)))))
