; Static datum and literal data emission.

; ---------------- static data ----------------

(define DATUM-OBJS (cell ()))

;; Static string and symbol boxes (runtime/string.c layout): narrow (one
;; byte per character) unless a character is above 255, then wide (32-bit
;; code points, flag NPL_FLAG_WIDE = 2). Header: tag, flags, length,
;; capacity; then the characters and a terminating zero unit.
;; Character data as ", b 40, b 100, ..." (unit b) or ", w ..." (unit w).
;; Built by halving, so a text of n characters is copied O(n log n) times;
;; right-nested string-append copied the rest of the text at every character
;; (O(n^2)), which dominated self-compile once the derived syntax source
;; reached tens of thousands of characters.
(define (data-units-run unit text from to)
  (if (= from to)
      ""
      (string-append ", " unit " "
        (number->string (string-byte-ref text from))
        (data-units-run unit text (+ from 1) to))))

(define (data-units unit text from to)
  (if (<= (- to from) 8)
      (data-units-run unit text from to)
      (let ((mid (+ from (npl_number_quotient (- to from) 2))))
        (string-append (data-units unit text from mid)
                       (data-units unit text mid to)))))

(define (byte-data text index)
  (data-units "b" text index (string-length text)))

(define (word-data text index)
  (data-units "w" text index (string-length text)))

(define (wide-text? text index)
  (if (= index (string-length text))
      #f
      (if (> (string-byte-ref text index) 255)
          #t
          (wide-text? text (+ index 1)))))

; "$label = { ... }" for a static box; tag 1 string, 3 symbol; flags 1 for
; literal strings, 0 for symbols. The capacity word is length + 1 (static
; boxes are immutable, so the runtime never reads it).
(define (static-text-box lab tag flags text)
  (let ((wide (wide-text? text 0)))
    (string-append lab " = { w " (number->string tag)
      (string-append ", w " (number->string (if wide (+ flags 2) flags))
        (string-append ", w " (number->string (string-length text))
          (string-append ", w " (number->string (+ 1 (string-length text)))
            (if wide
                (string-append (word-data text 0) ", w 0 }")
                (string-append (byte-data text 0) ", b 0 }"))))))))

(define (static-text-data lab tag flags text)
  (string-append "data " (static-text-box lab tag flags text)))

(define (intern-sym nm)
  (let ((found (lk-s (cell-get SYMS) nm)))
    (if (> (string-length found) 0)
        found
        (begin
          (cell-set! DATAN (+ 1 (cell-get DATAN)))
          (let ((lab (string-append "$sym_" (number->string (cell-get DATAN)))))
            (cell-set! SYMS (cons (cons nm lab) (cell-get SYMS)))
            (data-line (static-text-data lab 3 0 nm))
            lab)))))

(define (fresh-string-label text)
  (cell-set! DATAN (+ 1 (cell-get DATAN)))
  (let ((lab (string-append "$s_" (number->string (cell-get DATAN)))))
    ; flags 1 = NPL_FLAG_LITERAL: literal strings are immutable (R7RS 3.4)
    (data-line (static-text-data lab 1 1 text))
    lab))

(define (fresh-string-op text)
  (label-ref-op (fresh-string-label text)))

(define (label-constant lab)
  (string-append lab "+1"))

(define (label-ref-op lab)
  (let ((address (new-tmp)))
    (func-line (string-append address " =l copy " lab))
    (let ((tagged (new-tmp)))
      (func-line (string-append tagged " =l add " address ", 1"))
      tagged)))

(define (datum-object-label entries object)
  (if (null? entries)
      ""
      (if (eq? (car (car entries)) object)
          (cdr (car entries))
          (datum-object-label (cdr entries) object))))

(define (walk-datum d)
  (cond
    ((null? d) "2")
    ((number? d) (integer-literal-op d #f))
    ((datum-symbol? d) (label-ref-op (intern-sym (datum-symbol-name d))))
    ((datum-string? d) (fresh-string-op (datum-string-text d)))
    ((datum-char? d)
     (number->string (+ (* (datum-char-code d) 256) 14)))
    ((datum-vector? d) (label-ref-op (ensure-static-vector d)))
    ((datum-bytevector? d)
     (label-ref-op (ensure-static-bytevector d)))
    ((datum-true? d) "6")
    ((datum-false? d) "10")
    ((pair-shape? d)
     (let ((known (datum-object-label (cell-get DATUM-OBJS) d)))
       (if (> (string-length known) 0)
           (label-ref-op known)
           (build-static-pair d))))
    (else
      (begin
        (display "nplc1: bad datum: ")
        (display d)
        (newline)
        (fatal "bad datum")))))

(define (walk-boxed d)
  (case (car d)
    ((100) (label-ref-op (intern-sym (cdr d))))
    ((101) (fresh-string-op (cdr d)))
    ((102) (number->string (+ (* (cdr d) 256) 14)))
    ((103) (label-ref-op (ensure-static-vector d)))
    ((104) (label-ref-op (ensure-static-bytevector d)))
    ((106) "6")
    ((107) "10")
    (else (build-static-pair d))))

(define (walk-static-datum datum)
  (cond
    ((null? datum) "2")
    ((number? datum) (integer-literal-op datum #t))
    ((datum-symbol? datum)
     (label-constant (intern-sym (datum-symbol-name datum))))
    ((datum-string? datum)
     (label-constant (fresh-string-label (datum-string-text datum))))
    ((datum-char? datum)
     (number->string (+ (* (datum-char-code datum) 256) 14)))
    ((datum-vector? datum)
     (label-constant (ensure-static-vector datum)))
    ((datum-bytevector? datum)
     (label-constant (ensure-static-bytevector datum)))
    ((datum-true? datum) "6")
    ((datum-false? datum) "10")
    ((pair-shape? datum)
     (let ((known (datum-object-label (cell-get DATUM-OBJS) datum)))
       (if (> (string-length known) 0)
           (label-constant known)
           (label-constant (ensure-static-pair datum)))))
    (else
      (begin
        (display "nplc1: bad static datum: ")
        (display datum)
        (newline)
        (fatal "bad static datum")))))

(define (static-vector-items items)
  (if (null? items)
      ""
      (string-append ", l " (walk-static-datum (car items))
                     (static-vector-items (cdr items)))))

(define (literal-vector-items datum)
  (if (datum-vector? datum)
      (datum-vector-items datum)
      (car (cdr datum))))

(define (ensure-static-vector datum)
  (let ((known (datum-object-label (cell-get DATUM-OBJS) datum)))
    (if (> (string-length known) 0)
        known
        (begin
          (cell-set! DATAN (+ 1 (cell-get DATAN)))
          (let ((lab (string-append "$v_" (number->string (cell-get DATAN)))))
            (cell-set! DATUM-OBJS
              (cons (cons datum lab) (cell-get DATUM-OBJS)))
            (let ((items (literal-vector-items datum)))
              (let ((count (count-up items 0)))
                (data-line
                  (string-append lab " = { w 2, w 1, w "
                    (number->string count) ", w " (number->string count)
                    (static-vector-items items) " }"))
                lab)))))))

(define (bytevector-items items)
  (if (null? items)
      ""
      (let ((value (car items)))
        (if (not (number? value))
            (fatal "bytevector literal needs exact integer bytes"))
        (if (if (< value 0) #t (> value 255))
            (fatal "bytevector literal byte out of range"))
        (string-append ", b " (number->string value)
                       (bytevector-items (cdr items))))))

(define (literal-bytevector-items datum)
  (if (datum-bytevector? datum)
      (datum-bytevector-items datum)
      (car (cdr datum))))

(define (ensure-static-bytevector datum)
  (let ((known (datum-object-label (cell-get DATUM-OBJS) datum)))
    (if (> (string-length known) 0)
        known
        (begin
          (cell-set! DATAN (+ 1 (cell-get DATAN)))
          (let ((lab (string-append "$bv_" (number->string (cell-get DATAN)))))
            (cell-set! DATUM-OBJS
              (cons (cons datum lab) (cell-get DATUM-OBJS)))
            (let ((items (literal-bytevector-items datum)))
              (let ((count (count-up items 0)))
                (data-line
                  (string-append lab " = { w 6, w 1, w "
                    (number->string count) ", w " (number->string count)
                    (bytevector-items items) " }"))
                lab)))))))

(define (ensure-static-pair datum)
  (cell-set! DATAN (+ 1 (cell-get DATAN)))
  (let ((lab (string-append "$q_" (number->string (cell-get DATAN)))))
    (cell-set! DATUM-OBJS (cons (cons datum lab) (cell-get DATUM-OBJS)))
    (let ((car-op (walk-static-datum (car datum))))
      (let ((cdr-op (walk-static-datum (cdr datum))))
        (data-line
          (string-append lab " = { w 0, w 1, l " car-op
                         ", l " cdr-op " }"))
        lab))))

(define (build-static-pair d)
  (label-ref-op (ensure-static-pair d)))
