; Top-level registration, global initialization, and compiler entry point.

; ---------------- top-level ----------------

(define (fun-def? f)
  (if (pair-shape? f) (= (car f) 211) #f))

(define (defined-name e) (cdr (car (car (cdr e)))))

(define (pass-register-functions forms)
  (if (null? forms)
      0
      (begin
        (if (fun-def? (car forms))
            (register-func
              (defined-name (car forms))
              (parameter-arity (cdr (car (cdr (car forms))))))
            0)
        (pass-register-functions (cdr forms)))))

(define (variable-def e)
  (let ((nm-e (car (cdr e))))
    (let ((init (car (cdr (cdr e)))))
      (if (not (sym-atom? nm-e))
          (fatal "bad define-variable name")
          (let ((slot (string-append "$gv_" (sanitize (cdr nm-e) 0 ""))))
            (register-glob (cdr nm-e) slot)
            ; Global slots live in the data segment, which the collector does
            ; not scan; register every slot so set! and runtime initializers
            ; keep their values alive.
            (cell-set! GLOBAL-ROOTS (cons slot (cell-get GLOBAL-ROOTS)))
            (emit-global-slot (cdr nm-e) init))))))

(define (emit-global-slot nm init)
  (let ((slot (string-append "$gv_" (sanitize nm 0 ""))))
    (if (number? init)
        (data-line (string-append slot " = { l "
                                  (integer-literal-op init #t) " }"))
        (if (null? init)
            (data-line (string-append slot " = { l 2 }"))
            (if (str-atom? init)
                (begin
                  (declare-string-box init 1)
                  (data-line (string-append "data " slot " = { l $s_"
                                            (number->string (cell-get DATAN))
                                            "+1 }")))
                (if (sym-atom? init)
                    (data-line (string-append slot " = { l "
                                              (intern-sym (cdr init))
                                              "+1 }"))
                    ; runtime-computed initializer: placeholder slot now,
                    ; real value stored by $npl_global_inits at startup
                    (begin
                      (data-line (string-append "data " slot " = { l 2 }"))
                      (cell-set! HAS-INIT 7)
                      (cell-set! CURBUF "I")
                      (let ((v (emit-expr init ())))
                        (func-line (string-append "storel " v ", " slot)))
                      (cell-set! CURBUF "F")
                      0)))))))

; declares just the box at the *current* DATAN id, matching fresh-string-op
(define (declare-string-box init k)
  (let ((txt (cdr init)))
    (cell-set! DATAN (+ 1 (cell-get DATAN)))
    (let ((lab (string-append "$s_" (number->string (cell-get DATAN)))))
      (data-line (static-text-box lab 1 1 txt)))))



(define (emit-function-header nm)
  (func-line
    (string-append "function l $" (function-symbol nm)
                   "(l %npl_env, l %npl_argc, l %npl_argv) {"))
  (func-line "@start"))

(define (emit-function nm params body)
  (if (self-loop-eligible? nm params)
      (emit-self-loop-function nm params body)
      (begin
        (emit-function-header nm)
        (emit-tail-body body (bind-generic-params params 0 ()))
        (func-line "}"))))

; A function may turn a tail call to itself into a jump (tail.npl
; emit-self-jump) when its parameters are fixed and neither they nor its name
; are assigned: each parameter is then one temporary, with no cell to renew
; per iteration.
(define (self-loop-eligible? nm params)
  (if (assigned-name? nm (cell-get ASSIGNED-NAMES))
      #f
      (self-loop-eligible-params? params)))

(define (self-loop-eligible-params? params)
  (if (variadic-parameters? params)
      #f
      (not (params-assigned? params))))

(define (params-assigned? params)
  (if (null? params)
      #f
      (if (assigned-name? (cdr (car params)) (cell-get ASSIGNED-NAMES))
          #t
          (params-assigned? (cdr params)))))

(define (param-ops params env)
  (if (null? params)
      ()
      (cons (env-entry-op (env-entry env (cdr (car params))))
            (param-ops (cdr params) env))))

; The body is emitted into an empty FUNC-BUF so its lines can be placed
; after the prologue (header and argument loads) once it is known whether a
; self jump occurred.
(define (emit-self-loop-function nm params body)
  (let ((before (cell-get FUNC-BUF)))
    (cell-set! FUNC-BUF ())
    (emit-function-header nm)
    (let ((env (bind-generic-params params 0 ())))
      (cell-set! FUNC-BUF (append-list (cell-get FUNC-BUF) before))
      (emit-self-loop-body nm params #f body env)
      (func-line "}"))))

; Emit the body of a function that may jump to itself. The current buffer
; already holds its prologue (header, capture and argument loads); the loop
; label goes after it, so captures and the closure are loaded once.
(define (emit-self-loop-body name params entry body env)
  (emit-hoisted-body name params entry body env (lambda (jumps) ()) #f))

; With name, the body may jump to itself (SELF-FUNCTION). guard: a procedure
; of whether the body made a self jump, returning lines, newest first,
; placed after the hoisted allocs and before the loop label (a direct
; entry's stack check and parameter copies). hoist: move the allocs to
; @start even without a self jump.
(define (emit-hoisted-body name params entry body env guard hoist)
  (let ((prologue (current-buffer)) (label (cell #f)))
    (set-current-buffer! ())
    (if name
        (cell-set! SELF-FUNCTION
          (make-self-function name (count-up params 0)
                              (param-ops params env) label entry))
        0)
    (emit-tail-body body env)
    (cell-set! SELF-FUNCTION #f)
    (set-current-buffer!
      (self-loop-lines (current-buffer) (cell-get label)
                       (guard (if (cell-get label) #t #f)) hoist
                       prologue))))

(define (untag-line line) (if (pair? line) (cdr line) line))

; Lines of a newest-first buffer, in the same order: the alloc lines
; (emit-alloc8) when allocs is #t, the others when it is #f.
(define (body-lines lines allocs)
  (if (null? lines)
      ()
      (if (eq? (pair? (car lines)) allocs)
          (cons (untag-line (car lines)) (body-lines (cdr lines) allocs))
          (body-lines (cdr lines) allocs))))

; With a self jump (or hoist) the allocs move to @start, which falls through
; the guard to the loop label; otherwise the body is kept as emitted.
(define (self-loop-lines body label guard hoist entry)
  (if (if label #t hoist)
      (append-list (body-lines body #f)
        (append-list (if label (cons label guard) guard)
          (append-list (body-lines body #t) entry)))
      (append-list (map-cons untag-line body) (append-list guard entry))))

; ---------------- direct entries ----------------
;
; The direct entry of a direct-safe function (frontend/direct-calls.npl,
; form 218) takes its arguments as C parameters and returns its value. Its
; body is in direct style: a tail call is a self jump or a value call
; followed by ret (tail.npl tail-call-application?). Below npl_stack_limit
; (runtime/stack.c) it runs the CPS entry through npl_direct_fallback
; instead, whose continuations are on the heap, so deep recursion stays
; bounded on the C stack.

(define (direct-def? f)
  (if (pair-shape? f) (= (car f) 218) #f))

; A variadic entry's formals are (230 fixed rest): its last C parameter is
; the rest list.
(define (direct-formals params)
  (if (variadic-parameters? params)
      (append-list (variadic-fixed-parameters params)
                   (cons (variadic-rest-parameter params) ()))
      params))

(define (direct-param-ops params index)
  (if (null? params)
      ()
      (cons (string-append "%npl_p" (number->string index))
            (direct-param-ops (cdr params) (+ index 1)))))

(define (direct-param-temps ops)
  (if (null? ops) () (cons (new-tmp) (direct-param-temps (cdr ops)))))

; A parameter that is a set! target gets its cell from the temporary at the
; start of the body (env-bind), after the copies.
(define (bind-direct-params params temps env)
  (if (null? params)
      env
      (bind-direct-params (cdr params) (cdr temps)
        (env-bind env (cdr (car params)) (car temps)))))

; The copies of the parameters into their temporaries, newest first. With a
; self jump the temporaries are the loop variables: combined with
; npl_opaque_zero (runtime/stack.c), which QBE cannot see through, they get
; their own registers. A plain copy lets QBE keep them in the argument
; registers, which costs register moves around every call in the loop
; (loop workload: +6% instructions); without a jump the extra or and load
; cost instructions instead (fib: +16%).
(define (direct-param-lines temps ops jumps)
  (if jumps
      (let ((zero (new-tmp)))
        (cons-copies temps ops " =l or " (string-append ", " zero)
          (cons (string-append zero " =l loadl $npl_opaque_zero") ())))
      (cons-copies temps ops " =l copy " "" ())))

(define (cons-copies temps ops middle suffix acc)
  (if (null? temps)
      acc
      (cons-copies (cdr temps) (cdr ops) middle suffix
        (cons (string-append (car temps) middle (car ops) suffix) acc))))

; The stack check, emitted into the current buffer. slot is the entry's
; argument buffer in @start; its address is the stack position. A variadic
; entry's fallback spreads the rest list (npl_direct_fallback_rest).
(define (emit-direct-guard name ops slot rest)
  (emit-stack-guard (string-append "$" (lookup-func name)) "2" ops slot rest))

; function and environment: the CPS entry the fallback runs.
(define (emit-stack-guard function environment ops slot rest)
  (let ((limit (new-tmp)) (below (new-tmp)) (result (new-tmp))
        (fallback (new-label)) (body (new-label)))
    (func-line (string-append limit " =l loadl $npl_stack_limit"))
    (func-line (string-append below " =w cultl " slot ", " limit))
    (func-line (string-append "jnz " below ", " fallback ", " body))
    (func-line fallback)
    (store-argv ops slot 0)
    (func-line
      (string-append result " =l call $"
                     (if rest "npl_direct_fallback_rest" "npl_direct_fallback")
                     "(l " function ", l " environment ", l "
                     (number->string
                       (if rest (- (count-up ops 0) 1) (count-up ops 0)))
                     ", l " slot ")"))
    (func-line (string-append "ret " result))
    (func-line body)))

(define (emit-direct-function name signature body)
  (let ((params (direct-formals signature))
        (rest (variadic-parameters? signature)))
  (let ((before (cell-get FUNC-BUF))
        (ops (direct-param-ops params 0))
        (slot (new-tmp)))
    (cell-set! FUNC-BUF ())
    (func-line
      (string-append "function l $" (direct-function-symbol name) "("
                     (if (null? ops) "" (args-join ops)) ") {"))
    (func-line "@start")
    (func-line
      (string-append slot " =l alloc8 "
        (number->string (* 8 (if (null? ops) 1 (count-up ops 0))))))
    (let ((temps (direct-param-temps ops))
          (prologue (append-list (cell-get FUNC-BUF) before)))
      (cell-set! FUNC-BUF ())
      (emit-direct-guard name ops slot rest)
      (let ((guard (cell-get FUNC-BUF)))
        (cell-set! FUNC-BUF prologue)
        (cell-set! DIRECT-ENTRY #t)
        (emit-direct-body name (if rest signature params) params body temps
          (lambda (jumps)
            (append-list (direct-param-lines temps ops jumps) guard)))
        (cell-set! DIRECT-ENTRY #f)
        (func-line "}"))))))

; The body buffer starts empty, so a cell made for an assigned parameter
; comes after the copies and the stack check.
; signature: the formals as written, so a variadic function makes no self
; jump (self-loop-eligible?); params: one per C parameter.
(define (emit-direct-body name signature params body temps guard)
  (let ((prologue (current-buffer)))
    (set-current-buffer! ())
    (let ((env (bind-direct-params params temps ())))
      (let ((cells (current-buffer)))
        (set-current-buffer! prologue)
        (emit-hoisted-body
          (if (self-loop-eligible? name signature) name #f)
          params #f body env
          (lambda (jumps) (append-list cells (guard jumps)))
          #t)))))

; The entry nplc generates (CONTROL-ENTRY-NAME, frontend/control-program.npl)
; is the C main. Emitted programs follow the same runtime ABI as stage0
; output: store args, run global initializers, then the entry body.
(define (emit-main params body)
  (func-line "export function l $main(l %argc, l %argv) {")
  (func-line "@start")
  (func-line "call $npl_runtime_init()")
  (func-line "call $npl_store_args(l %argc, l %argv)")
  (func-line "call $npl_global_inits()")
  (let ((result (emit-body body ())))
    (func-line (string-append "ret " result)))
  (func-line "}"))

(define (var-def? f)
  (if (pair-shape? f) (= (car f) 200) #f))

(define (emit-top-level f)
  (cell-set! ASSIGNED-NAMES (collect-assigned f ()))
  (cell-set! LOCAL-LOOP-CELLS ())
  (if (fun-def? f)
      ; sig = ((100 . nm) . params); body-list = (car (cdr (cdr f)))
      (if (string=? (defined-name f) CONTROL-ENTRY-NAME)
          (emit-main (cdr (car (cdr f))) (car (cdr (cdr f))))
          (emit-function (defined-name f)
                         (cdr (car (cdr f)))
                         (car (cdr (cdr f)))))
      (if (direct-def? f)
          (emit-direct-function (defined-name f)
                                (cdr (car (cdr f)))
                                (car (cdr (cdr f))))
          (if (var-def? f)
              (variable-def f)
              (fatal "top level must contain definitions")))))

(define (flush-code-buffers)
  (print-lines (rev (cell-get DATA-BUF)))
  (print-lines (rev (cell-get LAMBDA-BUF)))
  (print-lines (rev (cell-get FUNC-BUF)))
  (cell-set! DATA-BUF ())
  (cell-set! LAMBDA-BUF ())
  (cell-set! FUNC-BUF ()))

(define (print-global-roots slots)
  (if (null? slots)
      0
      (begin
        (display "call $npl_gc_root(l ")
        (display (car slots))
        (display ")")
        (newline)
        (print-global-roots (cdr slots)))))

; Static symbol boxes join the runtime intern table before any code runs, so
; quoted symbols are eq? to symbols made by read and string->symbol.
(define (print-static-symbols entries)
  (if (null? entries)
      0
      (begin
        ; QBE call operands cannot carry an offset; tag the address first.
        (display "%static_symbol =l add ")
        (display (cdr (car entries)))
        (display ", 1")
        (newline)
        (display "call $npl_intern_static_symbol(l %static_symbol)")
        (newline)
        (print-static-symbols (cdr entries)))))

(define (dump-and-print)
  ; Top-level forms are flushed incrementally. Only symbol and root
  ; registration and runtime initializer code remain until their function
  ; can be emitted.
  (emit-primitive-wrappers (rev (cell-get PRIMITIVE-VALUES)))
  (flush-code-buffers)
  (display "function l $npl_global_inits() {")
  (newline)
  (display "@start")
  (newline)
  (print-static-symbols (rev (cell-get SYMS)))
  (print-global-roots (rev (cell-get GLOBAL-ROOTS)))
  (if (= (cell-get HAS-INIT) 7)
      (print-lines (rev (cell-get INIT-BUF)))
      0)
  (display "ret 2")
  (newline)
  (display "}")
  (newline))

(define (print-lines xs)
  (if (null? xs)
      0
      (begin (display (car xs)) (newline) (print-lines (cdr xs)))))

(define (emit-program path)
  (let ((raw-forms
          (expand-includes (parse-source-file path)
                           (path-dir path)
                           (cons path ()))))
    (let ((lowered
            (lower-program
              (expand-source-program raw-forms (path-dir path)))))
      (direct-calls-analyze! lowered)
      (let ((forms (control-program lowered)))
        (pass-register-functions forms)
        (emit-all-forms forms)
        (dump-and-print)))))

(define (emit-all-forms forms)
  (if (null? forms)
      0
      (begin
        (emit-top-level (car forms))
        (flush-code-buffers)
        (emit-all-forms (cdr forms)))))

; ---------------- direct entries of lambdas (design-calls C3) ----------------
;
; $<name>_d(l %npl_env, l %npl_p0, ...): the direct entry of a lambda whose
; body is direct-safe. %npl_env is the closure, as for its CPS function
; $<name>, which is the stack-limit fallback. The body is emitted as a
; function's direct entry is, with the captures loaded first; it never
; jumps to itself (a lambda's self call goes through a captured variable).
(define (emit-lambda-direct-entry name params body captures)
  (let ((saved-mode (cell-get CURBUF)) (saved-local (cell-get LOCAL-BUF))
        (saved-self (cell-get SELF-FUNCTION))
        (saved-cells (cell-get LOCAL-LOOP-CELLS))
        (saved-direct (cell-get DIRECT-ENTRY))
        (ops (direct-param-ops params 0)) (slot (new-tmp)))
    (cell-set! LOCAL-BUF ())
    (cell-set! LOCAL-LOOP-CELLS ())
    (cell-set! CURBUF "X")
    (cell-set! SELF-FUNCTION #f)
    (func-line
      (string-append "function l $" name "_d(l %npl_env"
                     (if (null? ops) "" (string-append ", " (args-join ops)))
                     ") {"))
    (func-line "@start")
    (func-line
      (string-append slot " =l alloc8 "
        (number->string (* 8 (if (null? ops) 1 (count-up ops 0))))))
    (let ((capture-env (bind-captures captures 0 ()))
          (temps (direct-param-temps ops)))
      (let ((prologue (cell-get LOCAL-BUF)))
        (cell-set! LOCAL-BUF ())
        (emit-stack-guard (string-append "$" name) "%npl_env" ops slot #f)
        (let ((guard (cell-get LOCAL-BUF)))
          (cell-set! LOCAL-BUF prologue)
          (cell-set! DIRECT-ENTRY #t)
          (emit-lambda-direct-body params body temps capture-env
            (lambda (jumps)
              (append-list (direct-param-lines temps ops #f) guard)))
          (func-line "}"))))
    (print-lines (rev (cell-get DATA-BUF)))
    (cell-set! DATA-BUF ())
    (print-lines (rev (cell-get LOCAL-BUF)))
    (cell-set! LOCAL-BUF saved-local)
    (cell-set! LOCAL-LOOP-CELLS saved-cells)
    (cell-set! SELF-FUNCTION saved-self)
    (cell-set! DIRECT-ENTRY saved-direct)
    (cell-set! CURBUF saved-mode)))

(define (emit-lambda-direct-body params body temps capture-env guard)
  (let ((prologue (current-buffer)))
    (set-current-buffer! ())
    (let ((env (bind-direct-params params temps capture-env)))
      (let ((cells (current-buffer)))
        (set-current-buffer! prologue)
        (emit-hoisted-body #f params #f body env
          (lambda (jumps) (append-list cells (guard jumps)))
          #t)))))
