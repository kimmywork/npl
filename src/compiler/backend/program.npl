; Top-level registration, global initialization, and compiler entry point.

; ---------------- top-level ----------------

(define (fun-def? f)
  (if (pair-shape? f) (= (car f) 211) #f))

(define (defined-name e) (cdr (car (car (cdr e)))))

(define (pass-register-functions forms)
  (if (null? forms)
      0
      (begin
        (if (fun-def? (car forms))
            (register-func
              (defined-name (car forms))
              (parameter-arity (cdr (car (cdr (car forms))))))
            0)
        (pass-register-functions (cdr forms)))))

(define (variable-def e)
  (let ((nm-e (car (cdr e))))
    (let ((init (car (cdr (cdr e)))))
      (if (not (sym-atom? nm-e))
          (fatal "bad define-variable name")
          (let ((slot (string-append "$gv_" (sanitize (cdr nm-e) 0 ""))))
            (cell-set! GLOBS (cons (cons (cdr nm-e) slot) (cell-get GLOBS)))
            ; Global slots live in the data segment, which the collector does
            ; not scan; register every slot so set! and runtime initializers
            ; keep their values alive.
            (cell-set! GLOBAL-ROOTS (cons slot (cell-get GLOBAL-ROOTS)))
            (emit-global-slot (cdr nm-e) init))))))

(define (emit-global-slot nm init)
  (let ((slot (string-append "$gv_" (sanitize nm 0 ""))))
    (if (number? init)
        (data-line (string-append slot " = { l "
                                  (integer-literal-op init #t) " }"))
        (if (null? init)
            (data-line (string-append slot " = { l 2 }"))
            (if (str-atom? init)
                (begin
                  (declare-string-box init 1)
                  (data-line (string-append "data " slot " = { l $s_"
                                            (number->string (cell-get DATAN))
                                            "+1 }")))
                (if (sym-atom? init)
                    (data-line (string-append slot " = { l "
                                              (intern-sym (cdr init))
                                              "+1 }"))
                    ; runtime-computed initializer: placeholder slot now,
                    ; real value stored by $npl_global_inits at startup
                    (begin
                      (data-line (string-append "data " slot " = { l 2 }"))
                      (cell-set! HAS-INIT 7)
                      (cell-set! CURBUF "I")
                      (let ((v (emit-expr init ())))
                        (func-line (string-append "storel " v ", " slot)))
                      (cell-set! CURBUF "F")
                      0)))))))

; declares just the box at the *current* DATAN id, matching fresh-string-op
(define (declare-string-box init k)
  (let ((txt (cdr init)))
    (cell-set! DATAN (+ 1 (cell-get DATAN)))
    (let ((lab (string-append "$s_" (number->string (cell-get DATAN)))))
      (data-line
        (string-append lab " = { w 1, w 0, w "
                       (number->string (string-length txt))
                       ", w "
                       (number->string (+ 1 (string-length txt)))
                       (byte-data txt 0)
                       ", b 0 }")))))



(define (emit-function nm params body)
  (func-line
    (string-append "function l $" (sanitize nm 0 "")
                   "(l %npl_env, l %npl_argc, l %npl_argv) {"))
  (func-line "@start")
  (emit-tail-body body (bind-generic-params params 0 ()))
  (func-line "}"))

(define (emit-main params body)
  ; emitted programs follow the same runtime ABI as stage0 output:
  ; store args, run global initializers, then the user body
  (func-line "export function l $main(l %argc, l %argv) {")
  (func-line "@start")
  (func-line "call $npl_runtime_init()")
  (func-line "call $npl_store_args(l %argc, l %argv)")
  (func-line "call $npl_global_inits()")
  (let ((result (emit-body body ())))
    (func-line (string-append "ret " result)))
  (func-line "}"))

(define (var-def? f)
  (if (pair-shape? f) (= (car f) 200) #f))

(define (emit-top-level f)
  (cell-set! ASSIGNED-NAMES (collect-assigned f ()))
  (if (fun-def? f)
      ; sig = ((100 . nm) . params); body-list = (car (cdr (cdr f)))
      (if (string=? (defined-name f) "main")
          (emit-main (cdr (car (cdr f))) (car (cdr (cdr f))))
          (emit-function (defined-name f)
                         (cdr (car (cdr f)))
                         (car (cdr (cdr f)))))
      (if (var-def? f)
          (variable-def f)
          (fatal "top level must contain definitions"))))

(define (flush-code-buffers)
  (print-lines (rev (cell-get DATA-BUF)))
  (print-lines (rev (cell-get LAMBDA-BUF)))
  (print-lines (rev (cell-get FUNC-BUF)))
  (cell-set! DATA-BUF ())
  (cell-set! LAMBDA-BUF ())
  (cell-set! FUNC-BUF ()))

(define (print-global-roots slots)
  (if (null? slots)
      0
      (begin
        (display "call $npl_gc_root(l ")
        (display (car slots))
        (display ")")
        (newline)
        (print-global-roots (cdr slots)))))

; Static symbol boxes join the runtime intern table before any code runs, so
; quoted symbols are eq? to symbols made by read and string->symbol.
(define (print-static-symbols entries)
  (if (null? entries)
      0
      (begin
        ; QBE call operands cannot carry an offset; tag the address first.
        (display "%static_symbol =l add ")
        (display (cdr (car entries)))
        (display ", 1")
        (newline)
        (display "call $npl_intern_static_symbol(l %static_symbol)")
        (newline)
        (print-static-symbols (cdr entries)))))

(define (dump-and-print)
  ; Top-level forms are flushed incrementally. Only symbol and root
  ; registration and runtime initializer code remain until their function
  ; can be emitted.
  (emit-primitive-wrappers (rev (cell-get PRIMITIVE-VALUES)))
  (flush-code-buffers)
  (display "function l $npl_global_inits() {")
  (newline)
  (display "@start")
  (newline)
  (print-static-symbols (rev (cell-get SYMS)))
  (print-global-roots (rev (cell-get GLOBAL-ROOTS)))
  (if (= (cell-get HAS-INIT) 7)
      (print-lines (rev (cell-get INIT-BUF)))
      0)
  (display "ret 2")
  (newline)
  (display "}")
  (newline))

(define (print-lines xs)
  (if (null? xs)
      0
      (begin (display (car xs)) (newline) (print-lines (cdr xs)))))

(define (emit-program path)
  (let ((raw-forms
          (expand-includes (parse-source-file path)
                           (path-dir path)
                           (cons path ()))))
    (let ((forms
            (control-program
              (lower-program
                (expand-source-program raw-forms (path-dir path))))))
      (pass-register-functions forms)
      (emit-all-forms forms)
      (dump-and-print))))

(define (emit-all-forms forms)
  (if (null? forms)
      0
      (begin
        (emit-top-level (car forms))
        (flush-code-buffers)
        (emit-all-forms (cdr forms)))))
