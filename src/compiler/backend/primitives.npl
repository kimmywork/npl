; Backend helpers over the shared primitive registry
; (frontend/primitive-table.npl), which defines PRIMITIVE-TABLE and the row
; accessors.

; Public numeric aliases are registered by the frontend
; (frontend/numeric-aliases.npl).

; Minimum operand count for which the inline operation agrees with the
; library procedure; below it the call must reach the procedure, which
; reports the error at runtime. `(scheme base)` allows `(+)` and `(*)`.
(define (numeric-alias-min-count primitive)
  (let ((row (primitive-row primitive)))
    (if row (primitive-row-required row) -1)))
