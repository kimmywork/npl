; Primitive registry: one row per compiler intrinsic.
;
; Row: (name kind runtime-symbol required optional), kind a symbol:
;   kind fixed     call symbol with exactly `required` operands
;        in-port   0..1 operands; missing input port is current-input-port
;        out-port  required..required+1; missing port is current-output-port
;        count     variadic: symbol(argc, argv)
;        special   emitted by emit-special-primitive (inline or bespoke)
; `optional` is -1 for unbounded (count kind) and 1 for port kinds.
;
; Control conversion treats every registered name as synchronous
; (control-primitive-name?), so a new intrinsic is added here only.

(define PRIMITIVE-TABLE
  '(
    ; numbers
    ("+" special "" 0 -1) ("-" special "" 1 -1)
    ("*" special "" 0 -1)
    ("<" special "" 2 -1) (">" special "" 2 -1)
    ("=" special "" 2 -1) ("<=" special "" 2 -1)
    (">=" special "" 2 -1)
    ("number?" fixed "npl_number_p" 1 0)
    ("number->string" fixed "npl_number_to_string" 1 0)
    ("npl_tagged_num_to_string" fixed "npl_tagged_num_to_string" 1 0)
    ("npl_inexact_p" fixed "npl_inexact_p" 1 0)
    ("npl_inexact_bits" fixed "npl_inexact_bits" 1 0)
    ("npl_inexact_op" fixed "npl_inexact_op" 2 0)
    ("npl_inexact_binary" fixed "npl_inexact_binary" 3 0)
    ("npl_finite_p" fixed "npl_finite_p" 1 0)
    ("npl_nan_p" fixed "npl_nan_p" 1 0)
    ("npl_infinite_p" fixed "npl_infinite_p" 1 0)
    ("npl_exact_to_inexact" fixed "npl_exact_to_inexact" 1 0)
    ("npl_inexact_to_exact" fixed "npl_inexact_to_exact" 1 0)
    ("npl_number_div" fixed "npl_number_div" 2 0)
    ("npl_integer_p" fixed "npl_integer_p" 1 0)
    ("npl_rational_numerator" fixed "npl_rational_numerator" 1 0)
    ("npl_rational_denominator" fixed "npl_rational_denominator" 1 0)
    ("npl_number_from_string" fixed "npl_number_from_string" 1 0)
    ("npl_number_from_string_radix" fixed
          "npl_number_from_string_radix" 2 0)
    ("npl_number_to_string_radix" fixed
          "npl_number_to_string_radix" 2 0)
    ("npl_complex_make" fixed "npl_complex_make" 2 0)
    ("npl_complex_p" fixed "npl_complex_p" 1 0)
    ("npl_complex_real" fixed "npl_complex_real" 1 0)
    ("npl_complex_imag" fixed "npl_complex_imag" 1 0)
    ("npl_number_zero_p" fixed "npl_number_zero_p" 1 0)
    ("npl_number_gcd" fixed "npl_number_gcd" 2 0)
    ("npl_number_quotient" fixed "npl_number_quotient" 2 0)
    ("npl_number_remainder" fixed "npl_number_remainder" 2 0)
    ; pairs, equivalence, booleans
    ("cons" fixed "npl_cons" 2 0) ("car" fixed "npl_car" 1 0)
    ("cdr" fixed "npl_cdr" 1 0)
    ("set-car!" special "npl_set_car" 2 0)
    ("set-cdr!" special "npl_set_cdr" 2 0)
    ("null?" special "" 1 0) ("pair?" special "" 1 0)
    ("not" special "" 1 0) ("eq?" special "" 2 0)
    ("eqv?" fixed "npl_eqv" 2 0)
    ("procedure?" fixed "npl_procedure_p" 1 0)
    ("append" fixed "npl_append" 2 0)
    ; strings, symbols, chars
    ("string?" fixed "npl_string_p" 1 0)
    ("string-length" special "" 1 0)
    ("string-ref" fixed "npl_string_ref" 2 0)
    ("substring" fixed "npl_substring" 3 0)
    ("string-append" count "npl_string_append_n" 0 -1)
    ("string=?" special "" 2 0)
    ("int->string" fixed "npl_int_to_string_char" 1 0)
    ("symbol?" fixed "npl_symbol_predicate" 1 0)
    ("symbol->string" fixed "npl_symbol_to_string" 1 0)
    ("string->symbol" fixed "npl_string_to_symbol" 1 0)
    ("char?" fixed "npl_char_p" 1 0)
    ("char->integer" fixed "npl_char_to_integer" 1 0)
    ("integer->char" fixed "npl_integer_to_char" 1 0)
    ("npl_lex_class_w" fixed "npl_lex_class_w" 2 0)
    ("npl_lex_scan_sym_end" fixed "npl_lex_scan_sym_end" 2 0)
    ("npl_lex_number" fixed "npl_lex_number" 3 0)
    ; vectors, bytevectors
    ("vector" count "npl_make_vector" 0 -1)
    ("list->vector" fixed "npl_list_to_vector" 1 0)
    ("vector?" fixed "npl_vector_p" 1 0)
    ("vector-length" fixed "npl_vector_length" 1 0)
    ("vector-ref" fixed "npl_vector_ref" 2 0)
    ("vector-set!" fixed "npl_vector_set" 3 0)
    ("bytevector" count "npl_make_bytevector" 0 -1)
    ("bytevector?" fixed "npl_bytevector_p" 1 0)
    ("bytevector-length" fixed "npl_bytevector_length" 1 0)
    ("bytevector-u8-ref" fixed "npl_bytevector_ref" 2 0)
    ("bytevector-u8-set!" fixed "npl_bytevector_set" 3 0)
    ; output
    ("display" out-port "npl_display_port" 1 1)
    ("write" out-port "npl_write_port" 1 1)
    ("write-shared" out-port "npl_write_port" 1 1)
    ("write-simple" out-port "npl_write_port" 1 1)
    ("newline" out-port "npl_newline_port" 0 1)
    ("flush-output-port" out-port "npl_flush_output_port" 0 1)
    ("write-char" out-port "npl_write_char" 1 1)
    ("write-u8" out-port "npl_write_byte" 1 1)
    ("write-bytevector" special "npl_write_bytevector" 1 3)
    ; input
    ("read-char" in-port "npl_read_char" 0 1)
    ("peek-char" in-port "npl_peek_char" 0 1)
    ("read-u8" in-port "npl_read_byte" 0 1)
    ("peek-u8" in-port "npl_peek_byte" 0 1)
    ("read-result" in-port "npl_read_result" 0 1)
    ("read" in-port "npl_read_datum" 0 1)
    ("read-bytevector" special "npl_read_bytevector" 1 1)
    ("read-bytevector!" special "npl_read_bytevector_into" 1 3)
    ("read-file" fixed "npl_read_file" 1 0)
    ; ports
    ("current-input-port" fixed "npl_current_input_port" 0 0)
    ("current-output-port" fixed "npl_current_output_port" 0 0)
    ("current-error-port" fixed "npl_current_error_port" 0 0)
    ("open-input-file" fixed "npl_open_input_file" 1 0)
    ("open-output-file" fixed "npl_open_output_file" 1 0)
    ("open-binary-input-file" fixed "npl_open_binary_input_file" 1 0)
    ("open-binary-output-file" fixed "npl_open_binary_output_file" 1 0)
    ("open-input-bytevector" fixed "npl_open_input_bytevector" 1 0)
    ("open-output-bytevector" fixed "npl_open_output_bytevector" 0 0)
    ("get-output-bytevector" fixed "npl_get_output_bytevector" 1 0)
    ("open-input-string" fixed "npl_open_input_string" 1 0)
    ("open-output-string" fixed "npl_open_output_string" 0 0)
    ("get-output-string" fixed "npl_get_output_string" 1 0)
    ("close-input-port" fixed "npl_close_input_port" 1 0)
    ("close-output-port" fixed "npl_close_output_port" 1 0)
    ("close-port" fixed "npl_close_port" 1 0)
    ("eof-object" fixed "npl_eof_object" 0 0)
    ("eof-object?" fixed "npl_eof_object_p" 1 0)
    ("port?" fixed "npl_port_p" 1 0)
    ("input-port?" fixed "npl_input_port_p" 1 0)
    ("output-port?" fixed "npl_output_port_p" 1 0)
    ("input-port-open?" fixed "npl_input_port_open_p" 1 0)
    ("output-port-open?" fixed "npl_output_port_open_p" 1 0)
    ("textual-port?" fixed "npl_textual_port_p" 1 0)
    ("binary-port?" fixed "npl_binary_port_p" 1 0)
    ; process and files
    ("exit" special "" 1 0)
    ("program-arguments" fixed "npl_program_arguments" 0 0)
    ("command-line" fixed "npl_command_line" 0 0)
    ("set-command-line!" fixed "npl_set_command_line" 1 0)
    ("get-environment-variable" fixed
          "npl_get_environment_variable" 1 0)
    ("get-environment-variables" fixed
          "npl_get_environment_variables" 0 0)
    ("run-process" fixed "npl_process_run" 2 0)
    ("file-exists?" fixed "npl_file_exists" 1 0)
    ("delete-file" fixed "npl_delete_file" 1 0)
    ("make-temporary-directory" fixed
          "npl_make_temporary_directory" 0 0)
    ("delete-directory" fixed "npl_delete_directory" 1 0)
    ("executable-path" fixed "npl_executable_path" 0 0)
    ; control mechanisms used by control conversion and (scheme base)
    ("npl_expect_one" fixed "npl_expect_one" 1 0)
    ("npl_make_values" count "npl_make_values" 0 -1)
    ("npl_list_to_values" fixed "npl_list_to_values" 1 0)
    ("npl_current_wind" fixed "npl_current_wind" 0 0)
    ("npl_wind_push" fixed "npl_wind_push" 2 0)
    ("npl_wind_pop" fixed "npl_wind_pop" 1 0)
    ("npl_current_handler" fixed "npl_current_handler" 0 0)
    ("npl_handler_push" fixed "npl_handler_push" 1 0)
    ("npl_handler_pop" fixed "npl_handler_pop" 1 0)
    ("npl_make_parameter" fixed "npl_make_parameter" 2 0)
    ("npl_parameter_converter" fixed "npl_parameter_converter" 1 0)
    ("npl_parameters_enter" fixed "npl_parameters_enter" 3 0)
    ("npl_parameters_leave" fixed "npl_parameters_leave" 1 0)
    ("npl_promise_op" count "npl_promise_op" 0 -1)
    ; apply is a tail-call form in head position (control conversion); this
    ; row gives it a value form (primitive-values.npl)
    ("apply" special "npl_apply_tail" 2 -1)))

(define (primitive-row-name row) (car row))
(define (primitive-row-kind row) (symbol->string (car (cdr row))))
(define (primitive-row-symbol row) (car (cdr (cdr row))))
(define (primitive-row-required row) (car (cdr (cdr (cdr row)))))
(define (primitive-row-optional row) (car (cdr (cdr (cdr (cdr row))))))

(define (primitive-row-in name rows)
  (if (null? rows)
      #f
      (if (string=? name (primitive-row-name (car rows)))
          (car rows)
          (primitive-row-in name (cdr rows)))))

(define (primitive-row name) (primitive-row-in name PRIMITIVE-TABLE))
