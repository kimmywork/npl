; Exact-integer literals and arithmetic. Value semantics live in runtime/numeric.c.

(define (integer-immediate? value)
  (if (>= value (- (- 0 2305843009213693951) 1))
      (<= value 2305843009213693951)
      #f))

; Static BOX_BIGNUM layout follows NplBigint in runtime/npl.h:
; header, sign, count, capacity, little-endian base-10^9 limbs.
; Slice canonical decimal output into limbs; do not reimplement arithmetic.
(define (integer-literal-limbs text start end)
  (if (= start end)
      ()
      (let ((begin (if (> (- end start) 9) (- end 9) start)))
        (cons (npl_lex_number text begin end)
              (integer-literal-limbs text start begin)))))

(define (integer-limb-data limbs)
  (if (null? limbs)
      ""
      (string-append ", w " (number->string (car limbs))
                     (integer-limb-data (cdr limbs)))))

(define (integer-literal-label value)
  (let ((text (number->string value)))
    (let ((negative (= (string-byte-ref text 0) 45)))
      (let ((limbs (integer-literal-limbs
                     text (if negative 1 0) (string-length text))))
        (let ((count (number->string (count-up limbs 0))))
          (cell-set! DATAN (+ 1 (cell-get DATAN)))
          (let ((label (string-append "$integer_" (number->string (cell-get DATAN)))))
            (data-line
              (string-append label " = { w 19, w 1, w "
                (if negative "-1" "1") ", w " count ", w " count
                (integer-limb-data limbs) " }"))
            label))))))

(define (float-literal-label bits)
  (cell-set! DATAN (+ 1 (cell-get DATAN)))
  (let ((label (string-append "$float_" (number->string (cell-get DATAN)))))
    ; NplFloat is a two-word header followed by the IEEE binary64 payload.
    ; QBE data has no floating scalar kind, so preserve the payload as a l word.
    (data-line (string-append label " = { w 5, w 1, l "
                             (number->string bits) " }"))
    label))

(define (complex-literal-label value)
  (let ((real (integer-literal-op (npl_complex_real value) #t))
        (imag (integer-literal-op (npl_complex_imag value) #t)))
    (cell-set! DATAN (+ 1 (cell-get DATAN)))
    (let ((label (string-append "$complex_" (number->string (cell-get DATAN)))))
      (data-line (string-append label " = { w 21, w 1, l " real
                               ", l " imag " }"))
      label)))

(define (integer-literal-op value static)
  (if (npl_integer_p value)
      (if (integer-immediate? value)
          (npl_tagged_num_to_string value)
          (let ((label (integer-literal-label value)))
            (if static (label-constant label) (label-ref-op label))))
      (if (npl_complex_p value)
          (let ((label (complex-literal-label value)))
            (if static (label-constant label) (label-ref-op label)))
          (if (npl_inexact_p value)
          (let ((label (float-literal-label (npl_inexact_bits value))))
            (if static (label-constant label) (label-ref-op label)))
          (let ((numerator (integer-literal-op (npl_rational_numerator value) #t))
                (denominator (integer-literal-op (npl_rational_denominator value) #t)))
            (cell-set! DATAN (+ 1 (cell-get DATAN)))
            (let ((label (string-append "$rational_" (number->string (cell-get DATAN)))))
              (data-line (string-append label " = { w 20, w 1, l " numerator
                                       ", l " denominator " }"))
              (if static (label-constant label) (label-ref-op label))))))))

(define (emit-integer-fold fn operands result)
  (if (null? operands)
      result
      (emit-integer-fold fn (cdr operands)
        (call-with-ops fn (cons result (cons (car operands) ()))))))

(define (emit-integer-arithmetic name args env)
  (let ((count (count-up args 0)))
    (if (string=? name "-") (check-arity args 1 count))
    (let ((ops (eval-args-fixed args env count ())))
      (cond
        ((string=? name "+") (emit-fixnum-sum ops #t))
        ((string=? name "*") (emit-integer-fold "npl_number_mul" ops "4"))
        ((null? (cdr ops))
         (emit-fixnum-arith "npl_number_sub" "sub" "0" (car ops) #t))
        (else
         (emit-fixnum-fold "npl_number_sub" "sub" (car ops) (cdr ops) #t))))))

; ---------------- inline fixnum operations ----------------
;
; A fixnum is its value shifted left by 2 with tag 0 (runtime/npl.h), so two
; tagged fixnums add, subtract, and compare as signed 64-bit integers, and the
; fixnum range overflows exactly when the tagged operation overflows. Every
; other case calls the generic runtime function. `checked` says whether the
; operands still need the tag test; the alias fast path has already done it.

; Continue at a new block when both operands have the fixnum tag (the OR of
; two tag-0 values has low bits 0), otherwise jump to slow. A literal operand
; is an immediate (fixnum, boolean, character, ...) and is tested too; QBE
; folds the constant.
(define (emit-fixnum-pair-branch va vb slow)
  (let ((both (new-tmp)) (fast (new-label)))
    (func-line (string-append both " =l or " va ", " vb))
    (let ((low (new-tmp)))
      (func-line (string-append low " =w and " both ", 3"))
      (func-line (string-append "jnz " low ", " slow ", " fast))
      (func-line fast))))

(define (emit-fixnum-guard checked va vb slow)
  (if checked (emit-fixnum-pair-branch va vb slow) #f))

(define (emit-xor va vb)
  (let ((x (new-tmp)))
    (func-line (string-append x " =l xor " va ", " vb))
    x))

; 1 when the sign bit of (left & right) is set.
(define (emit-sign-flag left right)
  (let ((both (new-tmp)))
    (func-line (string-append both " =l and " left ", " right))
    (let ((flag (new-tmp)))
      (func-line (string-append flag " =w csltl " both ", 0"))
      flag)))

; s = a + b overflows iff ((s ^ a) & (s ^ b)) < 0;
; s = a - b overflows iff ((a ^ b) & (a ^ s)) < 0.
(define (emit-overflow-flag opcode va vb value)
  (if (string=? opcode "add")
      (emit-sign-flag (emit-xor value va) (emit-xor value vb))
      (emit-sign-flag (emit-xor va vb) (emit-xor va value))))

; A temporary may hold a static box address plus its tag (a literal such as
; 1/2). The guard keeps it off the fast path at run time, but QBE propagates
; constants into the dead fast path and folds an address plus a constant into
; a relocation addend, which Mach-O arm64 rejects when negative. Either
; operand may become the constant only after propagation, so every temporary
; is masked: `and x, -4` is the identity on a fixnum and QBE never folds an
; address through it. Decimal operands are fixnums and need no mask.
(define (fixnum-operand op)
  (if (= (string-byte-ref op 0) 37)
      (let ((masked (new-tmp)))
        (func-line (string-append masked " =l and " op ", -4"))
        masked)
      op))

; opcode is the QBE "add" or "sub"; fn the runtime function for the same
; operation, called on overflow and for non-fixnum operands.
(define (emit-fixnum-arith fn opcode va vb checked)
  (let ((result (new-tmp)) (slow (new-label)) (merge (new-label)))
    (emit-fixnum-guard checked va vb slow)
    (let ((value (new-tmp)) (ok (new-label))
          (a (fixnum-operand va)) (b (fixnum-operand vb)))
      (func-line (string-append value " =l " opcode " " a ", " b))
      (func-line (string-append "jnz " (emit-overflow-flag opcode a b value)
                                ", " slow ", " ok))
      (func-line ok)
      (func-line (string-append result " =l copy " value))
      (func-line (string-append "jmp " merge))
      (func-line slow)
      (func-line (string-append result " =l call $" fn "(l " va ", l " vb ")"))
      (func-line merge)
      result)))

; Left fold. An intermediate result may be a bignum, so every step after the
; first tests its tags again.
(define (emit-fixnum-fold fn opcode result operands checked)
  (if (null? operands)
      result
      (emit-fixnum-fold fn opcode
        (emit-fixnum-arith fn opcode result (car operands) checked)
        (cdr operands) #t)))

; (+) is 0 and (+ x) is x. An unchecked operand is a fixnum already; a
; checked one goes through the runtime, which rejects a non-number.
(define (emit-fixnum-sum ops checked)
  (cond
    ((null? ops) "0")
    ((null? (cdr ops))
     (if checked (call-with-ops "npl_number_add" (cons "0" ops)) (car ops)))
    (else
     (emit-fixnum-fold "npl_number_add" "add" (car ops) (cdr ops) checked))))

; ---------------- public numeric alias fast paths ----------------
;
; The guard is a tag test: TAG_FIXNUM is 0, so a fixnum has low word bits 0.
; The result is 1 only when every operand is a fixnum.
(define (fixnum-tag-test op)
  (let ((low (new-tmp)))
    (func-line (string-append low " =w and " op ", 3"))
    (let ((hit (new-tmp)))
      (func-line (string-append hit " =w ceqw " low ", 0"))
      hit)))

(define (map-cons fn xs)
  (if (null? xs) () (cons (fn (car xs)) (map-cons fn (cdr xs)))))

(define (combine-fixnum-guards ops)
  (if (null? (cdr ops))
      (car ops)
      (let ((rest (combine-fixnum-guards (cdr ops))))
        (let ((all (new-tmp)))
          (func-line (string-append all " =w and " (car ops) ", " rest))
          all))))

; Call a registered function in value position. npl_call_sync supplies the
; continuation and forwards a raise to the caller's trampoline, so a handler
; that escapes resumes on the right C frame (runtime/trampoline.c).
(define (emit-value-call nm ops)
  (let ((result (new-tmp)))
    (func-line
      (string-append result " =l call $npl_call_sync(l $" (lookup-func nm)
                     ", l 2, l " (number->string (count-up ops 0))
                     ", l " (argv-op ops) ")"))
    result))

; Inline the primitive when every operand is a fixnum, otherwise apply the
; library procedure the alias names. Both paths produce the same result, so
; the two branches may define one SSA result before a merge block, as the
; pair? emission already does.
(define (emit-numeric-alias-ops nm primitive ops)
  (let ((result (new-tmp)))
    (if (null? ops)
        (emit-numeric-alias-inline primitive ops)
        (let ((fast (new-label)))
          (let ((slow (new-label)))
            (let ((merge (new-label)))
              (let ((guard (combine-fixnum-guards (map-cons fixnum-tag-test ops))))
                (begin
                  (func-line (string-append "jnz " guard ", " fast ", " slow))
                  (func-line fast)
                  (let ((value (emit-numeric-alias-inline primitive ops)))
                    (func-line (string-append result " =l copy " value)))
                  (func-line (string-append "jmp " merge))
                  (func-line slow)
                  (func-line (string-append result " =l copy " (emit-value-call nm ops)))
                  (func-line merge)
                  result))))))))

(define (emit-numeric-alias-inline primitive ops)
  (cond
    ((string=? primitive "+") (emit-fixnum-sum ops #f))
    ((string=? primitive "*") (emit-integer-fold "npl_number_mul" ops "4"))
    ((string=? primitive "-")
     (if (null? (cdr ops))
         (emit-fixnum-arith "npl_number_sub" "sub" "0" (car ops) #f)
         (emit-fixnum-fold "npl_number_sub" "sub" (car ops) (cdr ops) #f)))
    (else (emit-compare-chain primitive ops #f))))

; A call to a public numeric alias takes the fixnum fast path when the operand
; count is one the inline operation supports. Below that count the call goes
; to the procedure, which reports the error at runtime. Value-position thunks
; carry no continuation, so the procedure call supplies one.
(define (emit-numeric-alias-call nm args env)
  (let ((primitive (numeric-alias-primitive-name nm)))
    (let ((count (count-up args 0)))
      (let ((ops (eval-args-fixed args env count ())))
        (if (< count (numeric-alias-min-count primitive))
            (emit-value-call nm ops)
            (emit-numeric-alias-ops nm primitive ops))))))

; Tail-call request of a registered function; emitted by emit-tail-request and
; by the numeric alias slow path.
(define (emit-tail-request-function nm argc argv)
  (func-line (string-append "call $npl_tail_request(l $" (lookup-func nm)
                            ", l 2, l " argc
                          ", l " argv ")")))

; Fast path when every operand is a fixnum: inline the primitive and hand its
; result to the caller's continuation. Otherwise apply the library procedure.
; The caller emits the final `ret`.
(define (emit-numeric-alias-guard nm primitive ops continuation argv argc)
  (if (null? ops)
      (emit-tail-request-function nm argc argv)
      (let ((fast (new-label)) (slow (new-label)))
        (let ((guard (combine-fixnum-guards (map-cons fixnum-tag-test ops))))
          (begin
            (func-line (string-append "jnz " guard ", " fast ", " slow))
            (func-line fast)
            (let ((result (emit-numeric-alias-inline primitive ops)))
              (let ((result-argv (argv-op (cons result ()))))
                (func-line (string-append "call $npl_tail_request_closure(l "
                                        continuation ", l 1, l " result-argv
                                        ")"))))
            (func-line "ret 2")
            (func-line slow)
            (emit-tail-request-function nm argc argv))))))

; Tail-position call to a public numeric alias. `ops` holds the evaluated
; source operands followed by the continuation, as control conversion leaves
; them, and `argv` already stores all of them for the procedure call.
(define (emit-numeric-alias-tail nm ops argv)
  (let ((reversed (rev ops)))
    (let ((source-ops (rev (cdr reversed))))
      (let ((primitive (numeric-alias-primitive-name nm))
            (count (count-up ops 0)))
        (if (< (count-up source-ops 0) (numeric-alias-min-count primitive))
            (emit-tail-request-function nm (number->string count) argv)
            (emit-numeric-alias-guard
              nm primitive source-ops (car reversed) argv
              (number->string count)))))))
