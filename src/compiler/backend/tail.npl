; Tail-position analysis and trampoline request emission.

; In a direct entry only a self jump leaves value position.
(define (tail-call-application? e env)
  (if (cell-get DIRECT-ENTRY)
      (if (pair-shape? (car e))
          (self-tail-call? (car e) (count-up (cdr e) 0) env)
          #f)
      (generic-tail-call-application? e env)))

(define (generic-tail-call-application? e env)
  (if (not (pair-shape? (car e)))
      #f
      (let ((head (car e)))
        (if (sym-atom? head)
            (if (env-entry env (cdr head))
                #t
                (if (> (string-length (lookup-func (cdr head))) 0)
                    #t
                    (> (string-length (lookup-glob (cdr head))) 0)))
            #t))))

(define (emit-tail-request e env)
  (let ((head (car e)))
    (let ((args (cdr e)))
      (let ((count (count-up args 0)))
        (let ((ops (eval-args-fixed args env count ())))
          (if (self-tail-call? head count env)
              (emit-self-jump ops)
              (emit-tail-request-ops head ops count env)))))))

(define (emit-tail-request-ops head ops count env)
  (let ((argv (argv-op ops)))
    (if (sym-atom? head)
        (let ((closure (env-read env (cdr head))))
          (if (> (string-length closure) 0)
              (begin
                (func-line
                  (string-append
                    "call $npl_tail_request_closure(l " closure
                    ", l " (number->string count) ", l " argv ")")))
              (if (> (string-length (lookup-func (cdr head))) 0)
                  (if (> (string-length
                           (numeric-alias-primitive-name
                             (cdr head))) 0)
                      (emit-numeric-alias-tail (cdr head) ops argv)
                      (emit-tail-request-function (cdr head)
                        (number->string count) argv))
                  (let ((closure (symbol-value (cdr head) env)))
                    (func-line
                      (string-append
                        "call $npl_tail_request_closure(l " closure
                        ", l " (number->string count)
                        ", l " argv ")"))))))
        (let ((closure (emit-expr head env)))
          (func-line
            (string-append "call $npl_tail_request_closure(l " closure
              ", l " (number->string count) ", l " argv ")"))))
    (func-line "ret 2")))

; ---------------- closure calls with an inline continuation ----------------
;
; (223 head arguments continuation) (frontend direct-calls.npl
; control-closure-call-site?): when the closure in head has a direct entry
; for this arity (runtime npl_closure_direct), call it and run the
; continuation's body here with its parameter bound to the result;
; otherwise make the CPS call. Errors (arity, not a procedure) come from
; the CPS call, as before.
(define (emit-closure-call-site e env)
  (let ((closure (emit-expr (car (cdr e)) env))
        (args (car (cdr (cdr e))))
        (continuation (car (cdr (cdr (cdr e))))))
    (let ((ops (eval-args-fixed args env (count-up args 0) ()))
          (entry (new-tmp)) (test (new-tmp))
          (fast (new-label)) (slow (new-label)) (result (new-tmp)))
      (func-line
        (string-append entry " =l call $npl_closure_direct(l " closure
                       ", l " (number->string (+ 1 (count-up ops 0))) ")"))
      (func-line (string-append test " =w cnel " entry ", 0"))
      (func-line (string-append "jnz " test ", " fast ", " slow))
      (func-line fast)
      (func-line
        (string-append result " =l call " entry "(l " closure
          (if (null? ops) "" (string-append ", " (args-join ops))) ")"))
      (emit-tail-body (car (cdr (cdr continuation)))
        (env-bind env (cdr (car (car (cdr continuation)))) result))
      (func-line slow)
      (let ((all (append-list ops (cons (emit-expr continuation env) ()))))
        (func-line
          (string-append "call $npl_tail_request_closure(l " closure
            ", l " (number->string (count-up all 0))
            ", l " (argv-op all) ")"))
        (func-line "ret 2")))))

; ---------------- direct self tail calls ----------------
;
; A tail call from an eligible top-level function (program.npl
; self-loop-eligible?) or named loop (bindings.npl self-loop-binding?) to
; itself, by its unshadowed name and with its fixed arity, assigns the
; parameters and jumps to the body instead of returning to the trampoline.
; QBE accepts the reassigned temporaries and builds SSA. Numeric aliases keep
; their inline fast path.

(define (self-name self) (car self))
(define (self-arity self) (car (cdr self)))
(define (self-params self) (car (cdr (cdr self))))
(define (self-label-cell self) (car (cdr (cdr (cdr self)))))
(define (self-entry self) (car (cdr (cdr (cdr (cdr self))))))

; The call names the function being emitted: a top-level function's name is
; not lexically bound there; a named loop's name is its captured binding.
(define (self-binding? self entry)
  (if (self-entry self) (eq? entry (self-entry self)) (not entry)))

(define (self-tail-call? head count env)
  (let ((self (cell-get SELF-FUNCTION)))
    (if (not self)
        #f
        (if (not (sym-atom? head))
            #f
            (if (not (string=? (cdr head) (self-name self)))
                #f
                (if (not (self-binding? self (env-entry env (cdr head))))
                    #f
                    (if (= count (self-arity self))
                        (= (string-length (numeric-alias-primitive-name
                                            (cdr head))) 0)
                        #f)))))))

; The loop label is made at the first jump, so a function without one is
; emitted exactly as before.
(define (self-loop-label self)
  (let ((label (self-label-cell self)))
    (if (cell-get label)
        (cell-get label)
        (begin (cell-set! label (new-label)) (cell-get label)))))

(define (copy-op op)
  (let ((copy (new-tmp)))
    (func-line (string-append copy " =l copy " op))
    copy))

(define (assign-params params ops)
  (if (null? params)
      0
      (begin
        (func-line (string-append (car params) " =l copy " (car ops)))
        (assign-params (cdr params) (cdr ops)))))

; The caller evaluated every argument. Copy them first so an argument that
; reads a parameter (a swap) sees its old value, then assign and jump. This
; jmp is the only back edge a self call creates: a safepoint poll for a
; later preemptive scheduler or stop-the-world collector belongs here.
(define (emit-self-jump ops)
  (let ((self (cell-get SELF-FUNCTION)))
    (assign-params (self-params self) (map-cons copy-op ops))
    (func-line (string-append "jmp " (self-loop-label self)))))

(define (emit-tail-if e env)
  (let ((true-label (new-label)))
    (let ((false-label (new-label)))
      (let ((test (emit-expr (car (cdr e)) env)))
        (let ((truthy (new-tmp)))
          (func-line (string-append truthy " =w cnel " test ", 10"))
          (func-line
            (string-append "jnz " truthy ", " true-label ", " false-label))
          (func-line true-label)
          (emit-tail-expr (car (cdr (cdr e))) env)
          (func-line false-label)
          (emit-tail-expr (car (cdr (cdr (cdr e)))) env))))))

(define (emit-tail-let e env mode)
  (let ((binds (car (cdr e))))
    (let ((body (car (cdr (cdr e)))))
      (case mode
        ((0) (emit-tail-body body
               (bind-values binds (binding-values binds env) env)))
        ((1) (emit-tail-letstar-binds binds body env))
        ((2)
          (let ((recursive-env (allocate-bindings binds env)))
            (write-bindings binds (binding-values binds recursive-env)
                            recursive-env)
            (emit-tail-body body recursive-env)))
        (else
          (let ((recursive-env (allocate-bindings binds env)))
            (initialize-bindings binds recursive-env)
            (emit-tail-body body recursive-env)))))))

(define (emit-tail-letstar-binds binds body env)
  (if (null? binds)
      (emit-tail-body body env)
      (let ((binding (car binds)))
        (let ((value (emit-expr (cdr binding) env)))
          (emit-tail-letstar-binds
            (cdr binds) body
            (env-bind env (cdr (car binding)) value))))))

(define (values-dispatch-application? expression)
  (if (not (pair-shape? expression))
      #f
      (let ((head (car expression)))
        (if (sym-atom? head)
            (string=? (cdr head) "_npl_values_dispatch")
            #f))))

(define (emit-values-dispatch expression env)
  (let ((args (cdr expression)))
    (check-arity args 3 3)
    (let ((ops (eval-args-fixed args env 3 ())))
      (func-line
        (string-append "call $npl_values_dispatch(l " (car ops)
          ", l " (car (cdr ops))
          ", l " (car (cdr (cdr ops))) ")"))
      (func-line "ret 2"))))

(define (apply-application? expression)
  (if (not (pair-shape? expression))
      #f
      (let ((head (car expression)))
        (if (sym-atom? head)
            (string=? (cdr head) "_npl_apply")
            #f))))

; (_npl_apply k f a ... list): argv = f a ... list k for npl_apply_tail.
(define (emit-apply expression env)
  (let ((args (cdr expression)))
    (let ((count (count-up args 0)))
      (let ((ops (eval-args-fixed args env count ())))
        (let ((argv (argv-op (append-list (cdr ops) (cons (car ops) ())))))
          (func-line
            (string-append "call $npl_apply_tail(l "
                           (number->string count) ", l " argv ")"))
          (func-line "ret 2"))))))

(define (wind-transfer-application? expression)
  (if (not (pair-shape? expression))
      #f
      (let ((head (car expression)))
        (if (sym-atom? head)
            (string=? (cdr head) "_npl_wind_transfer")
            #f))))

(define (emit-wind-transfer expression env)
  (let ((args (cdr expression)))
    (check-arity args 4 4)
    (let ((ops (eval-args-fixed args env 4 ())))
      (func-line
        (string-append "call $npl_wind_transfer(l " (car ops)
          ", l " (car (cdr ops))
          ", l " (car (cdr (cdr ops)))
          ", l " (car (cdr (cdr (cdr ops)))) ")"))
      (func-line "ret 2"))))

(define (raise-application-mode expression)
  (if (not (pair-shape? expression))
      0
      (let ((head (car expression)))
        (if (not (sym-atom? head))
            0
            (if (string=? (cdr head) "_npl_raise")
                1
                (if (string=? (cdr head) "_npl_raise_continuable")
                    2
                    0))))))

(define (emit-raise expression env mode)
  (let ((args (cdr expression)))
    (check-arity args 2 2)
    (let ((ops (eval-args-fixed args env 2 ())))
      (func-line
        (string-append "call $npl_raise(l " (car ops)
          ", l " (car (cdr ops)) ", l "
          (if (= mode 2) "1" "0") ")"))
      (func-line "ret 2"))))

(define (emit-tail-expr expression env)
  (if (values-dispatch-application? expression)
      (emit-values-dispatch expression env)
      (if (apply-application? expression)
          (emit-apply expression env)
      (if (wind-transfer-application? expression)
          (emit-wind-transfer expression env)
          (let ((raise-mode (raise-application-mode expression)))
            (if (> raise-mode 0)
                (emit-raise expression env raise-mode)
                (if (if (pair-shape? expression)
                        (number? (car expression)) #f)
      (case (car expression)
        ((213) (emit-tail-if expression env))
        ((214) (emit-tail-let expression env 0))
        ((216) (emit-tail-sequence (cdr expression) env))
        ((223) (emit-closure-call-site expression env))
        ((220) (emit-tail-let expression env 1))
        ((221) (emit-tail-let expression env 2))
        ((222) (emit-tail-let expression env 3))
        (else
          (let ((result (emit-expr expression env)))
            (func-line (string-append "ret " result)))))
      (if (if (pair-shape? expression)
              (tail-call-application? expression env)
              #f)
          (emit-tail-request expression env)
          (let ((result (emit-expr expression env)))
            (func-line (string-append "ret " result)))))))))))

(define (emit-tail-sequence body env)
  (if (null? body)
      (func-line "ret 2")
      (if (null? (cdr body))
          (emit-tail-expr (car body) env)
          (begin
            (emit-expr (car body) env)
            (emit-tail-sequence (cdr body) env)))))

(define (emit-tail-body body env)
  (let ((body-env (allocate-internal body env)))
    (emit-tail-sequence (initialize-internal body body-env) body-env)))
