; QBE emitter buffers and symbol registries.

; ---------------- emitter state ----------------

(define TMPN (cell 0))
(define DATAN (cell 0))
(define DATA-BUF (cell ()))
(define FUNC-BUF (cell ()))
; Top-level function symbols and arities, and global slots: string hash
; tables from name, filled once per compilation; a later registration of a
; name wins, as the association lists they replace did.
(define FUNCS (cell (npl_make_hash_table 3 #f #f 0)))
(define FUNC-ARITIES (cell (npl_make_hash_table 3 #f #f 0)))
(define GLOBS (cell (npl_make_hash_table 3 #f #f 0)))
(define SYMS (cell ()))

(define (new-tmp)
  (cell-set! TMPN (+ 1 (cell-get TMPN)))
  (string-append "%t" (number->string (cell-get TMPN))))

(define (new-label)
  (begin
    (cell-set! DATAN (+ 1 (cell-get DATAN)))
    (string-append "@L" (number->string (cell-get DATAN)))))

; every entry in DATA-BUF is a QBE data definition — prepend the keyword
; here so all construction sites share one contract
(define (data-line ln)
  (if (string=? "$" (substring ln 0 1))
      (cell-set! DATA-BUF (cons (string-append "data " ln) (cell-get DATA-BUF)))
      (cell-set! DATA-BUF (cons ln (cell-get DATA-BUF)))))
; single writer for code lines: honours CURBUF ("I" -> global inits body)
(define INIT-BUF (cell ()))
(define LAMBDA-BUF (cell ()))
(define LOCAL-BUF (cell ()))
(define LAMBDA-N (cell 0))
(define CURBUF  (cell "F"))
(define HAS-INIT (cell 0))
; set! targets of the top-level form being emitted; see collect-assigned.
(define ASSIGNED-NAMES (cell ()))
; data-segment global slots registered as GC roots at program start
(define GLOBAL-ROOTS (cell ()))
; primitives referenced as values; their closure wrappers are emitted once
(define PRIMITIVE-VALUES (cell ()))
; Direct self tail calls (tail.npl emit-self-jump): while the body of an
; eligible function is emitted, (name arity parameter-ops label-cell entry);
; #f otherwise. entry is #f for a top-level function (its name must be
; lexically unbound at the call) and the lambda's captured binding of its
; letrec name for a named loop (the call must see that binding).
(define SELF-FUNCTION (cell #f))
; Bindings of control-converted letrecs (all placeholders, assigned only by
; set!) allocated in the C function being emitted (bindings.npl).
(define LOCAL-LOOP-CELLS (cell ()))
; #t while the direct entry of a direct-safe function is emitted
; (program.npl emit-direct-function): a tail call other than a self jump is
; then a value call followed by ret (tail.npl tail-call-application?).
(define DIRECT-ENTRY (cell #f))

; The buffer of the C function being emitted: a lambda's ("X") or a
; top-level function's.
(define (current-buffer)
  (if (string=? (cell-get CURBUF) "X")
      (cell-get LOCAL-BUF)
      (cell-get FUNC-BUF)))

(define (set-current-buffer! lines)
  (if (string=? (cell-get CURBUF) "X")
      (cell-set! LOCAL-BUF lines)
      (cell-set! FUNC-BUF lines)))

(define (func-line ln)
  (cond ((string=? (cell-get CURBUF) "I")
         (cell-set! INIT-BUF (cons ln (cell-get INIT-BUF))))
        ((string=? (cell-get CURBUF) "X")
         (cell-set! LOCAL-BUF (cons ln (cell-get LOCAL-BUF))))
        (else
         (cell-set! FUNC-BUF (cons ln (cell-get FUNC-BUF))))))

; Stack slot of `bytes` bytes. While SELF-FUNCTION or DIRECT-ENTRY is set the
; line is tagged so emit-hoisted-body can move it into @start: QBE gives an
; alloc there a fixed frame slot, but one in a loop body grows the stack on
; every iteration.
(define (emit-alloc8 slot bytes)
  (let ((line (string-append slot " =l alloc8 " bytes)))
    (if (if (if (cell-get SELF-FUNCTION) #t (cell-get DIRECT-ENTRY))
            (not (string=? (cell-get CURBUF) "I"))
            #f)
        (set-current-buffer! (cons (cons #t line) (current-buffer)))
        (func-line line))))

(define (append-list left right)
  (if (null? left) right (cons (car left) (append-list (cdr left) right))))

; QBE symbol of a top-level procedure. The prefix keeps program names off C
; symbols (main, which nplc generates, and libc's free, read, ...); sanitize
; escapes every _, so no sanitized name starts with _npl_.
(define (function-symbol nm) (string-append "_npl_fn_" (sanitize nm 0 "")))
; Its direct entry (frontend/direct-calls.npl), when it is direct-safe.
(define (direct-function-symbol nm)
  (string-append "_npl_dfn_" (sanitize nm 0 "")))

; registry stores the BARE symbol; callers prepend '$' themselves
(define (register-func nm arity)
  (npl_hash_table_set (cell-get FUNCS) nm (function-symbol nm))
  (npl_hash_table_set (cell-get FUNC-ARITIES) nm arity))

(define (register-glob nm slot)
  (npl_hash_table_set (cell-get GLOBS) nm slot))

(define (lk-s entries nm)
  (if (null? entries)
      ""
      (if (string=? (car (car entries)) nm)
          (cdr (car entries))
          (lk-s (cdr entries) nm))))

(define (lookup-func nm) (npl_hash_table_ref (cell-get FUNCS) nm ""))
(define (lookup-func-arity nm)
  (npl_hash_table_ref (cell-get FUNC-ARITIES) nm 0))
(define (lookup-glob nm) (npl_hash_table_ref (cell-get GLOBS) nm ""))
