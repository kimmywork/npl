(import (scheme base)
        (scheme read)
        (scheme write)
        (scheme file)
        (scheme process-context)
        (scheme internal evaluator))

(define environment (make-eval-environment))

(define (fail condition)
  (display (eval-condition-text condition) (current-error-port))
  (newline (current-error-port))
  (exit 1))

(define (evaluate form)
  (guard (condition (#t (fail condition)))
    (eval-in-environment form environment)))

(define (load-forms port)
  (let ((form (read port)))
    (if (eof-object? form)
        #t
        (begin
          (evaluate form)
          (load-forms port)))))

(define (main)
  (let ((arguments (cdr (command-line))))
    (if (not (= (length arguments) 1))
        (exit 2))
    (let ((port (open-input-file (car arguments))))
      (load-forms port)
      (close-input-port port))
    (write (evaluate (read (open-input-string "(differential-results)"))))
    (newline)
    0))
(main)
