(import (scheme base)
        (scheme read)
        (scheme write)
        (scheme file)
        (scheme process-context)
        (npl evaluator))

(define environment (make-eval-environment))

(define (load-forms port)
  (let ((form (read port)))
    (if (eof-object? form)
        #t
        (let ((result (eval-in-environment form environment)))
          (if (eval-error? result)
              (begin
                (display (eval-error-message result)
                         (current-error-port))
                (newline (current-error-port))
                (exit 1))
              (load-forms port))))))

(define (main)
  (let ((arguments (command-line)))
    (if (not (= (length arguments) 1))
        (exit 2))
    (let ((port (open-input-file (car arguments))))
      (load-forms port)
      (close-input-port port))
    (let ((result
            (eval-in-environment
              (read (open-input-string "(differential-results)"))
              environment)))
      (if (eval-error? result)
          (begin
            (display (eval-error-message result) (current-error-port))
            (newline (current-error-port))
            (exit 1))
          (begin
            (write result)
            (newline)
            0)))))
