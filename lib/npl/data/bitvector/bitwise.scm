    (define (bitvector-not bvec)
      (let ((result (allocate (bitvector-length bvec))))
        (let loop ((index 0))
          (if (< index (bitvector-length bvec))
              (begin
                (bitvector-set! result index
                                (- 1 (bitvector-ref/int bvec index)))
                (loop (+ index 1)))))
        result))

    (define (bitvector-not! bvec)
      (let loop ((index 0))
        (if (< index (bitvector-length bvec))
            (begin
              (bitvector-set! bvec index
                              (- 1 (bitvector-ref/int bvec index)))
              (loop (+ index 1))))))

    (define (operands-at bvecs index)
      (if (null? bvecs)
          '()
          (cons (bitvector-ref/int (car bvecs) index)
                (operands-at (cdr bvecs) index))))

    (define (fold-operands op values seed)
      (if (null? values)
          seed
          (fold-operands op (cdr values) (op seed (car values)))))

    (define (bitvector-fold-operands who op mutating first rest)
      (let ((bvecs (cons first rest)))
        (for-each (lambda (bvec)
                    (check-bitvector who bvec)
                    (if (not (= (bitvector-length bvec)
                                (bitvector-length first)))
                        (error who "bitvector lengths differ" bvec)))
                  bvecs)
        (let ((result (if mutating first
                          (allocate (bitvector-length first)))))
          (let loop ((index 0))
            (if (< index (bitvector-length first))
                (begin
                  (bitvector-set! result index
                                  (fold-operands
                                   op (cdr (operands-at bvecs index))
                                   (bitvector-ref/int first index)))
                  (loop (+ index 1)))))
          result)))

    (define (and-op left right) (if (= left 1) right 0))
    (define (ior-op left right) (if (= left 1) 1 right))
    (define (xor-op left right) (if (= left right) 0 1))
    (define (eqv-op left right) (if (= left right) 1 0))
    (define (nand-op left right) (- 1 (and-op left right)))
    (define (nor-op left right) (- 1 (ior-op left right)))
    (define (andc1-op left right) (if (= left 0) right 0))
    (define (andc2-op left right) (if (= right 0) left 0))
    (define (orc1-op left right) (if (= left 0) 1 right))
    (define (orc2-op left right) (if (= right 0) 1 left))

    (define (bitvector-and first . rest)
      (bitvector-fold-operands "bitvector-and" and-op #f first rest))
    (define (bitvector-and! first . rest)
      (bitvector-fold-operands "bitvector-and!" and-op #t first rest))
    (define (bitvector-ior first . rest)
      (bitvector-fold-operands "bitvector-ior" ior-op #f first rest))
    (define (bitvector-ior! first . rest)
      (bitvector-fold-operands "bitvector-ior!" ior-op #t first rest))
    (define (bitvector-xor first . rest)
      (bitvector-fold-operands "bitvector-xor" xor-op #f first rest))
    (define (bitvector-xor! first . rest)
      (bitvector-fold-operands "bitvector-xor!" xor-op #t first rest))
    (define (bitvector-eqv first . rest)
      (bitvector-fold-operands "bitvector-eqv" eqv-op #f first rest))
    (define (bitvector-eqv! first . rest)
      (bitvector-fold-operands "bitvector-eqv!" eqv-op #t first rest))
    (define (bitvector-nand first . rest)
      (bitvector-fold-operands "bitvector-nand" nand-op #f first rest))
    (define (bitvector-nand! first . rest)
      (bitvector-fold-operands "bitvector-nand!" nand-op #t first rest))
    (define (bitvector-nor first . rest)
      (bitvector-fold-operands "bitvector-nor" nor-op #f first rest))
    (define (bitvector-nor! first . rest)
      (bitvector-fold-operands "bitvector-nor!" nor-op #t first rest))
    (define (bitvector-andc1 first . rest)
      (bitvector-fold-operands "bitvector-andc1" andc1-op #f first rest))
    (define (bitvector-andc1! first . rest)
      (bitvector-fold-operands "bitvector-andc1!" andc1-op #t first rest))
    (define (bitvector-andc2 first . rest)
      (bitvector-fold-operands "bitvector-andc2" andc2-op #f first rest))
    (define (bitvector-andc2! first . rest)
      (bitvector-fold-operands "bitvector-andc2!" andc2-op #t first rest))
    (define (bitvector-orc1 first . rest)
      (bitvector-fold-operands "bitvector-orc1" orc1-op #f first rest))
    (define (bitvector-orc1! first . rest)
      (bitvector-fold-operands "bitvector-orc1!" orc1-op #t first rest))
    (define (bitvector-orc2 first . rest)
      (bitvector-fold-operands "bitvector-orc2" orc2-op #f first rest))
    (define (bitvector-orc2! first . rest)
      (bitvector-fold-operands "bitvector-orc2!" orc2-op #t first rest))

    (define (bitvector-logical-shift bvec count bit)
      (let ((bit (check-bit "bitvector-logical-shift" bit))
            (result (allocate (bitvector-length bvec))))
        (let loop ((index 0))
          (if (< index (bitvector-length bvec))
              (let ((source-index (+ index count)))
                (bitvector-set! result index
                  (if (if (<= 0 source-index)
                          (< source-index (bitvector-length bvec))
                          #f)
                      (bitvector-ref/int bvec source-index)
                      bit))
                (loop (+ index 1)))))
        result))

    (define (bitvector-count bit bvec)
      (let ((bit (check-bit "bitvector-count" bit)))
        (let loop ((index 0) (total 0))
          (if (>= index (bitvector-length bvec))
              total
              (loop (+ index 1)
                    (if (= bit (bitvector-ref/int bvec index))
                        (+ total 1)
                        total))))))

    (define (bitvector-count-run bit bvec start)
      (let ((bit (check-bit "bitvector-count-run" bit)))
        (let loop ((index start) (total 0))
          (if (if (< index (bitvector-length bvec))
                  (= bit (bitvector-ref/int bvec index))
                  #f)
              (loop (+ index 1) (+ total 1))
              total))))

    (define (bitvector-if condition then else)
      (let ((result (allocate (bitvector-length condition))))
        (let loop ((index 0))
          (if (< index (bitvector-length condition))
              (begin
                (bitvector-set! result index
                  (if (= 1 (bitvector-ref/int condition index))
                      (bitvector-ref/int then index)
                      (bitvector-ref/int else index)))
                (loop (+ index 1)))))
        result))

    (define (bitvector-first-bit bit bvec)
      (let ((bit (check-bit "bitvector-first-bit" bit)))
        (let loop ((index 0))
          (cond ((>= index (bitvector-length bvec)) -1)
                ((= bit (bitvector-ref/int bvec index)) index)
                (else (loop (+ index 1)))))))

    (define (bitvector-field-any? bvec start end)
      (let* ((range (check-range "bitvector-field-any?" bvec start end)))
        (let loop ((index (range-start range)))
          (if (>= index (range-end range))
              #f
              (if (= 1 (bitvector-ref/int bvec index))
                  #t
                  (loop (+ index 1)))))))

    (define (bitvector-field-every? bvec start end)
      (let* ((range (check-range "bitvector-field-every?" bvec start end)))
        (let loop ((index (range-start range)))
          (if (>= index (range-end range))
              #t
              (if (= 0 (bitvector-ref/int bvec index))
                  #f
                  (loop (+ index 1)))))))

    (define (bitvector-field-clear bvec start end)
      (let ((result (bitvector-copy bvec)))
        (bitvector-field-clear! result start end)
        result))

    (define (bitvector-field-clear! bvec start end)
      (let* ((range (check-range "bitvector-field-clear!" bvec start end)))
        (let loop ((index (range-start range)))
          (if (< index (range-end range))
              (begin (bitvector-set! bvec index 0)
                     (loop (+ index 1)))))))

    (define (bitvector-field-set bvec start end)
      (let ((result (bitvector-copy bvec)))
        (bitvector-field-set! result start end)
        result))

    (define (bitvector-field-set! bvec start end)
      (let* ((range (check-range "bitvector-field-set!" bvec start end)))
        (let loop ((index (range-start range)))
          (if (< index (range-end range))
              (begin (bitvector-set! bvec index 1)
                     (loop (+ index 1)))))))

    (define (bitvector-field-replace dest source start end)
      (let ((result (bitvector-copy dest)))
        (bitvector-field-replace! result source start end)
        result))

    (define (bitvector-field-replace! dest source start end)
      (let ((snapshot (bitvector-copy source 0 (- end start))))
        (let loop ((offset 0))
          (if (< offset (- end start))
              (begin
                (bitvector-set! dest (+ start offset)
                                (bitvector-ref/int snapshot offset))
                (loop (+ offset 1)))))))

    (define (bitvector-field-replace-same dest source start end)
      (let ((result (bitvector-copy dest)))
        (bitvector-field-replace-same! result source start end)
        result))

    (define (bitvector-field-replace-same! dest source start end)
      (bitvector-copy! dest start source start end))

    (define (bitvector-field-rotate bvec count start end)
      (let* ((length (- end start))
             (source (bitvector-copy bvec start end))
             (result (bitvector-copy bvec)))
        (let loop ((offset 0))
          (if (< offset length)
              (begin
                (bitvector-set! result (+ start offset)
                                (bitvector-ref/int
                                 source (modulo (+ offset count) length)))
                (loop (+ offset 1)))))
        result))

    (define (bitvector-field-flip bvec start end)
      (let ((result (bitvector-copy bvec)))
        (bitvector-field-flip! result start end)
        result))

    (define (bitvector-field-flip! bvec start end)
      (let loop ((index start))
        (if (< index end)
            (begin
              (bitvector-set! bvec index
                              (- 1 (bitvector-ref/int bvec index)))
              (loop (+ index 1))))))
