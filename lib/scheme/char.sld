(define-library (scheme char)
  (export (rename char-equal char=?)
          (rename char-less char<?)
          (rename char-greater char>?)
          (rename char-less-equal char<=?)
          (rename char-greater-equal char>=?)
          (rename char-ci-equal char-ci=?)
          (rename char-ci-less char-ci<?)
          (rename char-ci-greater char-ci>?)
          (rename char-ci-less-equal char-ci<=?)
          (rename char-ci-greater-equal char-ci>=?)
          char-alphabetic? char-numeric? char-whitespace?
          char-upper-case? char-lower-case?
          digit-value char-upcase char-downcase char-foldcase)
  (import (only (scheme base)
                + - < <= = > >= and or null? car cdr
                char->integer integer->char))
  (begin
    (define (char-equal-rest previous rest)
      (if (null? rest) #t
          (if (= (char->integer previous) (char->integer (car rest)))
              (char-equal-rest (car rest) (cdr rest)) #f)))
    (define (char-less-rest previous rest)
      (if (null? rest) #t
          (if (< (char->integer previous) (char->integer (car rest)))
              (char-less-rest (car rest) (cdr rest)) #f)))
    (define (char-greater-rest previous rest)
      (if (null? rest) #t
          (if (> (char->integer previous) (char->integer (car rest)))
              (char-greater-rest (car rest) (cdr rest)) #f)))
    (define (char-less-equal-rest previous rest)
      (if (null? rest) #t
          (if (<= (char->integer previous) (char->integer (car rest)))
              (char-less-equal-rest (car rest) (cdr rest)) #f)))
    (define (char-greater-equal-rest previous rest)
      (if (null? rest) #t
          (if (>= (char->integer previous) (char->integer (car rest)))
              (char-greater-equal-rest (car rest) (cdr rest)) #f)))
    (define (char-equal a b . rest)
      (if (= (char->integer a) (char->integer b))
          (char-equal-rest b rest) #f))
    (define (char-less a b . rest)
      (if (< (char->integer a) (char->integer b))
          (char-less-rest b rest) #f))
    (define (char-greater a b . rest)
      (if (> (char->integer a) (char->integer b))
          (char-greater-rest b rest) #f))
    (define (char-less-equal a b . rest)
      (if (<= (char->integer a) (char->integer b))
          (char-less-equal-rest b rest) #f))
    (define (char-greater-equal a b . rest)
      (if (>= (char->integer a) (char->integer b))
          (char-greater-equal-rest b rest) #f))
    (define (char-upper-case? character)
      (let ((code (char->integer character)))
        (and (>= code 65) (<= code 90))))
    (define (char-lower-case? character)
      (let ((code (char->integer character)))
        (and (>= code 97) (<= code 122))))
    (define (char-alphabetic? character)
      (or (char-upper-case? character) (char-lower-case? character)))
    (define (char-numeric? character)
      (let ((code (char->integer character)))
        (and (>= code 48) (<= code 57))))
    (define (char-whitespace? character)
      (let ((code (char->integer character)))
        (or (= code 32) (= code 9) (= code 10) (= code 13))))
    (define (digit-value character)
      (if (char-numeric? character)
          (- (char->integer character) 48) #f))
    (define (char-upcase character)
      (if (char-lower-case? character)
          (integer->char (- (char->integer character) 32)) character))
    (define (char-downcase character)
      (if (char-upper-case? character)
          (integer->char (+ (char->integer character) 32)) character))
    (define (char-foldcase character) (char-downcase character))
    (define (char-ci-equal-rest previous rest)
      (if (null? rest) #t
          (if (char-equal (char-foldcase previous)
                      (char-foldcase (car rest)))
              (char-ci-equal-rest (car rest) (cdr rest)) #f)))
    (define (char-ci-less-rest previous rest)
      (if (null? rest) #t
          (if (char-less (char-foldcase previous)
                      (char-foldcase (car rest)))
              (char-ci-less-rest (car rest) (cdr rest)) #f)))
    (define (char-ci-greater-rest previous rest)
      (if (null? rest) #t
          (if (char-greater (char-foldcase previous)
                      (char-foldcase (car rest)))
              (char-ci-greater-rest (car rest) (cdr rest)) #f)))
    (define (char-ci-less-equal-rest previous rest)
      (if (null? rest) #t
          (if (char-less-equal (char-foldcase previous)
                       (char-foldcase (car rest)))
              (char-ci-less-equal-rest (car rest) (cdr rest)) #f)))
    (define (char-ci-greater-equal-rest previous rest)
      (if (null? rest) #t
          (if (char-greater-equal (char-foldcase previous)
                       (char-foldcase (car rest)))
              (char-ci-greater-equal-rest (car rest) (cdr rest)) #f)))
    (define (char-ci-equal a b . rest)
      (if (char-equal (char-foldcase a) (char-foldcase b))
          (char-ci-equal-rest b rest) #f))
    (define (char-ci-less a b . rest)
      (if (char-less (char-foldcase a) (char-foldcase b))
          (char-ci-less-rest b rest) #f))
    (define (char-ci-greater a b . rest)
      (if (char-greater (char-foldcase a) (char-foldcase b))
          (char-ci-greater-rest b rest) #f))
    (define (char-ci-less-equal a b . rest)
      (if (char-less-equal (char-foldcase a) (char-foldcase b))
          (char-ci-less-equal-rest b rest) #f))
    (define (char-ci-greater-equal a b . rest)
      (if (char-greater-equal (char-foldcase a) (char-foldcase b))
          (char-ci-greater-equal-rest b rest) #f))))
