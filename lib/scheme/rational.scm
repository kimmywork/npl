; Public numeric classification, exactness, and rational policy. Raw numeric
; primitives only implement mechanisms. The runtime keeps complex values in
; canonical form: exact-zero imaginary parts demote, parts share exactness.
(define (rational? value)
  (if (real? value) (npl_finite_p value) #f))
(define (real? value)
  (if (number? value) (not (npl_complex_p value)) #f))
(define (complex? value) (number? value))
(define (integer? value)
  (if (rational? value)
      (if (npl_inexact_p value) (npl_inexact_op 6 value) (npl_integer_p value))
      #f))
(define (exact-integer? value) (npl_integer_p value))
(define (inexact-number? value) (npl_inexact_p (npl_complex_real value)))
(define (exact? value)
  (if (number? value) (not (inexact-number? value))
      (argument-error "exact?" "expected a number" value)))
(define (inexact? value)
  (if (number? value) (inexact-number? value)
      (argument-error "inexact?" "expected a number" value)))

(define (inexact value)
  (if (number? value)
      (if (npl_complex_p value)
          (npl_complex_make (npl_exact_to_inexact (npl_complex_real value))
                            (npl_exact_to_inexact (npl_complex_imag value)))
          (npl_exact_to_inexact value))
      (argument-error "inexact" "expected a number" value)))
(define (real->exact value who)
  (let ((result (npl_inexact_op 5 value)))
    (if (eq? result #f)
        (argument-error who "non-finite number has no exact value" value)
        result)))
(define (exact value)
  (if (number? value)
      (if (npl_complex_p value)
          (npl_complex_make (real->exact (npl_complex_real value) "exact")
                            (real->exact (npl_complex_imag value) "exact"))
          (real->exact value "exact"))
      (argument-error "exact" "expected a number" value)))
; R5RS names retained as aliases of the R7RS conversions.
(define (exact->inexact value) (inexact value))
(define (inexact->exact value) (exact value))
(define (inexact-if flag value) (if flag (npl_exact_to_inexact value) value))

(define (numerator value)
  (if (rational? value)
      (if (npl_inexact_p value)
          (if (npl_number_zero_p value) value
              (npl_exact_to_inexact (npl_rational_numerator (exact value))))
          (npl_rational_numerator value))
      (argument-error "numerator" "expected a rational" value)))
(define (denominator value)
  (if (rational? value)
      (if (npl_inexact_p value)
          (npl_exact_to_inexact (npl_rational_denominator (exact value)))
          (npl_rational_denominator value))
      (argument-error "denominator" "expected a rational" value)))
(define (abs value)
  (if (real? value)
      ; Negating an inexact zero also normalizes -0.0 to 0.0.
      (if (if (raw-less value 0) #t (npl_number_zero_p value))
          (raw-subtract 0 value) value)
      (argument-error "abs" "expected a real number" value)))
(define (positive? value)
  (if (real? value) (if (npl_nan_p value) #f (raw-greater value 0))
      (argument-error "positive?" "expected a real number" value)))
(define (negative? value)
  (if (real? value) (raw-less value 0)
      (argument-error "negative?" "expected a real number" value)))
(define (zero? value)
  (if (number? value) (npl_number_zero_p value)
      (argument-error "zero?" "expected a number" value)))
; Integer-valued inputs, including inexact integers, as exact integers.
(define (exact-integer-value value who)
  (if (integer? value)
      (if (npl_inexact_p value) (npl_inexact_op 5 value) value)
      (argument-error who "expected an integer" value)))
(define (even? value)
  (raw-equal (raw-remainder (exact-integer-value value "even?") 2) 0))
(define (odd? value) (not (even? value)))
(define (power-loop base exponent result)
  (if (raw-equal exponent 0) result
      (power-loop (raw-multiply base base)
                  (raw-quotient exponent 2)
                  (if (raw-equal (raw-remainder exponent 2) 0)
                      result (raw-multiply result base)))))
(define (integer-power base exponent)
  (if (raw-less exponent 0)
      (rational-divide 1 (power-loop base (raw-subtract 0 exponent) 1))
      (power-loop base exponent 1)))
; Non-integer exponents (exp/log based) remain outside this bounded policy.
(define (expt base exponent)
  (if (if (number? base) (number? exponent) #f)
      (if (integer? exponent)
          (if (npl_inexact_p exponent)
              (inexact (integer-power (inexact base) (npl_inexact_op 5 exponent)))
              (integer-power base exponent))
          (argument-error "expt" "expected an integer exponent" exponent))
      (argument-error "expt" "expected a number"
                      (if (number? base) exponent base))))
(define (square value) (if (number? value) (raw-multiply value value)
                           (argument-error "square" "expected a number" value)))

; Exact rational rounding; inexact inputs round through their exact value.
(define (truncated-quotient value)
  (raw-quotient (npl_rational_numerator value) (npl_rational_denominator value)))
(define (truncated-remainder value)
  (raw-remainder (npl_rational_numerator value) (npl_rational_denominator value)))
(define (exact-floor value)
  (if (raw-less (truncated-remainder value) 0)
      (raw-subtract (truncated-quotient value) 1) (truncated-quotient value)))
(define (exact-ceiling value)
  (if (raw-greater (truncated-remainder value) 0)
      (raw-add (truncated-quotient value) 1) (truncated-quotient value)))
(define (exact-round value)
  (let ((q (truncated-quotient value))
        (r (abs (truncated-remainder value)))
        (d (npl_rational_denominator value)))
    (let ((twice (raw-multiply r 2))
          (away (if (raw-less value 0) (raw-subtract q 1) (raw-add q 1))))
      (if (raw-less twice d) q
          (if (raw-greater twice d) away
              (if (even? q) q away))))))
; Codes: 0 floor, 1 ceiling, 2 truncate, 3 round.
(define (exact-rounding operation value)
  (cond ((raw-equal operation 0) (exact-floor value))
        ((raw-equal operation 1) (exact-ceiling value))
        ((raw-equal operation 2) (truncated-quotient value))
        (else (exact-round value))))
(define (real-rounding who operation value)
  (if (real? value)
      (if (npl_inexact_p value)
          ; Infinities, NaNs, and signed zeros are already integral results.
          (if (if (npl_finite_p value) (not (npl_number_zero_p value)) #f)
              (let ((result (exact-rounding operation (exact value))))
                ; Like IEEE roundToIntegral, a negative input keeps its sign.
                (if (if (raw-equal result 0) (raw-less value 0) #f) -0.0
                    (npl_exact_to_inexact result)))
              value)
          (exact-rounding operation value))
      (argument-error who "expected a real number" value)))
(define (floor value) (real-rounding "floor" 0 value))
(define (ceiling value) (real-rounding "ceiling" 1 value))
(define (truncate value) (real-rounding "truncate" 2 value))
(define (round value) (real-rounding "round" 3 value))

; An exact zero divisor is an error; inexact zero follows IEEE division.
(define (exact-zero? value)
  (if (npl_number_zero_p value) (not (inexact-number? value)) #f))
(define (divide-rationals value rest)
  (if (null? rest) value
      (if (exact-zero? (car rest)) (argument-error "/" "division by zero" value)
          (divide-rationals (npl_number_div value (car rest)) (cdr rest)))))
(define (rational-divide . xs)
  (if (null? xs) (argument-error "/" "wrong number of arguments" 0))
  (check-numeric-arguments "/" xs)
  (if (null? (cdr xs)) (divide-rationals 1 xs)
      (divide-rationals (car xs) (cdr xs))))
(define (string->number . arguments)
  (if (null? arguments)
      (argument-error "string->number" "wrong number of arguments" 0))
  (let ((text (car arguments))
        (rest (cdr arguments)))
    (if (not (string? text))
        (argument-error "string->number" "expected a string" text))
    (if (null? rest)
        (npl_number_from_string text)
        (if (not (null? (cdr rest)))
            (argument-error "string->number" "wrong number of arguments"
                            (length arguments))
            (let ((radix (car rest)))
              (if (not (valid-radix? radix))
                  (argument-error "string->number" "invalid radix" radix))
              (npl_number_from_string_radix text radix))))))
