; Public exact-integer arithmetic policy; both native and evaluator execute it.
; Raw primitives remain the compiler/runtime boundary, not a second public API.
(define (check-numeric-arguments who xs)
  (if (not (null? xs))
      (if (number? (car xs))
          (check-numeric-arguments who (cdr xs))
          (raise (string-append who ": expected numbers")))))

(define (sum-integers xs value)
  (if (null? xs) value
      (sum-integers (cdr xs) (raw-add value (car xs)))))
(define (multiply-integers xs value)
  (if (null? xs) value
      (multiply-integers (cdr xs) (raw-multiply value (car xs)))))
(define (subtract-integers xs value)
  (if (null? xs) value
      (subtract-integers (cdr xs) (raw-subtract value (car xs)))))
(define (integer-add . xs)
  (check-numeric-arguments "+" xs)
  (sum-integers xs 0))
(define (integer-multiply . xs)
  (check-numeric-arguments "*" xs)
  (multiply-integers xs 1))
(define (integer-subtract . xs)
  (if (null? xs) (raise "-: needs an argument"))
  (check-numeric-arguments "-" xs)
  (if (null? (cdr xs)) (raw-subtract 0 (car xs))
      (subtract-integers (cdr xs) (car xs))))

; Use a small operation code rather than exposing raw primitives as closures.
; Only = accepts complex operands; it compares rectangular components.
(define (numbers-equal? a b)
  (if (if (npl_complex_p a) #t (npl_complex_p b))
      (if (raw-equal (npl_complex_real a) (npl_complex_real b))
          (raw-equal (npl_complex_imag a) (npl_complex_imag b)) #f)
      (raw-equal a b)))
(define (check-real-arguments who xs)
  (if (not (null? xs))
      (if (real? (car xs))
          (check-real-arguments who (cdr xs))
          (raise (string-append who ": expected real numbers")))))
(define (compare-integer-pair operation a b)
  (cond ((raw-equal operation 0) (numbers-equal? a b))
        ((raw-equal operation 1) (raw-less a b))
        ((raw-equal operation 2) (raw-less-equal a b))
        ; Raw > and >= lower to order > 0 / >= 0, which treats the unordered
        ; result as true; exclude NaN here until the compiler lowering changes.
        ((if (npl_nan_p a) #t (npl_nan_p b)) #f)
        ((raw-equal operation 3) (raw-greater a b))
        (else (raw-greater-equal a b))))
(define (compare-integer-chain operation xs)
  (if (null? (cdr xs)) #t
      (if (compare-integer-pair operation (car xs) (car (cdr xs)))
          (compare-integer-chain operation (cdr xs)) #f)))
(define (compare-integers who operation xs)
  (if (if (null? xs) #t (null? (cdr xs)))
      (raise (string-append who ": needs at least two arguments")))
  ; Validate all arguments, including those beyond a false adjacent comparison.
  (if (raw-equal operation 0)
      (check-numeric-arguments who xs)
      (check-real-arguments who xs))
  (compare-integer-chain operation xs))
(define (integer-equal . xs) (compare-integers "=" 0 xs))
(define (integer-less . xs) (compare-integers "<" 1 xs))
(define (integer-less-equal . xs) (compare-integers "<=" 2 xs))
(define (integer-greater . xs) (compare-integers ">" 3 xs))
(define (integer-greater-equal . xs) (compare-integers ">=" 4 xs))

(define (valid-radix? radix)
  (if (npl_integer_p radix)
      (if (raw-greater-equal radix 2) (raw-less-equal radix 36) #f)
      #f))
; Integer utilities accept inexact integers: compute exactly, then return an
; inexact result when any argument was inexact.
(define (exact-integer-values who xs inexact output)
  (if (null? xs) (cons inexact (reverse output))
      (exact-integer-values who (cdr xs)
        (if inexact #t (npl_inexact_p (car xs)))
        (cons (exact-integer-value (car xs) who) output))))
(define (absolute-integer value)
  (if (raw-less value 0) (raw-subtract 0 value) value))
(define (integer-gcd-loop value rest)
  (if (null? rest) value
      (integer-gcd-loop
        (raw-gcd value (absolute-integer (car rest))) (cdr rest))))
(define (integer-gcd . xs)
  (let ((parts (exact-integer-values "gcd" xs #f '())))
    (inexact-if (car parts)
      (if (null? (cdr parts)) 0
          (integer-gcd-loop (absolute-integer (car (cdr parts)))
                            (cdr (cdr parts)))))))
(define (integer-lcm-loop value rest)
  (if (null? rest) value
      (let ((item (car rest)))
        (if (raw-equal item 0) 0
            (integer-lcm-loop
              (absolute-integer
                (raw-quotient (raw-multiply value item)
                              (raw-gcd value item)))
              (cdr rest))))))
(define (integer-lcm . xs)
  (let ((parts (exact-integer-values "lcm" xs #f '())))
    (inexact-if (car parts) (integer-lcm-loop 1 (cdr parts)))))

; Exact integer division kernels on nonzero divisors.
(define (floor-adjusted-quotient left right)
  (let ((q (raw-quotient left right))
        (r (raw-remainder left right)))
    (if (if (raw-equal r 0) #f
            (if (raw-less r 0) (raw-greater right 0) (raw-less right 0)))
        (raw-subtract q 1) q)))
(define (floor-adjusted-remainder left right)
  (let ((r (raw-remainder left right)))
    (if (if (raw-equal r 0) #f
            (if (raw-less r 0) (raw-greater right 0) (raw-less right 0)))
        (raw-add r right) r)))
; Codes: 0 truncate quotient, 1 truncate remainder, 2 floor quotient,
; 3 floor remainder.
(define (integer-division-kernel operation left right)
  (cond ((raw-equal operation 0) (raw-quotient left right))
        ((raw-equal operation 1) (raw-remainder left right))
        ((raw-equal operation 2) (floor-adjusted-quotient left right))
        (else (floor-adjusted-remainder left right))))
(define (integer-division who operation left right)
  (let ((parts (exact-integer-values who (cons left (cons right '())) #f '())))
    (let ((n (car (cdr parts)))
          (d (car (cdr (cdr parts)))))
      (if (raw-equal d 0) (raise (string-append who ": division by zero")))
      (inexact-if (car parts) (integer-division-kernel operation n d)))))
(define (integer-quotient left right)
  (integer-division "quotient" 0 left right))
(define (integer-remainder left right)
  (integer-division "remainder" 1 left right))
(define (integer-modulo left right)
  (integer-division "modulo" 3 left right))
(define (truncate-quotient left right)
  (integer-division "truncate-quotient" 0 left right))
(define (truncate-remainder left right)
  (integer-division "truncate-remainder" 1 left right))
(define (floor-quotient left right)
  (integer-division "floor-quotient" 2 left right))
(define (floor-remainder left right)
  (integer-division "floor-remainder" 3 left right))
(define (truncate/ left right)
  (values (integer-division "truncate/" 0 left right)
          (integer-division "truncate/" 1 left right)))
(define (floor/ left right)
  (values (integer-division "floor/" 2 left right)
          (integer-division "floor/" 3 left right)))
(define (number->string . arguments)
  (if (null? arguments) (raise "number->string: needs an argument"))
  (let ((value (car arguments))
        (rest (cdr arguments)))
    (if (not (number? value)) (raise "number->string: expected a number"))
    (if (null? rest)
        (raw-number->string value)
        (if (not (null? (cdr rest)))
            (raise "number->string: expected one or two arguments")
            (let ((radix (car rest)))
              (if (not (valid-radix? radix))
                  (raise "number->string: invalid radix"))
              (if (npl_inexact_p value)
                  (if (raw-equal radix 10) (raw-number->string value)
                      (raise "number->string: radix requires an exact number"))
                  (npl_number_to_string_radix value radix)))))))
